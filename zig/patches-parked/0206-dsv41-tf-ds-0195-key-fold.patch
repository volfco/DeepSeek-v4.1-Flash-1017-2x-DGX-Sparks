+/// The candidate block size the key fold needs: at `candidate_block == 8` eight threads' blocks are one 64-key tile, so
+/// the fused launch can write queries.py _score_keys' outputs (every column's key and each tile's largest key) from the
+/// same score reads as the block maxima, and the decode arm skips that launch. Other block sizes keep it.
+pub const key_fold_bsize = 8;
+/// _score_keys' tile width (TB in the kit's launch and `tri_index.tile`).
+pub const key_tile = 64;
+
+/// The key fold's bytes, on the host: every column's key (`scoreKey`) and each `key_tile`-wide tile's largest key in
+/// the keys' unsigned order (the kernel's eight-lane max, which the test below pins). `keys` is [width], `tmax`
+/// [ceil(width / key_tile)]; the kernel's partial last tile is the last block's live lanes only.
+pub fn foldKeys(score: []const f32, keys: []u64, tmax: []u64) void {
+    std.debug.assert(keys.len >= score.len and tmax.len >= (score.len + key_tile - 1) / key_tile);
+    for (score, 0..) |x, i| keys[i] = scoreKey(x, i);
+    var t: usize = 0;
+    while (t * key_tile < score.len) : (t += 1) {
+        var m: u64 = 0;
+        for (keys[t * key_tile..@min(score.len, (t + 1) * key_tile)]) |u| m = @max(m, u);
+        tmax[t] = m;
+    }
+}
