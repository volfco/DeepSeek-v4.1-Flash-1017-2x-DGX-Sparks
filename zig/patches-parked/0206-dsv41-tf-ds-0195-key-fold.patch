+test "foldKeys: the keys are scoreKey's, a tile's maximum is its largest key (unsigned), NaN ranks first" {
+    // a tile boundary at 64 keys, plus a partial last tile
+    var s: [70]f32 = undefined;
+    for (&s, 0..) |*x, i| x.* = @floatFromInt(70 - i); // descending: the first tile's max is column 0
+    var keys: [70]u64 = undefined;
+    var tmax: [2]u64 = undefined;
+    foldKeys(&s, &keys, &tmax);
+    for (s, 0..) |_, i| try expectEqual(scoreKey(s[i], i), keys[i]);
+    try expectEqual(keys[0], tmax[0]); // 70.0 at column 0 beats the rest of its tile
+    try expectEqual(keys[64], tmax[1]); // 6.0 at column 64, the second tile's (largest, then partial) head
+    // a NaN in the second tile outranks +inf there: the tile max is the NaN's key, above every finite one
+    s[65] = @bitCast(@as(u32, 0x7FC00000));
+    foldKeys(&s, &keys, &tmax);
+    try expectEqual(scoreKey(s[65], 65), tmax[1]);
+    try std.testing.expect(tmax[1] > scoreKey(std.math.inf(f32), 65));
+    // -inf ties break to the lower column, and the tail beyond the row is not in any tile
+    var flat: [64]f32 = @splat(-std.math.inf(f32));
+    var fkeys: [64]u64 = undefined;
+    var ftmax: [1]u64 = undefined;
+    foldKeys(&flat, &fkeys, &ftmax);
+    try expectEqual(fkeys[0], ftmax[0]);
+}
