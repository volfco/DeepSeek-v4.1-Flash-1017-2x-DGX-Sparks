+/// tf_ds_compress2_pair's finite path on the host: the maximum side's exp(0) is exactly 1, so only the other
+/// exponential is evaluated, once (the full path's operand order). Above 1e38 the full path is used, as in the kernel.
+pub fn pairSumFinite(kv0: f32, kv1: f32, s0: f32, s1: f32) f32 {
+    if (!(std.math.isFinite(s0) and std.math.isFinite(s1))) return pairSum(kv0, kv1, s0, s1);
+    var sum: f32 = 0;
+    var p0: f32 = 0;
+    var p1: f32 = 0;
+    if (!(s0 < s1)) {
+        const e1 = @exp(s1 - s0);
+        sum = (0.0 + 1.0) + e1;
+        p0 = 1.0 / sum;
+        p1 = e1 / sum;
+    } else {
+        const e0 = @exp(s0 - s1);
+        sum = (0.0 + e0) + 1.0;
+        p0 = e0 / sum;
+        p1 = 1.0 / sum;
+    }
+    const y0 = kv0 * p0;
+    const y1 = kv1 * p1;
+    return ((0.0 + y0) + (0.0 + y1)) + 0.0 + 0.0;
+}
