+    try std.testing.expect(std.math.isNan(pairSumFinite(1.0, 1.0, std.math.nan(f32), 0.0)));
+    try expectEqual(pairSum(1.0, 1.0, 0.0, -std.math.inf(f32)), pairSumFinite(1.0, 1.0, 0.0, -std.math.inf(f32)));
+}
