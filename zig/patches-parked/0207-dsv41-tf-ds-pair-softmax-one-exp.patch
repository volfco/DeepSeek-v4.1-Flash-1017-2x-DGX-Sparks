 // The pair-sum arithmetic of tf_ds_compress2_kernel / tf_ds_compress2x_kernel, verbatim (kv/score addressed by the
 // caller): the pair's softmax (max, the two expf, the sum from 0), the products, the pair's sum as compress2 adds it.
-__device__ __forceinline__ float tf_ds_compress2_pair(float s0, float s1, float kv0, float kv1) {
+// Every score that is not finite takes this path (NaN: the max never takes it, so the exps see NaN; +inf: inf - inf
+// must stay NaN; -inf likewise), which is what keeps the fast path below from changing a bit.
+__device__ __forceinline__ float tf_ds_compress2_pair_full(float s0, float s1, float kv0, float kv1) {
     float m = -3.402823466e+38f;   // numeric_limits<float>::lowest()
     m = m < s0 ? s0 : m;
     m = m < s1 ? s1 : m;
@@ -414,6 +416,32 @@ __device__ __forceinline__ float tf_ds_compress2_pair(float s0, float s1, float
     return t;
 }
 
+// Two finite scores: the maximum side's exp(0) is exactly 1, so only the other exponential is evaluated, once, for
+// both its addition and its division. The operand order is the full path's: (0 + 1) + e1 when s0 is the maximum
+// (m is s0 there, ties included) and (0 + e0) + 1 when it is s1; every later operation is unchanged.
+__device__ __forceinline__ float tf_ds_compress2_pair(float s0, float s1, float kv0, float kv1) {
+    if (!(isfinite(s0) && isfinite(s1))) return tf_ds_compress2_pair_full(s0, s1, kv0, kv1);
+    float p0, p1;
+    float sum;
+    if (!(s0 < s1)) {   // s0 is the maximum the full path's running max takes (a tie takes s0)
+        const float e1 = expf(__fsub_rn(s1, s0));
+        sum = __fadd_rn(__fadd_rn(0.f, 1.f), e1);
+        p0 = __fdiv_rn(1.f, sum);
+        p1 = __fdiv_rn(e1, sum);
+    } else {
+        const float e0 = expf(__fsub_rn(s0, s1));
+        sum = __fadd_rn(__fadd_rn(0.f, e0), 1.f);
+        p0 = __fdiv_rn(e0, sum);
+        p1 = __fdiv_rn(1.f, sum);
+    }
+    const float y0 = __fmul_rn(kv0, p0);
+    const float y1 = __fmul_rn(kv1, p1);
+    float t = __fadd_rn(__fadd_rn(0.f, y0), __fadd_rn(0.f, y1));
+    t = __fadd_rn(t, 0.f);
+    t = __fadd_rn(t, 0.f);
+    return t;
+}
