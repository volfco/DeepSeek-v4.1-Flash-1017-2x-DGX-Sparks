+/// The cached high word the kernel keeps in shared memory (tf_ds_score_high): the key's top 32 bits, which is the whole
+/// score order. The float maximum is not needed once the column's key can be rebuilt from it.
+pub fn scoreHigh(x: f32) u32 {
+    return @truncate(scoreKey(x, 0) >> 32);
+}
+
+/// A cached high word and its column as the key `scoreKey` makes for that score (tf_ds_score_key_from).
+pub fn keyFromHigh(high: u32, j: usize) u64 {
+    return (@as(u64, high) << 32) | (0xFFFFFFFF - @as(u64, @intCast(j)));
+}
