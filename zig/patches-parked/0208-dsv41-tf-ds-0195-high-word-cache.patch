+test "scoreHigh/keyFromHigh: a cached high word rebuilds the very key scoreKey makes" {
+    const corpus = [_]f32{
+        0.0, -0.0, 1.0, -1.0, 1e-30, -1e-30, 65504.0, -65504.0, std.math.inf(f32), ninf,
+        @bitCast(@as(u32, 0x7FC00000)), @bitCast(@as(u32, 0x7F800001)), // canonical and a signalling NaN pattern
+        @bitCast(@as(u32, 0x00000001)), -3.402823466e+38, 3.402823466e+38,
+    };
+    for (corpus) |x| for ([_]usize{ 0, 1, 7, 8191, 8192 }) |j| {
+        if (j >= max_nbk) continue;
+        try expectEqual(scoreKey(x, j), keyFromHigh(scoreHigh(x), j));
+    };
+    // the highs order the scores as the keys do, and -inf/NaN are the two invalid ones
+    try std.testing.expect(scoreHigh(-1.0) < scoreHigh(0.0));
+    try std.testing.expect(scoreHigh(0.0) < scoreHigh(1.0));
+    try std.testing.expect(scoreHigh(1.0) < scoreHigh(std.math.inf(f32)));
+    try std.testing.expect(scoreHigh(std.math.inf(f32)) < scoreHigh(@bitCast(@as(u32, 0x7FC00000))));
+    try std.testing.expect(!highValid(scoreHigh(ninf)));
+    try std.testing.expect(!highValid(scoreHigh(@bitCast(@as(u32, 0x7FC00000)))));
+    try std.testing.expect(highValid(scoreHigh(0.0)));
+    try std.testing.expect(highValid(scoreHigh(std.math.inf(f32))));
+    try std.testing.expect(highValid(scoreHigh(-65504.0)));
+    // signed zeros share one key byte for byte
+    try std.testing.expectEqual(scoreHigh(0.0), scoreHigh(-0.0));
+}
+
+test "blockHighs: the newest block's +inf is valid, a NaN and -inf blocks are not, signed zeros tie" {
+    var s = [_]f32{ 0.0, -0.0, ninf, 3.0 };
+    var highs: [2]u32 = undefined;
+    blockHighs(&s, 4, 2, 4, &highs); // vis = 4: the newest block is 1, pinned +inf
+    try expectEqual(scoreHigh(std.math.inf(f32)), highs[1]);
+    try std.testing.expect(highValid(highs[1]));
+    try expectEqual(scoreHigh(0.0), highs[0]); // -0.0 vs +0.0: one key
+    try std.testing.expect(highValid(highs[0]));
+    // an -inf block is invalid even when selected; a NaN block is invalid too (it sorts above +inf)
+    var neg = [_]f32{ ninf, ninf };
+    blockHighs(&neg, 2, 2, 0, highs[0..1]); // vis 0 pins nothing: the block is the -inf floor
+    try std.testing.expect(!highValid(highs[0]));
+    var nan = [_]f32{ @bitCast(@as(u32, 0x7FC00000)), 0.0 };
+    blockHighs(&nan, 2, 2, 0, highs[0..1]);
+    try std.testing.expect(!highValid(highs[0]));
+    try std.testing.expect(highs[0] > scoreHigh(std.math.inf(f32)));
+}
