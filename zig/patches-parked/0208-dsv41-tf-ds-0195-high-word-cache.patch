+/// The pool pick's validity on a cached high word, which replaces the old `value > -inf` test: -inf's high word is the
+/// floor and the canonical NaN's sorts above +inf yet is not a value, so both are invalid.
+pub fn highValid(high: u32) bool {
+    return high > scoreHigh(ninf) and high != scoreHigh(@bitCast(@as(u32, 0x7FC00000)));
+}
