+// TF_DS_IDX_FUSED, eight scores per candidate and 16-byte-aligned rows (idx_fused.candMask8Ok).
+extern "C" __global__ void tf_ds_cand_fast8_kernel(const float* score, long long ss, int nb, int /*bsize*/,
+                                                   const long long* vis, uint8_t* out, long long os, int pdl) {
+    pdl_enter(pdl);
+    const int r = blockIdx.y;
+    const float4* row = reinterpret_cast<const float4*>(score + (long long)r * ss);
+    const long long visible = vis[r];
+    const long long last = visible > 0 ? (visible - 1) / 8 : -1;
+    const float ninf = -__int_as_float(0x7f800000);
+    for (int b = blockIdx.x * blockDim.x + threadIdx.x; b < nb; b += gridDim.x * blockDim.x) {
+        const float4 lo = row[2LL * b], hi = row[2LL * b + 1];
+        const float values[8] = {lo.x, lo.y, lo.z, lo.w, hi.x, hi.y, hi.z, hi.w};
+        bool nan = false, above = false;
+        #pragma unroll
+        for (int j = 0; j < 8; ++j) {
+            nan |= isnan(values[j]);
+            above |= values[j] > ninf;
+        }
+        out[(long long)r * os + b] = (uint8_t)((!nan && above) || b == last);
+    }
+}
