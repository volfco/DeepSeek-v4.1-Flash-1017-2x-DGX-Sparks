--- a/zig/src/families/dsv41/expert_prune.zig
+++ b/zig/src/families/dsv41/expert_prune.zig
@@ -183,6 +183,47 @@ pub fn write(w: *std.Io.Writer, rank: u32, s: Stats) !void {
 /// What pruneRow did to a row.
 pub const Outcome = struct { dropped: u32 = 0, mass: f32 = 0 };
 
+/// tf_ds_drop_six's trailing-ranks rule after its ordering network, on the host: `shares`/`bits` in slot order (an
+/// unrouted slot is -inf with bit 0), sorted by share descending, ties to the higher bit. The first three live slots are
+/// kept; each later rank drops once the inclusive rounded prefix reaches topp, where "reaches" is `!(prefix < topp)`
+/// (NaN counts as reached, as in the kernel). `monotone` is the item-13 early-out: with every share finite and
+/// nonnegative the premise holds, so the two forms must agree.
+pub const SlotShare = struct { share: f32, bit: u32 };
+
+pub fn dropTrailing(shares: [6]f32, bits: [6]u32, topp: f32, monotone: bool) u32 {
+    var s: [6]SlotShare = undefined;
+    for (shares, bits, 0..) |f, b, i| s[i] = .{ .share = f, .bit = b };
+    std.mem.sort(SlotShare, &s, {}, struct {
+        fn lt(_: void, a: SlotShare, b: SlotShare) bool {
+            if (a.share == b.share) return a.bit > b.bit;
+            return a.share > b.share;
+        }
+    }.lt);
+    var prefix = (s[0].share + s[1].share) + s[2].share;
+    if (monotone) {
+        if (!(prefix < topp)) return s[3].bit | s[4].bit | s[5].bit;
+        prefix += s[3].share;
+        if (!(prefix < topp)) return s[4].bit | s[5].bit;
+        prefix += s[4].share;
+        return if (prefix < topp) 0 else s[5].bit;
+    }
+    var drop: u32 = if (prefix < topp) 0 else s[3].bit;
+    prefix += s[3].share;
+    if (!(prefix < topp)) drop |= s[4].bit;
+    prefix += s[4].share;
+    if (!(prefix < topp)) drop |= s[5].bit;
+    return drop;
+}
+
+/// The kernel's guard for the early-out: every share finite and nonnegative (an unrouted slot is -inf, so a row with
+/// one never takes it).
+pub fn monotoneShares(shares: []const f32) bool {
+    for (shares) |f| {
+        if (!(std.math.isFinite(f) and f >= 0)) return false;
+    }
+    return true;
+}
