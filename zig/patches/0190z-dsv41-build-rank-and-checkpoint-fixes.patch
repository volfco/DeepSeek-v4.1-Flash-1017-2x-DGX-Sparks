 /// The parsed TF_DS_ENGRAM_CPUS (empty = unset); model open sets it once, before any Engram thread starts.
 var engram_cpus: CpuSet = .{};
 
-pub fn setCpus(text: ?[]const u8, cpu_count: usize) !void {
-    engram_cpus = if (text) |t| try parseCpus(t, cpu_count) else .{};
+pub fn setCpus(text: ?[]const u8) !void {
+    const spec = text orelse {
+        engram_cpus = .{};
+        return;
+    };
+    const requested = try parseCpus(spec, max_cpus);
+    var allowed: std.os.linux.cpu_set_t = @splat(0);
+    if (std.os.linux.errno(std.os.linux.sched_getaffinity(0, @sizeOf(@TypeOf(allowed)), &allowed)) != .SUCCESS) return error.InvalidCpus;
+    for (requested.set, allowed) |want, have| {
+        if (want & ~have != 0) return error.InvalidCpus;
+    }
+    engram_cpus = requested;
 }
 
