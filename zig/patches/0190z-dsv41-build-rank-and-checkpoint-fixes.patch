+
+test "full ends displace through the cache, match identical IDs and release memory at capacity" {
+    const gpa = std.testing.allocator;
+    var f: Fake = .{ .gpa = gpa };
+    var s = Store.init(gpa, f.snapshots(), .{ .grid = 4, .window = 2, .tail = 2, .endstate = true, .end_limit = 1 }, 1 << 20);
+    defer s.deinit();
+    const a = [_]u32{ 1, 2, 3, 4, 5 };
+    const b = [_]u32{ 6, 7, 8, 9 };
+    f.at = a.len;
+    try std.testing.expect(s.keep(&a, a.len, null, &.{}));
+    try std.testing.expectEqual(@as(u32, a.len), s.find(&a,&.{}).?.at);
+    f.at = b.len;
+    try std.testing.expect(s.keep(&b, b.len, null, &.{}));
+    try std.testing.expect(s.find(&a,&.{}) == null);
+    try std.testing.expectEqual(@as(u32, b.len), s.find(&b,&.{}).?.at);
+    try std.testing.expectEqual(@as(usize,1), f.live);
+}
