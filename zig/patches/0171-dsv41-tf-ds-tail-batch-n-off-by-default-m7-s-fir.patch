+/// 0180 (TF_DS_TAIL_BATCH): `1`..`8` - a prompt pass resuming a full end state computes the new rows only (the
+/// rings hold the window; today's states keep no complete rings, so every warm pass replays the window), and N
+/// names the batch width the next step takes (several streams' tails in one pass - the design is the patch's
+/// commit body). Unset, `0` or `off`: the engine as it was. A malformed value refuses the start.
+fn parseTailBatch(v: ?[]const u8) !?u8 {
+    const s = std.mem.trim(u8, v orelse return null, " \t\r\n");
+    if (s.len == 0 or std.mem.eql(u8, s, "0") or std.mem.eql(u8, s, "off")) return null;
+    const n = std.fmt.parseInt(u8, s, 10) catch return error.BadTailBatch;
+    return if (n >= 1 and n <= 8) n else error.BadTailBatch;
+}
+
