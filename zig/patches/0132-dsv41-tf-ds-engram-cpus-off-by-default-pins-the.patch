+test "TF_DS_ENGRAM_CPUS: ranges and lists parse, an inverted range or a CPU past the count is refused" {
+    const a = try parseCpus("10-14", 16);
+    try std.testing.expectEqual(@as(usize, 5), a.len);
+    try std.testing.expect(a.has(10) and a.has(14) and !a.has(9) and !a.has(15));
+    const b = try parseCpus("10,12,14", 16);
+    try std.testing.expectEqual(@as(usize, 3), b.len);
+    try std.testing.expect(b.has(10) and b.has(12) and b.has(14) and !b.has(11));
+    try std.testing.expectEqual(@as(usize, 3), (try parseCpus("1,3-4", 16)).len);
+    try std.testing.expectError(error.InvalidCpus, parseCpus("14-10", 16));
+    try std.testing.expectError(error.InvalidCpus, parseCpus("16", 16));
+    try std.testing.expectError(error.InvalidCpus, parseCpus("10-20", 16));
+    for ([_][]const u8{ "", "x", "1-", "-3", "1,,2", "1-2-3", " 1", "1 " }) |v| try std.testing.expectError(error.InvalidCpus, parseCpus(v, 16));
+}
