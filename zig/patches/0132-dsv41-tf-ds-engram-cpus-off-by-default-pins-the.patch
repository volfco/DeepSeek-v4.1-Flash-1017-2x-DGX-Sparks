+/// TF_DS_ENGRAM_CPUS: the CPUs the Engram host threads run on. Empty (unset) = no affinity call anywhere.
+pub const CpuSet = struct {
+    set: std.os.linux.cpu_set_t = @splat(0),
+    len: usize = 0, // CPUs in the set
+
+    pub fn has(self: *const CpuSet, cpu: usize) bool {
+        return self.set[cpu / @bitSizeOf(usize)] & (@as(usize, 1) << @intCast(cpu % @bitSizeOf(usize))) != 0;
+    }
+};
+
+const max_cpus = @bitSizeOf(std.os.linux.cpu_set_t);
+
+fn parseCpu(s: []const u8) !usize {
+    if (s.len == 0) return error.InvalidCpus;
+    return std.fmt.parseInt(usize, s, 10) catch error.InvalidCpus;
+}
+
+/// a-b ranges and/or comma lists ("10-14", "10,12,14"); every CPU below `cpu_count` (and the mask's size). An inverted
+/// range or a CPU past either is refused: a mis-set affinity must not run on another core.
+pub fn parseCpus(text: []const u8, cpu_count: usize) !CpuSet {
+    var out: CpuSet = .{};
+    var it = std.mem.splitScalar(u8, text, ',');
+    while (it.next()) |part| {
+        var lo: usize = undefined;
+        var hi: usize = undefined;
+        if (std.mem.indexOfScalar(u8, part, '-')) |d| {
+            if (std.mem.indexOfScalarPos(u8, part, d + 1, '-') != null) return error.InvalidCpus;
+            lo = try parseCpu(part[0..d]);
+            hi = try parseCpu(part[d + 1 ..]);
+        } else {
+            lo = try parseCpu(part);
+            hi = lo;
+        }
+        if (lo > hi or hi >= cpu_count or hi >= max_cpus) return error.InvalidCpus;
+        for (lo..hi + 1) |c| {
+            out.set[c / @bitSizeOf(usize)] |= @as(usize, 1) << @intCast(c % @bitSizeOf(usize));
+            out.len += 1;
+        }
+    }
+    if (out.len == 0) return error.InvalidCpus;
+    return out;
+}
+
+/// The parsed TF_DS_ENGRAM_CPUS (empty = unset); model open sets it once, before any Engram thread starts.
+var engram_cpus: CpuSet = .{};
+
+pub fn setCpus(text: ?[]const u8, cpu_count: usize) !void {
+    engram_cpus = if (text) |t| try parseCpus(t, cpu_count) else .{};
+}
+
+/// The calling thread on the Engram CPUs, when TF_DS_ENGRAM_CPUS is set; no syscall otherwise and off Linux.
+pub fn pin() void {
+    if (engram_cpus.len == 0 or comptime builtin.os.tag != .linux) return;
+    std.os.linux.sched_setaffinity(0, &engram_cpus.set) catch {};
+}
