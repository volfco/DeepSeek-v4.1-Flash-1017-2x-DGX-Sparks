+// TF_DS_CONF_PACK (conf_pack.zig): the DSpark confidence head's input, conf_in fp32 [streams * steps, d + rank], in one
+// launch. Output row j = i * steps + s (stream i, step s) reads token ids[i * (steps + 1) + s]: its first d floats are xc
+// row i * n + s widened, the next rank floats the token's markov_embed row widened, which is also copied into embs row j
+// (the chain's gather buffer). An id outside [0, vocab) sets the flag (tf_gather_rows_kernel's rule) and leaves embs row
+// j as it was, and that stale row is what gets widened: the chain widened the gather's destination either way. One
+// block a row, threads striding the row's columns.
+extern "C" __global__ void tf_ds_conf_pack_kernel(const __nv_bfloat16* xc, const __nv_bfloat16* embed, const int64_t* ids,
+                                                  __nv_bfloat16* embs, float* conf_in, uint32_t* invalid, int n, int steps,
+                                                  int d, int rank, unsigned long long vocab, int pdl) {
+    pdl_enter(pdl);
+    const int j = blockIdx.x;
+    const int i = j / steps, s = j - i * steps;
+    const int64_t id = ids[(size_t)i * (steps + 1) + s];
+    const bool ok = id >= 0 && (unsigned long long)id < vocab;
+    if (!ok && threadIdx.x == 0) atomicExch(invalid, 1u);
+    const __nv_bfloat16* x = xc + ((size_t)i * n + s) * d;
+    __nv_bfloat16* e = embs + (size_t)j * rank;
+    const __nv_bfloat16* src = ok ? embed + (size_t)id * rank : e;
+    float* out = conf_in + (size_t)j * (d + rank);
+    for (int c = threadIdx.x; c < d + rank; c += blockDim.x) {
+        if (c < d) {
+            out[c] = __bfloat162float(x[c]);
+        } else {
+            const __nv_bfloat16 v = src[c - d];
+            if (ok) e[c - d] = v;
+            out[c] = __bfloat162float(v);
+        }
+    }
+}
diff --git a/zig/src/families/dsv41/conf_pack.zig b/zig/src/families/dsv41/conf_pack.zig
new file mode 100644
index 0000000000000000000000000000000000000000..1867394f8ca9406c4821719a478a0427699d3ed5
--- /dev/null
+++ b/zig/src/families/dsv41/conf_pack.zig
@@ -0,0 +1,220 @@
+//! TF_DS_CONF_PACK (off by default): the DSpark confidence head's input in one launch (tf_ds_conf_pack_kernel,
+//! dsv41_ops.cu) instead of draft.zig body's chain of a gatherRows and a toF32 a stream, a toF32 of the gathered rows and
+//! two copyRows (11 launches at four streams). Pure: no cuda import; the launcher is Ops.confPack and the call site is
+//! Drafter.body. The flag clear before it and the cuBLAS GEMV after it are unchanged.
+//!
+//! The kernel writes conf_in and the gathered embedding rows (dr.embs) only: the chain's fp32 staging (dr.xcf, dr.ef)
+//! has no other reader, so the fused path leaves it unwritten. dr.embs keeps being written because the gather leaves an
+//! invalid id's row untouched, and the chain then widens that stale row: keeping the buffer's history is what makes a
+//! later pass's invalid id byte-identical too. A malformed switch refuses startup.
+const std = @import("std");
+
+pub const env_name: [:0]const u8 = "TF_DS_CONF_PACK";
+
+/// The switch's value: unset, "" or "0" off; "1" on; anything else is a refusal to start (the message is on stderr).
+pub fn parse(text: ?[]const u8) ?bool {
+    const t = text orelse return false;
+    if (t.len == 0 or std.mem.eql(u8, t, "0")) return false;
+    if (std.mem.eql(u8, t, "1")) return true;
+    std.debug.print("{s}: expected 1 or 0\n", .{env_name});
+    return null;
+}
+
+pub fn fromText(text: ?[]const u8) error{BadConfPack}!bool {
+    return parse(text) orelse error.BadConfPack;
+}
+
+// -- host reference -------------------------------------------------------------------------------------------------
+
+/// The pass's shape: N streams of `steps` scored rows, n block rows a stream in xc (n >= steps), the hidden width d,
+/// the Markov rank and the vocabulary (markov_embed's rows).
+pub const Dims = struct { streams: usize, steps: usize, n: usize, d: usize, rank: usize, vocab: usize };
+
+/// bf16 -> fp32 (`.float()`, exact: the bits move up 16 places, NaN payloads and signs included).
+pub fn widen(b: u16) f32 {
+    return @bitCast(@as(u32, b) << 16);
+}
+
+/// tf_gather_rows_kernel's validity rule (movement.cu): an id outside [0, vocab) sets the flag and leaves its
+/// destination row untouched.
+pub fn idValid(id: i64, vocab: usize) bool {
+    return id >= 0 and @as(u64, @intCast(id)) < vocab;
+}
+
+/// The packed pass: for output row j = i * steps + s, the token it reads is ids[i * (steps + 1) + s]; conf_in row j
+/// (d + rank floats) is xc row i * n + s widened, then the embedding row widened - markov_embed's row for a valid id
+/// (also copied into embs row j), embs row j's existing bytes for an invalid one. Returns whether any id was invalid.
+pub fn pack(m: Dims, xc: []const u16, embed: []const u16, ids: []const i64, embs: []u16, conf_in: []f32) bool {
+    const w = m.d + m.rank;
+    var invalid = false;
+    for (0..m.streams) |i| for (0..m.steps) |s| {
+        const j = i * m.steps + s;
+        const id = ids[i * (m.steps + 1) + s];
+        const row = embs[j * m.rank ..][0..m.rank];
+        if (idValid(id, m.vocab)) {
+            @memcpy(row, embed[@as(usize, @intCast(id)) * m.rank ..][0..m.rank]);
+        } else invalid = true;
+        const out = conf_in[j * w ..][0..w];
+        for (out[0..m.d], xc[(i * m.n + s) * m.d ..][0..m.d]) |*o, x| o.* = widen(x);
+        for (out[m.d..], row) |*o, x| o.* = widen(x);
+    };
+    return invalid;
+}
+
+// -- tests ----------------------------------------------------------------------------------------------------------
+
+test "switch parse" {
+    try std.testing.expectEqual(@as(?bool, false), parse(null));
+    try std.testing.expectEqual(@as(?bool, false), parse(""));
+    try std.testing.expectEqual(@as(?bool, false), parse("0"));
+    try std.testing.expectEqual(@as(?bool, true), parse("1"));
+    try std.testing.expectEqual(@as(?bool, null), parse("on"));
+    try std.testing.expectError(error.BadConfPack, fromText("2"));
+}
+
+/// The served chain, transcribed launch by launch (draft.zig body before this switch): a gatherRows and a toF32 a
+/// stream, the toF32 of all gathered rows, then the two copyRows into conf_in's halves.
+fn chain(m: Dims, xc: []const u16, embed: []const u16, ids: []const i64, embs: []u16, xcf: []f32, ef: []f32, conf_in: []f32) bool {
+    const ts = m.steps + 1;
+    const w = m.d + m.rank;
+    var flag = false;
+    for (0..m.streams) |i| {
+        // gatherRows(markov_embed, vocab, out + i*ts, embs + i*steps rows, rank*2 bytes, steps rows)
+        for (0..m.steps) |r| {
+            const pick = ids[i * ts + r];
+            if (pick < 0 or @as(u64, @bitCast(pick)) >= m.vocab) {
+                flag = true;
+                continue;
+            }
+            const p: usize = @intCast(pick);
+            for (0..m.rank) |b| embs[(i * m.steps + r) * m.rank + b] = embed[p * m.rank + b];
+        }
+        // toF32(xc + i*n rows, xcf + i*steps rows, steps*d values)
+        for (0..m.steps * m.d) |k| xcf[i * m.steps * m.d + k] = @bitCast(@as(u32, xc[i * m.n * m.d + k]) << 16);
+    }
+    for (0..m.streams * m.steps * m.rank) |k| ef[k] = @bitCast(@as(u32, embs[k]) << 16);
+    for (0..m.streams * m.steps) |r| {
+        @memcpy(conf_in[r * w ..][0..m.d], xcf[r * m.d ..][0..m.d]);
+        @memcpy(conf_in[r * w + m.d ..][0..m.rank], ef[r * m.rank ..][0..m.rank]);
+    }
+    return flag;
+}
+
+const Case = struct {
+    m: Dims,
+    xc: []u16,
+    embed: []u16,
+    ids: []i64,
+    embs_a: []u16,
+    embs_b: []u16,
+    xcf: []f32,
+    ef: []f32,
+    ca: []f32,
+    cb: []f32,
+
+    fn init(a: std.mem.Allocator, m: Dims, rnd: std.Random) !Case {
+        const rows = m.streams * m.steps;
+        const cs: Case = .{
+            .m = m,
+            .xc = try a.alloc(u16, m.streams * m.n * m.d),
+            .embed = try a.alloc(u16, m.vocab * m.rank),
+            .ids = try a.alloc(i64, m.streams * (m.steps + 1)),
+            .embs_a = try a.alloc(u16, rows * m.rank),
+            .embs_b = try a.alloc(u16, rows * m.rank),
+            .xcf = try a.alloc(f32, rows * m.d),
+            .ef = try a.alloc(f32, rows * m.rank),
+            .ca = try a.alloc(f32, rows * (m.d + m.rank)),
+            .cb = try a.alloc(f32, rows * (m.d + m.rank)),
+        };
+        for (cs.xc) |*x| x.* = rnd.int(u16);
+        for (cs.embed) |*x| x.* = rnd.int(u16);
+        for (cs.embs_a) |*x| x.* = rnd.int(u16);
+        @memcpy(cs.embs_b, cs.embs_a);
+        for (cs.ids) |*x| x.* = rnd.intRangeLessThan(i64, 0, @intCast(m.vocab));
+        // conf_in's prior contents are irrelevant (every float is written); make them differ to prove it
+        for (cs.ca) |*x| x.* = 1.5;
+        for (cs.cb) |*x| x.* = -2.5;
+        return cs;
+    }
+
+    fn check(cs: *Case) !void {
+        const fa = pack(cs.m, cs.xc, cs.embed, cs.ids, cs.embs_a, cs.ca);
+        const fb = chain(cs.m, cs.xc, cs.embed, cs.ids, cs.embs_b, cs.xcf, cs.ef, cs.cb);
+        try std.testing.expectEqual(fb, fa);
+        try std.testing.expectEqualSlices(u16, cs.embs_b, cs.embs_a);
+        try std.testing.expectEqualSlices(u32, @as([]const u32, @ptrCast(cs.cb)), @as([]const u32, @ptrCast(cs.ca)));
+    }
+};
+
+test "packed rows equal the chain over 48 stream, block and depth combinations" {
+    var arena = std.heap.ArenaAllocator.init(std.testing.allocator);
+    defer arena.deinit();
+    var prng = std.Random.DefaultPrng.init(0x260);
+    const rnd = prng.random();
+    var count: usize = 0;
+    for ([_]usize{ 1, 2, 4 }) |streams| for ([_]usize{ 1, 3, 5, 6 }) |steps| for ([_]usize{ 0, 1, 2, 3 }) |extra| {
+        // n: the block rows (>= steps): exactly steps, one more (the served blockRows), and wider
+        const m: Dims = .{ .streams = streams, .steps = steps, .n = steps + extra, .d = 24 + 8 * extra, .rank = 8 + 4 * (steps % 3), .vocab = 37 };
+        var cs = try Case.init(arena.allocator(), m, rnd);
+        // a stream's pending token sits at ids[i*ts]; its last draft (ids[i*ts + steps]) is never read: poison it
+        for (0..streams) |i| cs.ids[i * (steps + 1) + steps] = -7;
+        // every third case: one read id out of range (a stale row and the flag)
+        if (count % 3 == 1) cs.ids[(rnd.uintLessThan(usize, streams)) * (steps + 1) + rnd.uintLessThan(usize, steps)] = @intCast(m.vocab);
+        try cs.check();
+        count += 1;
+    };
+    try std.testing.expectEqual(@as(usize, 48), count);
+}
+
+test "ids at the boundaries: the flag and the untouched row" {
+    var arena = std.heap.ArenaAllocator.init(std.testing.allocator);
+    defer arena.deinit();
+    var prng = std.Random.DefaultPrng.init(0x2601);
+    const m: Dims = .{ .streams = 1, .steps = 1, .n = 2, .d = 16, .rank = 8, .vocab = 50 };
+    const ids = [_]i64{ 0, 49, 50, -1, std.math.minInt(i64), std.math.maxInt(i64) };
+    for (ids) |id| {
+        var cs = try Case.init(arena.allocator(), m, prng.random());
+        cs.ids[0] = id;
+        const before = try arena.allocator().dupe(u16, cs.embs_a);
+        const valid = idValid(id, m.vocab);
+        try std.testing.expectEqual(!valid, pack(m, cs.xc, cs.embed, cs.ids, cs.embs_a, cs.ca));
+        if (valid) {
+            try std.testing.expectEqualSlices(u16, cs.embed[@as(usize, @intCast(id)) * m.rank ..][0..m.rank], cs.embs_a);
+        } else try std.testing.expectEqualSlices(u16, before, cs.embs_a);
+        for (cs.ca[m.d..], cs.embs_a) |f, b| try std.testing.expectEqual(@as(u32, b) << 16, @as(u32, @bitCast(f)));
+        @memcpy(cs.embs_a, before);
+        try cs.check();
+    }
+    try std.testing.expect(idValid(0, 50) and idValid(49, 50) and !idValid(50, 50) and !idValid(-1, 50));
+}
+
+test "an invalid id widens the previous pass's gathered row" {
+    var arena = std.heap.ArenaAllocator.init(std.testing.allocator);
+    defer arena.deinit();
+    var prng = std.Random.DefaultPrng.init(0x2602);
+    const m: Dims = .{ .streams = 2, .steps = 3, .n = 4, .d = 16, .rank = 8, .vocab = 20 };
+    var cs = try Case.init(arena.allocator(), m, prng.random());
+    // pass 1: every id valid (stream 1 step 2 reads token 13)
+    cs.ids[1 * 4 + 2] = 13;
+    try cs.check();
+    // pass 2, the same buffers: that row's id is now invalid, and the chain widens token 13's bytes again
+    cs.ids[1 * 4 + 2] = -1;
+    try cs.check();
+    const j = 1 * 3 + 2;
+    for (cs.ca[j * (m.d + m.rank) + m.d ..][0..m.rank], cs.embed[13 * m.rank ..][0..m.rank]) |f, b|
+        try std.testing.expectEqual(widen(b), f);
+}
+
+test "bf16 specials widen bit-exact" {
+    const specials = [_]u16{ 0x7FC0, 0xFFC1, 0x7F81, 0x7F80, 0xFF80, 0x0000, 0x8000, 0x0001, 0x807F, 0x7F7F, 0xFF7F, 0x3F80 };
+    const expect = [_]u32{ 0x7FC00000, 0xFFC10000, 0x7F810000, 0x7F800000, 0xFF800000, 0, 0x80000000, 0x00010000, 0x807F0000, 0x7F7F0000, 0xFF7F0000, 0x3F800000 };
+    for (specials, expect) |b, e| try std.testing.expectEqual(e, @as(u32, @bitCast(widen(b))));
+    try std.testing.expect(std.math.isNan(widen(0x7FC0)) and std.math.isInf(widen(0xFF80)) and widen(0x3F80) == 1.0);
+    // and through the packer's embedding half and hidden half
+    const m: Dims = .{ .streams = 1, .steps = 1, .n = 1, .d = specials.len, .rank = specials.len, .vocab = 1 };
+    var embs: [specials.len]u16 = undefined;
+    var out: [2 * specials.len]f32 = undefined;
+    try std.testing.expect(!pack(m, &specials, &specials, &.{ 0, 0 }, &embs, &out));
+    for (out[0..specials.len], expect) |f, e| try std.testing.expectEqual(e, @as(u32, @bitCast(f)));
+    for (out[specials.len..], expect) |f, e| try std.testing.expectEqual(e, @as(u32, @bitCast(f)));
+}
