From 0000000000000000000000000000000000000104 Mon Sep 17 00:00:00 2001
From: colum <colum@users.noreply.github.com>
Date: Thu, 12 Nov 2026 09:13:07 -0800
Subject: [PATCH] dsv41: TF_DS_DRAFT_DEPTH3=1 adds the 3-deep benchmark pin

One toggle a patch. 0103's mechanism pins every head draft to the depth this
patch's toggle names; TF_DS_DRAFT_DEPTH2 and TF_DS_DRAFT_DEPTH3 together refuse
the start (error.BadDraftPin), so a depth curve is one variable at a time.
---
 zig/src/families/dsv41/lanes.zig  | 9 ++++++---
 zig/src/families/dsv41/native.zig | 1 +
 2 files changed, 7 insertions(+), 3 deletions(-)

diff --git a/zig/src/families/dsv41/lanes.zig b/zig/src/families/dsv41/lanes.zig
index c780bea3..077fb48f 100644
--- a/zig/src/families/dsv41/lanes.zig
+++ b/zig/src/families/dsv41/lanes.zig
@@ -402,6 +402,7 @@ pub const DepthPin = struct { name: [:0]const u8, depth: u32 };
 /// The benchmark depth pins, one a patch (0103-0106): at most one may be on.
 pub const depth_pins = [_]DepthPin{
     .{ .name = "TF_DS_DRAFT_DEPTH2", .depth = 2 },
+    .{ .name = "TF_DS_DRAFT_DEPTH3", .depth = 3 },
 };
 
 /// The pin from the toggles' values ("1" on; unset, empty or "0" off), refusing two at once.
@@ -2184,9 +2185,11 @@ pub fn followPair(gpa: std.mem.Allocator, m: *Model, spill: ?*SpillFollower, fx:
 }
 
 test "one depth toggle at a time pins the depth" {
-    try std.testing.expectEqual(@as(?u32, null), try parseDepthPin(&[_]?[]const u8{null}));
-    try std.testing.expectEqual(@as(?u32, null), try parseDepthPin(&[_]?[]const u8{"0"}));
-    try std.testing.expectEqual(@as(?u32, 2), try parseDepthPin(&[_]?[]const u8{"1"}));
+    try std.testing.expectEqual(@as(?u32, null), try parseDepthPin(&[_]?[]const u8{ null, null }));
+    try std.testing.expectEqual(@as(?u32, null), try parseDepthPin(&[_]?[]const u8{ "0", null }));
+    try std.testing.expectEqual(@as(?u32, 2), try parseDepthPin(&[_]?[]const u8{ "1", null }));
+    try std.testing.expectEqual(@as(?u32, 3), try parseDepthPin(&[_]?[]const u8{ null, "1" }));
+    try std.testing.expectError(error.BadDraftPin, parseDepthPin(&[_]?[]const u8{ "1", "1" }));
 }
 
 test "a calibration weight parses to a finite value in 0..1" {
diff --git a/zig/src/families/dsv41/native.zig b/zig/src/families/dsv41/native.zig
index 32c4b25c..2ac74aeb 100644
--- a/zig/src/families/dsv41/native.zig
+++ b/zig/src/families/dsv41/native.zig
@@ -47,6 +47,7 @@
 //!   TF_DS_T25_CAL_LOG                           print every n-th calibrated verify of a stream to stderr (unset or 0: off)
 //!   TF_DS_DRAFT_DEPTH2=1                        a benchmark pin: every head draft is 2 deep, whatever the rule prices (unset or 0:
 //!                                               the rule; the checkpoint's draft count clamps it)
+//!   TF_DS_DRAFT_DEPTH3=1                        the same pin at 3 deep (unset or 0: the rule)
 //!   TF_DS_NO_COPIES=1                           a drafted stream proposes no suffix-lookup copy windows
 //!   TF_DS_POOL=P, TF_DS_WINDOW=W                (0008, pool.zig) the pool's positions, every stream's extents
 //!                                               together (unset: the context), and the window a request may use
