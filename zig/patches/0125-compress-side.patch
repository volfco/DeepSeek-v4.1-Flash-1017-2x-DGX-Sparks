@@ -822,6 +861,35 @@ fn ropeOf(e: *const Engine, lay: weights.Layer) prompt.Rope {
     return if (lay.ratio != 0) e.compressed else e.plain;
 }
 
+/// The compressor's chain (a compressed layer): the RMSNorm alone at ratio 1; at ratio 2 the scatter of the rows
+/// into the group's raw slots, the memset of ch.invalid, the double gather back, compress2's
+/// weighted sum to bf16, the RMSNorm. One copy of the launches, run on `t`/`s`: the unforked path passes the main
+/// stream, the forked (TF_DS_COMPRESS_SIDE) path the chain's own (every launch rides `s`: the kit's through the
+/// stream-carrying Tri `t`, the ops and the memset through `s` directly, so the event ordering is total).
+fn compressorChain(e: *const Engine, rd: *const Round, ch: *const Chunk, t: tri.Tri, s: cuda.Stream, caches: *const Caches, li: usize, ratio: usize) !void {
+    const lay = e.w.layers[li];
+    const c = e.c;
+    const hd = c.head_dim;
+    const R = rd.r;
+    if (ratio == 1) {
+        try tri_basic.rmsnorm(t, rd.ckv, hd, lay.comp_norm, rd.lat, hd, c.eps, R, hd);
+        return;
+    }
+    if (ratio == 2) {
+        // rk[rslot] = kv, rs[rslot] = score; the group's two rows back (rk[gi], rs[gi]); the pair's softmax-
+        // weighted sum to bf16 (torch's ops: exact.compress2's bytes), then the RMSNorm (Triton's)
+        try e.ops.scatterRows(s, rd.ckv, hd * 4, rd.g(.rslot), caches.raw_kv[li], hd * 4, hd * 4, R);
+        try e.ops.scatterRows(s, rd.cgate, hd * 4, rd.g(.rslot), caches.raw_score[li], hd * 4, hd * 4, R);
+        try e.d.check(e.d.api.cuMemsetD8Async(ch.invalid, 0, 4, s.handle), "cuMemsetD8Async");
+        try e.ops.gatherRows(s, caches.raw_kv[li], caches.slots * raw_rows, rd.g(.gi), rd.kvg, hd * 4, 2 * R, ch.invalid);
+        try e.ops.gatherRows(s, caches.raw_score[li], caches.slots * raw_rows, rd.g(.gi), rd.sg, hd * 4, 2 * R, ch.invalid);
+        try e.exact.compress2(s, rd.kvg, rd.sg, rd.lat2, R, hd);
+        try tri_basic.rmsnorm(t, rd.lat2, hd, lay.comp_norm, rd.lat, hd, c.eps, R, hd);
+        return;
+    }
+    return notPorted(@src());
+}
