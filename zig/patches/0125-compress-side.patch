@@ -875,6 +943,17 @@ fn attention(e: *const Engine, rd: *Round, ch: *const Chunk, cs: *const Caches,
         try prompt.grouped(e, ch, R, ls[0..n], xs[0..n], ldxs[0..n], outs[0..n], lds[0..n], dts[0..n]);
     }
     try rd.mark(e, .a_in);
+    // TF_DS_COMPRESS_SIDE: the layer's compressor chain forks onto the stream of its own (joined where the chain
+    // launches today, before anything reads its output). The chain's launches and their order are the same, so a
+    // reorder of independent launches; everything it writes is read only after the join.
+    if (rd.compress_side and has_comp) {
+        try rd.cs_fork.?.record(e.s);
+        try rd.cs.?.wait(rd.cs_fork.?);
+        const t2: tri.Tri = .{ .set = t.set, .stream = rd.cs.?, .pdl = t.pdl, .log = t.log, .kit = t.kit };
+        try compressorChain(e, rd, ch, t2, rd.cs.?, cs, li, ratio);
+        try rd.cs_join.?.record(rd.cs.?);
+        rd.cs_out = true;
+    }
     // the indexer's top-k takes every entry it scans (short contexts): its selection needs no scores
     const has_idx = ratio != 0 and lay.idx_wq_b != null;
     const nb: usize = if (ratio != 0) rd.bucket / ratio else 0;
@@ -932,19 +1011,11 @@ fn attention(e: *const Engine, rd: *Round, ch: *const Chunk, cs: *const Caches,
         const cb_k: Glue = if (ratio == 1) .cbase1 else .cbase2;
         cbase = rd.g(cb_k);
         if (lay.comp_wkv != null) {
-            if (ratio == 1) {
-                try tri_basic.rmsnorm(t, rd.ckv, hd, lay.comp_norm, rd.lat, hd, c.eps, R, hd);
