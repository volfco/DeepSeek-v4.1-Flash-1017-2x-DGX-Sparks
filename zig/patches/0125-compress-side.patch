+    /// TF_DS_COMPRESS_SIDE: the compressor chain's stream and events, made once at Round.init (the switch is read there).
+    /// The chain is forked behind a_in and joined where it is launched today, before anything reads its output: a
+    /// reorder of independent launches, so the bytes are the same. A stream of its own (not the mixes' side stream:
+    /// that protocol is the Sinkhorn's and is untouched), waiting only on cs_fork.
+    pub fn useCompress(rd: *Round, e: *const Engine) !void {
+        if (rd.cs != null) return;
+        var s = try cuda.Stream.init(e.d, true);
+        errdefer s.deinit();
+        rd.cs_fork = try cuda.Event.init(e.d, false);
+        rd.cs_join = try cuda.Event.init(e.d, false);
+        rd.cs = s;
+    }
+
+    pub fn dropCompress(rd: *Round) void {
+        if (rd.cs_fork) |*x| x.deinit();
+        if (rd.cs_join) |*x| x.deinit();
+        if (rd.cs) |*s| s.deinit();
+        rd.cs_fork = null;
+        rd.cs_join = null;
+        rd.cs = null;
+        rd.cs_out = false;
+    }
+
     /// These ranges touched into L2 behind the work queued so far, on the prefetch stream.
     /// One paced L2 prefetch launch on its stream: `ranges` in order, the last one cut where the launch reaches `budget`
