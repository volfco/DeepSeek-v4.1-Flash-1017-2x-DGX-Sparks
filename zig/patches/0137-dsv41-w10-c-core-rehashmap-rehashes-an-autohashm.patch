index 0000000000000000000000000000000000000000..3b2a3d6e9b75964fc4a581fbab5ea604b0af0c85
--- /dev/null
+++ b/zig/src/core/rehash_map.zig
@@ -0,0 +1,121 @@
+//! AutoHashMapUnmanaged that rehashes once its removals reach a quarter of capacity. std's map marks a removal with
+//! a tombstone and only `rehash()` drops it, so a long-lived map with steady insert/remove churn probes ever-longer
+//! tombstone chains - the insert, lookup and delete pattern 0119 fixed in the token cache (core/tokenizer/cache.zig).
+//! This is that fix for any AutoHashMapUnmanaged. rehash() moves entries, so a removal that rehashes invalidates
+//! pointers into the map (as does a grow); callers must not hold one across a removal.
+const std = @import("std");
+const Allocator = std.mem.Allocator;
+
+pub fn RehashMap(comptime K: type, comptime V: type) type {
+    return struct {
+        map: std.AutoHashMapUnmanaged(K, V) = .empty,
+        removed: usize = 0, // removals since the last rehash (a grow rehashes too, so this may overstate: rehashing early is safe)
+        rehashes: usize = 0, // rehashes so far (the test reads it)
+
+        const Self = @This();
+        const Map = std.AutoHashMapUnmanaged(K, V);
+        pub const KV = Map.KV;
+        pub const Size = Map.Size;
+        /// `.empty`, as std's maps (the `= .empty` default keeps this for completeness).
+        pub const empty: Self = .{};
+
+        pub fn deinit(self: *Self, gpa: Allocator) void {
+            self.map.deinit(gpa);
+            self.* = undefined;
+        }
+        pub fn count(self: Self) Size {
+            return self.map.count();
+        }
+        pub fn capacity(self: Self) Size {
+            return self.map.capacity();
+        }
+        pub fn valueIterator(self: Self) Map.ValueIterator {
+            return self.map.valueIterator();
+        }
+        pub fn get(self: Self, key: K) ?V {
+            return self.map.get(key);
+        }
+        pub fn getPtr(self: *Self, key: K) ?*V {
+            return self.map.getPtr(key);
+        }
+        pub fn getOrPut(self: *Self, gpa: Allocator, key: K) Allocator.Error!Map.GetOrPutResult {
+            return self.map.getOrPut(gpa, key);
+        }
+        pub fn put(self: *Self, gpa: Allocator, key: K, value: V) Allocator.Error!void {
+            return self.map.put(gpa, key, value);
+        }
+        pub fn putAssumeCapacity(self: *Self, key: K, value: V) void {
+            self.map.putAssumeCapacity(key, value);
+        }
+        pub fn ensureUnusedCapacity(self: *Self, gpa: Allocator, additional: Size) Allocator.Error!void {
+            return self.map.ensureUnusedCapacity(gpa, additional);
+        }
+        pub fn remove(self: *Self, key: K) bool {
+            if (!self.map.remove(key)) return false;
+            self.noteRemoval();
+            return true;
+        }
+
+        pub fn fetchRemove(self: *Self, key: K) ?KV {
+            const kv = self.map.fetchRemove(key) orelse return null;
+            self.noteRemoval();
+            return kv;
+        }
+
+        fn noteRemoval(self: *Self) void {
+            self.removed += 1;
+            const cap = self.map.capacity();
+            if (cap >= 4 and self.removed >= cap / 4) { // a quarter of the slots are stale: rehash, drop every tombstone
+                self.map.rehash(std.hash_map.AutoContext(K){});
+                self.removed = 0;
+                self.rehashes += 1;
+            }
+        }
+    };
+}
+
+test "churn: insert/remove cycles stay correct and removals stay under a quarter of capacity" {
+    const gpa = std.testing.allocator;
+    // the threshold is exact: a quarter of capacity removed rehashes, one fewer does not (tombstones themselves are not
+    // observable through std's API, so the counter and the threshold are what a test can hold)
+    {
+        var t: RehashMap(u64, u64) = .empty;
+        defer t.deinit(gpa);
+        try t.ensureUnusedCapacity(gpa, 64);
+        for (0..64) |i| t.putAssumeCapacity(@intCast(i), @intCast(i));
+        const quarter = t.capacity() / 4;
+        try std.testing.expect(quarter >= 2);
+        for (0..quarter - 1) |i| _ = t.remove(@intCast(i));
+        try std.testing.expectEqual(@as(usize, 0), t.rehashes); // not yet
+        _ = t.remove(@intCast(quarter - 1));
+        try std.testing.expectEqual(@as(usize, 1), t.rehashes); // a quarter of the slots are stale: dropped
+        try std.testing.expectEqual(@as(usize, 0), t.removed);
+        try std.testing.expectEqual(@as(usize, 64 - quarter), t.count());
+    }
+    var m: RehashMap(u64, u64) = .empty;
+    defer m.deinit(gpa);
+    // many rounds of fill, then delete half, then look the rest up: a wide high-water mark with steady churn,
+    // the pattern that leaves plain AutoHashMapUnmanaged probing tombstones
+    for (0..30) |round| {
+        for (0..128) |i| try m.put(gpa, @intCast(round * 1000 + i), @intCast(round * 1000 + i));
+        for (0..128) |i| {
+            if (i % 2 == 0) try std.testing.expect(m.remove(@intCast(round * 1000 + i)));
+        }
+        // the invariant: tombstones never reach a quarter of capacity (the rehash resets the count)
+        const cap = m.capacity();
+        try std.testing.expect(m.removed == 0 or m.removed < cap / 4);
+        for (0..128) |i| {
+            if (i % 2 == 1) try std.testing.expectEqual(@as(?u64, @intCast(round * 1000 + i)), m.get(@intCast(round * 1000 + i)));
+        }
+        for (0..128) |i| {
+            if (i % 2 == 0) try std.testing.expect(m.get(@intCast(round * 1000 + i)) == null);
+        }
+        for (0..128) |i| {
+            if (i % 2 == 1) _ = m.remove(@intCast(round * 1000 + i));
+        }
+    }
+    // 30 rounds x 128 removals = 3840 removals with never more than 128 live: rehashing kept tombstones (and so probe
+    // chains) bounded the whole time
+    try std.testing.expect(m.rehashes >= 4);
+    try std.testing.expectEqual(@as(usize, 0), m.count());
+}
