+            try st.m.useClock(clock_marks);
+            round_profile = .{ .ctx = st, .print = printRoundProfile };
+        }
+    }
     // a vision checkpoint's tower on this rank, from the kit's vision/ (torch's attention cubin, the routing bias)
     st.vision = null;
     if (st.m.cfg.vision) st.vision = try vision_mod.Vision.open(gpa, io, st.m, dir, getenv("TF_DS_KIT").?);
@@ -322,7 +345,82 @@ pub fn open(gpa: std.mem.Allocator, io: std.Io, ctx: *const cuda.Context, dir: [
     const engram: ?api.EngramSource = if (st.m.eh != null and st.m.eh.?.metrics) .{ .ctx = &st.lanes, .read = L.engramStatsFn } else null;
     const pair: ?Pair = if (pair_mode == .exit) .{ .watch = pairWatch, .abort = pairAbort } else null;
     if (pair != null) std.log.info("dsv41: a broken rank pair ends this server with status {d} for a restart of both ranks (TF_DS_PAIR_BROKEN=degrade: requests fail one by one instead)", .{api.LaneHost.pair_exit_code});
-    return .{ .backend = st.lanes.backend(), .facts = st.lanes.facts(), .rows = @intCast(st.m.eng.round_rows), .stream_bytes = 0, .ctx = st, .deinit = deinitFn, .snaps = snaps, .vision = if (st.vision) |v| v.hook() else null, .window = window, .tier = tier, .grid = model.chunk_rows, .replay = @intCast(st.m.cfg.window), .kv_parts = kv_parts, .engram = engram, .pair = pair, .quiet = quietFn };
+    return .{ .backend = st.lanes.backend(), .facts = st.lanes.facts(), .rows = @intCast(st.m.eng.round_rows), .stream_bytes = 0, .ctx = st, .deinit = deinitFn, .snaps = snaps, .vision = if (st.vision) |v| v.hook() else null, .window = window, .tier = tier, .grid = model.chunk_rows, .replay = @intCast(st.m.cfg.window), .kv_parts = kv_parts, .engram = engram, .pair = pair, .quiet = quietFn, .round_profile = round_profile };
+}
+
+// -- the round profile (TF_DS_ROUND_PROFILE; rank 0's /metrics scrape) -------------------------------------------
+
+/// The round profile, printed at /metrics' scrape (status_routes calls Engine.roundProfile after the reply): what
+/// tf-dsv41-lanes --profile prints at the end of its run, one JSON object per line, via std.log.info to stderr.
+/// step_ms is -1: the batch driver computes it from a local step's ns, which the serve path does not keep, so the
+/// field is a sentinel for "not measured (serve path)"; every other field is real. The counters are cumulative since
+/// process start and a scrape mid-round may read one torn (u64 loads); nothing resets them, and the `rounds` counter
+/// is in the line so a reader can take deltas between scrapes. Only rank 0 serves, so the rank is the literal 0.
+/// The profile line stays exactly the batch driver's shape; the attribution-only caveat rides as its own last line
+/// (profile_note): the profile syncs the GPU every round, so the figures include the sync and are not the unprofiled
+/// round cost.
+fn printRoundProfile(ctx: *anyopaque) void {
+    const st: *State = @ptrCast(@alignCast(ctx));
+    const p = st.lanes.prof orelse return; // (the switch is off: nothing to say)
+    const m = st.m;
+    // Values from a /metrics scrape are cumulative and may be torn mid-round; std.log.info writes to stderr (the
+    // container's log), with only the JSON object as our text.
+    var out: std.Io.Writer.Allocating = .init(std.heap.page_allocator);
+    defer out.deinit();
+    const w = &out.writer;
+    const ms = struct {
+        fn f(ns: u64, n: u64) f64 {
+            return if (n == 0) 0 else @as(f64, @floatFromInt(ns)) / @as(f64, @floatFromInt(n)) / 1e6;
+        }
+    }.f;
+    w.print("{{\"rank\": 0, \"profile\": {{\"rounds\": {d}, \"rows_a_round\": {d:.2}, \"step_ms\": -1, \"send_ms\": {d:.3}, \"enqueue_ms\": {d:.2}, \"forward_ms\": {d:.2}, \"absorb_ms\": {d:.2}, \"logits_ms\": {d:.2}, \"sample_ms\": {d:.2}, \"passes\": {d}, \"streams_a_pass\": {d:.2}, \"pass_ms\": {d:.2}, \"prefills\": {d}, \"prefill_ms\": {d:.1}}}}}", .{ p.rounds, ms(p.rows * 1000000, p.rounds), ms(p.send, p.rounds), ms(p.enqueue, p.rounds), ms(p.forward, p.rounds), ms(p.absorb, p.rounds), ms(p.logits, p.rounds), ms(p.sample, p.rounds), p.passes, ms(p.pass_streams * 1000000, p.passes), ms(p.pass, p.passes), p.prefills, ms(p.prefill, p.prefills) }) catch return;
+    std.log.info("{s}", .{out.written()});
+    out.clearRetainingCapacity();
+    // lanes_main.zig's printClock, ported: the rounds' GPU clock gaps and launch counts (only with useClock, i.e.
+    // the profile on)
+    if (m.clk_rounds > 0) {
+        const r: f64 = @floatFromInt(m.clk_rounds);
+        w.print("{{\"rank\": 0, \"round_clock_us\": {{\"rounds\": {d}", .{m.clk_rounds}) catch return;
+        const names = round.PhaseTimer.phases;
+        for (0..256) |i| {
+            if (m.clk_cnt[i] == 0) continue;
+            const name = if (i < names.len) names[i] else switch (i) {
+                round.Round.clock_wait => "wait",
+                round.Round.clock_tail => "tail",
+                else => "other",
+            };
+            if (i >= 64 and i < 128) {
+                w.print(", \"L{d}\": [{d:.1}, {d:.1}]", .{ i - 64, @as(f64, @floatFromInt(m.clk_ph[i])) / r / 1e3, @as(f64, @floatFromInt(m.clk_cnt[i])) / r }) catch return;
+                continue;
+            }
+            w.print(", \"{s}\": [{d:.1}, {d:.1}]", .{ name, @as(f64, @floatFromInt(m.clk_ph[i])) / r / 1e3, @as(f64, @floatFromInt(m.clk_cnt[i])) / r }) catch return;
+        }
+        w.print("}}}}", .{}) catch return;
+        std.log.info("{s}", .{out.written()});
+        out.clearRetainingCapacity();
+        w.print("{{\"rank\": 0, \"round_launches\": {{", .{}) catch return;
+        var first = true;
+        for (m.rd.launches, 0..) |n, i| {
+            if (n == 0 or i >= names.len) continue;
+            w.print("{s}\"{s}\": {d:.1}", .{ if (first) "" else ", ", names[i], @as(f64, @floatFromInt(n)) / r }) catch return;
+            first = false;
+        }
+        w.print("}}}}", .{}) catch return;
+        std.log.info("{s}", .{out.written()});
+        out.clearRetainingCapacity();
+    }
+    // lanes_main.zig's phases_ms line (m.timer from usePhaseTimer; the phases' ms a round, no "chunks": that is
+    // prefill_phases_ms, which this path does not print)
+    if (m.timer) |tm| {
+        w.print("{{\"rank\": 0, \"phases_ms\": {{", .{}) catch return;
+        for (round.PhaseTimer.phases, 0..) |name, i| w.print("{s}\"{s}\": {d:.3}", .{ if (i == 0) "" else ", ", name, if (tm.rounds == 0) 0 else tm.ms[i] / @as(f64, @floatFromInt(tm.rounds)) }) catch return;
+        w.print("}}}}", .{}) catch return;
+        std.log.info("{s}", .{out.written()});
+        out.clearRetainingCapacity();
+    }
+    // the caveat rides with the numbers in the log: a line read in isolation must not look like an unprofiled truth
+    w.print("{{\"rank\": 0, \"profile_note\": \"attribution only: the round profile syncs the GPU every round; figures include the sync and are not the unprofiled round cost\"}}", .{}) catch return;
+    std.log.info("{s}", .{out.written()});
 }
 
