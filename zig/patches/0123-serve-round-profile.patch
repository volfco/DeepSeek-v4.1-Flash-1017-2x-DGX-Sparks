     st.lanes.no_copies = if (getenv("TF_DS_NO_COPIES")) |v| !std.mem.eql(u8, v, "0") else false;
+    // TF_DS_ROUND_PROFILE (1 or 2; anything else or unset: off, nothing below runs and nothing changes): the served
+    // process's copy of the batch driver's --profile. 1 sets the same counters the lanes backend and the model read;
