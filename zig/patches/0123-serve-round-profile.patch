+        /// The round-profile print, for the metrics handler after its reply (TF_DS_ROUND_PROFILE). Null: the family
+        /// has none, and nothing prints. Cumulative; never resets.
+        roundProfile: ?*const fn (ctx: *anyopaque) void = null,
