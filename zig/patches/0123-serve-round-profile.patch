+
+    /// The round-profile hook, or nothing: a family without one (Metal) leaves the vtable's null, and nothing prints.
+    pub fn roundProfile(e: Engine) void {
+        const f = e.vtable.roundProfile orelse return;
+        f(e.ctx);
+    }
 };
 
