diff --git a/zig/kernels/cuda/dsv41_torch.cu b/zig/kernels/cuda/dsv41_torch.cu
index a336ef9..304439a 100644
--- a/zig/kernels/cuda/dsv41_torch.cu
+++ b/zig/kernels/cuda/dsv41_torch.cu
@@ -105,6 +105,111 @@ extern "C" __global__ void tf_ds_compress2_kernel(const float* kv, const float*
     }
 }
 
+// _compress at ratio 2 fused with its positional-store round trip (TF_DS_FUSED_COMPRESS2): the rows scattered to the
+// raw slots, the pair's rows back, and the pair's softmax-weighted sum to bf16 — scatterRows x2 + cuMemsetD8Async +
+// gatherRows x2 + compress2 in one launch (the RMSNorm after it stays outside). Grid.x = G (one group a block, 256
+// threads, no grid-stride).
+// The store is the ring itself (no kvg/sg roundtrip): phase 1 copies this round's rows ckv/cgate[g] to
+// ring_kv/ring_score[rslot[g]] (byte copies, like scatterRows), then __syncthreads() with phase 2. A partner scattered
+// in a PREVIOUS round reads the ring; a partner scattered THIS round by ANOTHER block of this launch (a drafted verify
+// window holds a slot's consecutive rows, an even/odd pair among them) is NOT ordered for this block by __syncthreads,
+// so thread 0 resolves each partner gi against rslot[0..G) at the top of the block: a match means that partner is this
+// round's own ckv/cgate row r' — the scatter copies those bytes verbatim, so reading them directly is byte-identical to
+// the ring bytes the base path's gather would return — and phase 2 reads them instead of the ring. Only partners not of
+// this round read the ring, and no block reads this-round ring bytes, so the sync carries the shared resolution handoff
+// (kept also as the honest fence). rslot values are unique within a round (max_rows 48 < raw_rows 64). gi is compared
+// against rslot, not pos: both sides are slot*raw + (x mod raw) and must agree modulo the ring wrap, exactly as the ring would.
+// Out-of-range partners (gi < 0 or gi >= src_rows; unreachable in this family — gi comes from the same glue as rslot, and
+// a match there resolves to ckv anyway) set the caller's dead u32 flag = 1 and zero that partner's row: deterministic,
+// and unlike the base path (which would leave stale kvg/sg bytes for that row) it cannot leak garbage into the output. The compress2 arithmetic below is compress2's verbatim, with kv/score addressed by gi
+// (or by the resolved row) in place of kv[(g*2)*C + c].
+extern "C" __global__ void __launch_bounds__(256) tf_ds_compress2x_kernel(const float* ckv, long long ckv_ld,
+                                                                          const float* cgate, long long cgate_ld,
+                                                                          const long long* rslot,
+                                                                          float* ring_kv,
+                                                                          float* ring_score,
+                                                                          const long long* gi, long long src_rows,
+                                                                          __nv_bfloat16* out, long long out_ld,
+                                                                          int G, int C,
+                                                                          unsigned* invalid, int pdl) {
+    pdl_enter(pdl);
+    const int g = blockIdx.x;
+    // phase 1: scatter this round's rows to the raw slots (byte copies, like scatterRows: uint4 when aligned, else scalar)
+    {
+        const long long dst = rslot[g] * (long long)C;
+        const float* s = ckv + (long long)g * ckv_ld;
+        float* d = ring_kv + dst;
+        if (((C & 3) == 0) && ((((uintptr_t)s | (uintptr_t)d) & 15) == 0)) {
+            const uint4* s4 = (const uint4*)s;
+            uint4* d4 = (uint4*)d;
+            for (int j = threadIdx.x; j < C / 4; j += blockDim.x) d4[j] = s4[j];
+        } else {
+            for (int j = threadIdx.x; j < C; j += blockDim.x) d[j] = s[j];
+        }
+        const float* sg = cgate + (long long)g * cgate_ld;
+        float* dg = ring_score + dst;
+        if (((C & 3) == 0) && ((((uintptr_t)sg | (uintptr_t)dg) & 15) == 0)) {
+            const uint4* s4 = (const uint4*)sg;
+            uint4* d4 = (uint4*)dg;
+            for (int j = threadIdx.x; j < C / 4; j += blockDim.x) d4[j] = s4[j];
+        } else {
+            for (int j = threadIdx.x; j < C; j += blockDim.x) dg[j] = sg[j];
+        }
+    }
+    // phase 2: resolve both partners against this round's rows (thread 0; block-uniform): partner_row[i] = the round
+    // row r' with rslot[r'] == gi[2g+i], or -1 for a row the ring already holds
+    __shared__ int partner_row[2];
+    if (threadIdx.x == 0) {
+        for (int i = 0; i < 2; i++) {
+            const long long want = gi[2 * g + i];
+            int found = -1;
+            for (int r = 0; r < G; r++) {
+                if (rslot[r] == want) { found = r; break; }
+            }
+            partner_row[i] = found;
+        }
+    }
+    __syncthreads();
+    const long long gi0 = gi[2 * g], gi1 = gi[2 * g + 1];
+    const bool ok0 = gi0 >= 0 && gi0 < src_rows;
+    const bool ok1 = gi1 >= 0 && gi1 < src_rows;
+    if (!(ok0 && ok1)) {
+        if (threadIdx.x == 0 && invalid) *invalid = 1u;
+    }
+    for (int c = threadIdx.x; c < C; c += blockDim.x) {
+        float kv[2], score[2];
+        for (int i = 0; i < 2; i++) {
+            const long long q = i == 0 ? gi0 : gi1;
+            const bool ok = i == 0 ? ok0 : ok1;
+            if (!ok) { kv[i] = 0.f; score[i] = 0.f; continue; }
+            const int pr = partner_row[i];
+            if (pr >= 0) {
+                kv[i] = ckv[(long long)pr * ckv_ld + c];
+                score[i] = cgate[(long long)pr * cgate_ld + c];
+            } else {
+                kv[i] = ring_kv[q * (long long)C + c];
+                score[i] = ring_score[q * (long long)C + c];
+            }
+        }
+        // tf_ds_compress2_kernel's arithmetic, verbatim, per channel
+        const float s0 = score[0], s1 = score[1];
+        float m = -3.402823466e+38f;   // numeric_limits<float>::lowest()
+        m = m < s0 ? s0 : m;
+        m = m < s1 ? s1 : m;
+        float sum = 0.f;
+        sum = __fadd_rn(sum, expf(__fsub_rn(s0, m)));
+        sum = __fadd_rn(sum, expf(__fsub_rn(s1, m)));
+        const float p0 = __fdiv_rn(expf(__fsub_rn(s0, m)), sum);
+        const float p1 = __fdiv_rn(expf(__fsub_rn(s1, m)), sum);
+        const float y0 = __fmul_rn(kv[0], p0);
+        const float y1 = __fmul_rn(kv[1], p1);
+        float t = __fadd_rn(__fadd_rn(0.f, y0), __fadd_rn(0.f, y1));
+        t = __fadd_rn(t, 0.f);
+        t = __fadd_rn(t, 0.f);
+        out[(long long)g * out_ld + c] = __float2bfloat16_rn(t);
+    }
+}
+
 // ops.rope_(x[..., off : off + 2 * half], f) of n rows (bf16, row stride ldx), in place: (a + b i)(c + d i), d negated
 // for the inverse (f.conj()), each part rounded to bf16. f = complex(cos, sin) at table row pos[r] (fp32 [*, half]).
 // torch's complex<float> multiply is a*c - b*d, a*d + b*c, and its CUDA build contracts each into one fused
