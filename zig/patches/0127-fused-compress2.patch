         try cuda.launch.launch(e.k_compress2, .{ .grid = .{ .x = @min(4096, blocks(g * c, 256)) }, .block = .{ .x = 256 }, .pdl = e.pdl }, s, &a);
     }
 
+    /// TF_DS_FUSED_COMPRESS2's fused ratio-2 chain (zig/kernels/cuda/dsv41_torch.cu, tf_ds_compress2x_kernel): the
+    /// scatter of the round's rows into the positional store's raw slots, the pair's rows back and compress2's pair
+    /// sum, in one launch (grid.x = g, block 256). LDs in ELEMENTS of the buffer's dtype (ckv/cgate/ring: fp32; out
+    /// (rd.lat2): bf16); the ring's rows are `c` floats; src_rows in rows. Partners scattered this round by another
+    /// block of the launch (a drafted verify window holds a slot's consecutive rows) are resolved against rslot by
+    /// the kernel and read from ckv/cgate directly — byte-identical to the ring bytes the base path's gather would
+    /// return; partners not of this round read the ring. The ch.invalid memset stays out of this path (the flag is
+    /// dead: no reader tree-wide; the kernel still writes 1 to it if a partner is out of range, gatherRows parity).
+    pub fn compress2x(e: *const Exact, s: cuda.Stream, ckv: u64, ckv_ld: usize, cgate: u64, cgate_ld: usize, rslot: u64, ring_kv: u64, ring_score: u64, gi: u64, src_rows: usize, out: u64, out_ld: usize, g: usize, c: usize, invalid: u64) !void {
+        if (g == 0) return;
+        var a: cuda.Args = .{};
+        a.add(ckv);
+        a.add(@as(c_longlong, @intCast(ckv_ld)));
+        a.add(cgate);
+        a.add(@as(c_longlong, @intCast(cgate_ld)));
+        a.add(rslot);
+        a.add(ring_kv);
+        a.add(ring_score);
+        a.add(gi);
+        a.add(@as(c_longlong, @intCast(src_rows)));
+        a.add(out);
+        a.add(@as(c_longlong, @intCast(out_ld)));
+        a.add(@as(c_int, @intCast(g)));
+        a.add(@as(c_int, @intCast(c)));
+        a.add(invalid);
+        a.add(@as(c_int, @intFromBool(e.pdl)));
+        try cuda.launch.launch(e.k_compress2x, .{ .grid = .{ .x = @intCast(g) }, .block = .{ .x = 256 }, .pdl = e.pdl }, s, &a);
+    }
+
     /// ops.rope_(x[..., off : off + 2 * half], complex(cos, sin)[pos]) of n rows of x bf16 (row stride ldx), in place;
     /// `inverse` rotates back (f.conj()).
     pub fn rope(e: *const Exact, s: cuda.Stream, x: u64, ldx: usize, off: usize, cos: u64, sin: u64, pos: u64, n: usize, half: usize, inverse: bool) !void {
