+// An inclusive cutoff on the unique score/column keys for a pool of at most 8192 blocks.
+__device__ __forceinline__ unsigned long long tf_ds_pool_kth(const float* row, int n, int k) {
+    __shared__ unsigned int hist[256];
+    __shared__ unsigned long long prefix_s, mask_s;
+    __shared__ int want_s;
+    if (threadIdx.x == 0) {
+        // Inverted columns below 8192 have two constant high bytes.
+        prefix_s = mask_s = 0xffff0000ull;
+        want_s = k;
+    }
+    __syncthreads();
+    for (int d = 7; d >= 0; --d) {
+        if (d == 3 || d == 2) continue;
+        for (int b = threadIdx.x; b < 256; b += blockDim.x) hist[b] = 0;
+        __syncthreads();
+        const unsigned long long prefix = prefix_s, mask = mask_s;
+        for (int i = threadIdx.x; i < n; i += blockDim.x) {
+            const unsigned long long u = tf_ds_score_key(row[i], i);
+            if ((u & mask) == prefix) atomicAdd(&hist[(u >> (8 * d)) & 0xff], 1u);
+        }
+        __syncthreads();
+        // Each lane covers eight descending bins. Only the lane containing the target
+        // rank scans its eight counts. A complete final bin already gives an inclusive cutoff.
+        if (threadIdx.x < 32) {
+            const int lane = threadIdx.x;
+            const int hi = 255 - 8 * lane;
+            const int target = want_s;
+            int count = 0;
+            #pragma unroll
+            for (int j = 0; j < 8; ++j) count += hist[hi - j];
+            int end = count;
+            #pragma unroll
+            for (int off = 1; off < 32; off <<= 1) {
+                const int prev = __shfl_up_sync(0xffffffffu, end, off);
+                if (lane >= off) end += prev;
+            }
+            int rank = target - (end - count);
+            if (rank > 0 && rank <= count) {
+                int digit = hi;
+                while (rank > (int)hist[digit]) {
+                    rank -= hist[digit];
+                    --digit;
+                }
+                want_s = rank == (int)hist[digit] ? 0 : rank;
+                prefix_s = prefix | ((unsigned long long)digit << (8 * d));
+                mask_s = mask | (0xffull << (8 * d));
+            }
+        }
+        __syncthreads();
+        if (want_s == 0) break;
+    }
+    return prefix_s;
+}
