+// tf_ds_rms_norm_kernel's reduction on one row held in `src` (bf16), L = blockDim.x matches rmsLanes(D, rows): the
+// four per-lane accumulators, the L > 32 shared fold, the shuffle down, and torch's mean/epsilon/rsqrt. Returns the
+// row's reciprocal, which the shared `rs` publishes to every thread. Extra y lanes help produce and store the row;
+// only y == 0 participates in the sum.
+__device__ __forceinline__ float tf_ds_torch_rmsnorm_inv(const __nv_bfloat16* src, int D, float factor, float eps) {
+    __shared__ float red[512];
