+    for (int idx = lane < L ? lane : D / 4; idx * 4 + 3 < D; idx += L) {
+        const float a = __bfloat162float(src[idx * 4 + 0]);
+        const float b = __bfloat162float(src[idx * 4 + 1]);
+        const float c = __bfloat162float(src[idx * 4 + 2]);
+        const float d = __bfloat162float(src[idx * 4 + 3]);
+        acc0 = __fadd_rn(acc0, __fmul_rn(a, a));
+        acc1 = __fadd_rn(acc1, __fmul_rn(b, b));
+        acc2 = __fadd_rn(acc2, __fmul_rn(c, c));
+        acc3 = __fadd_rn(acc3, __fmul_rn(d, d));
+    }
+    float v = __fadd_rn(__fadd_rn(__fadd_rn(acc0, acc1), acc2), acc3);
+    int dim_x = L;
+    if (L > 32) {
+        if (lane < L) red[lane] = v;
+        for (int offset = L / 2; offset >= 32; offset >>= 1) {
+            __syncthreads();
+            if (lane < offset && lane + offset < L) {
+                v = __fadd_rn(v, red[lane + offset]);
+                red[lane] = v;
+            }
+        }
+        dim_x = 32;
+        // Shared `red` is read only by the fold above and the reduction below is registers and shuffles, so the
+        // barrier is kept only for the folded shapes (whose last iteration ends on a shared write): at L == 32 no
+        // thread writes `red` at all. The `rs` publication barrier below stays for every shape.
+        __syncthreads();
+    }
+    for (int offset = dim_x >> 1; offset > 0; offset >>= 1) v = __fadd_rn(v, __shfl_down_sync(TF_FULL_MASK, v, offset));
+    if (lane == 0) rs = rsqrtf(__fadd_rn(__fmul_rn(v, factor), eps));
+    __syncthreads();
+    return rs;
+}
+
+// The same norm's store over `src`, one element a loop step from `lane` by `threads` (the caller's flattened index).
+__device__ __forceinline__ void tf_ds_torch_rmsnorm_row(const __nv_bfloat16* src, const __nv_bfloat16* w,
+                                                        __nv_bfloat16* dst, int D, float factor, float eps) {
+    const float r = tf_ds_torch_rmsnorm_inv(src, D, factor, eps);
+    const int lane = threadIdx.x + blockDim.x * threadIdx.y;
+    const int threads = blockDim.x * blockDim.y;
+    for (int j = lane; j < D; j += threads) {
+        const float y = __fmul_rn(__bfloat162float(src[j]), r);
+        dst[j] = __float2bfloat16_rn(__fmul_rn(__bfloat162float(w[j]), y));
+    }
+}
+
+// The same reduction and store, with the caller's own bf16 values (held in registers) standing in for `src` at its
+// flattened indices `lane + i * threads`: the output reads no shared memory. ITEMS is the caller's D / (blockDim.x *
+// blockDim.y), so the loop unrolls to registers with no local-memory array.
+template<int ITEMS>
+__device__ __forceinline__ void tf_ds_torch_rmsnorm_row_held(const __nv_bfloat16* src, const __nv_bfloat16* w,
+                                                             __nv_bfloat16* dst, int D, float factor, float eps,
+                                                             const __nv_bfloat16* held) {
+    const float r = tf_ds_torch_rmsnorm_inv(src, D, factor, eps);
+    const int lane = threadIdx.x + blockDim.x * threadIdx.y;
+    const int threads = blockDim.x * blockDim.y;
+    #pragma unroll
+    for (int i = 0; i < ITEMS; ++i) {
+        const int j = lane + i * threads;
+        if (j < D) {
+            const float y = __fmul_rn(__bfloat162float(held[i]), r);
+            dst[j] = __float2bfloat16_rn(__fmul_rn(__bfloat162float(w[j]), y));
+        }
+    }
+}
+
+// The pair-sum arithmetic of tf_ds_compress2_kernel / tf_ds_compress2x_kernel, verbatim (kv/score addressed by the
+// caller): the pair's softmax (max, the two expf, the sum from 0), the products, the pair's sum as compress2 adds it.
+__device__ __forceinline__ float tf_ds_compress2_pair(float s0, float s1, float kv0, float kv1) {
+    float m = -3.402823466e+38f;   // numeric_limits<float>::lowest()
+    m = m < s0 ? s0 : m;
+    m = m < s1 ? s1 : m;
+    float sum = 0.f;
+    sum = __fadd_rn(sum, expf(__fsub_rn(s0, m)));
+    sum = __fadd_rn(sum, expf(__fsub_rn(s1, m)));
+    const float p0 = __fdiv_rn(expf(__fsub_rn(s0, m)), sum);
+    const float p1 = __fdiv_rn(expf(__fsub_rn(s1, m)), sum);
+    const float y0 = __fmul_rn(kv0, p0);
+    const float y1 = __fmul_rn(kv1, p1);
+    float t = __fadd_rn(__fadd_rn(0.f, y0), __fadd_rn(0.f, y1));
+    t = __fadd_rn(t, 0.f);
+    t = __fadd_rn(t, 0.f);
+    return t;
+}
+
+// -- TF_DS_FUSED_COMPRESS2_NORM (0197) -------------------------------------------------------------------------------
+
+// The prompt path's ratio-2 chain: tf_ds_compress2_kernel (grid-stride over G*C, here one block per group, the pair
+// sums staged through shared memory as bf16 exactly as the unfused launch round-trips them through global memory)
+// followed by tf_ds_rms_norm_kernel's arithmetic (torch's reduce order, the block's lane count passed as blockDim.x,
+// the same `factor` the unfused launch computes). One block per group g, grid.x = G. `factor` is rows/(rows*D) as
+// float, computed by the caller exactly as Exact.rmsNorm does.
+// The pair pass over ITEMS channels a thread, keeping each channel's bf16 result: the norm's output is the same
+// flattened `lane + i * threads` index, so the store reads the register value instead of shared srow (srow still feeds
+// the reduction, whose four-channel mapping differs).
+template<int ITEMS>
+__device__ __forceinline__ void tf_ds_compress2_norm_items(const float* kv, const float* score, const __nv_bfloat16* w,
+                                                           __nv_bfloat16* out, __nv_bfloat16* srow, long long ldo,
+                                                           int D, float factor, float eps) {
+    const long long g = blockIdx.x;
+    const int lane = threadIdx.x + blockDim.x * threadIdx.y;
+    const int threads = blockDim.x * blockDim.y;
+    __nv_bfloat16 held[ITEMS];
+    #pragma unroll
+    for (int i = 0; i < ITEMS; ++i) {
+        const int c = lane + i * threads;
+        if (c < D) {
+            const float s0 = score[(g * 2) * D + c];
+            const float s1 = score[(g * 2 + 1) * D + c];
+            held[i] = __float2bfloat16_rn(tf_ds_compress2_pair(s0, s1, kv[(g * 2) * D + c], kv[(g * 2 + 1) * D + c]));
+            srow[c] = held[i];
+        }
+    }
+    __syncthreads();
+    tf_ds_torch_rmsnorm_row_held<ITEMS>(srow, w, out + g * ldo, D, factor, eps, held);
+}
+
+extern "C" __global__ void tf_ds_compress2_norm_kernel(const float* kv, const float* score,
+                                                       const __nv_bfloat16* w, __nv_bfloat16* out,
+                                                       long long ldo, int G, int D, float factor, float eps, int pdl) {
+    pdl_enter(pdl);
+    const int g = blockIdx.x;
+    __shared__ __nv_bfloat16 srow[2048];   // D <= 2048
+    const int threads = blockDim.x * blockDim.y;
+    // the launcher's block is min(D, target) lanes over a whole number of channels a thread: 1, 2, 4, 8 or 16 items
+    if (threads > 0 && threads <= D && (D % threads) == 0) {
+        switch (D / threads) {
+            case 1: tf_ds_compress2_norm_items<1>(kv, score, w, out, srow, ldo, D, factor, eps); return;
+            case 2: tf_ds_compress2_norm_items<2>(kv, score, w, out, srow, ldo, D, factor, eps); return;
+            case 4: tf_ds_compress2_norm_items<4>(kv, score, w, out, srow, ldo, D, factor, eps); return;
+            case 8: tf_ds_compress2_norm_items<8>(kv, score, w, out, srow, ldo, D, factor, eps); return;
+            case 16: tf_ds_compress2_norm_items<16>(kv, score, w, out, srow, ldo, D, factor, eps); return;
+            default: break;
+        }
+    }
+    // any other geometry: the pair pass, then the norm's own store over srow
+    for (int c = threadIdx.x + blockDim.x * threadIdx.y; c < D; c += threads) {
+        const float s0 = score[((long long)g * 2) * D + c];
+        const float s1 = score[((long long)g * 2 + 1) * D + c];
+        srow[c] = __float2bfloat16_rn(tf_ds_compress2_pair(s0, s1, kv[((long long)g * 2) * D + c], kv[((long long)g * 2 + 1) * D + c]));
+    }
+    __syncthreads();
+    tf_ds_torch_rmsnorm_row(srow, w, out + (long long)g * ldo, D, factor, eps);
+}
+
+// Each warp resolves both partners before reading any ring data. Use the first
+// matching current row, including when that row belongs to another block.
+__device__ __forceinline__ int2 tf_ds_compress2_partners(const long long* slots, int rows,
+                                                        long long own, long long q0, long long q1) {
+    if (rows == 1) return make_int2(own == q0 ? 0 : -1, own == q1 ? 0 : -1);
+    int2 found = make_int2(-1, -1);
+    for (int first = 0; first < rows; first += 32) {
+        const int r = first + (threadIdx.x & 31);
+        const long long slot = r < rows ? slots[r] : -1;
+        const unsigned m0 = __ballot_sync(0xffffffffu, r < rows && slot == q0);
+        const unsigned m1 = __ballot_sync(0xffffffffu, r < rows && slot == q1);
+        if (found.x < 0 && m0) found.x = first + __ffs(m0) - 1;
+        if (found.y < 0 && m1) found.y = first + __ffs(m1) - 1;
+        if (found.x >= 0 && found.y >= 0) break;
+    }
+    return found;
+}
+
+template<int D>
+__device__ __forceinline__ void tf_ds_compress2_decode(float value, const __nv_bfloat16* w, __nv_bfloat16* dst, float eps) {
+    const int tid = threadIdx.x;
+    const float x = __bfloat162float(__float2bfloat16_rn(value));
+    // Keep the rounded channel in a register for the final multiply. At width 512
+    // the kit first reduces four adjacent channels per logical lane.
+    __shared__ float row[D == 512 ? 512 : 1];
+    if (D == 512) {
+        row[tid] = x;
+        __syncthreads();
+    }
+    __shared__ float warp_sum[4];
+    if (tid < 128) {
+        float sum;
+        if (D == 512) {
+            const int base = tid * 4;
+            sum = tf_ds_kit_squares4(row[base], row[base + 1], row[base + 2], row[base + 3]);
+        } else {
+            sum = __fmul_rn(x, x);
+        }
+        sum = tf_ds_kit_warp_sum(sum);
+        if ((tid & 31) == 0) warp_sum[tid >> 5] = sum;
+    }
+    __syncthreads();
+    const float sum = __fadd_rn(__fadd_rn(warp_sum[0], warp_sum[2]), __fadd_rn(warp_sum[1], warp_sum[3]));
+    const float inv = tf_ds_kit_inverse_rms<D>(sum, eps);
+    const float y = __fmul_rn(x, inv);
+    dst[tid] = __float2bfloat16_rn(__fmul_rn(__bfloat162float(w[tid]), y));
+}
+
+// Decode ratio-2 scatter, pair compression and kit RMSNorm. Launch exactly D threads per row.
+extern "C" __global__ void __launch_bounds__(512) tf_ds_compress2x_norm_kernel(const float* ckv, long long ckv_ld,
+                                                                               const float* cgate, long long cgate_ld,
+                                                                               const long long* rslot,
+                                                                               float* ring_kv,
+                                                                               float* ring_score,
+                                                                               const long long* gi, long long src_rows,
+                                                                               const __nv_bfloat16* w,
+                                                                               __nv_bfloat16* out, long long ldo,
+                                                                               int G, int D, float eps,
+                                                                               unsigned* invalid, int pdl) {
+    pdl_enter(pdl);
+    const int g = blockIdx.x;
+    const long long own = rslot[g];
+    const int c = threadIdx.x;
+    const float own_kv = ckv[g * ckv_ld + c], own_score = cgate[g * cgate_ld + c];
+    ring_kv[own * D + c] = own_kv;
+    ring_score[own * D + c] = own_score;
+    const long long q0 = gi[2 * g], q1 = gi[2 * g + 1];
+    const int2 pr = tf_ds_compress2_partners(rslot, G, own, q0, q1);
+    const bool ok0 = q0 >= 0 && q0 < src_rows, ok1 = q1 >= 0 && q1 < src_rows;
+    if ((!ok0 || !ok1) && threadIdx.x == 0 && invalid) atomicExch(invalid, 1u);
+    float kv[2], score[2];
+    #pragma unroll
+    for (int i = 0; i < 2; ++i) {
+        const bool ok = i == 0 ? ok0 : ok1;
+        const int row = i == 0 ? pr.x : pr.y;
+        const long long q = i == 0 ? q0 : q1;
+        if (!ok) {
+            kv[i] = score[i] = 0.f;
+        } else if (row == g) {
+            kv[i] = own_kv;
+            score[i] = own_score;
+        } else if (row >= 0) {
+            kv[i] = ckv[row * ckv_ld + c];
+            score[i] = cgate[row * cgate_ld + c];
+        } else {
+            kv[i] = ring_kv[q * D + c];
+            score[i] = ring_score[q * D + c];
+        }
+    }
+    const float value = tf_ds_compress2_pair(score[0], score[1], kv[0], kv[1]);
+    if (D == 512) tf_ds_compress2_decode<512>(value, w, out + g * ldo, eps);
+    else tf_ds_compress2_decode<128>(value, w, out + g * ldo, eps);
+}
+
+// ===================================================================================================================
+// TF_DS_FUSED_ROPE_STORE (0198, off by default).
+//
+// These kernels combine the following operations at their original bf16 rounding boundaries:
+//   - the kit's `_rmsnorm` (see tf_ds_triton_rmsnorm_row above),
+//   - the kit's `_rope_heads` (Triton contracts the first product into the add: re = fma(xe, cs, -(xo*sn)),
+//     im = fma(xe, sn, xo*cs); the torch ops.rope_ equivalent is re = fma(xe, cs, -(xo*sn)), im = fma(xo, cs, xe*sn)) -
+//     both forms live in tf_ds_latent_element, which the key and latent passes call,
+//   - the kit's `_fp4_store` (E2M1 codes, the E4M3 or the pow2/E8M0 scale, byte packing),
+//   - the kit's `_fp4qd_p2` (E2M1 codes with the pow2 scale, the dequantized bf16 out).
+// The decode norm and rotary contraction follow the pinned SM121 kit.
+// ===================================================================================================================
+
+// E2M1 magnitude of an already-clamped t (|t| <= 6), ties to the even code (kernels.py `_e2m1_round`).
+__device__ __forceinline__ unsigned tf_ds_e2m1_code(float t) {
+    const float a = fabsf(t);
+    const unsigned idx = (a > 0.25f) + (a >= 0.75f) + (a > 1.25f) + (a >= 1.75f)
+                       + (a > 2.5f) + (a >= 3.5f) + (a > 5.0f);
+    return idx | ((t < 0.0f && idx > 0u) ? 8u : 0u);
+}
+
+// The E2M1 magnitude as a float (kernels.py's g table).
+__device__ __forceinline__ float tf_ds_e2m1_mag(unsigned idx) {
+    switch (idx) {
+        case 0: return 0.0f;
+        case 1: return 0.5f;
+        case 2: return 1.0f;
+        case 3: return 1.5f;
+        case 4: return 2.0f;
+        case 5: return 3.0f;
+        case 6: return 4.0f;
+        default: return 6.0f;
+    }
+}
+
+// E4M3 byte -> float (the scale the codes are dequantized with).
+__device__ __forceinline__ float tf_ds_e4m3_to_float(unsigned b) {
+    const unsigned exp = (b >> 3) & 15u, mantissa = b & 7u;
+    // The encoder returns positive scale bytes through 0x7e.
+    return exp ? __uint_as_float(((exp + 120u) << 23) | (mantissa << 20)) : mantissa * 0x1p-9f;
+}
+
+// The kit's FMNMX instructions select the numeric operand for a NaN.
+__device__ __forceinline__ float tf_ds_clamp6(float v) { return fminf(fmaxf(v, -6.f), 6.f); }
+
+template<int BLOCK>
+__device__ __forceinline__ float tf_ds_fp4_amax(float x) {
+    float m = fmaxf(0.f, fabsf(x));
+    #pragma unroll
+    for (int delta = BLOCK / 2; delta; delta >>= 1)
+        m = fmaxf(m, __shfl_xor_sync(0xffffffffu, m, delta, BLOCK));
+    return m;
+}
+
+__device__ __forceinline__ unsigned tf_ds_pow2_exponent(float amax) {
+    const unsigned bits = __float_as_uint(__fdiv_rn(fmaxf(amax, 6.f * 0x1p-126f), 6.f));
+    return ((bits >> 23) & 255u) + ((bits & 0x7fffffu) != 0);
+}
+
+// One rotary element as the fused chains rotate it: the pair partner is the neighbour lane's value (xor 1), the result
+// is rounded to bf16 once. PROMPT takes torch's odd-element contraction (re = fma(xe, cs, -(xo*sn)), im = fma(xo, cs,
+// xe*sn)); otherwise the kit's Triton form (im = fma(xe, sn, xo*cs)). `i < start` (the unrotated prefix) passes the
+// value through, and a caller outside the row passes start = D.
+template<bool PROMPT>
+__device__ __forceinline__ __nv_bfloat16 tf_ds_latent_element(__nv_bfloat16 x, int i, int start,
+                                                             const float* cs, const float* sn) {
+    const float v = __bfloat162float(x);
+    const float other = __shfl_xor_sync(0xffffffffu, v, 1);
+    if (i < start) return x;
+    const int j = (i - start) >> 1;
+    float rotated;
+    if ((i & 1) == 0) rotated = __fmaf_rn(v, cs[j], -__fmul_rn(other, sn[j]));
+    else if (PROMPT) rotated = __fmaf_rn(v, cs[j], __fmul_rn(other, sn[j]));
+    else rotated = __fmaf_rn(other, sn[j], __fmul_rn(v, cs[j]));
+    return __float2bfloat16_rn(rotated);
+}
+
+// One subgroup per scale. Preserve the kit's low/high half-row packing and target row indirection.
+// One pass, one lane a packed column: element i and element i + D/2 are loaded, rotated in registers (PROMPT picks
+// torch's odd-element contraction over the kit's), and their 32-key scale groups' maxima come from those same register
+// values - a lane's low and high elements are each the first element of their group at i % 32 == 0, so the lane that
+// writes a group's byte is the lane that quantizes it. No shared scale array, no barrier, and no second srow read.
+// The tail of the last iteration (D/2 not a multiple of blockDim.x) is whole 32-lane groups: those lanes run the
+// shuffles with 0 and write nothing, which keeps every full-mask shuffle whole-warp.
+template<bool PROMPT>
+__device__ __forceinline__ void tf_ds_key_store_row(const __nv_bfloat16* srow, const float* cos, const float* sin,
+                                                    long long pos, uint8_t* codes, uint8_t* scales, long long row,
+                                                    int D, int RD) {
+    constexpr int BLOCK = 32;
+    const int nb = D / BLOCK;
+    const int half = D / 2, start = D - RD;
+    cos += pos * (RD / 2);
+    sin += pos * (RD / 2);
+    scales += row * nb;
+    codes += row * half;
+    const __nv_bfloat16 zero = __float2bfloat16_rn(0.f);
+    const int lane = threadIdx.x + blockDim.x * threadIdx.y;
+    const int threads = blockDim.x * blockDim.y;
+    for (int first = 0; first < half; first += threads) {
+        const int i = first + lane;
+        const bool live = i < half;
+        // dead lanes read nothing and rotate nothing (start = D keeps the helper off the rope table)
+        const float x = __bfloat162float(tf_ds_latent_element<PROMPT>(live ? srow[i] : zero, i, live ? start : D, cos, sin));
+        const float y = __bfloat162float(tf_ds_latent_element<PROMPT>(live ? srow[i + half] : zero, i + half, live ? start : D, cos, sin));
+        const float ax = tf_ds_fp4_amax<BLOCK>(x);
+        const float ay = tf_ds_fp4_amax<BLOCK>(y);
+        if (!live) continue;
+        const unsigned bx = tf_ds_pow2_exponent(ax), by = tf_ds_pow2_exponent(ay);
+        if ((i % BLOCK) == 0) {
+            scales[i / BLOCK] = (uint8_t)bx;
+            scales[(i + half) / BLOCK] = (uint8_t)by;
+        }
+        const float lo = tf_ds_clamp6(__fdiv_rn(x, __uint_as_float(bx << 23)));
+        const float hi = tf_ds_clamp6(__fdiv_rn(y, __uint_as_float(by << 23)));
+        codes[i] = (uint8_t)(tf_ds_e2m1_code(lo) | (tf_ds_e2m1_code(hi) << 4));
+    }
+}
+
+// -- TF_DS_FUSED_ROPE_STORE (0198) ----------------------------------------------------------------------------------
+
+// The decode indexer key (round.zig's kv-source layers): the kit's `_rmsnorm` (D=128) + `_rope_heads` (RD=64, H=1,
+// forward) + `_fp4_store` (D=128, BLOCK=32, E4M3=false) in one launch. grid.x = rows, block = 128 (the _rmsnorm
+// num_warps=4 layout). The packed codes/scales go to rows_idx[r] (the ctarget row), exactly as _fp4_store's ROWS
+// indirection; the rotated row stays in shared memory (rd.ik's store had no reader, so nothing writes it).
+extern "C" __global__ void __launch_bounds__(128) tf_ds_fused_idx_key_kernel(const __nv_bfloat16* x, long long ldx,
+                                                                             const __nv_bfloat16* w,
+                                                                             const float* cos, const float* sin,
+                                                                             const long long* pos,
+                                                                             uint8_t* codes, uint8_t* scales,
+                                                                             const long long* rows_idx,
+                                                                             int D, int RD, float eps, int pdl) {
+    pdl_enter(pdl);
+    const int r = blockIdx.x;
+    __shared__ __nv_bfloat16 srow[512];   // D <= 512
+    // phase 1: _rmsnorm (x row -> srow, bf16)
+    tf_ds_triton_rmsnorm_row<128>(x + (long long)r * ldx, w, srow, eps);
+    __syncthreads();
+    // phases 2+3: _rope_heads (RD/2 pairs, head base = D - RD) and _fp4_store in one packed-column pass
+    tf_ds_key_store_row<false>(srow, cos, sin, pos[r], codes, scales, rows_idx[r], D, RD);
+}
+
+__device__ __forceinline__ unsigned tf_ds_latent_code(__nv_bfloat16 x, uint8_t* scales, int i) {
+    const float v = __bfloat162float(x);
+    const float m = tf_ds_fp4_amax<16>(v);
+    const float f = __fdiv_rn(fmaxf(m, 6.f * 0x1p-9f), 6.f);
+    const unsigned byte = __nv_cvt_float_to_fp8(f, __NV_SATFINITE, __NV_E4M3);
+    if ((i & 15) == 0) scales[i >> 4] = byte;
+    const float sc = tf_ds_e4m3_to_float(byte);
+    // With bf16 inputs and positive E4M3 scales every scaled midpoint is exactly
+    // representable in fp32. Adjacent bf16 values cannot round onto a midpoint after
+    // division. Comparing against the midpoint in input units preserves all seven ties.
+    const float a = fabsf(v);
+    const unsigned idx = (a > .25f * sc) + (a >= .75f * sc) + (a > 1.25f * sc)
+                       + (a >= 1.75f * sc) + (a > 2.5f * sc) + (a >= 3.5f * sc) + (a > 5.f * sc);
+    if (isnan(v)) return 15u; // kit clamps NaN to -6
+    return idx | ((v < 0.f && idx) ? 8u : 0u);
+}
+
+template<bool PROMPT>
+__device__ __forceinline__ void tf_ds_latent_row(const __nv_bfloat16* src, const float* cos, const float* sin,
+                                                 long long pos, uint8_t* codes, uint8_t* scales, long long row,
+                                                 int D, int RD) {
+    const int half = D / 2, start = D - RD;
+    const long long base = (long long)blockIdx.x * D;
+    const int lane = threadIdx.x + blockDim.x * threadIdx.y;
+    const int threads = blockDim.x * blockDim.y;
+    cos += pos * (RD / 2);
+    sin += pos * (RD / 2);
+    scales += row * (D / 16);
+    for (int i = lane; i < half; i += threads) {
+        const auto lo = tf_ds_latent_element<PROMPT>(src[base+i], i, start, cos, sin);
+        const auto hi = tf_ds_latent_element<PROMPT>(src[base+i+half], i+half, start, cos, sin);
+        const unsigned l = tf_ds_latent_code(lo, scales, i);
+        const unsigned h = tf_ds_latent_code(hi, scales, i+half);
+        codes[row * half + i] = (uint8_t)(l | (h << 4));
+    }
+}
+
+// The decode latent (round.zig's kv-source layers): `_rope_heads` (RD=64, H=1, forward) + `_fp4_store`
+// (D=512, BLOCK=16, E4M3=true) in one launch. x is rd.lat, read only: the rotation is a register value here and the
+// in-place store had no reader after the pack. The packed codes/scales go to rows_idx[r] (the ltarget row; under
+// TF_DS_KV_SHARD the rank's plane or the trash row).
+extern "C" __global__ void __launch_bounds__(256) tf_ds_fused_rope_store_kernel(const __nv_bfloat16* x,
+                                                                                const float* cos, const float* sin,
+                                                                                const long long* pos,
+                                                                                uint8_t* codes, uint8_t* scales,
+                                                                                const long long* rows_idx,
+                                                                                int D, int RD, int pdl) {
+    pdl_enter(pdl);
+    const int r = blockIdx.x;
+    tf_ds_latent_row<false>(x, cos, sin, pos[r], codes, scales, rows_idx[r], D, RD);
+}
+
+// The decode indexer query (round.zig's index-source layers): `_rope_heads` (RD=64, H=index_heads, forward) +
+// `_fp4qd_p2` (32-element blocks, E2M1 codes with a pow2 scale, the dequantized bf16 written back out) in one launch.
+// grid.x = rows * H, block = 128. out (rd.iq4) gets the dequantized values; the rotated value is a register input to
+// its quantization (x is read only: the in-place rotation had no reader).
+extern "C" __global__ void __launch_bounds__(128) tf_ds_fused_rope_qd_kernel(const __nv_bfloat16* x, __nv_bfloat16* out,
+                                                                             const float* cos, const float* sin,
+                                                                             const long long* pos,
+                                                                             int H, int HD, int RD, int pdl) {
+    pdl_enter(pdl);
+    const int r = blockIdx.x / H, h = blockIdx.x % H;
+    const long long base = ((long long)r * H + h) * HD;
+    const long long p = pos[r];
+    for (int i = threadIdx.x; i < HD; i += blockDim.x) {
+        float v = __bfloat162float(x[base + i]);
+        const float other = __shfl_xor_sync(0xffffffffu, v, 1);
+        if (i >= HD - RD) {
+            const int j = (i - (HD - RD)) / 2;
+            const float cs = cos[p * (RD / 2) + j], sn = sin[p * (RD / 2) + j];
+            const float rot = (i & 1) ? __fmaf_rn(other, sn, __fmul_rn(v, cs))
+                                      : __fmaf_rn(v, cs, -__fmul_rn(other, sn));
+            v = __bfloat162float(__float2bfloat16_rn(rot));
+        }
+        const float scale = __uint_as_float(tf_ds_pow2_exponent(tf_ds_fp4_amax<32>(v)) << 23);
+        const float t = tf_ds_clamp6(__fdiv_rn(v, scale));
+        const float q = copysignf(tf_ds_e2m1_mag(tf_ds_e2m1_code(t) & 7u), t);
+        out[base + i] = __float2bfloat16_rn(__fmul_rn(q, scale));
+    }
+}
+
+// The prompt indexer key (prompt.zig's kv-source layers): torch's ops.rms_norm (the Exact kernel's arithmetic) +
+// ops.rope_ (tf_ds_rope_kernel's arithmetic) + the kit's `_fp4_store` (D=128, BLOCK=32, E4M3=false) in one launch.
+// grid.x = rows, block = { x = rmsLanes(D, rows), y = packLanes } (the x lane count the unfused rmsNorm launch uses,
+// so the reduction order is unchanged; the y lanes only share the packed-column pass, which strides on the flattened
+// threadIdx.x + blockDim.x * threadIdx.y). codes/scales go to rows_idx[r] (the group's slot); the rotated row stays in
+// shared memory (ch.ik's store had no reader).
+extern "C" __global__ void tf_ds_fused_prompt_idx_key_kernel(const __nv_bfloat16* x, long long ldx,
+                                                             const __nv_bfloat16* w, float eps, float factor,
+                                                             const float* cos, const float* sin, const long long* pos,
+                                                             uint8_t* codes, uint8_t* scales, const long long* rows_idx,
+                                                             int D, int RD, int pdl) {
+    pdl_enter(pdl);
+    const int r = blockIdx.x;
+    __shared__ __nv_bfloat16 srow[512];   // D <= 512
+    tf_ds_torch_rmsnorm_row(x + (long long)r * ldx, w, srow, D, factor, eps);
+    __syncthreads();
+    // ops.rope_ (torch's contraction) and the kit's _fp4_store in one packed-column pass
+    tf_ds_key_store_row<true>(srow, cos, sin, pos[r], codes, scales, rows_idx[r], D, RD);
+}
+
+// The prompt latent (prompt.zig's kv-source layers): ops.rope_ (tf_ds_rope_kernel's arithmetic) + the kit's
+// `_fp4_store` (D=512, BLOCK=16, E4M3=true) in one launch. x is ch.lat, read only: the copy into ch.lat2 with its
+// rotation had no reader after the pack. codes/scales go to rows_idx[r] (the group's slot). block = { x =
+// min(D/2, 256), y = 1 }: blockDim.x already covers the packed half row, so no extra y lanes are passed.
+extern "C" __global__ void __launch_bounds__(256) tf_ds_fused_prompt_latent_kernel(const __nv_bfloat16* x,
+                                                                                   const float* cos, const float* sin,
+                                                                                   const long long* pos,
+                                                                                   uint8_t* codes, uint8_t* scales,
+                                                                                   const long long* rows_idx,
+                                                                                   int D, int RD, int pdl) {
+    pdl_enter(pdl);
+    const int r = blockIdx.x;
+    tf_ds_latent_row<true>(x, cos, sin, pos[r], codes, scales, rows_idx[r], D, RD);
+}
diff --git a/zig/src/families/dsv41/compress2_norm.zig b/zig/src/families/dsv41/compress2_norm.zig
new file mode 100644
index 0000000..56663a4
--- /dev/null
+++ b/zig/src/families/dsv41/compress2_norm.zig
@@ -0,0 +1,220 @@
+//! TF_DS_FUSED_COMPRESS2_NORM (off by default): the ratio-2 compressor chain and the RMSNorm after it in ONE launch.
+//!
+//! Prompt follows Exact.compress2 and Exact.rmsNorm, including bf16 staging and the row-dependent lane count.
+//! Decode combines the 0127 scatter/gather/compress2 with the pinned kit RMSNorm for the recorded widths.
+//! TF_DS_FUSED_COMPRESS2 alone keeps its separate kit norm. Other widths retain the existing decode path.
+const std = @import("std");
+
+pub const env_name: [:0]const u8 = "TF_DS_FUSED_COMPRESS2_NORM";
+
+/// The switch's value: unset, "" or "0" off; "1" on; anything else is a refusal to start (the message is on stderr).
+pub fn parse(text: ?[]const u8) ?bool {
+    const t = text orelse return false;
+    if (t.len == 0 or std.mem.eql(u8, t, "0")) return false;
+    if (std.mem.eql(u8, t, "1")) return true;
+    std.debug.print("{s}: expected 1 or 0\n", .{env_name});
+    return null;
+}
+
+pub fn fromText(text: ?[]const u8) error{BadCompress2Norm}!bool {
+    return parse(text) orelse error.BadCompress2Norm;
+}
+
+fn isPow2(n: usize) bool {
+    return n > 0 and (n & (n - 1)) == 0;
+}
+
+/// Prompt uses the vectorized torch norm. Decode additionally requires a matching kit specialization.
+pub fn fuseOk(fused: bool, rows: usize, d: usize) bool {
+    return fused and rows > 0 and isPow2(d) and d >= 128 and d <= 2048;
+}
+
+pub fn decodeOk(fused: bool, rows: usize, d: usize) bool {
+    return fused and rows > 0 and (d == 128 or d == 512);
+}
+
+test "decode fusion uses recorded four-warp kit widths" {
+    for ([_]usize{ 128, 512 }) |d| try std.testing.expect(decodeOk(true, 1, d));
+    for ([_]usize{ 256, 1024, 2048 }) |d| try std.testing.expect(!decodeOk(true, 1, d));
+}
+
+// -- host reference --------------------------------------------------------------------------------------------------
+
+/// Round-to-nearest-even f32 -> bf16 -> f32 (the rounding the kernels apply at every bf16 store).
+pub fn bf16Round(x: f32) f32 {
+    if (std.math.isNan(x)) return x;
+    const b: u32 = @bitCast(x);
+    return @bitCast((b + 0x7FFF + ((b >> 16) & 1)) & 0xFFFF0000);
+}
+
+/// The pair's softmax-weighted sum (tf_ds_compress2_kernel's arithmetic), the raw fp32 value.
+pub fn pairSum(kv0: f32, kv1: f32, s0: f32, s1: f32) f32 {
+    var m: f32 = -3.402823466e+38; // numeric_limits<float>::lowest()
+    if (s0 > m) m = s0;
+    if (s1 > m) m = s1;
+    var sum: f32 = 0;
+    sum += @exp(s0 - m);
+    sum += @exp(s1 - m);
+    const p0 = @exp(s0 - m) / sum;
+    const p1 = @exp(s1 - m) / sum;
+    const y0 = kv0 * p0;
+    const y1 = kv1 * p1;
+    return ((0.0 + y0) + (0.0 + y1)) + 0.0 + 0.0;
+}
+
+/// The pair sum as the kernels store it: bf16-rounded.
+pub fn pairSumBf16(kv0: f32, kv1: f32, s0: f32, s1: f32) f32 {
+    return bf16Round(pairSum(kv0, kv1, s0, s1));
+}
+
+/// The torch rms_norm lane count (exact.zig's rmsLanes; replicated here so this module stands alone — the test below
+/// asserts the two agree).
+pub fn rmsLanes(d: usize, rows: usize) usize {
+    const dim0 = d / 4;
+    const d0 = if (dim0 < 512) lastPow2(dim0) else 512;
+    const d1 = if (rows < 512) lastPow2(rows) else 512;
+    const bw: usize = @min(d0, 32);
+    const bh: usize = @min(d1, 512 / bw);
+    return @min(d0, 512 / bh);
+}
+
+fn lastPow2(n: usize) usize {
+    return if (n == 0) 0 else @as(usize, 1) << @intCast(std.math.log2_int(usize, n));
+}
+
+/// The pair pass's thread count (exact.compress2Norm's block: rmsLanes lanes over `groups` y lanes).
+pub fn pairThreads(d: usize, rows: usize) usize {
+    const lanes = rmsLanes(d, rows);
+    const target: usize = if (rows <= 32) 512 else if (rows <= 128) 256 else 128;
+    return @max(1, @min(d, target) / lanes) * lanes;
+}
+
+/// The channels one thread produces and then stores: tf_ds_compress2_norm_kernel's held-values specialization is
+/// unrolled per item count (1, 2, 4, 8, 16); any other count takes the generic path that rereads srow.
+pub fn pairItems(d: usize, rows: usize) usize {
+    return d / pairThreads(d, rows);
+}
+
+/// The norm of one bf16-valued row, torch's lane structure (per-lane 4-wide vector accumulators combined in order,
+/// the L>32 fold, the shuffle down), returning bf16-valued f32. `factor` is torch's rows/(rows*D) as f32. Not
+/// bit-identical to the kernel (rsqrtf vs 1/@sqrt); used for the property tests, not for bitwise checks.
+pub fn rmsNormRef(x: []const f32, w: []const f32, out: []f32, lanes: usize, factor: f32, eps: f32) void {
+    const d = x.len;
+    const l = lanes;
+    var part: [512]f32 = @splat(0);
+    var lane: usize = 0;
+    while (lane < l) : (lane += 1) {
+        var a0: f32 = 0;
+        var a1: f32 = 0;
+        var a2: f32 = 0;
+        var a3: f32 = 0;
+        var idx = lane;
+        while (idx * 4 + 3 < d) : (idx += l) {
+            a0 += x[idx * 4 + 0] * x[idx * 4 + 0];
+            a1 += x[idx * 4 + 1] * x[idx * 4 + 1];
+            a2 += x[idx * 4 + 2] * x[idx * 4 + 2];
+            a3 += x[idx * 4 + 3] * x[idx * 4 + 3];
+        }
+        part[lane] = ((a0 + a1) + a2) + a3;
+    }
+    var dim_x = l;
+    if (l > 32) {
+        var offset = l / 2;
+        while (offset >= 32) : (offset >>= 1) {
+            var lane2: usize = 0;
+            while (lane2 < offset) : (lane2 += 1) {
+                if (lane2 + offset < l) part[lane2] = part[lane2] + part[lane2 + offset];
+            }
+        }
+        dim_x = 32;
+    }
+    var offset = dim_x / 2;
+    while (offset > 0) : (offset >>= 1) {
+        var lane2: usize = 0;
+        while (lane2 < dim_x) : (lane2 += 1) {
+            if (lane2 + offset < dim_x) part[lane2] = part[lane2] + part[lane2 + offset];
+        }
+    }
+    const r = 1.0 / @sqrt(part[0] * factor + eps);
+    var j: usize = 0;
+    while (j < d) : (j += 1) out[j] = bf16Round(w[j] * (x[j] * r));
+}
+
+// -- tests -----------------------------------------------------------------------------------------------------------
+
+const expectEqual = std.testing.expectEqual;
+const exact = @import("exact.zig");
+
+test "the switch parses its forms and nothing else" {
+    try expectEqual(false, parse(null).?);
+    try expectEqual(false, parse("").?);
+    try expectEqual(false, parse("0").?);
+    try expectEqual(true, parse("1").?);
+    try expectEqual(@as(?bool, null), parse("2"));
+    try expectEqual(@as(?bool, null), parse("yes"));
+    try expectEqual(@as(?bool, null), parse("01"));
+    try std.testing.expectEqual(@as(bool, true), try fromText("1"));
+    try std.testing.expectError(error.BadCompress2Norm, fromText("2"));
+}
+
+test "fuseOk takes pow2 channel counts in [128, 2048] and any nonzero rows" {
+    try std.testing.expect(fuseOk(true, 1, 512));
+    try std.testing.expect(fuseOk(true, 16, 128));
+    try std.testing.expect(fuseOk(true, 2048, 2048));
+    try std.testing.expect(!fuseOk(true, 0, 512));
+    try std.testing.expect(!fuseOk(false, 16, 512));
+    try std.testing.expect(!fuseOk(true, 16, 96)); // not pow2
+    try std.testing.expect(!fuseOk(true, 16, 64)); // too narrow for the torch norm's vectorization
+    try std.testing.expect(!fuseOk(true, 16, 4096));
+    try std.testing.expect(!fuseOk(true, 16, 500)); // not pow2
+}
+
+test "rmsLanes matches exact.zig's" {
+    for ([_]usize{ 128, 256, 512, 1024, 2048 }) |d| {
+        for ([_]usize{ 1, 2, 3, 4, 5, 8, 9, 16, 17, 33, 512, 2048 }) |rows| {
+            try expectEqual(exact.rmsLanes(d, rows), rmsLanes(d, rows));
+        }
+    }
+}
+
+test "pairItems: every served geometry is a held-values specialization power of two" {
+    for ([_]usize{ 128, 256, 512, 1024, 2048 }) |d| {
+        for ([_]usize{ 1, 2, 7, 16, 32, 33, 64, 128, 129, 512, 1024, 2048 }) |rows| {
+            const threads = pairThreads(d, rows);
+            try std.testing.expect(threads > 0 and threads <= d);
+            try std.testing.expectEqual(@as(usize, 0), d % threads); // whole channels a thread
+            const items = pairItems(d, rows);
+            try std.testing.expect(items == 1 or items == 2 or items == 4 or items == 8 or items == 16);
+        }
+    }
+}
+
+test "pairSum: the softmax pair, bf16 rounding at the store" {
+    // s0 == s1: the softmax splits 0.5/0.5; the pair sum is the mean of the kv values
+    const v = pairSum(2.0, 4.0, 1.0, 1.0);
+    try std.testing.expectApproxEqAbs(@as(f32, 3.0), v, 1e-6);
+    try expectEqual(@as(f32, 3.0), pairSumBf16(2.0, 4.0, 1.0, 1.0));
+    // one score far above the other: the pair sum is that side's kv (to bf16)
+    try expectEqual(bf16Round(4.0), pairSumBf16(2.0, 4.0, -100.0, 100.0));
+    // a tie at the -inf floor: both weights equal
+    const v2 = pairSum(2.0, 6.0, -3.4e38, -3.4e38);
+    try std.testing.expectApproxEqAbs(@as(f32, 4.0), v2, 1e-3);
+}
+
+test "bf16Round rounds to nearest even at the 16-bit boundary" {
+    try expectEqual(@as(f32, 1.0), bf16Round(1.0));
+    try expectEqual(@as(f32, 1.0), bf16Round(1.00390625)); // halfway between 1.0 and 1.0078125 -> ties to even (1.0)
+    try expectEqual(@as(f32, 1.015625), bf16Round(1.01171875)); // halfway -> ties to even (1.015625)
+    try expectEqual(@as(f32, 0.0), bf16Round(0.0));
+    try expectEqual(@as(f32, -0.0), bf16Round(-0.0));
+}
+
+test "rmsNormRef: a constant row normalizes to w * sign (x * rinv)" {
+    // x = c (all ones): sum = d * c^2; rinv = rsqrt(c^2 + eps); out = bf16(w * c * rinv)
+    var x: [512]f32 = @splat(2.0);
+    var w: [512]f32 = @splat(1.5);
+    var out: [512]f32 = undefined;
+    rmsNormRef(&x, &w, &out, 32, 1.0 / 512.0, 1e-20);
+    const expect_v = bf16Round(1.5 * (2.0 / @sqrt(4.0 + 1e-20)));
+    for (out) |v| try expectEqual(expect_v, v);
+}
