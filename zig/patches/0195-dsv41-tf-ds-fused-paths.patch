+// One CTA owns a candidate row. Keep the maxima on chip for radix selection.
+// Compact selected columns in input order so neither the mask nor the list needs a sort. The maxima and the selection
+// live only on chip: the call sites read the mask (the prompt arm) or the block list (decode), never bmax/pidx, so the
+// fused launch writes neither (the unfused blockMax/topkIndices/poolPick sequence still does).
+extern "C" __global__ void __launch_bounds__(1024) tf_ds_idx_fused_kernel(const float* score, long long ss, int width,
+                                                                          int bsize, const long long* vis,
+                                                                          const long long* every, int k,
+                                                                          uint8_t* mask, long long ms, int* cblk,
+                                                                          int pdl) {
+    pdl_enter(pdl);
+    const int r = blockIdx.x;
+    const int nb = 1 + (width - 1) / bsize;
+    extern __shared__ float maxima[];
+    const float ninf = -__int_as_float(0x7f800000);
+    const float* row = score + (long long)r * ss;
+    // phase 1: the block maxima (tf_ds_block_max_kernel's rule, one thread a block)
+    const long long visible = vis[r];
+    const long long last = visible > 0 ? (visible - 1) / bsize : -1;
+    for (int b = threadIdx.x; b < nb; b += blockDim.x) {
+        const float* s = row + (long long)b * bsize;
+        float m = ninf;
+        bool nan = false;
+        for (int j = 0; j < bsize && b * bsize + j < width; ++j) {
+            const float x = s[j];
+            if (x != x) nan = true;
+            else if (x > m) m = x;
+        }
+        float v = nan ? __int_as_float(0x7fc00000) : m;
+        if (b == last) v = __int_as_float(0x7f800000);
+        maxima[b] = v;
+    }
+    __syncthreads();
+    const unsigned long long kth = k == nb ? 0 : tf_ds_pool_kth(maxima, nb, k);
+    const long long limit = every[r];
+    const int lane = threadIdx.x & 31;
+    const int warp = threadIdx.x >> 5;
+    __shared__ int warp_end[32];
+    int base = 0;
+    for (int first = 0; first < nb; first += blockDim.x) {
+        const int col = first + threadIdx.x;
+        const float value = col < nb ? maxima[col] : ninf;
+        const bool picked = col < nb && tf_ds_score_key(value, col) >= kth;
+        const unsigned bits = __ballot_sync(0xffffffffu, picked);
+        if (lane == 0) warp_end[warp] = __popc(bits);
+        __syncthreads();
+        if (warp == 0) {
+            int total = warp_end[lane];
+            #pragma unroll
+            for (int step = 1; step < 32; step <<= 1) {
+                const int prev = __shfl_up_sync(0xffffffffu, total, step);
+                if (lane >= step) total += prev;
+            }
+            warp_end[lane] = total;
+        }
+        __syncthreads();
+        const bool valid = picked && col < limit && value > ninf;
+        if (mask && col < nb) mask[(long long)r * ms + col] = valid;
+        if (picked && cblk) {
+            const int rank = base + (warp ? warp_end[warp - 1] : 0) + __popc(bits & ((1u << lane) - 1));
+            cblk[(long long)r * k + rank] = valid ? col : -1;
+        }
+        base += warp_end[31];
+        __syncthreads();  // all warps consumed the offsets before the next tile
+    }
+}
