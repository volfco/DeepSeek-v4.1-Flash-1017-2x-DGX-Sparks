+// Decode RMSNorm, specialized to the two matching _rmsnorm cubins in kit abe07c7d.
+// Each of the 128 threads loads one contiguous group. The 512-wide cubin starts with
+// lane element 1 squared, then contracts elements 0, 2 and 3 into that sum.
+template<int D>
+__device__ __forceinline__ void tf_ds_triton_rmsnorm_row(const __nv_bfloat16* src, const __nv_bfloat16* w,
+                                                         __nv_bfloat16* dst, float eps) {
+    static_assert(D == 128 || D == 512, "missing kit specialization");
+    constexpr int items = D / 128;
+    const int tid = threadIdx.x;
+    const int base = tid * items;
+    float x[items];
+    #pragma unroll
+    for (int j = 0; j < items; ++j) x[j] = __bfloat162float(src[base + j]);
+    float sum;
+    if (D == 512) sum = tf_ds_kit_squares4(x[0], x[1], x[2], x[3]);
+    else sum = __fmul_rn(x[0], x[0]);
+    sum = tf_ds_kit_warp_sum(sum);
+    __shared__ float warp_sum[4];
+    __shared__ float inv;
+    if ((tid & 31) == 0) warp_sum[tid >> 5] = sum;
+    __syncthreads();
+    if (tid < 4) {
+        sum = warp_sum[tid];
+        sum = __fadd_rn(sum, __shfl_xor_sync(0xfu, sum, 2));
+        sum = __fadd_rn(sum, __shfl_xor_sync(0xfu, sum, 1));
+        if (tid == 0) inv = tf_ds_kit_inverse_rms<D>(sum, eps);
+    }
+    __syncthreads();
+    #pragma unroll
+    for (int j = 0; j < items; ++j) {
+        const float y = __fmul_rn(x[j], inv);
+        dst[base + j] = __float2bfloat16_rn(__fmul_rn(__bfloat162float(w[base + j]), y));
+    }
+}
