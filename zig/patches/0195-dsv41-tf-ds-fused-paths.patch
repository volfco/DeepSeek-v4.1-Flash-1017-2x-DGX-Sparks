+        }
+        __syncthreads();
+        if (r < 32) {
+            const unsigned n_before = __reduce_add_sync(0xffffffffu, r < 16 ? (unsigned)__popc(discarded[r] | retained[r]) : 0u);
+            const unsigned n_after = __reduce_add_sync(0xffffffffu, r < 16 ? (unsigned)__popc(retained[r]) : 0u);
+            if (r < 6) {
+                unsigned value = 1;
+                switch (r) {
+                    case 1: value = n_before; break;
+                    case 2: value = n_after; break;
+                    case 3: value = drops[0] + (blockDim.x > 32 ? drops[1] : 0u); break;
+                    case 4: value = rows; break;
+                    case 5: value = ppm[0] + (blockDim.x > 32 ? ppm[1] : 0u); break;
+                }
+                atomicAdd(stats + r, (unsigned long long)value);
+            }
+        }
+    }
+}
