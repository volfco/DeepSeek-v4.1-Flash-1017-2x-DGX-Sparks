+// The six routed picks precede the shared expert. A zero bit marks an invalid slot.
+// Higher bits win equal-share ties, which preserves the router's slot order.
+struct TfDsPruneSlot {
+    float share;
+    unsigned bit;
+};
+
+__device__ __forceinline__ void tf_ds_order_slots(TfDsPruneSlot &left, TfDsPruneSlot &right) {
+    if (right.share > left.share || (right.share == left.share && right.bit > left.bit)) {
+        const TfDsPruneSlot tmp = left;
+        left = right;
+        right = tmp;
+    }
+}
+
+__device__ __forceinline__ unsigned tf_ds_drop_six(const float (&shares)[6], const int (&ids)[6]) {
+    TfDsPruneSlot s[6];
+    #pragma unroll
+    for (int i = 0; i < 6; ++i) {
+        s[i] = {ids[i] >= 0 ? shares[i] : __int_as_float(0xff800000), ids[i] >= 0 ? 32u >> i : 0u};
+    }
+    // With bias-corrected routing, slot order may differ from weight order.
+    bool ordered = true;
+    #pragma unroll
+    for (int i = 1; i < 6; ++i) {
+        ordered &= ids[i - 1] >= 0 && s[i - 1].share >= s[i].share;
+    }
+    if (!ordered) {
+        tf_ds_order_slots(s[0], s[5]); tf_ds_order_slots(s[1], s[3]); tf_ds_order_slots(s[2], s[4]);
+        tf_ds_order_slots(s[1], s[2]); tf_ds_order_slots(s[3], s[4]);
+        tf_ds_order_slots(s[0], s[3]); tf_ds_order_slots(s[2], s[5]);
+        tf_ds_order_slots(s[0], s[1]); tf_ds_order_slots(s[2], s[3]); tf_ds_order_slots(s[4], s[5]);
+        tf_ds_order_slots(s[1], s[2]); tf_ds_order_slots(s[3], s[4]);
+    }
+    // The first three live slots are guaranteed. Only the three trailing ranks need decisions.
+    float prefix = __fadd_rn(__fadd_rn(s[0].share, s[1].share), s[2].share);
+    unsigned drop = prefix < 0.85f ? 0u : s[3].bit;
+    prefix = __fadd_rn(prefix, s[3].share);
+    if (!(prefix < 0.85f)) drop |= s[4].bit;
+    prefix = __fadd_rn(prefix, s[4].share);
+    if (!(prefix < 0.85f)) drop |= s[5].bit;
+    return drop;
+}
+
+template<bool collect>
+__device__ __forceinline__ void tf_ds_prune_six(int *pick, float *wts, int rows,
+        unsigned long long *stats, const unsigned char *dead) {
+    const int r = threadIdx.x;
+    __shared__ unsigned discarded[16], retained[16], drops[2], ppm[2];
+    if (collect) {
+        if (r < 16) discarded[r] = retained[r] = 0;
+        __syncthreads();
+    }
+
+    unsigned drop = 0;
+    float mass = 0.f;
+    if (r < rows) {
+        int *pk = pick + 7 * r;
+        float *w = wts + 7 * r;
+        const bool clear = dead && dead[r];
+        if (collect || !clear) {
+            int ids[6];
+            float weights[6], shares[6], total = 0.f;
+            #pragma unroll
+            for (int i = 0; i < 6; ++i) {
+                ids[i] = pk[i];
+                weights[i] = w[i];
+                if (ids[i] >= 0) total = __fadd_rn(total, weights[i]);
+            }
+            if (total > 0.f && !isinf(total)) {
+                #pragma unroll
+                for (int i = 0; i < 6; ++i) shares[i] = ids[i] >= 0 ? __fdiv_rn(weights[i], total) : 0.f;
+                drop = tf_ds_drop_six(shares, ids);
+                if (drop) {
+                    float kept = 0.f;
+                    #pragma unroll
+                    for (int i = 0; i < 6; ++i) {
+                        if (drop & (32u >> i)) {
+                            if (collect) mass = __fadd_rn(mass, shares[i]);
+                        } else if (ids[i] >= 0) {
+                            kept = __fadd_rn(kept, weights[i]);
+                        }
+                    }
+                    if (!clear) {
+                        const float scale = __fdiv_rn(total, kept);
+                        #pragma unroll
+                        for (int i = 0; i < 6; ++i) {
+                            if (drop & (32u >> i)) { pk[i] = -1; w[i] = 0.f; }
+                            else if (ids[i] >= 0) w[i] = __fmul_rn(weights[i], scale);
+                        }
+                    }
+                }
+            }
+            if (collect) {
+                #pragma unroll
+                for (int i = 0; i < 6; ++i) {
+                    const unsigned id = (unsigned)ids[i];
+                    if (id < 512) {
+                        const unsigned bit = 1u << (id & 31);
+                        // The union of the two sets recovers the pre-prune distinct count.
+                        unsigned *bitmap = (drop & (32u >> i)) ? discarded : retained;
+                        atomicOr(&bitmap[id >> 5], bit);
+                    }
+                }
+            }
+        }
+        if (clear) {
+            #pragma unroll
+            for (int i = 0; i < 7; ++i) { pk[i] = -1; w[i] = 0.f; }
+        }
