+test "keyStore: the fused packed-column pass writes the separate-pass pipeline's very bytes" {
+    // D = 128 with RD = 2 (the smallest suffix) and RD = 64 (the served decode key), then D = 512 / RD = 64 (the prompt
+    // key's multi-iteration case at 32 lanes) and RD == D (the whole row rotates). Five rows a shape: random, small
+    // integers, underflowing, signed zeros, and past the clamp / E2M1 top code.
+    var cos: [256]f32 = undefined; // RD/2 entries at most
+    var sin: [256]f32 = undefined;
+    for (&cos, &sin, 0..) |*c, *sn, j| {
+        const t = @as(f32, @floatFromInt(j)) * 0.11;
+        c.* = @cos(t);
+        sn.* = @sin(t);
+    }
+    var row: [512]f32 = undefined;
+    var prng = std.Random.DefaultPrng.init(0x5EED);
+    const rnd = prng.random();
+    for ([_]struct { d: usize, rd: usize, torch: bool }{
+        .{ .d = 128, .rd = 2, .torch = false },
+        .{ .d = 128, .rd = 64, .torch = false },
+        .{ .d = 128, .rd = 64, .torch = true },
+        .{ .d = 512, .rd = 64, .torch = true },
+        .{ .d = 512, .rd = 512, .torch = false },
+    }) |case| {
+        for (0..5) |round| {
+            for (row[0..case.d], 0..) |*x, i| {
+                x.* = switch (round) {
+                    0 => rnd.float(f32) * 2.0 - 1.0,
+                    1 => @as(f32, @floatFromInt(i % 7)) - 3.0,
+                    2 => if (i % 11 == 0) 0.0 else rnd.float(f32) * 1e-8, // underflowing scales
+                    3 => if (i % 13 == 0) -0.0 else @as(f32, @floatFromInt(@as(i32, @intCast(i % 5)) - 2)),
+                    else => rnd.float(f32) * 60.0 - 30.0, // past clamp6 and the E2M1 top code
+                };
+                x.* = bf16Value(x.*); // the row the norm wrote is bf16
+            }
+            // the old pipeline: the separate rotation pass's srow (the pair-wise kit/torch helpers, not rotateOne),
+            // then a 32-key amax a group, then the packed codes
+            var rot: [512]f32 = undefined;
+            const start = case.d - case.rd;
+            for (rot[0..case.d], 0..) |*r, i| r.* = row[i];
+            for (0..case.rd / 2) |j| {
+                const pair = if (case.torch)
+                    ropePairTorch(row[start + 2 * j], row[start + 2 * j + 1], cos[j], sin[j], false)
+                else
+                    ropePairTriton(row[start + 2 * j], row[start + 2 * j + 1], cos[j], sin[j], false);
+                rot[start + 2 * j] = bf16Value(pair[0]);
+                rot[start + 2 * j + 1] = bf16Value(pair[1]);
+            }
+            var codes_a: [256]u8 = undefined;
+            var codes_b: [256]u8 = undefined;
+            var scales_a: [16]u8 = undefined;
+            var scales_b: [16]u8 = undefined;
+            keyStoreRotated(rot[0..case.d], case.d, codes_a[0 .. case.d / 2], scales_a[0 .. case.d / 32]);
+            keyStoreFused(row[0..case.d], case.d, case.rd, &cos, &sin, case.torch, codes_b[0 .. case.d / 2], scales_b[0 .. case.d / 32]);
+            try std.testing.expectEqualSlices(u8, codes_a[0 .. case.d / 2], codes_b[0 .. case.d / 2]);
+            try std.testing.expectEqualSlices(u8, scales_a[0 .. case.d / 32], scales_b[0 .. case.d / 32]);
+        }
+    }
+}
