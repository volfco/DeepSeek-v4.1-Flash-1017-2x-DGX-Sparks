 zig/src/core/lanes/depth.zig      | 48 ++++++++++++++++++++++++++++++-
 zig/src/core/lanes/engine.zig     |  1 +
 zig/src/core/lanes/windows.zig    | 20 +++++++++++++
 zig/src/families/dsv41/lanes.zig  | 30 +++++++++++++++++++
 zig/src/families/dsv41/native.zig |  5 ++++
 6 files changed, 115 insertions(+), 1 deletion(-)

