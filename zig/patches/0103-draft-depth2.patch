diff --git a/zig/src/core/lanes/windows.zig b/zig/src/core/lanes/windows.zig
index 0b1a9688..6e6464e9 100644
--- a/zig/src/core/lanes/windows.zig
+++ b/zig/src/core/lanes/windows.zig
@@ -178,6 +178,11 @@ pub fn allocate(e: *Engine, plans: []Plan) !void {
     }
     const overhead = soloHeadOverhead(e.cfg.solo_head_overhead_ms, e.rule.overheadMs(plans.len), e.alone, plans.len, if (plans.len > 0) plans[0].kind else .none);
     const counts = try alloc.allocate(a, fixed, probs, &e.cfg.shared_costs, overhead, @max(plans.len, e.cfg.batch_rows));
+    if (e.rule.pin) |pin| {
+        for (plans, probs, counts) |p, chances, *c| {
+            if (pinnedHead(pin, p.kind, chances.len)) |n| c.* = n;
+        }
+    }
     for (plans, probs, counts, raw) |*p, chances, c, rw| {
         if (p.kind == .head) p.stream.granted = c;
         if (e.cfg.draft_cal > 0.0) p.stream.predict(if (p.kind == .head) rw[0..c] else &.{});
@@ -258,6 +263,21 @@ fn soloHeadOverhead(fixed: ?f64, observed: f64, alone: bool, streams: usize, kin
     if (alone and streams == 1 and kind == .head) return fixed orelse observed;
     return observed;
 }
+
+/// The rows a head plan verifies under a benchmark pin (TF_DS_DRAFT_DEPTH2): the pinned number of its held drafts, never
+/// past them. Null: the allocation decides (every other kind keeps its own rows).
+fn pinnedHead(pin: u32, kind: Kind, chances: usize) ?u32 {
+    if (kind != .head) return null;
+    return @min(pin, @as(u32, @intCast(chances)));
+}
+
+test "a pin takes a head plan to the pinned rows and leaves the others to the allocation" {
+    try std.testing.expectEqual(@as(?u32, 2), pinnedHead(2, .head, 5));
+    try std.testing.expectEqual(@as(?u32, 5), pinnedHead(9, .head, 5)); // never past the drafts the backend holds
+    for ([_]Kind{ .copy, .forced, .fill, .none }) |kind| {
+        try std.testing.expectEqual(@as(?u32, null), pinnedHead(2, kind, 5));
+    }
+}
 test "fixed cost excludes shared, copied, forced and unconfigured windows" {
     try std.testing.expectEqual(@as(f64, 3.5), soloHeadOverhead(3.5, 8.0, true, 1, .head));
     try std.testing.expectEqual(@as(f64, 8.0), soloHeadOverhead(null, 8.0, true, 1, .head));
diff --git a/zig/src/families/dsv41/lanes.zig b/zig/src/families/dsv41/lanes.zig
index b654e3be..c780bea3 100644
--- a/zig/src/families/dsv41/lanes.zig
+++ b/zig/src/families/dsv41/lanes.zig
@@ -396,6 +396,28 @@ pub fn parseCalWeight(text: []const u8) !f64 {
     return v;
 }
 
+/// A benchmark depth toggle: its environment name and the depth it pins (TF_DS_DRAFT_DEPTH2).
+pub const DepthPin = struct { name: [:0]const u8, depth: u32 };
+
+/// The benchmark depth pins, one a patch (0103-0106): at most one may be on.
+pub const depth_pins = [_]DepthPin{
+    .{ .name = "TF_DS_DRAFT_DEPTH2", .depth = 2 },
+};
+
+/// The pin from the toggles' values ("1" on; unset, empty or "0" off), refusing two at once.
+pub fn parseDepthPin(vals: []const ?[]const u8) !?u32 {
+    if (vals.len != depth_pins.len) return error.BadDraftPin;
+    var pin: ?u32 = null;
+    for (depth_pins, vals) |d, v| {
+        const s = v orelse continue;
+        const t = std.mem.trim(u8, s, " ");
+        if (t.len == 0 or std.mem.eql(u8, t, "0")) continue;
+        if (pin != null) return error.BadDraftPin;
+        pin = d.depth;
+    }
+    return pin;
+}
+
 /// A stream's place in the pool and the drafts it holds; TF_DS_KV_SHARD: its planner stream, part and generation
 /// (parts.zig's Live), and whether its first decode round ran (planDecode).
 const Lane = struct {
@@ -500,6 +522,7 @@ pub const Lanes = struct {
     solo_overhead: bool = false, // TF_DS_SOLO_OVERHEAD=1: a lone drafted stream's head windows cost the fixed draft allowance
     draft_cal: f64 = 0.0, // TF_DS_T25_DRAFT_CAL: the weight of a round in each stream's draft-survival calibration (0: off)
     cal_log: u32 = 0, // TF_DS_T25_CAL_LOG: every n-th calibrated verify of a stream prints to stderr (0: off)
+    draft_pin: ?u32 = null, // TF_DS_DRAFT_DEPTH2: a benchmark pin of every head draft's depth (null: the rule decides)
     no_copies: bool = false, // TF_DS_NO_COPIES=1: a drafted stream proposes no suffix-lookup copy windows
     drawn: [ring]u32 = undefined,
     next: u64 = 0,
@@ -571,6 +594,7 @@ pub const Lanes = struct {
             .solo_head_overhead_ms = if (drafting and self.solo_overhead) draft.draft_ms else null, // opt-in: the Python engine's fixed draft allowance
             .draft_cal = self.draft_cal,
             .cal_log = self.cal_log,
+            .draft_pin = self.draft_pin,
             .copy_proposals = !(drafting and self.no_copies), // opt-in: the draft head proposes; the Python engine makes no copies either
             .streams_exact = true,
             .hidden_rows = true,
@@ -2159,6 +2183,12 @@ pub fn followPair(gpa: std.mem.Allocator, m: *Model, spill: ?*SpillFollower, fx:
     }
 }
 
+test "one depth toggle at a time pins the depth" {
+    try std.testing.expectEqual(@as(?u32, null), try parseDepthPin(&[_]?[]const u8{null}));
+    try std.testing.expectEqual(@as(?u32, null), try parseDepthPin(&[_]?[]const u8{"0"}));
+    try std.testing.expectEqual(@as(?u32, 2), try parseDepthPin(&[_]?[]const u8{"1"}));
+}
+
 test "a calibration weight parses to a finite value in 0..1" {
     try std.testing.expectEqual(@as(f64, 0.5), try parseCalWeight(" 0.5 "));
     try std.testing.expectEqual(@as(f64, 1.0), try parseCalWeight("1"));
