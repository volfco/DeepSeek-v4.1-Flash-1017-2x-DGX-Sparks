diff --git a/zig/src/core/lanes/depth.zig b/zig/src/core/lanes/depth.zig
index e3653cfe..1ce2dbdd 100644
--- a/zig/src/core/lanes/depth.zig
+++ b/zig/src/core/lanes/depth.zig
@@ -56,6 +56,7 @@ pub const Rule = struct {
     plain_guard: bool,
     node_probabilities: bool,
     batch_rows: u32,
+    pin: ?u32 = null, // a benchmark pin of every head draft's depth (TF_DS_DRAFT_DEPTH2; null: the rule decides)
     round_ms: Table = .{}, // a round's wall time by drafts, shared by every stream
     overhead: std.ArrayList(Overhead) = .empty, // a shared round's ms past its forward, by streams (insertion order)
 
@@ -72,6 +73,13 @@ pub const Rule = struct {
         return who.state.*.?.p;
     }
 
+    /// A benchmark pin of a stream's head drafts (TF_DS_DRAFT_DEPTH2): the depth clamped by the family's most drafts
+    /// and the stream's room; null: the rule decides.
+    fn pinned(r: *const Rule, who: Who) ?i64 {
+        const n = r.pin orelse return null;
+        return @min(@as(i64, @intCast(n)), @min(@as(i64, r.most_drafts), @max(1, who.draft_room - 1)));
+    }
+
     /// Draft j was tried when drafts 1 .. j - 1 were kept; its estimate moves toward whether it was kept.
     pub fn observeDepth(r: *Rule, who: Who, proposed: i64, accepted: i64) !void {
         const p = try r.rates(who);
@@ -128,6 +136,7 @@ pub const Rule = struct {
     pub fn depth(r: *Rule, who: Who) !i64 {
         const most = @min(@as(i64, r.most_drafts), @max(1, who.draft_room - 1));
         if (most <= 0) return 0;
+        if (r.pinned(who)) |d| return d;
         const p = try r.rates(who);
         if (r.family_costs.empty()) {
             const want: i64 = if (p[0] < 0.8) 1 else if (p[0] < 0.9) 2 else 3;
@@ -169,6 +178,7 @@ pub const Rule = struct {
     /// every later round (no round of the stream is measured yet, and the learned tables are empty after boot: the
     /// first request after boot would otherwise draft shallower than the same request warm).
     pub fn openDepth(r: *Rule, who: Who) !i64 {
+        if (r.pinned(who)) |d| return d;
         if (r.node_probabilities) return @min(@as(i64, r.most_drafts), @max(1, who.draft_room - 1));
         return r.depth(who);
     }
@@ -185,7 +195,7 @@ pub const Rule = struct {
 
     /// Python `_head_depth`: the next round's head drafts for a stream (0 when forced, 1 with a copy ahead).
     pub fn headDepth(r: *Rule, who: *const Who, budget: ?i64, probe: Probe) !i64 {
-        const d: i64 = if (who.finished) 0 else if (budget) |b| b else if (r.node_probabilities)
+        const d: i64 = if (who.finished) 0 else if (r.pinned(who.*)) |p| p else if (budget) |b| b else if (r.node_probabilities)
             @min(@as(i64, r.most_drafts), @max(1, who.draft_room - 1))
         else
             try r.depth(who.*);
@@ -196,6 +206,10 @@ pub const Rule = struct {
 
     /// Head drafts for the streams of a shared round, sized by allocation over their chain chances.
     pub fn budgets(r: *Rule, whos: []Who, probe: Probe, out: []i64) !void {
+        if (r.pin != null) {
+            for (whos, out) |*w, *o| o.* = try r.headDepth(w, null, probe);
+            return;
+        }
         if (r.node_probabilities) {
             for (whos, out) |*w, *o| {
                 const inner = try r.headDepth(w, null, probe);
@@ -303,3 +317,35 @@ test "the first drafts after a prompt take the head's depth with node probabilit
         }
     }
 }
+
+test "a depth pin takes every head draft to the pinned depth" {
+    const gpa = std.testing.allocator;
+    var fc: Table = .{};
+    defer fc.deinit(gpa);
+    const served = [_]f64{ 25.72, 28.72, 31.72, 33.38, 34.29, 35.17 };
+    for (served, 1..) |ms, w| try fc.put(gpa, @intCast(w), ms);
+    const shared: Table = .{};
+    const prior = [_]f64{ 0.5, 0.4, 0.3, 0.2, 0.1 }; // unpinned, this prices depth 1
+    var rule: Rule = .{ .gpa = gpa, .prior = &prior, .most_drafts = 5, .family_costs = &fc, .shared_costs = &shared, .mtp_step_ms = 3.5, .plain_guard = false, .node_probabilities = true, .batch_rows = 16, .pin = 2 };
+    defer rule.deinit();
+    var st: ?State = null;
+    defer if (st) |*s| s.deinit(gpa);
+    const who: Who = .{ .state = &st, .draft_room = 160, .finished = false, .forced = false };
+    try std.testing.expectEqual(@as(i64, 2), try rule.openDepth(who));
+    try std.testing.expectEqual(@as(i64, 2), try rule.headDepth(&who, null, noCopy));
+    var whos = [_]Who{ who, who };
+    var out: [2]i64 = undefined;
+    try rule.budgets(&whos, noCopy, &out);
+    try std.testing.expectEqualSlices(i64, &.{ 2, 2 }, &out);
+    var finished = who;
+    finished.finished = true;
+    try std.testing.expectEqual(@as(i64, 0), try rule.headDepth(&finished, null, noCopy));
+    rule.pin = 9;
+    try std.testing.expectEqual(@as(i64, 5), try rule.openDepth(who)); // clamped by the family's most drafts
+}
+
+const noCopy: Probe = .{ .ptr = undefined, .copy = noCopyFn };
+
+fn noCopyFn(_: *anyopaque, _: *const Who) bool {
+    return false;
+}
