+/// TF_DS_CACHE_METRICS (on; `0` or `off` turns it off): the prompt cache's coarse counters split by cause, and the
+/// resume depth of finished prompt passes, published beside the counters (CacheStats.detail). Read from HTTP threads
+/// as one copy (LaneHost publishes it on its engine thread); counted only while the switch is on.
+pub const CacheDetail = struct {
+    /// Of CacheStats.memory_misses: why the look-up found no usable kept state.
+    misses_no_prefix: u64 = 0,
+    misses_tail_window: u64 = 0,
+    misses_stale: u64 = 0,
+    /// Of CacheStats.refused: why the keep was refused.
+    refused_budget: u64 = 0,
+    refused_restores: u64 = 0,
+    /// Of CacheStats.evicted: which state the store freed first.
+    evicted_superseded: u64 = 0,
+    evicted_lru: u64 = 0,
+    /// Of CacheStats.failed: what failed.
+    failed_save: u64 = 0,
+    failed_restore: u64 = 0,
+    /// The resume depth of finished prompt passes (the histogram's 0/25/50/75/90/99/100 percent buckets).
+    depth: prompt_cache.ResumeDepth = .{},
+
+    /// Each field's /metrics help (a missing one fails the build).
+    pub const help = .{
+        .misses_no_prefix = "Of memory_misses: no kept state's tokens matched the prompt's.",
+        .misses_tail_window = "Of memory_misses: a state matched but the tail, window or grid rules passed it over.",
+        .misses_stale = "Of memory_misses: a state matched but the family staled it.",
+        .refused_budget = "Of refused: the state alone passed the memory budget.",
+        .refused_restores = "Of refused: restores in flight held the budget's rest.",
+        .evicted_superseded = "Of evicted: a state a later prompt extends (its superseded turn).",
+        .evicted_lru = "Of evicted: the least recently used state.",
+        .failed_save = "Of failed: a keep's save failed.",
+        .failed_restore = "Of failed: a restore failed (this pass's resume, or a peer's).",
+    };
+};
