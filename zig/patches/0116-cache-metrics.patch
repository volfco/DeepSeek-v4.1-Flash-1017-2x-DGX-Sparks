+/// Why a look-up found no usable kept state (the misses' split), closest to a hit first: a stale state was a hit but
+/// for the family's rule, a passed-over one but for the tail/window rules, a mismatched one never was.
+pub const MissCause = enum { no_prefix, tail_window, stale };
+
+/// Raises `why` to the miss cause closer to a hit (MissCause's order).
+fn worse(why: *MissCause, c: MissCause) void {
+    if (@intFromEnum(c) > @intFromEnum(why.*)) why.* = c;
+}
