     memory_hits: u64 = 0,
     memory_misses: u64 = 0,
@@ -296,6 +332,11 @@ pub const CacheStats = struct {
     computed_tokens: u64 = 0,
     /// The tier's own counters, each rank's (null: no tier).
     spill: ?prompt_cache.RankCounts = null,
+    /// The coarse counters' causes and the resume depth (TF_DS_CACHE_METRICS; null: `0`).
+    detail: ?CacheDetail = null,
+    /// Whether the cache is wired to the spill tier (or grouping, which a tier turns on): `Spill.unbound` asks this,
+    /// live from LaneHost.configure (before telemetry's first snapshot fills the counters).
+    tier_bound: bool = false,
 
     pub const gauges = [_][]const u8{ "entries", "held_bytes", "restores_active", "restoring_bytes", "restore_blocks_done", "restore_blocks_total", "parked" };
 
@@ -374,7 +415,7 @@ pub const Status = struct {
     streams: usize = 0,
     /// Generated tokens held by live streams, excluding their prompts.
     generation_tokens: u64 = 0,
-    /// The prompt cache's counters, when its tier or grouping is on.
+    /// The prompt cache's counters, when its tier or grouping is on, or TF_DS_CACHE_METRICS is (then regardless of tier).
     cache: ?CacheStats = null,
