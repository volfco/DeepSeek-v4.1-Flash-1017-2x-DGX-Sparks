+/// TF_DS_CACHE_METRICS=0 (or =off) turns the cache's detail counters and resume depth off (on by default, as
+/// TF_DS_ENGRAM_METRICS is).
+pub fn cacheMetricsEnabled(v: ?[]const u8) bool {
+    const value = v orelse return true;
+    return !std.mem.eql(u8, value, "0") and !std.mem.eql(u8, value, "off");
+}
