diff --git a/zig/src/core/energy.zig b/zig/src/core/energy.zig
new file mode 100644
index 0000000..20a6179
--- /dev/null
+++ b/zig/src/core/energy.zig
@@ -0,0 +1,271 @@
+//! TF_DS_ENERGY (off by default): a request's energy from NVML's cumulative counter (millijoules since the driver
+//! started). Off: no driver call, no line. On: the request's own window and the idle window before it, per rank.
+const std = @import("std");
+const builtin = @import("builtin");
+
+/// TF_DS_ENERGY: `1` or `on` turns it on; unset, `0`, `off` or anything else leave it off.
+pub fn enabled(v: ?[]const u8) bool {
+    const value = v orelse return false;
+    return std.mem.eql(u8, value, "1") or std.mem.eql(u8, value, "on");
+}
+
+/// A device's cumulative energy counter: the driver's, or a test's. A driver without the read has no counter, and
+/// every figure is "-" (the switch degrades, nothing fails).
+pub const Counter = struct {
+    ctx: ?*anyopaque = null,
+    read: ?*const fn (ctx: ?*anyopaque) ?u64 = null,
+
+    pub fn millijoules(c: Counter) ?u64 {
+        const f = c.read orelse return null;
+        return f(c.ctx);
+    }
+};
+
+const EnergyFn = *const fn (device: *anyopaque, energy: *u64) callconv(.c) c_int;
+const PowerFn = *const fn (device: *anyopaque, power: *c_uint) callconv(.c) c_int;
+
+/// NVML's entry points. `nvmlInit_v2` and `nvmlDeviceGetHandleByIndex_v2` are required for this reader; the energy
+/// and power reads are optional lookups of their own, so a driver without them still opens (the all-or-nothing table
+/// of `zig/src/cuda/`'s libraries is the trap: one missing symbol must not refuse the whole reader).
+pub const Nvml = struct {
+    lib: std.DynLib,
+    api: Api,
+    device: *anyopaque,
+
+    const Api = struct {
+        init: *const fn () callconv(.c) c_int,
+        handle: *const fn (index: c_uint, device: *?*anyopaque) callconv(.c) c_int,
+        total_energy: ?EnergyFn = null,
+        power: ?PowerFn = null,
+    };
+
+    pub fn open(index: c_uint) error{ LibraryUnavailable, MissingSymbol, NvmlFailed }!Nvml {
+        var lib = std.DynLib.open(if (builtin.os.tag == .macos) "libnvidia-ml.dylib" else "libnvidia-ml.so.1") catch return error.LibraryUnavailable;
+        errdefer lib.close();
+        var api: Api = undefined;
+        api.init = lib.lookup(@TypeOf(api.init), "nvmlInit_v2") orelse return error.MissingSymbol;
+        api.handle = lib.lookup(@TypeOf(api.handle), "nvmlDeviceGetHandleByIndex_v2") orelse return error.MissingSymbol;
+        api.total_energy = lib.lookup(EnergyFn, "nvmlDeviceGetTotalEnergyConsumption");
+        api.power = lib.lookup(PowerFn, "nvmlDeviceGetPowerUsage");
+        if (api.init() != 0) return error.NvmlFailed;
+        var device: ?*anyopaque = null;
+        if (api.handle(index, &device) != 0 or device == null) return error.NvmlFailed;
+        return .{ .lib = lib, .api = api, .device = device.? };
+    }
+
+    /// The device's cumulative millijoules, or null when the driver has no such read.
+    pub fn millijoules(n: Nvml) ?u64 {
+        const f = n.api.total_energy orelse return null;
+        var v: u64 = 0;
+        if (f(n.device, &v) != 0) return null;
+        return v;
+    }
+
+    /// The device's draw in milliwatts, or null: the cross-check's read, optional like the counter.
+    pub fn milliwatts(n: Nvml) ?u32 {
+        const f = n.api.power orelse return null;
+        var v: c_uint = 0;
+        if (f(n.device, &v) != 0) return null;
+        return @intCast(v);
+    }
+};
+
+/// A request's start: the counter then, and the sample the last finished request left (the idle gap's start).
+pub const Window = struct {
+    start_mj: ?u64 = null,
+    start_ns: i96 = 0,
+    prev_mj: ?u64 = null,
+    prev_ns: i96 = 0,
+};
+
+/// A finished request's figures: the counter's rise over its own window, and over an equal idle window before it.
+pub const Readings = struct {
+    gross_mj: ?u64 = null,
+    idle_mj: ?u64 = null,
+};
+
+/// The switch and the driver, one per process: off means no driver call at all, and no allocation.
+pub const Reader = struct {
+    on: bool = false,
+    nvml: ?Nvml = null,
+    /// A test's counter read, in place of the driver's.
+    test_read: ?*const fn (ctx: ?*anyopaque) ?u64 = null,
+    test_ctx: ?*anyopaque = null,
+    prev_mj: ?u64 = null,
+    prev_ns: i96 = 0,
+    mutex: std.Io.Mutex = .init,
+
+    /// Opens the driver when the switch is on; a driver or symbol that is missing leaves every figure "-" (no error).
+    pub fn open(on: bool) Reader {
+        if (!on) return .{};
+        const index = deviceIndex();
+        const n = Nvml.open(index) catch |e| {
+            noteLine("energy: no NVML ({s}) for device {d}; the figures print -", .{ @errorName(e), index });
+            return .{ .on = true };
+        };
+        if (n.millijoules() == null) noteLine("energy: this driver has no nvmlDeviceGetTotalEnergyConsumption; the figures print -", .{});
+        return .{ .on = true, .nvml = n };
+    }
+
+    fn millijoules(r: *const Reader) ?u64 {
+        if (r.test_read) |f| return f(r.test_ctx);
+        const n = r.nvml orelse return null;
+        return n.millijoules();
+    }
+
+    /// The request's start: one counter read (none when the switch is off), and the idle gap's last sample.
+    pub fn begin(r: *Reader, io: std.Io, now: i96) Window {
+        if (!r.on) return .{};
+        const mj = r.millijoules();
+        r.mutex.lockUncancelable(io);
+        defer r.mutex.unlock(io);
+        return .{ .start_mj = mj, .start_ns = now, .prev_mj = r.prev_mj, .prev_ns = r.prev_ns };
+    }
+
+    /// The request's finish: its own window's delta, and the idle baseline over an equal window (the gap before it).
+    pub fn finish(r: *Reader, io: std.Io, w: Window, now: i96) Readings {
+        if (!r.on) return .{};
+        const end = r.millijoules();
+        r.mutex.lockUncancelable(io);
+        defer r.mutex.unlock(io);
+        r.prev_mj = end;
+        r.prev_ns = now;
+        const gross: ?u64 = if (w.start_mj) |s| if (end) |e| e -| s else null else null;
+        return .{ .gross_mj = gross, .idle_mj = idle(w, now) };
+    }
+
+    /// A follower's own line (rank 1 has no server and no done line): the frame ordinal and the counter before that
+    /// frame runs, so the rank-0 done line's ordinals bracket a request exactly. `-` when the driver has no counter.
+    pub fn note(r: *const Reader, step: u64) void {
+        if (!r.on) return;
+        var buf: [24]u8 = undefined;
+        const text = if (r.millijoules()) |mj| std.fmt.bufPrint(&buf, "{d}", .{mj}) catch "-" else "-";
+        noteLine("energy step={d} mj={s}", .{ step, text });
+    }
+};
+
+/// The idle window's counter delta scaled to the request's own length: the rise over the gap between the last
+/// finished request and this one's start. Null when there is no such gap, or it is shorter than the request (then a
+/// request ran in it, so it was not idle). A previous sample stands in for a sampling thread: no integration.
+fn idle(w: Window, now: i96) ?u64 {
+    const s = w.start_mj orelse return null;
+    const p = w.prev_mj orelse return null;
+    const gap = w.start_ns - w.prev_ns;
+    const window = now - w.start_ns;
+    if (gap <= 0 or gap < window or s < p) return null;
+    return (s - p) * @as(u64, @intCast(window)) / @as(u64, @intCast(gap));
+}
+
+/// The done line's added fields (switch on only): the request's own energy, the idle baseline, and the wire ordinals
+/// the rank-1 follower's line is joined by. They come after every existing field, so the old line's parsers still
+/// match (`tools/zig/reuse_served.py`).
+pub fn suffix(buf: []u8, r: Readings, from: ?u64, to: ?u64) []const u8 {
+    var g: [24]u8 = undefined;
+    var i: [24]u8 = undefined;
+    var f: [24]u8 = undefined;
+    var t: [24]u8 = undefined;
+    return std.fmt.bufPrint(buf, " energy_j={s} idle_j={s} round_from={s} round_to={s}", .{ joules(&g, r.gross_mj), joules(&i, r.idle_mj), count(&f, from), count(&t, to) }) catch
+        " energy_j=- idle_j=- round_from=- round_to=-";
+}
+
+/// Millijoules as joules with three decimals ("-": no counter).
+fn joules(buf: []u8, mj: ?u64) []const u8 {
+    const v = mj orelse return "-";
+    return std.fmt.bufPrint(buf, "{d}.{d:0>3}", .{ v / 1000, v % 1000 }) catch "-";
+}
+
+fn count(buf: []u8, v: ?u64) []const u8 {
+    return std.fmt.bufPrint(buf, "{d}", .{v orelse return "-"}) catch "-";
+}
+
+/// The device this process's GPU is: TF_CUDA_DEVICE's ordinal, else 0 (each rank of the pair has one GPU).
+fn deviceIndex() c_uint {
+    const v = std.mem.span(std.c.getenv("TF_CUDA_DEVICE") orelse return 0);
+    return std.fmt.parseInt(c_uint, std.mem.trim(u8, v, " "), 10) catch 0;
+}
+
+/// A line on the engine's log; tests stay quiet (the build runner fails a test that writes to stderr).
+fn noteLine(comptime fmt: []const u8, args: anytype) void {
+    if (builtin.is_test) return;
+    std.log.info(fmt, args);
+}
+
+test "TF_DS_ENERGY: 1 and on turn it on, everything else leaves it off" {
+    try std.testing.expect(enabled("1"));
+    try std.testing.expect(enabled("on"));
+    try std.testing.expect(!enabled(null));
+    try std.testing.expect(!enabled("0"));
+    try std.testing.expect(!enabled("off"));
+    try std.testing.expect(!enabled(""));
+    try std.testing.expect(!enabled("yes"));
+}
+
+const Fake = struct { mj: u64 = 0, calls: u64 = 0 };
+
+fn fakeRead(ctx: ?*anyopaque) ?u64 {
+    const f: *Fake = @ptrCast(@alignCast(ctx.?));
+    f.calls += 1;
+    return f.mj;
+}
+
+test "the off path reads no counter and allocates nothing" {
+    var f: Fake = .{ .mj = 5000 };
+    var r: Reader = .{ .test_read = fakeRead, .test_ctx = &f };
+    try std.testing.expect(!r.on);
+    const w = r.begin(std.testing.io, 1_000);
+    const got = r.finish(std.testing.io, w, 2_000);
+    try std.testing.expectEqual(@as(u64, 0), f.calls); // no driver call at all
+    try std.testing.expectEqual(@as(?u64, null), got.gross_mj);
+    try std.testing.expectEqual(@as(?u64, null), got.idle_mj);
+}
+
+test "a request's delta and the equal idle window before it, labelled apart" {
+    var f: Fake = .{ .mj = 1_000_000 };
+    var r: Reader = .{ .on = true, .test_read = fakeRead, .test_ctx = &f };
+    const s: i96 = std.time.ns_per_s;
+    // a first request: its own window only (no finished request to measure an idle gap from)
+    const w0 = r.begin(std.testing.io, 100 * s);
+    f.mj = 1_000_200;
+    const first = r.finish(std.testing.io, w0, 102 * s);
+    try std.testing.expectEqual(@as(?u64, 200), first.gross_mj);
+    try std.testing.expectEqual(@as(?u64, null), first.idle_mj);
+    // the next one, after a 5 s idle gap that rose 50 mJ: the equal 2 s window is 20 mJ
+    f.mj = 1_000_250;
+    const w1 = r.begin(std.testing.io, 107 * s);
+    f.mj = 1_000_400;
+    const second = r.finish(std.testing.io, w1, 109 * s);
+    try std.testing.expectEqual(@as(?u64, 150), second.gross_mj);
+    try std.testing.expectEqual(@as(?u64, 20), second.idle_mj);
+    var buf: [96]u8 = undefined;
+    try std.testing.expectEqualStrings(" energy_j=0.150 idle_j=0.020 round_from=41 round_to=97", suffix(&buf, second, 41, 97));
+    try std.testing.expectEqualStrings(" energy_j=0.200 idle_j=- round_from=- round_to=-", suffix(&buf, first, null, null));
+}
+
+test "a gap shorter than the request is no idle window" {
+    var f: Fake = .{ .mj = 0 };
+    var r: Reader = .{ .on = true, .test_read = fakeRead, .test_ctx = &f };
+    const s: i96 = std.time.ns_per_s;
+    _ = r.begin(std.testing.io, 0);
+    f.mj = 100;
+    _ = r.finish(std.testing.io, .{ .start_mj = 0, .start_ns = 0 }, 10 * s); // prev at 10 s
+    f.mj = 200;
+    const w = r.begin(std.testing.io, 12 * s); // a 2 s gap
+    f.mj = 400;
+    const got = r.finish(std.testing.io, w, 22 * s); // a 10 s request: the gap does not cover it
+    try std.testing.expectEqual(@as(?u64, 200), got.gross_mj);
+    try std.testing.expectEqual(@as(?u64, null), got.idle_mj);
+}
+
+test "a driver without the energy read degrades to - and still opens" {
+    // this host has no libnvidia-ml at all: the switch is on, the counter is absent, nothing fails
+    const r = Reader.open(true);
+    try std.testing.expect(r.on);
+    try std.testing.expectEqual(@as(?u64, null), r.millijoules());
+    var buf: [96]u8 = undefined;
+    try std.testing.expectEqualStrings(" energy_j=- idle_j=- round_from=- round_to=-", suffix(&buf, .{}, null, null));
+    try std.testing.expectEqual(@as(?u64, null), (Counter{}).millijoules());
+    // an absent optional symbol is a null entry, never an error: the Api's other fields still open
+    const api: Nvml.Api = .{ .init = undefined, .handle = undefined };
+    try std.testing.expectEqual(@as(?EnergyFn, null), api.total_energy);
+    try std.testing.expectEqual(@as(?PowerFn, null), api.power);
+}
