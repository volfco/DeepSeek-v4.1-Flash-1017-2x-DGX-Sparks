diff --git a/zig/src/families/dsv41/lanes.zig b/zig/src/families/dsv41/lanes.zig
index 423d12d..0b0f367 100644
--- a/zig/src/families/dsv41/lanes.zig
+++ b/zig/src/families/dsv41/lanes.zig
@@ -581,9 +581,16 @@ pub const Lanes = struct {
             .draft = draftFn,
             .probabilities = probabilitiesFn,
             .release = releaseFn,
+            .ordinal = ordinalFn,
         } };
     }
 
+    /// The wire's frame ordinal: the frame rank 0 last sent. Rank 1 checks each frame's step (`error.OutOfStep`), so
+    /// both sides count the same ordinals, and a request's window joins the follower's per-frame counter exactly.
+    fn ordinalFn(ptr: *anyopaque) u64 {
+        return of(ptr).step;
+    }
+
     /// The facts the round loop reads: windows of the pending row and up to the drafter's block, several streams'
