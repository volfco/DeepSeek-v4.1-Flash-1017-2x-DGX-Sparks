         var seed: [4]u8 = undefined;
         io.random(&seed);
         store_v.setTier(ln.spill.?.tier(), std.mem.readInt(u32, &seed, .little));
diff --git a/zig/src/families/dsv41/native.zig b/zig/src/families/dsv41/native.zig
index 6ba59539..f5cdda2f 100644
--- a/zig/src/families/dsv41/native.zig
+++ b/zig/src/families/dsv41/native.zig
@@ -493,10 +493,11 @@ pub fn rankExchange(gpa: std.mem.Allocator, io: std.Io, mo: model.Options, m: *m
     const envp = try rank_identity.Extra.envFor(getenvFn, s != null);
     var fbuf: [256]u8 = undefined;
     const image_cache = spill_tier.Settings.imageCache(getenv("TF_DS_IMAGE_CACHE"));
+    const edit_mark = api.prompt_cache.editMark(getenv("TF_DS_EDIT_MARK")); // (the marks gate: the fingerprint's reading)
     // TF_DS_KV_SHARD's switches every rank's planner takes (carry, twins) and its part size: agreed in `features`
     const kvs: kv_lanes.Settings = if (m.kvs != null) try kv_lanes.Settings.fromEnv(getenvFn) else .{ .carry = false, .twins = false };
     const part_rows: u64 = if (m.caches.shard) |x| x.part else 0;
-    const features = try rank_identity.featureString(&fbuf, .{ .spill = s != null, .spill_min_tokens = if (s) |x| x.min_tokens else 0, .kv_shard = m.kvs != null, .kv_carry = kvs.carry, .twins = kvs.twins, .part_rows = part_rows, .image_cache = image_cache, .streams = @intCast(m.streams), .round_rows = @intCast(m.eng.round_rows), .pool = m.pool_cap, .drafts = m.drafting() });
+    const features = try rank_identity.featureString(&fbuf, .{ .spill = s != null, .spill_min_tokens = if (s) |x| x.min_tokens else 0, .kv_shard = m.kvs != null, .kv_carry = kvs.carry, .twins = kvs.twins, .part_rows = part_rows, .image_cache = image_cache, .edit_mark = edit_mark, .streams = @intCast(m.streams), .round_rows = @intCast(m.eng.round_rows), .pool = m.pool_cap, .drafts = m.drafting() });
     var pbuf: [model.Model.spill.StateLayout.max_encoded]u8 = undefined;
     const lp = try rank_identity.layoutPart(layout, m.world, &pbuf);
     var arena = std.heap.ArenaAllocator.init(gpa);
diff --git a/zig/src/families/dsv41/rank_identity.zig b/zig/src/families/dsv41/rank_identity.zig
index 38ed2c2c..4f95e637 100644
--- a/zig/src/families/dsv41/rank_identity.zig
+++ b/zig/src/families/dsv41/rank_identity.zig
@@ -130,22 +130,24 @@ pub const Features = struct {
     part_rows: u64 = 0, // TF_DS_KV_SHARD: positions a part (the pool / world)
     engram_lanes: u8 = 1,
     image_cache: bool = true,
+    edit_mark: bool = false, // TF_DS_EDIT_MARK (named in the string only when on)
     streams: u32,
     round_rows: u32,
     pool: u64,
     drafts: bool,
 };
 
-/// TF_DS_KV_SHARD adds "part=N;" (the part size: the owner layout's, also in the planes field); off, the bytes are
-/// what they always were.
+/// TF_DS_KV_SHARD adds "part=N;" (the part size: the owner layout's, also in the planes field) and TF_DS_EDIT_MARK=1
+/// "edit_mark=1;"; with neither on, the bytes are what they always were.
 pub fn featureString(buf: []u8, f: Features) ![]const u8 {
     const head = try std.fmt.bufPrint(buf, "spill={d};spill_min={d};kv_shard={d};kv_carry={d};twins={d};engram_lanes={d};image_cache={d};streams={d};round_rows={d};pool={d};drafts={d};", .{
         @intFromBool(f.spill), f.spill_min_tokens, @intFromBool(f.kv_shard), @intFromBool(f.kv_carry), @intFromBool(f.twins),
         f.engram_lanes, @intFromBool(f.image_cache), f.streams, f.round_rows, f.pool, @intFromBool(f.drafts),
     });
-    if (!f.kv_shard) return head;
-    const tail = try std.fmt.bufPrint(buf[head.len..], "part={d};", .{f.part_rows});
-    return buf[0 .. head.len + tail.len];
+    var n = head.len;
+    if (f.kv_shard) n += (try std.fmt.bufPrint(buf[n..], "part={d};", .{f.part_rows})).len;
+    if (f.edit_mark) n += (try std.fmt.bufPrint(buf[n..], "edit_mark=1;", .{})).len; // named only when on: a mismatch with an off peer is a hello refusal
+    return buf[0..n];
 }
 
 /// The split of every rank (prompt2d.split's rule: world 2 is plain TP2; world 4 is two TP2 pairs).
@@ -603,6 +605,12 @@ test "the features: off as they always were; TF_DS_KV_SHARD adds its switches an
     try testing.expectEqualStrings("spill=1;spill_min=8192;kv_shard=1;kv_carry=1;twins=0;engram_lanes=1;image_cache=1;streams=8;round_rows=16;pool=2101248;drafts=1;part=1050624;", on);
 }
 
+test "TF_DS_EDIT_MARK is named in the features only when on (an off pair's string is unchanged)" {
+    var b: [256]u8 = undefined;
+    const edit = try featureString(&b, .{ .spill = true, .spill_min_tokens = 8192, .edit_mark = true, .streams = 8, .round_rows = 16, .pool = 1 << 20, .drafts = true });
+    try testing.expectEqualStrings("spill=1;spill_min=8192;kv_shard=0;kv_carry=0;twins=0;engram_lanes=1;image_cache=1;streams=8;round_rows=16;pool=1048576;drafts=1;edit_mark=1;", edit);
+}
+
 test "TF_DS_KV_SHARD alone: a missing recipe identity reads unset, never a refusal; with the spill tier it is refused" {
     const e = try Extra.envFor(noEnv, false);
     try testing.expectEqualStrings("unset", e.engine_id);
