         e.* = .{ .tokens = tokens, .at = at, .saved = saved, .bytes = charged, .born = @intCast(prompt.len), .used = s.clock, .last = last, .shared = shared, .group = info.group, .images = info.images, .lineage = lin };
+        if (shared) if (s.family.vtable.share) |f| f(s.family.ptr, saved); // kept shared: the family's copy marked
         s.entries.append(s.gpa, e) catch {
             s.free(e);
             return s.fail(at, error.OutOfMemory);
@@ -1113,14 +1136,27 @@ pub const Store = struct {
         return false;
     }
 
+    /// Whether a superseder (a later entry's, or the keeping pass's `group` and `lineage`) continues `e`'s own
+    /// conversation, so `e` has moved on. With keep_protect (TF_DS_KEEP_PROTECT=1): the groups when both carry a
+    /// conversation, else the lineage link when both carry one (a descendant of `e`'s lineage qualifies); where
+    /// neither link identifies the relation it counts as before (protection is never claimed on guesswork).
+    fn related(s: *const Store, e: *const Entry, group: u64, lineage: []const Fork) bool {
+        if (!s.rules.keep_protect) return true;
+        if (e.group != 0 and group != 0) return e.group == group;
+        if (e.lineage.len > 0 and lineage.len > 0) return for (e.lineage, 0..) |f, i| {
+            if (i >= lineage.len or lineage[i].name != f.name or lineage[i].at != f.at) break false;
+        } else true;
+        return true;
+    }
+
     /// The entry to free first, never `skip` (a pass's resume): one a later prompt extends (never a shared cut), oldest first; else the oldest.
-    fn victimBut(s: *const Store, skip: ?*Entry, prompt: []const u32) ?usize {
+    fn victimBut(s: *const Store, skip: ?*Entry, prompt: []const u32, group: u64, lineage: []const Fork) ?usize {
         var best: ?usize = null;
         for (s.entries.items, 0..) |e, i| {
             if (e.shared or e == skip) continue; // a shared cut is evicted only as the least recently used
-            const now = prompt.len > e.born and prompt.len > e.tokens.len and std.mem.eql(u32, prompt[0..e.tokens.len], e.tokens); // this prompt extends it
+            const now = prompt.len > e.born and prompt.len > e.tokens.len and std.mem.eql(u32, prompt[0..e.tokens.len], e.tokens) and s.related(e, group, lineage); // this prompt extends it
             const moved_on = now or for (s.entries.items) |o| {
-                if (o != e and o.born > e.born and o.tokens.len > e.tokens.len and std.mem.eql(u32, o.tokens[0..e.tokens.len], e.tokens)) break true;
+                if (o != e and o.born > e.born and o.tokens.len > e.tokens.len and std.mem.eql(u32, o.tokens[0..e.tokens.len], e.tokens) and s.related(e, o.group, o.lineage)) break true;
             } else false;
             if (moved_on and (best == null or e.used < s.entries.items[best.?].used)) best = i;
         }
diff --git a/zig/src/core/prompt_cache_test.zig b/zig/src/core/prompt_cache_test.zig
index b80cf8ce..0cd6ac7b 100644
--- a/zig/src/core/prompt_cache_test.zig
+++ b/zig/src/core/prompt_cache_test.zig
@@ -262,6 +262,100 @@ test "eviction frees a conversation's superseded state first, then the oldest; a
     try std.testing.expectEqual(s.entries.items.len, f.live);
 }
 
+/// Keep `prompt`'s state at `at` with its conversation and lineage, as a pass would (the family stands at `at`).
+fn keepAs(s: *Store, f: *Fake, prompt: []const u32, at: u32, info: pc.KeepInfo) bool {
+    f.at = at;
+    return s.keepWith(prompt, at, null, &.{}, info);
+}
+
+/// Whether the store still holds `e`.
+fn holds(s: *Store, e: *pc.Entry) bool {
+    return std.mem.indexOfScalar(*pc.Entry, s.entries.items, e) != null;
+}
+
+test "TF_DS_KEEP_PROTECT=1: a branch point's own conversation moving on frees it first" {
+    const gpa = std.testing.allocator;
+    var f: Fake = .{ .gpa = gpa };
+    var s = Store.init(gpa, f.snapshots(), .{ .min_prompt = 0, .keep_protect = true }, 215); // fake bytes: 100 + at
+    defer s.deinit();
+    const p = [_]u32{ 1, 2, 3, 4, 9 };
+    try std.testing.expect(keepAs(&s, &f, &p, 4, .{ .group = 1 })); // 104
+    const turn = [_]u32{ 1, 2, 3, 4, 5, 5, 9 };
+    try std.testing.expect(keepAs(&s, &f, &turn, 6, .{ .group = 1 })); // 106: its own conversation's next turn
+    const parent, const grown = .{ s.entries.items[0], s.entries.items[1] };
+    parent.used = 100; // the branch point is the most recently used: only its own turn supersedes it
+    const x = [_]u32{ 8, 8, 8, 8, 8 };
+    try std.testing.expect(keepAs(&s, &f, &x, 5, .{})); // 105: room for one eviction only
+    try std.testing.expectEqual(@as(u64, 1), s.counts.evicted);
+    try std.testing.expect(!holds(&s, parent)); // its own turn supersedes it: first to free
+    try std.testing.expect(holds(&s, grown));
+}
+
+test "TF_DS_KEEP_PROTECT=1: a cross-conversation fork's longer state leaves its branch point alone" {
+    const gpa = std.testing.allocator;
+    var f: Fake = .{ .gpa = gpa };
+    var s = Store.init(gpa, f.snapshots(), .{ .min_prompt = 0, .keep_protect = true }, 215);
+    defer s.deinit();
+    const p = [_]u32{ 1, 2, 3, 4, 9 };
+    try std.testing.expect(keepAs(&s, &f, &p, 4, .{ .group = 1 })); // 104
+    const fork = [_]u32{ 1, 2, 3, 4, 7, 7, 9 };
+    try std.testing.expect(keepAs(&s, &f, &fork, 6, .{ .group = 2 })); // 106: another conversation's fork
+    const parent, const forker = .{ s.entries.items[0], s.entries.items[1] };
+    parent.used = 100; // the branch point is the most recently used: the fork does not supersede it
+    const x = [_]u32{ 8, 8, 8, 8, 8 };
+    try std.testing.expect(keepAs(&s, &f, &x, 5, .{})); // 105: room for one eviction only
+    try std.testing.expectEqual(@as(u64, 1), s.counts.evicted);
+    try std.testing.expect(holds(&s, parent)); // the fork goes as the least recently used
+    try std.testing.expect(!holds(&s, forker));
+    parent.used = 0; // and the plain least-recently-used path takes the branch point later
+    const y = [_]u32{ 6, 6, 6, 6, 6 };
+    try std.testing.expect(keepAs(&s, &f, &y, 4, .{}));
+    try std.testing.expect(!holds(&s, parent));
+}
+
+test "TF_DS_KEEP_PROTECT unset: any longer descendant makes its parent the first victim" {
+    const gpa = std.testing.allocator;
+    var f: Fake = .{ .gpa = gpa };
+    var s = Store.init(gpa, f.snapshots(), .{ .min_prompt = 0 }, 215);
+    defer s.deinit();
+    const p = [_]u32{ 1, 2, 3, 4, 9 };
+    try std.testing.expect(keepAs(&s, &f, &p, 4, .{ .group = 1 })); // 104
+    const fork = [_]u32{ 1, 2, 3, 4, 7, 7, 9 };
+    try std.testing.expect(keepAs(&s, &f, &fork, 6, .{ .group = 2 })); // 106
+    const parent, const forker = .{ s.entries.items[0], s.entries.items[1] };
+    parent.used = 100; // most recently used, and still the first victim: the fork counts as superseding
+    const x = [_]u32{ 8, 8, 8, 8, 8 };
+    try std.testing.expect(keepAs(&s, &f, &x, 5, .{})); // 105: room for one eviction only
+    try std.testing.expectEqual(@as(u64, 1), s.counts.evicted);
+    try std.testing.expect(!holds(&s, parent));
+    try std.testing.expect(holds(&s, forker));
+}
+
+test "TF_DS_KEEP_PROTECT=1: the lineage link supersedes within one computation, and claims nothing without one" {
+    const gpa = std.testing.allocator;
+    const p = [_]u32{ 1, 2, 3, 4, 9 };
+    const x = [_]u32{ 8, 8, 8, 8, 8 };
+    const cases = [_]struct { lin: []const pc.Fork, other: []const pc.Fork, parent_goes: bool }{
+        .{ .lin = &.{.{ .name = 1, .at = 0 }}, .other = &.{.{ .name = 9, .at = 0 }}, .parent_goes = false }, // a fresh prefill: not its lineage
+        .{ .lin = &.{.{ .name = 1, .at = 0 }}, .other = &.{ .{ .name = 1, .at = 0 }, .{ .name = 2, .at = 4 } }, .parent_goes = true }, // a descendant qualifies
+        .{ .lin = &.{}, .other = &.{}, .parent_goes = true }, // neither link identifies the relation: base behaviour
+    };
+    for (cases) |k| {
+        var f: Fake = .{ .gpa = gpa };
+        var s = Store.init(gpa, f.snapshots(), .{ .min_prompt = 0, .keep_protect = true }, 215);
+        defer s.deinit();
+        try std.testing.expect(keepAs(&s, &f, &p, 4, .{ .lineage = k.lin })); // 104
+        const long = [_]u32{ 1, 2, 3, 4, 7, 7, 9 };
+        try std.testing.expect(keepAs(&s, &f, &long, 6, .{ .lineage = k.other })); // 106, longer, born later
+        const parent, const longer = .{ s.entries.items[0], s.entries.items[1] };
+        parent.used = 100;
+        try std.testing.expect(keepAs(&s, &f, &x, 5, .{})); // 105: room for one eviction only
+        try std.testing.expectEqual(@as(u64, 1), s.counts.evicted);
+        try std.testing.expectEqual(k.parent_goes, !holds(&s, parent));
+        try std.testing.expectEqual(!k.parent_goes, !holds(&s, longer));
+    }
+}
+
 test "a failed copy keeps nothing and a failed restore prefills from the start" {
     const gpa = std.testing.allocator;
     var arena: std.heap.ArenaAllocator = .init(gpa);
