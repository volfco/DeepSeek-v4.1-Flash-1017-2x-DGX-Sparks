+/// TF_DS_KEEP_PROTECT's one reading (the prompt cache's eviction and dsv41's placement alike): on only when it is
+/// exactly "1".
+pub fn keepProtect(v: ?[]const u8) bool {
+    return std.mem.eql(u8, v orelse return false, "1");
+}
+
+test keepProtect {
+    try std.testing.expect(!keepProtect(null) and !keepProtect("0") and !keepProtect(""));
+    try std.testing.expect(keepProtect("1"));
+    try std.testing.expect(!keepProtect(" 1") and !keepProtect("1 ")); // (exact, as imageCacheOn reads "0")
+}
