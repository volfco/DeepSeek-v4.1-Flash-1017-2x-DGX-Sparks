 }
 
+test "a restored shared state's family copy is marked shared at adopt (placeKept's victim order)" {
+    var f: Sum = .{};
+    var tier: FakeTier = .{ .gpa = gpa, .codec = f.codec() };
+    defer tier.deinit();
+    var s = Store.init(gpa, f.snapshots(), .{ .min_prompt = 0 }, 1 << 20);
+    defer s.deinit();
+    s.setTier(tier.tier(), 0);
+    const a = seq(40, 1);
+    _ = try tier.put(a[0..16], 16, std.mem.asBytes(&Sum.State{ .at = 16, .sum = Sum.fresh(&a, 16) }), 0, 3, true); // a shared point on disk
+    const p = s.probe(&a, &.{}).durable.?;
+    try std.testing.expect(p.shared);
+    try std.testing.expectEqual(pc.Restored.adopted, settle(&s, try s.restoreBegin(p, &a)));
+    try std.testing.expect(s.entries.items[0].shared and s.entries.items[0].restored);
+    try std.testing.expectEqual(@as(usize, 1), f.shared_marks); // the share hook fired: the family's copy is marked too
+}
+
 test "without a tier the store asks nothing and counts nothing new" {
     var f: Sum = .{};
     var s = Store.init(gpa, f.snapshots(), .{ .min_prompt = 0 }, 1 << 20);
