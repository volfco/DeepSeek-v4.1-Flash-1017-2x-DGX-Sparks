 }
 
+/// TF_DS_ENGRAM_POOL=<n>: the Engram read pool's size (the pread path when the AIO ring is off); unset, unparsable or
+/// outside 1 .. 256 reads 64, as before. The bytes are the same either way.
+pub fn poolThreads(v: ?[]const u8) usize {
+    const n = std.fmt.parseInt(u32, v orelse return 64, 10) catch return 64;
+    if (n < 1 or n > 256) return 64;
+    return n;
+}
+
 /// TF_DS_ENGRAM_FAST's hash cache: forget the chunk `hashes` holds (a round's engramAhead wrote it, or a new pass started).
 pub fn forgetHashes(eh: *EngramHost) void {
