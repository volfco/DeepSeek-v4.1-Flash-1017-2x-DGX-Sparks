+
+/// Each of the two float4 loads must be aligned for every row, including a score view.
+pub fn candMask8Ok(score: u64, stride: usize, bsize: usize) bool {
+    return bsize == 8 and score % 16 == 0 and stride % 4 == 0;
+}
+
+test "eight-score candidate mask requires aligned rows" {
+    try std.testing.expect(candMask8Ok(0x1000, 2048, 8));
+    try std.testing.expect(!candMask8Ok(0x1004, 2048, 8));
+    try std.testing.expect(!candMask8Ok(0x1000, 2049, 8));
+    try std.testing.expect(!candMask8Ok(0x1000, 2048, 4));
 }
 
