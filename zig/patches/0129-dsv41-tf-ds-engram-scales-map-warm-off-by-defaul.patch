@@ -131,6 +131,34 @@ pub const Tables = struct {
         return m[@intCast(base - lo)..][0..@intCast(rows * row)];
     }
 
+    /// TF_DS_ENGRAM_SCALES=map-warm: a detached thread walks each scale mapping in ~64 MiB pieces with
+    /// madvise(MADV_WILLNEED), so the pages come in on the walk instead of on the first row read. Detached: model open
+    /// does not wait. Only madvise is issued, never a read, so a walk that outlives `close`'s munmap just gets ENOMEM;
+    /// the copy of the slice list is the thread's, so `close` freeing `maps` cannot leave it dangling. Non-Linux: no walk.
+    pub fn warmScales(t: *const Tables) void {
+        if (comptime builtin.os.tag != .linux) return;
+        if (t.maps.items.len == 0) return;
+        const maps = t.gpa.alloc([]align(std.heap.page_size_min) const u8, t.maps.items.len) catch return;
+        @memcpy(maps, t.maps.items);
+        const th = std.Thread.spawn(.{}, warmWalk, .{ t.gpa, maps }) catch {
+            t.gpa.free(maps);
+            return;
+        };
+        th.detach();
+    }
+
+    fn warmWalk(gpa: std.mem.Allocator, maps: []const []align(std.heap.page_size_min) const u8) void {
+        defer gpa.free(maps);
+        for (maps) |m| {
+            var at: usize = 0;
+            while (at < m.len) {
+                const n = @min(m.len - at, 64 << 20);
+                _ = std.os.linux.madvise(@constCast(m.ptr) + at, n, std.os.linux.MADV.WILLNEED);
+                at += n;
+            }
+        }
+    }
+
     pub fn close(t: *Tables) void {
         for (t.maps.items) |m| std.posix.munmap(m);
         t.maps.deinit(t.gpa);
