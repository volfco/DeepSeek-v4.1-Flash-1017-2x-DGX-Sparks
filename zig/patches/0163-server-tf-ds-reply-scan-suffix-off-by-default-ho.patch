+test "TF_DS_REPLY_SCAN_SUFFIX: the resumed scans equal the full scans at every streamed prefix" {
+    var arena: std.heap.ArenaAllocator = .init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const gpa = std.testing.allocator;
+    const close = think_markers.close;
+    const opener = calls[3][0];
+    const seeds: [4][]const u8 = .{
+        try std.mem.concat(a, u8, &.{ think_open, "\nPlan.\n", close, "\n\nDone." }),
+        try std.mem.concat(a, u8, &.{ "plan", close, "\n\nHi" }),
+        try std.mem.concat(a, u8, &.{ "step by step ", opener, "{\"x\": 1} tail" }),
+        try std.mem.concat(a, u8, &.{ channel_markers.open, " hi ", channel_markers.close, " out" }),
+    };
+    for (seeds) |seed| {
+        // one append-only buffer: the streaming case (the base stands, the text grows)
+        var sr: Stops.Resume = .{};
+        var pr: SplitResume = .{};
+        for (1..seed.len + 1) |n| {
+            const text = seed[0..n];
+            const stops: Stops = .{ .strings = &.{ "ND", "zz", "tail" } };
+            try std.testing.expectEqualStrings(stops.visible(text, true), stops.visibleR(text, true, &sr));
+            const full = try splitThinking(a, text, false, think_markers);
+            const resumed = try splitThinkingR(a, text, false, think_markers, &pr);
+            try std.testing.expectEqualStrings(full.reasoning, resumed.reasoning);
+            try std.testing.expectEqualStrings(full.answer, resumed.answer);
+            const fullc = try splitThinking(a, text, false, channel_markers);
+            const resumedc = try splitThinkingR(a, text, false, channel_markers, &pr);
+            try std.testing.expectEqualStrings(fullc.reasoning, resumedc.reasoning);
