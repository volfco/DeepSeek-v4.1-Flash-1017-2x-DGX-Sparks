+/// 0167 (TF_DS_REPLY_SCAN_SUFFIX): ``findTag(text, 0, tag)`` over a reply's append-only text with a resume: a miss
+/// remembers how far it searched (the next call re-checks only the overlap where the tag could straddle the old end)
+/// and a hit remembers its offset (the first hit on append-only text stays the first). A text whose base moved or
+/// shrank restarts the search, so every call still returns findTag's own answer; an empty tag finds at 0 as it does.
+pub const FirstFind = struct {
+    base: ?[*]const u8 = null,
+    scanned: usize = 0,
+    at: ?usize = null,
+
+    pub fn find(f: *FirstFind, text: []const u8, tag: []const u8) ?usize {
+        if (tag.len == 0) return find(text, tag);
+        if (f.base) |b| {
+            if (b != text.ptr or text.len < f.scanned) f.* = .{};
+        }
+        f.base = text.ptr;
+        if (f.at) |at| return at;
+        const from = f.scanned -| (tag.len - 1);
+        const hit = findTag(text, from, tag);
+        f.scanned = text.len;
+        if (hit) |at| f.at = at;
+        return hit;
+    }
+};
+
+/// 0167: the resumed find when there is one, else the full find (the switch's two paths).
+fn findR(r: ?*FirstFind, text: []const u8, tag: []const u8) ?usize {
+    return if (r) |f| f.find(text, tag) else find(text, tag);
+}
