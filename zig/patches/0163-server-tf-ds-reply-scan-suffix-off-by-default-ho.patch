+test "TF_DS_REPLY_SCAN_SUFFIX: FirstFind returns find's own answer through misses, straddles and a moved base" {
+    const tag = think_markers.close;
+    var f: FirstFind = .{};
+    // growing text, the tag straddling the scanned end: same answer as find at every prefix
+    var buf: std.ArrayList(u8) = .empty;
+    defer buf.deinit(std.testing.allocator);
+    try buf.appendSlice(std.testing.allocator, "nothing ");
+    try std.testing.expectEqual(find(buf.items, tag), f.find(buf.items, tag));
+    try buf.appendSlice(std.testing.allocator, tag[0 .. tag.len / 2]);
+    try std.testing.expectEqual(find(buf.items, tag), f.find(buf.items, tag));
+    try buf.appendSlice(std.testing.allocator, tag[tag.len / 2 ..]);
+    try std.testing.expectEqual(find(buf.items, tag), f.find(buf.items, tag));
+    try buf.appendSlice(std.testing.allocator, " tail");
+    try std.testing.expectEqual(find(buf.items, tag), f.find(buf.items, tag));
+    // a moved base (a fresh copy) restarts: the same answer
+    const copy = try std.testing.allocator.dupe(u8, buf.items);
+    defer std.testing.allocator.free(copy);
+    try std.testing.expectEqual(find(copy, tag), f.find(copy, tag));
+    // the empty tag finds at 0 as find does
+    try std.testing.expectEqual(find(copy, ""), f.find(copy, ""));
+}
