+    defer free(plain);
+    const empty = try run(&.{.{ .prompt = &.{ 1, 2, 3, 4, 5 }, .max_new = 6, .drafts = false, .score = &.{} }});
+    defer free(empty);
+    try std.testing.expectEqualSlices(u32, plain[0], empty[0]);
+}
