+/// ``probability_options`` refuses any other).
+pub fn scoreIds(cx: *Cx, body: Value, completions: bool, on: bool, engine: bool, stream: bool, temperature: f64, vocab: u32) errors.Refused!?[]const u32 {
+    const field = body.field("tensorfold_score") orelse return null;
+    if (!completions) return cx.refuse("tensorfold_score is only on /v1/completions");
+    if (!on) return cx.refuse("tensorfold_score needs TF_DS_SCORE=1 on the server (rank 0)");
+    if (!engine) return cx.refuse("tensorfold_score is not supported by this engine");
+    const items = field.items() orelse return cx.refuse("tensorfold_score must be an array of token ids");
+    if (items.len == 0) return cx.refuse("tensorfold_score must have at least one token id");
+    const ids = try cx.a.alloc(u32, items.len);
