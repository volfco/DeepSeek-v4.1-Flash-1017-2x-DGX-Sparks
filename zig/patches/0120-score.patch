+    defer other.deinit(gpa);
+    var s = try sm.Stream.init(gpa, .{ .id = "score", .prompt = &.{ 5, 6, 7 }, .max_new = 2, .eos = &.{}, .drafts = false, .score = &.{ 7, 8 } });
+    defer s.deinit(gpa);
+    try engine.addStream(&other);
+    // the lane host requeues a ContextFull score request until the lane is free
+    try std.testing.expectError(error.ContextFull, engine.addStream(&s));
+    while (engine.activeCount() > 0) try engine.step();
+    try engine.addStream(&s);
+    while (engine.activeCount() > 0) try engine.step();
+    try std.testing.expectEqualSlices(u32, &.{ 7, 8 }, s.emitted());
+
