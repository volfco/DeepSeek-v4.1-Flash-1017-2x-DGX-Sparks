diff --git a/zig/src/core/lanes/score.zig b/zig/src/core/lanes/score.zig
new file mode 100644
index 0000000..680c067
--- /dev/null
+++ b/zig/src/core/lanes/score.zig
@@ -0,0 +1,111 @@
+//! TF_DS_SCORE's teacher-forced scoring (Baseten's `run.rs` score): a recorded continuation's mean negative
+//! log-likelihood under the model, its standard error, its perplexity and how often the model's argmax was the
+//! recorded token. The rows are the backend's fp32 logits; the arithmetic is float64 here.
+const std = @import("std");
+
+/// A row's log-sum-exp in float64, shifted by the row's largest logit so the exponentials stay in range.
+pub fn logsumexp(row: []const f32) f64 {
+    var top: f64 = -std.math.inf(f64);
+    for (row) |v| top = @max(top, @as(f64, v));
+    if (top == -std.math.inf(f64)) return top; // every logit -inf: no mass
+    var sum: f64 = 0.0;
+    for (row) |v| sum += @exp(@as(f64, v) - top);
+    return top + @log(sum);
+}
+
+/// The recorded token's negative log-likelihood under a row of logits: logit[recorded] - logsumexp(row).
+pub fn nll(row: []const f32, recorded: u32) !f64 {
+    if (recorded >= row.len) return error.RecordedOutOfRange;
+    return @as(f64, row[recorded]) - logsumexp(row);
+}
+
+/// A scored stream's running figures: the recorded continuation and how many of its tokens have been scored, the
+/// negative log-likelihoods' sum and sum of squares (float64), and the rows whose argmax was the recorded token.
+pub const Score = struct {
+    ids: []const u32, // the recorded continuation (the request's)
+    next: usize = 0, // tokens scored so far: ids[next] is the next one to score
+    nll_sum: f64 = 0,
+    nll_sq: f64 = 0,
+    hits: u32 = 0,
+
+    /// One row: the token the model was asked for, its negative log-likelihood and whether the row's argmax was it.
+    pub fn add(s: *Score, nll_value: f64, argmax_hit: bool) void {
+        s.next += 1;
+        s.nll_sum += nll_value;
+        s.nll_sq += nll_value * nll_value;
+        s.hits += @intFromBool(argmax_hit);
+    }
+
+    /// The score's figures: the mean over the scored tokens, its standard error, the perplexity and the share of rows
+    /// whose argmax was the recorded token.
+    pub fn summary(s: Score) Summary {
+        const n: f64 = @floatFromInt(s.next);
+        const mean = s.nll_sum / n;
+        // shortcut: the sum of squares gives the standard error in one pass over the rows (cancellation is at the
+        // 1e-16 level for negative log-likelihoods of a few nats); upgrade if one token's dwarfs the set's mean
+        const variance = if (s.next > 1) @max(0.0, (s.nll_sq - n * mean * mean) / (n - 1.0)) else 0.0;
+        return .{
+            .tokens = @intCast(s.next),
+            .nll_sum = s.nll_sum,
+            .nll_mean = mean,
+            .nll_se = if (s.next > 1) @sqrt(variance / n) else 0.0,
+            .ppl = if (mean < 709.0) @exp(mean) else std.math.inf(f64),
+            .argmax_match = @as(f64, @floatFromInt(s.hits)) / n,
+        };
+    }
+};
+
+/// What a score stream's reply reports (engine_api's Stats.score, the tensorfold block's score).
+pub const Summary = struct {
+    tokens: u32,
+    nll_sum: f64,
+    nll_mean: f64,
+    nll_se: f64,
+    ppl: f64,
+    argmax_match: f64,
+};
+
+test "a toy row's negative log-likelihood is its hand-computed log-probability" {
+    // log(1 + e + e^2 + e^-1) = 2.4401896985611953
+    const row = [_]f32{ 0.0, 1.0, 2.0, -1.0 };
+    try std.testing.expectApproxEqAbs(@as(f64, 2.4401896985611953), logsumexp(&row), 1e-12);
+    try std.testing.expectApproxEqAbs(@as(f64, -0.4401896985611953), try nll(&row, 2), 1e-12);
