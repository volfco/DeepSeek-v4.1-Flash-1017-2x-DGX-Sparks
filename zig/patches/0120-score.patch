+        const n = if (v == .int) v.int64() else null;
+        if (n == null or n.? < 0 or n.? >= vocab) return cx.fail(.request, "tensorfold_score token ids must be integers in the valid range 0 to {d}", .{@as(i64, vocab) - 1});
