+/// The first pair of a round's rows naming the same raw ring slot (TF_DS_CHECK_INVALID's host check), or null.
+pub fn firstSharedSlot(slots: []const i64) ?struct { a: usize, b: usize } {
+    for (0..slots.len) |i| for (i + 1..slots.len) |j| {
+        if (slots[i] == slots[j]) return .{ .a = i, .b = j };
+    };
+    return null;
+}
