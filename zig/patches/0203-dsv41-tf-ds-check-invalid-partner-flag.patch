+test "TF_DS_CHECK_INVALID: a round's raw ring slots are distinct, a repeat is reported" {
+    // one stream's consecutive rows (raw_rows = 64, max_rows = 48): distinct
+    var slots: [48]i64 = undefined;
+    for (&slots, 0..) |*s, i| s.* = @intCast(i);
+    try std.testing.expect(firstSharedSlot(&slots) == null);
+    // a forced row repeating an earlier position's slot is the aliasing case the fused scatter cannot express
+    slots[17] = slots[3];
+    const got = firstSharedSlot(&slots) orelse return error.ExpectedSharedSlot;
+    try std.testing.expectEqual(@as(usize, 3), got.a);
