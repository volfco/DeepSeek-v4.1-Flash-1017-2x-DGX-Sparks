+// TF_DS_TOPK_MERGE (topk_merge.zig): a rank's best kmax candidates a row of its own head columns, for the exchange that
+// replaces the vocabulary halves' gather in a device-drawn round. logits [rows, n] fp32 (row stride ld) is this rank's
+// head output; its column c is the whole row's col0 + c. out [rows][kmax][2] u32: the value's bits (as read: -0 and NaN
+// unchanged) and the global id, in tf_ds_draw_key order (descending), selected by tf_ds_draw_rows_kernel's radix select
+// and rank sort. Bit 31 of a row's first id says this rank's column 0 is NaN (only rank 0's is read: the whole row's
+// row[0] rule, as tf_ds_argmax_pair_kernel carries it). One block (1024 threads) a row; kmax <= 56 <= n.
+extern "C" __global__ void __launch_bounds__(1024) tf_ds_topk_select_kernel(const float* logits, unsigned long long ld, int n,
+                                                                             unsigned col0, int kmax, unsigned* out, int pdl) {
+    pdl_enter(pdl);
+    const float* row = logits + (unsigned long long)blockIdx.x * ld;
+    unsigned* o = out + (unsigned long long)blockIdx.x * kmax * 2;
+    __shared__ unsigned hist[256];
+    __shared__ uint64_t sel[64];
+    __shared__ unsigned count, digit, remain;
+    const int tid = threadIdx.x;
+    const unsigned k = min((unsigned)kmax, (unsigned)n);
+
+    uint64_t prefix = 0;
+    unsigned want = k;
+    for (int d = 0; d < 8; ++d) {
+        const int shift = 56 - 8 * d;
+        for (int i = tid; i < 256; i += blockDim.x) hist[i] = 0;
+        __syncthreads();
+        for (int i = tid; i < n; i += blockDim.x) {
+            const uint64_t key = tf_ds_draw_key(row[i], (int)(col0 + (unsigned)i));
+            if (d == 0 || (key >> (shift + 8)) == (prefix >> (shift + 8))) atomicAdd(&hist[(key >> shift) & 0xFF], 1u);
+        }
+        __syncthreads();
+        if (tid == 0) {
+            unsigned above = 0;
+            int b = 255;
+            for (; b > 0; --b) {
+                if (above + hist[b] >= want) break;
+                above += hist[b];
+            }
+            digit = b;
+            remain = want - above;
+        }
+        __syncthreads();
+        prefix |= uint64_t(digit) << shift;
+        want = remain;
+    }
+    // prefix is the k-th largest key (keys are unique: exactly k at or above it)
+    if (tid == 0) count = 0;
+    __syncthreads();
+    for (int i = tid; i < n; i += blockDim.x) {
+        const uint64_t key = tf_ds_draw_key(row[i], (int)(col0 + (unsigned)i));
+        if (key >= prefix) {
+            const unsigned at = atomicAdd(&count, 1u);
+            if (at < 64) sel[at] = key;
+        }
+    }
+    __syncthreads();
+    if (tid < (int)k) {
+        unsigned rank = 0;
+        for (unsigned m = 0; m < k; ++m) rank += sel[m] > sel[tid] ? 1u : 0u;
+        const unsigned id = ~uint32_t(sel[tid]);
+        o[2 * rank] = __float_as_uint(row[id - col0]);
+        o[2 * rank + 1] = id | (rank == 0 && row[0] != row[0] ? 0x80000000u : 0u);
+    }
+}
+
+// TF_DS_TOPK_MERGE: the two ranks' lists (the all-gather's rank-major pairs [2][rows][kmax][2] u32) merged into the
+// round's first kmax candidates a row, merged [rows][kmax][2], in tf_ds_draw_key order: global ids are unique, so the
+// two-list merge is exact. Rank 0's row[0] NaN flag moves to the merged first id; every other id's bit 31 is cleared.
+// shortcut: two lists (the predicate's world == 2), a generic merge would index a per-rank cursor array in local
+// memory; upgrade when a wider transport takes this exchange. A thread a row.
+extern "C" __global__ void tf_ds_topk_merge_kernel(const unsigned* pairs, int rows, int kmax, unsigned* merged, int pdl) {
+    pdl_enter(pdl);
+    const int r = blockIdx.x * blockDim.x + threadIdx.x;
+    if (r >= rows) return;
+    const unsigned* a = pairs + (long long)r * kmax * 2;
+    const unsigned* b = pairs + ((long long)rows + r) * kmax * 2;
+    unsigned* m = merged + (long long)r * kmax * 2;
+    const unsigned flag = a[1] & 0x80000000u;
+    int i = 0, j = 0;
+    for (int q = 0; q < kmax; ++q) {
+        // (kmax picks from two lists of kmax: at most one list runs out, and then the other has what is left)
+        bool take_a = j >= kmax;
+        if (i < kmax && j < kmax)
+            take_a = tf_ds_draw_key(__uint_as_float(a[2 * i]), (int)(a[2 * i + 1] & 0x7fffffffu)) >
+                     tf_ds_draw_key(__uint_as_float(b[2 * j]), (int)(b[2 * j + 1] & 0x7fffffffu));
+        const unsigned* p = take_a ? a + 2 * i : b + 2 * j;
+        m[2 * q] = p[0];
+        m[2 * q + 1] = (p[1] & 0x7fffffffu) | (q == 0 ? flag : 0u);
+        if (take_a) ++i; else ++j;
+    }
+}
+
+// TF_DS_TOPK_MERGE: a row's token from the merged candidates (merged [rows][kmax][2] u32, rules the setDraw table): a
+// greedy row takes tf_ds_block_argmax's answer for the whole row (the largest key's id; pick 0 under rank 0's row[0] NaN
+// flag), a sampled row tf_ds_draw_rows_kernel's draw over its first top_k candidates. One block (64 threads) a row.
+extern "C" __global__ void __launch_bounds__(64) tf_ds_draw_rows_topk_kernel(const unsigned* merged, int kmax,
+                                                                            const TfDsDrawRow* rules, unsigned* out, int pdl) {
+    pdl_enter(pdl);
+    const unsigned* mr = merged + (unsigned long long)blockIdx.x * kmax * 2;
+    const TfDsDrawRow rule = rules[blockIdx.x];
+    if (rule.temp <= 0.0) {
+        if (threadIdx.x == 0) out[blockIdx.x] = (mr[1] & 0x80000000u) ? 0u : mr[1];
+        return;
+    }
+    __shared__ unsigned sid[64];
+    __shared__ float val[64];
+    __shared__ double scaled[64];
+    __shared__ double score[64];
+    const int tid = threadIdx.x;
+    const unsigned k = min(rule.top_k, (unsigned)kmax);
+    if (tid < (int)k) {
+        sid[tid] = mr[2 * tid + 1] & 0x7fffffffu;
+        val[tid] = __uint_as_float(mr[2 * tid]);
+    }
+    __syncthreads();
+    // from here tf_ds_draw_rows_kernel's tail, duplicated so that hardware-qualified kernel stays untouched (row[id] is
+    // the candidate's value val[tid])
+    const double t = fmax(rule.temp, 1e-6);
+    if (tid < (int)k) {
+        const unsigned id = sid[tid];
+        scaled[tid] = double(val[tid]) / t;
+        uint64_t x = tf_ds_mix64(rule.seed + 0x9E3779B97F4A7C15ull);
+        x = tf_ds_mix64(x ^ (rule.pos * 0xD1B54A32D192ED03ull));
+        x = tf_ds_mix64(x ^ uint64_t(id));
+        const double u = double(x >> 11) * 0x1p-53 + 0x1p-54;
+        score[tid] = scaled[tid] - log(-log(u));
+    }
+    __syncthreads();
+    if (tid != 0) return;
+    const double ninf = -__longlong_as_double(0x7ff0000000000000ll);
+    if (0.0 < rule.top_p && rule.top_p < 1.0) {
+        double mx = scaled[0];
+        for (unsigned j = 1; j < k; ++j) mx = fmax(mx, scaled[j]);
+        double probs[64];
+        for (unsigned j = 0; j < k; ++j) probs[j] = exp(scaled[j] - mx);
+        // numpy's pairwise sum of k <= 56 values (sampling.pairwiseSum)
+        double sum;
+        if (k < 8) {
+            sum = 0.0;
+            for (unsigned j = 0; j < k; ++j) sum += probs[j];
+        } else {
+            double r[8];
+            for (int j = 0; j < 8; ++j) r[j] = probs[j];
+            unsigned i = 8;
+            for (; i < k - k % 8; i += 8) {
+                for (int j = 0; j < 8; ++j) r[j] += probs[i + j];
+            }
+            sum = ((r[0] + r[1]) + (r[2] + r[3])) + ((r[4] + r[5]) + (r[6] + r[7]));
+            for (; i < k; ++i) sum += probs[i];
+        }
+        double acc = 0.0;
+        unsigned below = 0;
+        for (unsigned j = 0; j < k; ++j) {
+            acc += probs[j] / sum;
+            if (acc < rule.top_p) below += 1;
+        }
+        for (unsigned j = below + 1; j < k; ++j) score[j] = ninf;
+    }
+    if (rule.min_p > 0.0) {
+        const double floor_ = scaled[0] + log(rule.min_p);
+        for (unsigned j = 0; j < k; ++j) {
+            if (scaled[j] < floor_) score[j] = ninf;
+        }
+    }
+    unsigned best = 0;
+    for (unsigned j = 0; j < k; ++j) {
+        if (score[j] > score[best]) best = j;
+    }
+    out[blockIdx.x] = sid[best];
+}
