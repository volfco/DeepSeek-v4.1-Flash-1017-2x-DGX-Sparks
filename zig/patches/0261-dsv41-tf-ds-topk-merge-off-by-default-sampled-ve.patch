diff --git a/zig/src/families/dsv41/topk_merge.zig b/zig/src/families/dsv41/topk_merge.zig
new file mode 100644
index 0000000000000000000000000000000000000000..118a2854a6ca7c4ab93b69e99d977863c7ca59d0
--- /dev/null
+++ b/zig/src/families/dsv41/topk_merge.zig
@@ -0,0 +1,327 @@
+//! TF_DS_TOPK_MERGE (off by default): a TP2 verify round whose sampled rows the device draws (path .device_draw)
+//! exchanges each rank's best `kmax` (value, global id) pairs a row instead of the vocabulary halves: 448 bytes a row a
+//! rank at kmax 56 against 258,560. Pure: no cuda import. The kernels are tf_ds_topk_select_kernel (the head, both
+//! ranks, then an in-place all-gather), tf_ds_topk_merge_kernel and tf_ds_draw_rows_topk_kernel (rank 0's pick), all in
+//! dsv41_ops.cu; the launchers are Ops.topkSelect/topkMerge/drawTopk, the call sites round.zig's head, Model.launchPick
+//! and lanes.zig's verify (which decides `kmax` and carries it to the follower in the verify frame's header).
+//!
+//! Order: tf_ds_draw_key descending (the value's order-preserving bits with -0 as +0 and NaN lowest, then the lower
+//! id), which for rows without NaN is sampling.zig's (value desc, id asc). A row's draw reads only its first top_k
+//! candidates (tf_ds_draw_rows_kernel's own note), so every row takes the merged list's top_k prefix, kmax being the
+//! round's largest sampled top_k. A greedy row takes the merged top 1 with rank 0's row[0] NaN rule (tf_ds_block_argmax:
+//! pick 0), the flag riding bit 31 of rank 0's first id as in TF_DS_GREEDY_ARGMAX. A malformed switch refuses startup.
+const std = @import("std");
+const sampling = @import("sampling.zig");
+
+pub const env_name: [:0]const u8 = "TF_DS_TOPK_MERGE";
+
+/// The switch's value: unset, "" or "0" off; "1" on; anything else is a refusal to start (the message is on stderr).
+pub fn parse(text: ?[]const u8) ?bool {
+    const t = text orelse return false;
+    if (t.len == 0 or std.mem.eql(u8, t, "0")) return false;
+    if (std.mem.eql(u8, t, "1")) return true;
+    std.debug.print("{s}: expected 1 or 0\n", .{env_name});
+    return null;
+}
+
+pub fn fromText(text: ?[]const u8) error{BadTopkMerge}!bool {
+    return parse(text) orelse error.BadTopkMerge;
+}
+
+/// The largest top_k the device draw takes (sampling.deviceDrawable: top_k + margin <= max_candidates).
+pub const max_k = sampling.max_candidates - sampling.margin;
+
+/// The round's kmax as rows are added: the largest top_k of a sampled row (a greedy row's top_k is not bounded by
+/// deviceDrawable and is never read).
+pub fn addRow(kmax: usize, temperature: f64, top_k: usize) usize {
+    return if (temperature > 0) @max(kmax, top_k) else kmax;
+}
+
+/// Whether a round takes the merged exchange: the switch, a device-drawn round, the TP2 pair without the 2D split, no
+/// probe reading the full logits, kmax in 1..max_k, and the head's halves covering the vocabulary exactly (each rank's
+/// `hn` columns, global id rank * hn + column, at least kmax of them). Anything else keeps today's full gather.
+pub fn works(on: bool, path: sampling.RoundPath, world: usize, two: bool, probe: bool, vocab: usize, hn: usize, kmax: usize) bool {
+    return on and path == .device_draw and world == 2 and !two and !probe and kmax >= 1 and kmax <= max_k and world * hn == vocab and hn >= kmax;
+}
+
+/// The verify frame's header: the window count in bits 0..23, kmax in 24..29 (0: the full gather), bit 30 clear, bit 31
+/// TF_DS_GREEDY_ARGMAX's map. With kmax 0 the bytes are the header as it was.
+pub const header_shift = 24;
+pub fn headerK(header: u32) u32 {
+    return (header >> header_shift) & 0x3f;
+}
+pub fn headerWindows(header: u32) u32 {
+    return header & 0x00ffffff;
+}
+/// A follower's check of a header's kmax: zero, or in 1..max_k with its own switch on; and bit 30 clear.
+pub fn headerOk(header: u32, on: bool) bool {
+    const k = headerK(header);
+    return header & 0x40000000 == 0 and (k == 0 or (on and k <= max_k));
+}
+
+// -- host reference -------------------------------------------------------------------------------------------------
+
+/// tf_ds_draw_key: the value's order-preserving bits (-0 as +0, NaN lowest) above the inverted id.
+pub fn drawKey(v: f32, id: u32) u64 {
+    var b: u32 = @bitCast(v);
+    if (b << 1 == 0) b = 0;
+    const hi: u32 = if (std.math.isNan(v)) 0 else if (b & 0x80000000 != 0) ~b else b | 0x80000000;
+    return (@as(u64, hi) << 32) | @as(u64, 0xFFFFFFFF - id);
+}
+
+pub const Pair = struct { v: f32, id: u32 };
+
+fn keyAbove(_: void, a: Pair, b: Pair) bool {
+    return drawKey(a.v, a.id) > drawKey(b.v, b.id);
+}
+
+/// A rank's list (tf_ds_topk_select_kernel): its `shard` columns' best `kmax` by key, global ids from col0, in key
+/// order; bit 31 of the first id set when the shard's column 0 is NaN. `out` holds kmax pairs; returns how many.
+pub fn localTop(shard: []const f32, col0: u32, kmax: usize, out: []Pair) usize {
+    const k = @min(kmax, shard.len);
+    var n: usize = 0;
+    for (shard, 0..) |v, c| {
+        const p: Pair = .{ .v = v, .id = col0 + @as(u32, @intCast(c)) };
+        if (n == k and !keyAbove({}, p, out[k - 1])) continue;
+        var j: usize = if (n < k) n else k - 1;
+        while (j > 0 and keyAbove({}, p, out[j - 1])) : (j -= 1) out[j] = out[j - 1];
+        out[j] = p;
+        if (n < k) n += 1;
+    }
+    if (n > 0 and std.math.isNan(shard[0])) out[0].id |= 0x80000000;
+    return n;
+}
+
+/// tf_ds_topk_merge_kernel: two key-ordered lists to the first kmax of their union, the flag of `a`'s first id moved
+/// to the merged first id (every other id's bit 31 cleared).
+pub fn merge2(a: []const Pair, b: []const Pair, kmax: usize, out: []Pair) void {
+    const flag = a[0].id & 0x80000000;
+    var i: usize = 0;
+    var j: usize = 0;
+    for (0..kmax) |m| {
+        const pa: ?Pair = if (i < a.len) Pair{ .v = a[i].v, .id = a[i].id & 0x7fffffff } else null;
+        const pb: ?Pair = if (j < b.len) Pair{ .v = b[j].v, .id = b[j].id & 0x7fffffff } else null;
+        const take_a = pb == null or (pa != null and keyAbove({}, pa.?, pb.?));
+        out[m] = if (take_a) pa.? else pb.?;
+        if (take_a) i += 1 else j += 1;
+    }
+    out[0].id |= flag;
+}
+
+/// A greedy row's pick from the merged list: 0 under rank 0's row[0] NaN flag, else the top id.
+pub fn greedyPick(merged: []const Pair) u32 {
+    return if (merged[0].id & 0x80000000 != 0) 0 else merged[0].id;
+}
+
+extern "c" fn exp(x: f64) f64;
+extern "c" fn log(x: f64) f64;
+
+/// The served draw over the first top_k merged candidates (sampling.sampleRow's arithmetic after its topCandidates:
+/// the scaled values, the keyed Gumbel scores, top_p's pairwise-sum prefix, min_p's floor, the first best score).
+pub fn sampleCandidates(merged: []const Pair, position: u64, s: sampling.Sampling) i64 {
+    const k = @max(1, @min(s.top_k, merged.len));
+    const t = @max(s.temperature, 1e-6);
+    var scaled: [max_k]f64 = undefined;
+    var score: [max_k]f64 = undefined;
+    for (0..k) |j| {
+        const id: u64 = merged[j].id & 0x7fffffff;
+        scaled[j] = @as(f64, merged[j].v) / t;
+        score[j] = scaled[j] - log(-log(sampling.uniform(s.seed, position, id)));
+    }
+    if (0.0 < s.top_p and s.top_p < 1.0) {
+        var mx = scaled[0];
+        for (scaled[1..k]) |v| mx = @max(mx, v);
+        var probs: [max_k]f64 = undefined;
+        for (0..k) |j| probs[j] = exp(scaled[j] - mx);
+        const sum = sampling.pairwiseSum(probs[0..k]);
+        var acc: f64 = 0.0;
+        var below: usize = 0;
+        for (0..k) |j| {
+            acc += probs[j] / sum;
+            if (acc < s.top_p) below += 1;
+        }
+        for (below + 1..k) |j| score[j] = -std.math.inf(f64);
+    }
+    if (s.min_p > 0.0) {
+        const floor = scaled[0] + log(s.min_p);
+        for (0..k) |j| {
+            if (scaled[j] < floor) score[j] = -std.math.inf(f64);
+        }
+    }
+    var best: usize = 0;
+    for (0..k) |j| {
+        if (score[j] > score[best]) best = j;
+    }
+    return merged[best].id & 0x7fffffff;
+}
+
+// -- tests ----------------------------------------------------------------------------------------------------------
+
+test "switch parse, header and eligibility" {
+    try std.testing.expectEqual(@as(?bool, false), parse(null));
+    try std.testing.expectEqual(@as(?bool, false), parse("0"));
+    try std.testing.expectEqual(@as(?bool, true), parse("1"));
+    try std.testing.expectError(error.BadTopkMerge, fromText("yes"));
+    try std.testing.expectEqual(@as(usize, 56), max_k);
+    const h: u32 = 3 | (40 << header_shift) | (1 << 31);
+    try std.testing.expectEqual(@as(u32, 40), headerK(h));
+    try std.testing.expectEqual(@as(u32, 3), headerWindows(h));
+    try std.testing.expect(headerOk(h, true) and !headerOk(h, false) and headerOk(3, false));
+    try std.testing.expect(!headerOk(3 | (57 << header_shift), true) and !headerOk(3 | (1 << 30), true));
+    try std.testing.expect(works(true, .device_draw, 2, false, false, 129280, 64640, 56));
+    try std.testing.expect(!works(false, .device_draw, 2, false, false, 129280, 64640, 56));
+    try std.testing.expect(!works(true, .greedy, 2, false, false, 129280, 64640, 1)); // TF_DS_GREEDY_ARGMAX's arm
+    try std.testing.expect(!works(true, .host_draw, 2, false, false, 129280, 64640, 20)); // score streams, SPEC_SAMPLE
+    try std.testing.expect(!works(true, .device_draw, 1, false, false, 129280, 129280, 20));
+    try std.testing.expect(!works(true, .device_draw, 4, false, false, 129280, 32320, 20));
+    try std.testing.expect(!works(true, .device_draw, 2, true, false, 129280, 64640, 20)); // the four-node split
+    try std.testing.expect(!works(true, .device_draw, 2, false, true, 129280, 64640, 20)); // a probe reads the logits
+    try std.testing.expect(!works(true, .device_draw, 2, false, false, 129281, 64640, 20)); // halves not the vocabulary
+    try std.testing.expect(!works(true, .device_draw, 2, false, false, 129280, 64640, 57) and !works(true, .device_draw, 2, false, false, 129280, 64640, 0));
+    try std.testing.expectEqual(@as(usize, 20), addRow(addRow(addRow(0, 0.0, 999), 0.7, 20), 1.0, 8));
+}
+
+/// The ordered global candidates by key over the whole row (a full sort: the reference for rows with NaN).
+fn fullTop(a: std.mem.Allocator, row: []const f32, kmax: usize) ![]Pair {
+    const all = try a.alloc(Pair, row.len);
+    for (row, 0..) |v, i| all[i] = .{ .v = v, .id = @intCast(i) };
+    std.mem.sort(Pair, all, {}, keyAbove);
+    return all[0..@min(kmax, row.len)];
+}
+
+/// The two ranks' lists merged, as the device builds them (`hh` columns a rank).
+fn mergedTop(a: std.mem.Allocator, row: []const f32, hh: usize, kmax: usize) ![]Pair {
+    const l0 = try a.alloc(Pair, kmax);
+    const l1 = try a.alloc(Pair, kmax);
+    const n0 = localTop(row[0..hh], 0, kmax, l0);
+    const n1 = localTop(row[hh..], @intCast(hh), kmax, l1);
+    const out = try a.alloc(Pair, kmax);
+    merge2(l0[0..n0], l1[0..n1], kmax, out);
+    return out;
+}
+
+fn hasNan(row: []const f32) bool {
+    for (row) |v| if (std.math.isNan(v)) return true;
+    return false;
+}
+
+/// tf_ds_block_argmax over the whole row (the full path's greedy pick): pick 0 when row[0] is NaN, else the first of
+/// the largest non-NaN values.
+fn deviceArgmax(row: []const f32) u32 {
+    if (std.math.isNan(row[0])) return 0;
+    var bv = -std.math.inf(f32);
+    var bi: u32 = 0x7fffffff;
+    for (row, 0..) |v, i| {
+        if (v == v and (v > bv or (v == bv and i < bi))) {
+            bv = v;
+            bi = @intCast(i);
+        }
+    }
+    return bi;
+}
+
+/// One case: the merged list against the full sort (every row) and sampling.topCandidates (rows without NaN), each
+/// top_k <= kmax's prefix, and the greedy pick against the full row's.
+fn checkRow(a: std.mem.Allocator, row: []const f32, kmax: usize) !void {
+    const hh = row.len / 2;
+    const merged = try mergedTop(a, row, hh, kmax);
+    const want = try fullTop(a, row, kmax);
+    for (merged, want, 0..) |m, w, j| {
+        const id = if (j == 0) m.id & 0x7fffffff else m.id;
+        try std.testing.expectEqual(w.id, id);
+        try std.testing.expectEqual(@as(u32, @bitCast(w.v)), @as(u32, @bitCast(m.v)));
+    }
+    try std.testing.expectEqual(deviceArgmax(row), greedyPick(merged));
+    if (hasNan(row)) return;
+    var values: [sampling.max_candidates]f32 = undefined;
+    var ids: [sampling.max_candidates]i64 = undefined;
+    // every top_k <= kmax reads the merged prefix: the host's own top_k candidates
+    for ([_]usize{ 1, kmax / 2, kmax }) |top_k| {
+        if (top_k == 0) continue;
+        const n = sampling.topCandidates(row, top_k, &values, &ids);
+        for (0..n) |j| {
+            try std.testing.expectEqual(ids[j], @as(i64, merged[j].id & 0x7fffffff));
+            try std.testing.expectEqual(@as(u32, @bitCast(values[j])), @as(u32, @bitCast(merged[j].v)));
+        }
+    }
+}
+
+test "merged rank-local candidates equal the global candidates over 96+ cases" {
+    var arena = std.heap.ArenaAllocator.init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    var prng = std.Random.DefaultPrng.init(0x261);
+    const rnd = prng.random();
+    const inf = std.math.inf(f32);
+    const nan = std.math.nan(f32);
+    var cases: usize = 0;
+    // fuzz rows (sampling.testRow: a 1/8 grid, many ties, outliers), k = 1..56
+    for (1..max_k + 1) |kmax| {
+        const row = try sampling.testRow(a, 2 * (64 + kmax * 3), 0x2610 + kmax);
+        try checkRow(a, row, kmax);
+        cases += 1;
+    }
+    // cross-rank ties at the cutoff: equal values straddling kmax, split across the halves (the lower id must win)
+    for ([_]usize{ 1, 7, 20, 56 }) |kmax| {
+        const hh = 128;
+        const row = try a.alloc(f32, 2 * hh);
+        for (row) |*v| v.* = -1.0;
+        // kmax - 1 clear winners on rank 1, then a block of ties on both ranks at the cutoff
+        for (0..kmax - 1) |j| row[hh + j] = 10.0 + @as(f32, @floatFromInt(j));
+        for (0..8) |j| {
+            row[hh - 1 - j] = 3.0; // rank 0's high columns
+            row[hh + 64 + j] = 3.0; // rank 1's
+        }
+        try checkRow(a, row, kmax);
+        // and every value equal: the first kmax ids, all from rank 0
+        for (row) |*v| v.* = 0.5;
+        try checkRow(a, row, kmax);
+        cases += 2;
+    }
+    // signed zeros (-0 as +0: ties to the lower id), infinities, NaN placement incl. rank 0's row[0]
+    const specials = [_]f32{ 0.0, -0.0, inf, -inf, nan, 1.0, -1.0, std.math.floatMax(f32), -std.math.floatMax(f32), std.math.floatTrueMin(f32) };
+    for (0..40) |c| {
+        const hh = 32 + rnd.uintLessThan(usize, 32);
+        const row = try a.alloc(f32, 2 * hh);
+        for (row) |*v| v.* = if (rnd.boolean()) specials[rnd.uintLessThan(usize, specials.len)] else @round(rnd.floatNorm(f32) * 4) / 4;
+        if (c % 4 == 0) row[0] = nan; // rank 0's row[0] NaN: the greedy pick is 0
+        if (c % 4 == 1) row[hh] = nan; // rank 1's first column NaN: no rule (the flag is rank 0's only)
+        if (c % 5 == 2) for (row) |*v| {
+            v.* = nan; // every value NaN: key order is id order
+        };
+        if (c % 7 == 3) for (row) |*v| {
+            v.* = if (rnd.boolean()) 0.0 else -0.0;
+        };
+        try checkRow(a, row, 1 + rnd.uintLessThan(usize, max_k));
+        cases += 1;
+    }
+    try std.testing.expect(cases >= 96);
+}
+
+test "the seeded draw on the merged candidates equals sampleRow on the full row" {
+    var arena = std.heap.ArenaAllocator.init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    var prng = std.Random.DefaultPrng.init(0x2611);
+    const rnd = prng.random();
+    var draws: usize = 0;
+    for (0..48) |c| {
+        const row = try sampling.testRow(a, 2 * 2048, 0x26110 + c);
+        // a round's rows: sampled with different top_k (kmax their largest) and greedy ones
+        var rules: [6]sampling.Sampling = undefined;
+        var kmax: usize = 0;
+        for (&rules, 0..) |*s, j| {
+            s.* = .{ .seed = rnd.int(u64), .temperature = if (j == 5) 0.0 else 0.3 + rnd.float(f64) * 1.2, .top_k = 1 + rnd.uintLessThan(usize, max_k), .top_p = ([_]f64{ 1.0, 0.95, 0.5, 0.0 })[j % 4], .min_p = if (j % 3 == 0) 0.05 else 0.0 };
+            kmax = addRow(kmax, s.temperature, s.top_k);
+        }
+        const merged = try mergedTop(a, row, row.len / 2, kmax);
+        for (rules) |s| {
+            const pos = rnd.uintLessThan(u64, 1 << 20);
+            const want = try sampling.sampleRow(row, pos, s);
+            const got: i64 = if (s.temperature <= 0) greedyPick(merged) else sampleCandidates(merged[0..kmax], pos, s);
+            try std.testing.expectEqual(want, got);
+            draws += 1;
+        }
+    }
+    try std.testing.expectEqual(@as(usize, 288), draws);
+}
