+test "TF_DS_EXACT_RESUME: an off-grid state with a covering tail resumes, a grid state as ever, neither without its tail" {
+    const c = model.chunk_rows;
+    const gpa = std.testing.allocator;
+    var m: Model = undefined;
+    m.cfg.window = 128;
+    var ln: Lanes = .{ .gpa = gpa, .m = &m, .peer = null };
+    defer ln.snaps.deinit(gpa);
+    // a grid state: as ever (a chunk end before the replay), with the switch on or off
