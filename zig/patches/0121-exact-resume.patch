diff --git a/zig/src/core/prompt_cache_test.zig b/zig/src/core/prompt_cache_test.zig
index a632466..f096102 100644
--- a/zig/src/core/prompt_cache_test.zig
+++ b/zig/src/core/prompt_cache_test.zig
@@ -917,3 +917,24 @@ test "TF_DS_CACHE_METRICS=0: the cause splits and the resume depth count nothing
     try std.testing.expectEqual(@as(u64, 0), s.counts.failed_restore);
