+    const window = 128;
+    const Ring = struct {
+        const none = std.math.maxInt(usize);
+        /// The pass's chunks (2048 rows, the last shorter) stashed into the ring: slot -> the position it holds.
+        fn stash(ring: []usize, len: usize, window_: usize, chunks: []const usize) void {
+            @memset(ring, none);
+            var start: usize = 0;
+            var i: usize = 0;
+            while (start < len) : (i += 1) {
+                const n = @min(if (i < chunks.len) chunks[i] else 2048, len - start);
+                const r = tailRows(start, n, len -| window_, window_);
+                for (r[0]..r[1]) |p| ring[p % window_] = p;
+                start += n;
+            }
+        }
+        /// The ring holds exactly the positions [lo, hi) (each at its slot).
+        fn holds(ring: []const usize, lo: usize, hi: usize, window_: usize) bool {
+            for (lo..hi) |p| if (ring[p % window_] != p) return false;
+            return true;
+        }
+    };
+    var ring: [window]usize = undefined;
+    // a cold pass: the whole prompt under the window, the window's last rows at or past it (an exact grid multiple too)
