 /// TF_DS_SCORE's figures for a scored reply (lanes/score.zig's Summary).
 pub const Score = lanes.score.Summary;
 
+/// The done line's Engram field (0135): ` engram_host_ms=1.234`, the reply's share of the Engram host path, appended
+/// after every existing field so an old parser's prefix still matches; nothing when the backend keeps no such time
+/// (the line is the old one).
+pub fn engramSuffix(buf: []u8, seconds: ?f64) []const u8 {
+    const sec = seconds orelse return "";
+    return std.fmt.bufPrint(buf, " engram_host_ms={d:.3}", .{sec * 1e3}) catch "";
+}
+
+test "the done line's Engram host time appends last, or nothing when the backend keeps none" {
+    var buf: [32]u8 = undefined;
+    try std.testing.expectEqualStrings(" engram_host_ms=1.234", engramSuffix(&buf, 0.001234));
+    try std.testing.expectEqualStrings(" engram_host_ms=0.000", engramSuffix(&buf, 0));
+    try std.testing.expectEqualStrings("", engramSuffix(&buf, null));
+}
