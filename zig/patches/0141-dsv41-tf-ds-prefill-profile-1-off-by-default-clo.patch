diff --git a/zig/src/families/dsv41/prefill_prof.zig b/zig/src/families/dsv41/prefill_prof.zig
new file mode 100644
index 0000000000000000000000000000000000000000..fca02cdfcc980c381df0d33f02397288ef56e5d1
--- /dev/null
+++ b/zig/src/families/dsv41/prefill_prof.zig
@@ -0,0 +1,141 @@
+//! TF_DS_PREFILL_PROFILE=1: a prompt chunk's time by phase (default off). Attribution only: the stream is drained at
+//! every cut, so the figures include the syncs and are not an unprofiled chunk's cost. Names and the chunk-a-round shape
+//! follow round.zig's PhaseTimer (start/embed/.../head a chunk, a_in..a_woa inside a layer's attention, m_rt the router),
+//! but wall-clock a drained stream instead of events: the d_* and e_* sub-marks fire once a dense-GEMM call and once a
+//! prompt-experts call, far more marks than PhaseTimer's event array holds.
+//! Two classes of marks, one accumulator each, no double charging inside a class:
+//! - phases (start..head): each mark charges the interval since the previous mark to itself, the chunk boundaries'
+//!   (start, head's finish) excepted; their sum is the chunk's time.
+//! - sub-marks (a_in..a_woa, m_rt, d_*, e_*): each charges its own begin..end interval on the cursor of its class, so
+//!   the dense GEMMs' marks inside an a_in interval do not cut it. They never move the phases' cursor, so the phase
+//!   they sit inside keeps its full time; they are a breakdown of part of it, not a subtraction from it.
+//! A chunk cut by a decode round (TF_DS_PREFILL_SLICE) charges that round to its next phase, as PhaseTimer's does.
+//! The line prints at the end of the run next to prefill_engram_ms (lanes_main.zig) as "prefill_profile_ms": every
+//! mark's average ms a chunk, and the chunks counted. Unset, every mark is one load and a branch.
+const std = @import("std");
+const cuda = @import("cuda");
+
+pub const Phase = enum(u8) {
+    start, embed, engram, mix_attn, attn, gather_a, mix_ffn, moe, gather_m, head, // a chunk's stretches (model.sliceRun)
+    a_in, a_q, a_idx, a_core, a_woa, // prompt.attention: the input linears, q, the kv source and indexer, the core, wo_a
+    m_rt, // prompt.moe's routing, before the experts
+    d_rot, d_unpack, d_gemm, // exl3_prefill.matmul, once a dense-GEMM call
+    e_gu, e_down, // exl3_experts.prompt, once a call (gate-up through gateup_epilogue; down: grouped_rows and down_combine)
+};
+pub const phases = @typeInfo(Phase).@"enum".field_names;
+
+/// A sub-mark's class: a cursor each, so a mark of one class (a dense GEMM inside a_in's interval) leaves the others'.
+const Class = enum { attn, dense, moe, experts };
+
+fn classOf(ph: Phase) Class {
+    return switch (ph) {
+        .a_in, .a_q, .a_idx, .a_core, .a_woa => .attn,
+        .m_rt => .moe,
+        .d_rot, .d_unpack, .d_gemm => .dense,
+        .e_gu, .e_down => .experts,
+        else => unreachable, // (a phase has no begin..end interval of its own)
+    };
+}
+
+/// The one live profiler (model.open's TF_DS_PREFILL_PROFILE; null: every mark is a branch).
+pub var live: ?*Profiler = null;
+var one: Profiler = .{ .io = undefined };
+
+/// TF_DS_PREFILL_PROFILE=1: the marks on, from the next chunk (model.open, after its io).
+pub fn enable(io: std.Io) void {
+    one = .{ .io = io };
+    live = &one;
+}
+
+pub fn mark(s: cuda.Stream, ph: Phase) void {
+    const p = live orelse return;
+    p.cut(p.stamp(s), ph);
+}
+
+/// A sub-mark's first begin: the marks of its class that follow chain off it.
+pub fn subBegin(s: cuda.Stream, ph: Phase) void {
+    const p = live orelse return;
+    p.sub[@intFromEnum(classOf(ph))] = p.stamp(s);
+}
+
+/// A sub-mark's end: charges its class's cursor..now (consecutive marks of a class need one begin between them).
+pub fn subEnd(s: cuda.Stream, ph: Phase) void {
+    const p = live orelse return;
+    const c = @intFromEnum(classOf(ph));
+    if (p.sub[c] == 0) return;
+    const now = p.stamp(s);
+    p.ns[@backingInt(ph)] += now - p.sub[c];
+    p.sub[c] = now;
+}
+
+/// The chunk's end (head's mark drained it): count the chunk, close the open interval and drop the sub cursors. The
+/// tail after head is not charged.
+pub fn finish() void {
+    const p = live orelse return;
+    p.cursor = 0;
+    p.sub = @splat(0);
+    p.chunks += 1;
+}
+
+/// The run's line, next to prefill_engram_ms: each mark's average ms a chunk.
+pub fn print(w: anytype, rank: usize) !void {
+    const p = live orelse return;
+    const n: f64 = @floatFromInt(@max(p.chunks, 1));
+    try w.print("{{\"rank\": {d}, \"prefill_profile_ms\": {{\"chunks\": {d}", .{ rank, p.chunks });
+    for (phases, 0..) |name, i| try w.print(", \"{s}\": {d:.3}", .{ name, @as(f64, @floatFromInt(p.ns[i])) / n / 1e6 });
+    try w.print("}}}}\n", .{});
+    try w.flush();
+}
+
+pub const Profiler = struct {
+    io: std.Io,
+    ns: [phases.len]u64 = @splat(0),
+    cursor: u64 = 0, // the previous phase mark's stamp (0: between chunks)
+    sub: [@typeInfo(Class).@"enum".field_names.len]u64 = @splat(0), // by Class: the class's open sub-mark
+    chunks: u64 = 0,
+
+    fn stamp(p: *Profiler, s: cuda.Stream) u64 {
+        s.synchronize() catch {};
+        return @intCast(std.Io.Timestamp.now(p.io, .awake).nanoseconds);
+    }
+
+    fn cut(p: *Profiler, now: u64, ph: Phase) void {
+        // start opens a chunk's interval: a chunk that failed mid-way leaves no open one to charge it
+        if (p.cursor != 0 and ph != .start) p.ns[@backingInt(ph)] += now - p.cursor;
+        p.cursor = now;
+    }
+};
+
+test "the profiler charges intervals to their phases, counts chunks, and keeps sub-marks off the cursor" {
+    var p: Profiler = .{ .io = undefined };
+    live = &p;
+    defer live = null;
+    p.cut(100, .start); // a chunk's first cut charges nothing
+    p.cut(180, .embed);
+    p.sub[@intFromEnum(Class.attn)] = 180;
+    p.sub[@intFromEnum(Class.dense)] = 180;
+    p.ns[@intFromEnum(Phase.d_rot)] += 20; // a dense mark inside the a_in interval
+    p.ns[@intFromEnum(Phase.a_in)] += 60;
+    p.cut(400, .attn);
+    p.sub[@intFromEnum(Class.attn)] = 400;
+    p.ns[@intFromEnum(Phase.a_q)] += 100; // after the attn cut: still not charged to attn or its cursor
+    finish();
+    try std.testing.expectEqual(@as(u64, 80), p.ns[@intFromEnum(Phase.embed)]);
+    try std.testing.expectEqual(@as(u64, 220), p.ns[@intFromEnum(Phase.attn)]);
+    try std.testing.expectEqual(@as(u64, 60), p.ns[@intFromEnum(Phase.a_in)]);
+    try std.testing.expectEqual(@as(u64, 20), p.ns[@intFromEnum(Phase.d_rot)]);
+    try std.testing.expectEqual(@as(u64, 100), p.ns[@intFromEnum(Phase.a_q)]);
+    try std.testing.expectEqual(@as(u64, 1), p.chunks);
+    try std.testing.expectEqual(@as(u64, 0), p.cursor);
+    try std.testing.expectEqual(@as(u64, 0), p.sub[@intFromEnum(Class.attn)]);
+    p.cut(10, .start); // the next chunk's first cut charges nothing
+    try std.testing.expectEqual(@as(u64, 80), p.ns[@intFromEnum(Phase.embed)]);
+}
+
+test "the phase list has no duplicates" {
+    for (phases) |name| {
+        var n: usize = 0;
+        for (phases) |other| n += @intFromBool(std.mem.eql(u8, name, other));
+        try std.testing.expectEqual(@as(usize, 1), n);
+    }
+}
