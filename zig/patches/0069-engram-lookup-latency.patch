+/// TF_DS_ENGRAM_METRICS (on; `0` turns it off): the latencies of the engine's reads of Engram's table rows (a decode round's, a prompt
+/// chunk's, a read-ahead's or TF_DS_ENGRAM_LEAD's), as a histogram for /metrics; read from HTTP threads as one copy
+/// (LaneHost publishes it on its engine thread). Null in Status unless the switch is on.
+pub const EngramStats = struct {
+    /// Reads per bucket (seconds), the last the ones past every edge.
+    counts: [bucket_edges.len + 1]u64 = @splat(0),
+    /// Seconds the reads summed to.
+    total: f64 = 0,
+    /// Reads counted.
+    n: u64 = 0,
