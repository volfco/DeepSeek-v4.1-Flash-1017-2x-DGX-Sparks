+/// TF_DS_ENGRAM_METRICS=0 turns the read timing off (on by default, as TF_DS_LOAD_PREFETCH is).
+pub fn metricsEnabled(v: ?[]const u8) bool {
+    return !std.mem.eql(u8, v orelse "1", "0");
+}
+
+/// TF_DS_ENGRAM_METRICS (on; `0` turns it off): every read of Engram's table rows timed into api.EngramStats'
+/// buckets, on atomics because the prompt's read-ahead and TF_DS_ENGRAM_LEAD's readers record off the engine thread.
+pub const ReadTiming = struct {
+    counts: [api.EngramStats.bucket_edges.len + 1]std.atomic.Value(u64) = @splat(std.atomic.Value(u64).init(0)),
+    ns: std.atomic.Value(u64) = .init(0),
+    n: std.atomic.Value(u64) = .init(0),
+
+    pub fn observe(t: *ReadTiming, ns: u64) void {
+        const s: f64 = @as(f64, @floatFromInt(ns)) / 1e9;
+        var i: usize = 0;
+        while (i < api.EngramStats.bucket_edges.len and s > api.EngramStats.bucket_edges[i]) i += 1;
+        _ = t.counts[i].fetchAdd(1, .monotonic);
+        _ = t.ns.fetchAdd(ns, .monotonic);
+        _ = t.n.fetchAdd(1, .monotonic);
+    }
+
+    pub fn snapshot(t: *const ReadTiming) api.EngramStats {
+        var out: api.EngramStats = .{};
+        for (t.counts, 0..) |c, i| out.counts[i] = c.load(.monotonic);
+        out.total = @as(f64, @floatFromInt(t.ns.load(.monotonic))) / 1e9;
+        out.n = t.n.load(.monotonic);
+        return out;
+    }
+};
+
+/// The read timing's clock (EngramHost.io, set with the switch); 0 when it keeps no time.
+pub fn readStamp(eh: *const EngramHost) u64 {
+    const io = eh.io orelse return 0;
+    return @intCast(std.Io.Timestamp.now(io, .awake).nanoseconds);
+}
