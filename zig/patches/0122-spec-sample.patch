+// TF_DS_SPEC_SAMPLE: a draft step's clean scores, the proposal q's arithmetic, run between the step's _bias and its
+// keyed noise. The Markov loop's _score maximises logit + bias (the bias row of the token the step reads: the cached
+// row when slot[tok] >= 0, else the step's staged row), so with T * gumbel added to the logits the draft is a draw from
+// q = softmax((logit + bias) / T). For every stream r with T > 0 this writes l = logits[v] + bias[v] (fp32) to
+// clean[r * c_row + v] for the `width` columns, and each block's partial of the row's normaliser after them: at
+// clean[r * c_row + width + 2 * blockIdx.x] the block's largest l (m) and then sum exp((l - m) / T) over its columns
+// (z: 0 for a block without columns). The host folds every block and rank in double (sampling.foldLse). grid
+// (TF_DS_SPEC_PARTS = 16, streams), 256 threads; per thread a running (max, sum) in f32, then a tree over the block.
+extern "C" __global__ void tf_ds_spec_clean_kernel(const float* logits, uint64_t l_row, uint32_t width,
+                                                   const TfDsKeyedRow* rows, const int64_t* tok, uint64_t t_stride,
+                                                   const int32_t* slot, const __half* cache, const __half* stage,
+                                                   uint64_t b_row, float* clean, uint64_t c_row) {
+    const TfDsKeyedRow k = rows[blockIdx.y];
+    if (!(k.temp > 0.0)) return;
+    const float inv_t = float(1.0 / fmax(k.temp, 1e-6));
+    const float* row = logits + uint64_t(blockIdx.y) * l_row;
+    const int64_t id = tok[uint64_t(blockIdx.y) * t_stride];
+    const int32_t at = slot[id];
+    const __half* bias = at >= 0 ? cache + uint64_t(at) * b_row : stage + uint64_t(blockIdx.y) * b_row;
+    float* out = clean + uint64_t(blockIdx.y) * c_row;
+    float m = -INFINITY;
+    float z = 0.0f;
+    for (uint32_t v = blockIdx.x * blockDim.x + threadIdx.x; v < width; v += gridDim.x * blockDim.x) {
+        const float l = row[v] + __half2float(bias[v]);
+        out[v] = l;
+        if (l > m) {
+            z = z * expf((m - l) * inv_t) + 1.0f;
+            m = l;
+        } else {
+            z += expf((l - m) * inv_t);
+        }
+    }
+    __shared__ float sm[256];
+    __shared__ float sz[256];
+    sm[threadIdx.x] = m;
+    sz[threadIdx.x] = z;
+    __syncthreads();
+    for (unsigned off = 128; off > 0; off >>= 1) {
+        if (threadIdx.x < off) {
+            const float m1 = sm[threadIdx.x], z1 = sz[threadIdx.x];
+            const float m2 = sm[threadIdx.x + off], z2 = sz[threadIdx.x + off];
+            if (z2 > 0.0f) {
+                if (!(z1 > 0.0f)) {
+                    sm[threadIdx.x] = m2;
+                    sz[threadIdx.x] = z2;
+                } else if (m2 > m1) {
+                    sz[threadIdx.x] = z1 * expf((m1 - m2) * inv_t) + z2;
+                    sm[threadIdx.x] = m2;
+                } else {
+                    sz[threadIdx.x] = z1 + z2 * expf((m2 - m1) * inv_t);
+                }
+            }
+        }
+        __syncthreads();
+    }
+    if (threadIdx.x == 0) {
+        out[width + 2 * blockIdx.x] = sm[0];
+        out[width + 2 * blockIdx.x + 1] = sz[0];
+    }
+}
+
+// TF_DS_SPEC_SAMPLE: out[i] = src[idx[i]] (fp32; idx < 0: -inf, an element this rank does not hold): the verify's
+// gather of the clean scores at the target's candidates and of the normaliser partials. One thread an index.
+extern "C" __global__ void tf_ds_gather_cols_kernel(const float* src, const long long* idx, long long n, float* out) {
+    const long long i = (long long)blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= n) return;
+    const long long c = idx[i];
+    out[i] = c < 0 ? -INFINITY : src[c];
+}
+
