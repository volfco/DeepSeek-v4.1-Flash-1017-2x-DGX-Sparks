+        while (off > 0) : (off /= 2) {
+            for (0..off) |i| {
+                const m1 = tm[i];
+                const z1 = tz[i];
+                const m2 = tm[i + off];
+                const z2 = tz[i + off];
+                if (!(z2 > 0.0)) continue;
+                if (!(z1 > 0.0)) {
+                    tm[i] = m2;
+                    tz[i] = z2;
+                } else if (m2 > m1) {
+                    tz[i] = z1 * @exp((m1 - m2) * inv_t) + z2;
+                    tm[i] = m2;
+                } else tz[i] = z1 + z2 * @exp((m2 - m1) * inv_t);
+            }
+        }
+        ms[b] = tm[0];
+        zs[b] = tz[0];
+    }
+}
