+    /// TF_DS_SPEC_SAMPLE: a sampled stream's drafted rows by the speculative accept rule over the target's served
+    /// distribution p (row q - 1's logits) and the drafter's proposal q (step q - 1's logits and the pass's Zq): accept
+    /// draft x when a tagged uniform at the row's position falls under min(1, p(x)/q(x)), else draw from the residual
+    /// max(p - q, 0) and stop. The rows past the first rejection keep the target's own draws (the path stops before
+    /// them). Both ranks run the same launches and hold the same numbers, so they decide alike.
+    fn speculate(self: *Lanes, w: be.Window, o: *be.Verified, l: *const Lane, logits: []const f32, row0: usize, V: usize) !void {
+        const m = self.m;
+        const d = &m.dr.?;
+        if (d.zq == 0 or l.dgen != self.spec_gen or w.held == 0) return;
+        const sm = w.stream.sampling orelse return;
+        if (sm.temperature <= 0) return;
+        var at: ?usize = null;
+        for (self.spec_ids[0..self.spec_n], 0..) |id, i| if (id != null and id.? == w.stream) {
+            at = i;
+            break;
+        };
+        const i = at orelse return;
+        const s = sampling.Sampling{ .seed = sm.seed, .temperature = sm.temperature, .top_k = @intCast(sm.top_k), .top_p = sm.top_p, .min_p = sm.min_p };
+        const lw = d.mk.rowCols();
+        const col0: i64 = @intCast(d.mk.col0());
+        const lwi: i64 = @intCast(lw);
+        // only the drafter's held drafts are proposed: the host's tokens (a forced or copied window) keep the old rule
+        for (1..1 + w.held) |q| {
+            const x: i64 = o.drafts[q - 1];
+            const pos = w.positions[q - 1];
+            const p = try sampling.servedDist(logits[(row0 + q - 1) * V ..][0..V], s);
+            // the drafter's proposal at the candidate set and at x: each rank gathers its own columns, -1 elsewhere
+            var ids: [sampling.max_candidates + 1]i64 = undefined;
+            var gid: [sampling.max_candidates + 1]i64 = undefined;
+            var n: usize = 0;
+            for (p.ids[0..p.n]) |id| {
+                const c = id - col0;
+                ids[n] = if (c >= 0 and c < lwi) c else -1;
+                gid[n] = id;
+                n += 1;
+            }
+            ids[n] = if (x - col0 >= 0 and x - col0 < lwi) x - col0 else -1;
+            gid[n] = x;
+            n += 1;
+            try prompt.upload(&m.eng, d.gids, &ids, n * 8);
+            try m.ops.gatherCols(m.eng.s, d.local + 4 * (i * d.n + (q - 1)) * lw, lw, d.gids, n, d.gout);
+            const wide = (n + 3) / 4 * 4;
+            try m.eng.gatherF32(d.gout, d.gpeer, wide);
+            try m.eng.s.synchronize();
+            var got: [4 * (sampling.max_candidates + 4)]f32 = undefined;
+            try m.eng.d.check(m.eng.d.api.cuMemcpyDtoH_v2(&got, d.gpeer, m.eng.world * wide * 4), "cuMemcpyDtoH");
+            var qs: [sampling.max_candidates + 1]f64 = @splat(0.0);
+            const zq = d.spec_zq[i][q - 1];
+            const seed = d.spec_seeds[i];
+            for (0..n) |j| {
+                var v: f32 = -std.math.inf(f32);
+                for (0..m.eng.world) |r| v = @max(v, got[r * wide + j]);
+                if (v == -std.math.inf(f32) or zq <= 0) continue;
+                const g = sampling.gumbel(seed, pos, @bitCast(gid[j]));
+                qs[j] = sampling.expDiv(@as(f64, v) / sm.temperature - g, zq);
+            }
+            const y = sampling.speculateRow(sm.seed, pos, x, p, qs[0..p.n], qs[p.n]) orelse {
+                o.sampled[q - 1] = @intCast(x);
+                continue;
+            };
+            o.sampled[q - 1] = @intCast(y);
+            // the residual draw landed on the draft: it is accepted, and the rows past it were drafted along the path
+            // the target's own draws no longer follow, so the path stops there
+            if (y == x and q + 1 < w.rows()) o.sampled[q] = if (o.drafts[q] == 0) 1 else 0;
+            break;
+        }
+    }
+
     /// verifyFn's windows as both ranks build them (each stream's Lane: slot, extent, part, generation; its pending
     /// row, held drafts and host drafts), then the planner's round (kvRound: its frames go out before the verify's).
     fn roundWins(self: *Lanes, windows: []const be.Window, ids: *[max_streams][max_rows]i32, wins: *[max_streams]Win) !void {
@@ -1359,16 +1436,24 @@ fn chunkRows(start: usize, len: usize) usize {
             seeds[n] = 0;
             temps[n] = 0;
             if (r.stream.sampling) |sm| if (sm.temperature > 0) {
-                seeds[n] = sm.seed;
+                // TF_DS_SPEC_SAMPLE: the drafter's own key, tagged, independent of the sampler's
+                seeds[n] = if (m.ops.spec) sampling.tagged(sm.seed, sampling.draft_tag) else sm.seed;
                 temps[n] = sm.temperature;
                 sampled = true;
             };
+            if (m.ops.spec) {
+                self.spec_ids[n] = r.stream;
+                m.dr.?.spec_seeds[n] = seeds[n];
+                m.dr.?.spec_pos[n] = q0[n] + 1;
+            }
             depths[n] = @min(r.depth, block);
             asked[n] = l;
             steps = @max(steps, depths[n]);
             n += 1;
         }
         if (n == 0) return;
+        self.spec_n = n;
+        self.spec_gen += 1;
         // the sampler's keys go to the pass only with TF_DS_T26_KEYED_DRAFT (the drafter's kernel loaded) and a sampled stream
         const keyed = sampled and m.dr.?.nz != 0;
         if (try self.begin(if (keyed) .pass_keyed else .pass)) {
@@ -1399,6 +1484,7 @@ fn chunkRows(start: usize, len: usize) usize {
                 l.confs[j] = d.confs[i][j];
             }
             l.nheld = k;
+            l.dgen = self.spec_gen;
         }
     }
 
