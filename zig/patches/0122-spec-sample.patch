+/// TF_DS_SPEC_SAMPLE: the ranks a speculated pair runs (draft.Drafter.init refuses the switch on more).
+const spec_world = 2;
+
+/// TF_DS_SPEC_SAMPLE's verify gather as rank 0 plans it and the spec_q frame (kind 16) carries it: each speculated row's
+/// clean row in the last drafter pass (stream * block + step) and the global ids q is needed at (the target's
+/// candidates, then the draft when it is not one). Both ranks derive the gather's elements from it alike (`indices`,
+/// `wide`): a row's ids, then its 2 * ops.spec_parts normaliser partials, the rows one after another, padded to 4.
+pub const SpecPlan = struct {
+    n: usize = 0,
+    rows: [draft.spec_rows]u32 = undefined,
+    counts: [draft.spec_rows]u32 = undefined,
+    ids: [draft.spec_rows][sampling.max_candidates + 1]i32 = undefined,
+
+    pub fn add(p: *SpecPlan, row: usize, ids: []const i64, vocab: usize) !void {
+        if (p.n == draft.spec_rows or row >= draft.max_rows or ids.len == 0 or ids.len > sampling.max_candidates + 1) return error.BadSpecPlan;
+        for (ids, 0..) |id, j| {
+            if (id < 0 or id >= vocab) return error.BadSpecPlan;
+            p.ids[p.n][j] = @intCast(id);
+        }
+        p.rows[p.n] = @intCast(row);
+        p.counts[p.n] = @intCast(ids.len);
+        p.n += 1;
+    }
+
+    /// Where row k's elements start: every earlier row's ids and partials.
+    pub fn offset(p: *const SpecPlan, k: usize) usize {
+        var at: usize = 0;
+        for (p.counts[0..k]) |c| at += c + 2 * ops.spec_parts;
+        return at;
+    }
+
+    pub fn elems(p: *const SpecPlan) usize {
+        return p.offset(p.n);
+    }
+
+    /// The gather's count a rank (the elements padded to 4: the ring's float4 unit), every rank alike.
+    pub fn wide(p: *const SpecPlan) usize {
+        return (p.elems() + 3) / 4 * 4;
+    }
+
+    /// This rank's element indices into the clean rows (`sq_w` floats a row, its `lw` columns from global id `col0`,
+    /// then the partials): an id this rank's columns hold, else -1 (another rank's: -inf, the max over the ranks takes
+    /// the holder's); a row's partials on every rank. Returns the elements written.
