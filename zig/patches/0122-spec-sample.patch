diff --git a/zig/kernels/cuda/dsv41_ops.cu b/zig/kernels/cuda/dsv41_ops.cu
index be76fe9..5e86af1 100644
--- a/zig/kernels/cuda/dsv41_ops.cu
+++ b/zig/kernels/cuda/dsv41_ops.cu
@@ -679,20 +679,46 @@ __device__ __forceinline__ uint64_t tf_ds_mix64(uint64_t x) {
 }
 
 // grid (ceil(width / blockDim), streams); the row table is device memory so a captured graph reads each pass's seeds.
+// TF_DS_SPEC_SAMPLE: `zq` (when non-null) takes each row's sum of exp(logit / T) over the full vocabulary, the drafter's
+// proposal normaliser Zq, read before the noise is added: block-level reduction, one atomicAdd per block.
 extern "C" __global__ void tf_ds_keyed_noise_kernel(float* logits, uint64_t l_row, uint32_t width, uint64_t col0,
-                                                    const TfDsKeyedRow* rows, uint32_t step) {
+                                                    const TfDsKeyedRow* rows, uint32_t step, double* zq,
+                                                    uint32_t zq_stride) {
     const TfDsKeyedRow k = rows[blockIdx.y];
     if (!(k.temp > 0.0)) return;
     const double t = fmax(k.temp, 1e-6);
     const uint64_t pos = uint64_t(k.pos) + step;
     float* row = logits + uint64_t(blockIdx.y) * l_row;
+    double sum = 0.0;
     for (uint32_t v = blockIdx.x * blockDim.x + threadIdx.x; v < width; v += gridDim.x * blockDim.x) {
+        const double l = double(row[v]);
+        if (zq != nullptr) sum += exp(l / t);
         uint64_t x = tf_ds_mix64(k.seed + 0x9E3779B97F4A7C15ull);
         x = tf_ds_mix64(x ^ (pos * 0xD1B54A32D192ED03ull));
         x = tf_ds_mix64(x ^ (col0 + v));
         const double u = double(x >> 11) * 0x1p-53 + 0x1p-54;
         row[v] += float(t * -log(-log(u)));
     }
+    if (zq == nullptr) return;
+    __shared__ double acc[256];
+    acc[threadIdx.x] = sum;
+    __syncthreads();
+    for (int off = 128; off > 0; off >>= 1) {
+        if (threadIdx.x < off) acc[threadIdx.x] += acc[threadIdx.x + off];
+        __syncthreads();
+    }
+    if (threadIdx.x == 0) atomicAdd(&zq[uint64_t(step) * zq_stride + blockIdx.y], acc[0]);
+}
+
+// TF_DS_SPEC_SAMPLE: out[i] = the logits row's column ids[i] (a rank-local column of the drafter's own vocabulary
+// part; -1: -inf, this rank does not score it). One thread an id.
+extern "C" __global__ void tf_ds_gather_cols_kernel(const float* logits, unsigned long long ld, const long long* ids,
+                                                    long long n, float* out) {
+    const long long i = (long long)blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= n) return;
+    (void)ld;
+    const long long c = ids[i];
+    out[i] = c < 0 ? -INFINITY : logits[c];
 }
 
 // TF_DS_T27_DEVICE_DRAW: a sampled row's token on the device, sampling.zig's sampleRow. One block (1024 threads) a row
diff --git a/zig/src/families/dsv41/draft.zig b/zig/src/families/dsv41/draft.zig
index 32d427d..8269ddf 100644
--- a/zig/src/families/dsv41/draft.zig
+++ b/zig/src/families/dsv41/draft.zig
@@ -25,6 +25,7 @@ const exl3_experts = @import("exl3_experts.zig");
 const markov_tokens = @import("markov_tokens.zig");
 const draft2d = @import("draft2d.zig");
 const lora = @import("lora.zig");
+const sampling = @import("sampling.zig");
 
 const ops_mod = @import("ops.zig");
 
@@ -116,18 +117,27 @@ const NoiseTap = struct {
         const x: *NoiseTap = @ptrCast(@alignCast(ctx));
         const mk = x.dr.mk;
         const lw = mk.rowCols();
-        try x.e.ops.keyedNoise(x.e.s, x.dr.local + 4 * step * lw, x.dr.n * lw, lw, mk.col0(), x.dr.nz, step, x.n);
+        try x.e.ops.keyedNoise(x.e.s, x.dr.local + 4 * step * lw, x.dr.n * lw, lw, mk.col0(), x.dr.nz, step, x.n, x.dr.zq, max_streams);
     }
 };
 
-/// The per-step gather of the Markov loop's bests: [world, rows, 4] fp32 into dst.
+/// The per-step gather of the Markov loop's bests: [world, rows, 4] fp32 into dst, and with TF_DS_SPEC_SAMPLE this
+/// rank's proposal normalisers (Zq) for the step gathered into the peer's slots.
 const MarkovGather = struct {
     e: *const Engine,
+    dr: *const Drafter,
     dst: u64,
+    n: usize,
+    step: usize = 0,
 
     fn run(ctx: *anyopaque, send: u64, rows: usize) anyerror!u64 {
         const g: *MarkovGather = @ptrCast(@alignCast(ctx));
         try g.e.gatherF32(send, g.dst, rows * 4);
+        if (g.dr.zq != 0) {
+            const at = 8 * g.step * max_streams;
+            try g.e.gatherF64(g.dr.zq + at, g.dr.zqp + 8 * g.step * g.e.world * max_streams, g.n);
+            g.step += 1;
+        }
         return g.dst;
     }
 };
@@ -233,6 +243,16 @@ pub const Drafter = struct {
     mg: u64, // fp32 [world, max_streams, 4]: a step's gathered bests
     out: u64, // int64 [max_streams, n + 1]: each stream's last token, then its drafts
     nz: u64 = 0, // ops.KeyedRow [max_streams] (TF_DS_T26_KEYED_DRAFT; 0: off): each stream's seed, temperature and first draft position
+    // TF_DS_SPEC_SAMPLE (0: off): the drafter's proposal normalisers Zq a step (this rank's sum over its columns of
+    // exp(logit / T), the peer's gathered) and the small id gather a verify round makes against a step's logits row
+    zq: u64 = 0, // double [max_block * max_streams], step-major: this rank's sums
+    zqp: u64 = 0, // double [max_block * world * max_streams]: the ranks' sums, gathered
+    gids: u64 = 0, // i64 [max_candidates + 1]: the ids a verify gathers
+    gout: u64 = 0, // f32 [max_candidates + 1]
+    gpeer: u64 = 0, // f32 [world * (max_candidates + 4)]
+    spec_seeds: [max_streams]u64 = @splat(0), // their drafter seeds (the sampler's, tagged)
+    spec_pos: [max_streams]i64 = @splat(0), // their step-0 draft position
+    spec_zq: [max_streams][max_block]f64 = undefined, // the last pass's Zq a stream and step, every rank summed
     // the confidence head
     embs: u64, // bf16 [max_rows, rank]: the Markov embedding rows of the tokens each step read
     xcf: u64, // fp32 [max_rows, D]
@@ -362,6 +382,13 @@ pub const Drafter = struct {
         dr.mg = try a.take(dr.mk.world * max_streams * 4 * 4);
         dr.out = try a.take(max_streams * (max_block + 1) * 8);
         dr.nz = if (e.ops.keyed_noise != null) try a.take(max_streams * @sizeOf(ops_mod.KeyedRow)) else 0;
+        if (e.ops.spec) {
+            dr.zq = try a.take(max_block * max_streams * 8);
+            dr.zqp = try a.take(max_block * e.world * max_streams * 8);
+            dr.gids = try a.take((sampling.max_candidates + 1) * 8);
+            dr.gout = try a.take((sampling.max_candidates + 1) * 4);
+            dr.gpeer = try a.take(e.world * (sampling.max_candidates + 4) * 4);
+        }
         // the confidence head
         const rank = c.markov_rank;
         dr.embs = try a.take(R * rank * 2);
@@ -517,6 +544,17 @@ pub const Drafter = struct {
             dr.drafts[i][j] = ho[i * ts + 1 + j];
             dr.confs[i][j] = hc[i * steps + j];
         };
+        // TF_DS_SPEC_SAMPLE: the pass's Zq a stream and step, every rank's sum (the gathered table holds each rank's
+        // slice at rank * max_streams; world is 2 or 4)
+        if (dr.zq != 0) {
+            var hz: [max_block * 4 * max_streams]f64 = undefined;
+            try e.d.check(e.d.api.cuMemcpyDtoH_v2(&hz, dr.zqp, steps * e.world * max_streams * 8), "cuMemcpyDtoH");
+            for (0..N) |i| for (0..steps) |j| {
+                var z: f64 = 0;
+                for (0..e.world) |r| z += hz[j * e.world * max_streams + r * max_streams + i];
+                dr.spec_zq[i][j] = z;
+            };
+        }
         dr.streams = N;
         dr.steps = steps;
     }
@@ -566,7 +604,8 @@ pub const Drafter = struct {
         try Probe.check(probe, .local, S, dr.local);
         // the Markov loop: out [N, steps + 1], each stream's last token first
         const ts = steps + 1;
-        var g: MarkovGather = .{ .e = e, .dst = dr.mg };
+        if (dr.zq != 0) try e.d.check(e.d.api.cuMemsetD8Async(dr.zq, 0, max_block * max_streams * 8, e.s.handle), "cuMemsetD8Async");
+        var g: MarkovGather = .{ .e = e, .dr = dr, .dst = dr.mg, .n = N };
         var nt: NoiseTap = .{ .e = e, .dr = dr, .n = N };
         const noise: ?tri_markov.Tap = if (noisy) .{ .ctx = &nt, .run = NoiseTap.run } else null;
         try dr.mk.stepsWith(t, dr.local, dr.out, ts, N, n, steps, dr.msc, .{ .ctx = &g, .run = MarkovGather.run }, noise);
