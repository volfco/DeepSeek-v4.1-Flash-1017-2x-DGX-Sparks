+test "the draft, accept and residual keys are independent of the sampler's and of each other" {
+    const seed: u64 = 12345;
+    const pos: u64 = 99;
+    const id: u64 = 7;
+    const d = uniform(tagged(seed, draft_tag), pos, id);
+    const a = uniform(tagged(seed, accept_tag), pos, id);
+    const r = uniform(tagged(seed, residual_tag), pos, id);
+    try std.testing.expect(d != a and a != r and d != r);
+    try std.testing.expect(d != uniform(seed, pos, id));
+    try std.testing.expect(tagged(seed, draft_tag) != tagged(seed, accept_tag));
+}
