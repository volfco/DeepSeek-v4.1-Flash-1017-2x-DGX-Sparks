         const n_rows = rows.ids.len;
         var draw_tab: [round.max_rows]ops.DrawRow = undefined;
         if (path == .device_draw) {
@@ -1296,10 +1304,79 @@ fn chunkRows(start: usize, len: usize) usize {
             }
             @memcpy(o.drafts[0..w.held], l.held[0..w.held]);
