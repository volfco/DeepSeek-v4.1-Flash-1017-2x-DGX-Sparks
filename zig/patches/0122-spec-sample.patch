+        seen: [3]usize = undefined,
+        n: usize = 0,
+        fn gather(_: *anyopaque, _: u64, _: usize) anyerror!u64 {
+            return 0x7d00_0000_0000;
+        }
+        fn mid(ctx: *anyopaque, step: usize) anyerror!void {
