+test "spec gather layout: rank r's values at r * wide, fewer rows than the bound, and q from them sums to 1" {
+    // a toy vocabulary of 64 over two ranks (32 columns each), two speculated rows of a three-stream pass
+    const V = 64;
+    const lw = 32;
+    const sq_w = lw + 2 * ops.spec_parts;
+    var p: SpecPlan = .{};
+    try p.add(1 * 5 + 0, &.{ 3, 40, 63, 7 }, V);
+    try p.add(2 * 5 + 2, &.{ 31, 32 }, V);
+    // each rank's clean rows (only the two rows matter) and its partials: the row's whole (max, sum) in block 0
+    const t = 0.05;
+    var sq: [2][draft.max_rows * sq_w]f32 = undefined;
+    for (0..2) |rk| for (0..draft.max_rows) |row| {
+        const r = sq[rk][row * sq_w ..][0..sq_w];
+        var mx = -std.math.inf(f32);
+        for (0..lw) |c| {
+            const id = rk * lw + c;
+            r[c] = 30.0 + 0.25 * @as(f32, @floatFromInt((id * 7 + row) % 13));
+            mx = @max(mx, r[c]);
+        }
+        var z: f64 = 0;
+        for (r[0..lw]) |l| z += @exp((@as(f64, l) - mx) / t);
+        @memset(r[lw..], 0);
+        r[lw] = mx;
+        r[lw + 1] = @floatCast(z);
+    };
+    // each rank's gather (tf_ds_gather_cols_kernel), then the all-gather's layout
+    const wide = p.wide();
+    var got: [spec_world * draft.spec_elems]f32 = undefined;
+    for (0..2) |rk| {
+        var idx: [draft.spec_elems]i64 = undefined;
+        const n = p.indices(rk * lw, lw, sq_w, &idx);
+        try std.testing.expectEqual(p.elems(), n);
+        for (idx[0..n], 0..) |c, e| got[rk * wide + e] = if (c < 0) -std.math.inf(f32) else sq[rk][@intCast(c)];
+    }
+    for (0..p.n) |k| {
+        const v = specValues(&p, k, got[0 .. 2 * wide], wide, 2).?;
+        try std.testing.expectEqual(@as(usize, p.counts[k]), v.n);
+        // each id's clean score is its holder's
+        for (p.ids[k][0..v.n], v.l[0..v.n]) |id, l| {
+            const rk: usize = @intCast(@divFloor(id, lw));
+            try std.testing.expectEqual(@as(f64, sq[rk][p.rows[k] * sq_w + @as(usize, @intCast(@mod(id, lw)))]), l);
+        }
+        // rank 1's partials come from its own slice (r * wide), not rank 0's
+        try std.testing.expectEqual(sq[1][p.rows[k] * sq_w + lw], v.ms[ops.spec_parts]);
+        try std.testing.expectEqual(sq[0][p.rows[k] * sq_w + lw], v.ms[0]);
+        const z = sampling.foldLse(&v.ms, &v.zs, t).?;
+        var sum: f64 = 0;
+        for (0..2) |rk| for (sq[rk][p.rows[k] * sq_w ..][0..lw]) |l| {
+            sum += @exp(z.logQ(l));
+        };
+        try std.testing.expectApproxEqAbs(@as(f64, 1.0), sum, 1e-5);
+    }
+    // an id no rank holds (both -inf) refuses the row
+    var lost = got;
+    lost[p.offset(1)] = -std.math.inf(f32);
+    lost[wide + p.offset(1)] = -std.math.inf(f32);
+    try std.testing.expect(specValues(&p, 1, lost[0 .. 2 * wide], wide, 2) == null);
+    try std.testing.expect(specValues(&p, 0, lost[0 .. 2 * wide], wide, 2) != null);
+}
