+    for (counts, ps) |c, p| {
+        const e = @as(f64, @floatFromInt(n)) * p;
+        const d = @as(f64, @floatFromInt(c)) - e;
+        x += d * d / e;
+    }
+    return x;
+}
+
+test "the accept rule and the residual over toy p and q: q(x) = 0 accepts, p(x) = 0 rejects, p == q accepts, a draft off p's support takes the residual" {
+    const ids = [_]i64{ 10, 20, 30, 40 };
+    var p: Dist = .{ .n = 4 };
+    p.ids[0..4].* = ids;
+    p.p[0..4].* = .{ 0.2, 0.3, 0.25, 0.25 };
+    const q = [_]f64{ 0.4, 0.2, 0.2, 0.2 };
+    // q(x) = 0: accepted
+    try std.testing.expect(speculateRow(3, 11, 10, p, &q, 0.0) == null);
+    // p(x) = 0 (x off p's candidates): rejected, and the residual is a candidate
+    const y = speculateRow(3, 11, 77, p, &q, 0.25);
+    try std.testing.expect(y != null and y.? != 77 and p.prob(y.?) > 0.0);
+    // p == q: every draw accepted
+    var same = p;
+    same.p[0..4].* = q;
+    try std.testing.expect(speculateRow(3, 11, 10, same, &q, 0.4) == null);
+    // disjoint supports: q has no mass on p's candidates, so every draft is rejected and the residual is p
+    var none: Dist = .{ .n = 4 };
+    none.ids[0..4].* = ids;
+    none.p[0..4].* = .{ 0.1, 0.2, 0.3, 0.4 };
+    const zero = [_]f64{ 0.0, 0.0, 0.0, 0.0 };
+    var seen: [4]usize = @splat(0);
+    for (0..1000) |i| seen[@intCast(@divTrunc(speculateRow(i, 12, 55, none, &zero, 1.0).? - 10, 10))] += 1;
+    try std.testing.expect(chi2(&seen, 1000, none.p[0..4]) < 11.34);
+}
