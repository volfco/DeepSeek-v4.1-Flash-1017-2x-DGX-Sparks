+test "the proposal normaliser stays finite at large logits and small T: q sums to 1 where exp(l / T) overflows" {
+    const V = 6000;
+    var row: [V]f32 = undefined;
+    for (&row, 0..) |*l, v| l.* = 30.0 - 0.0137 * @as(f32, @floatFromInt(v % 997)) + 0.5 * @as(f32, @floatFromInt(v % 3));
+    for ([_]f64{ 1.0, 0.7, 0.04, 1e-3, 1e-7 }) |temp| {
+        const t = draftTemp(temp);
+        // two ranks, each its half of the columns in 16 blocks of 256 threads (the kernel's launch)
+        var ms: [32]f32 = undefined;
+        var zs: [32]f32 = undefined;
+        kernelPartials(row[0 .. V / 2], t, 16, 256, ms[0..16], zs[0..16]);
+        kernelPartials(row[V / 2 ..], t, 16, 256, ms[16..32], zs[16..32]);
+        const z = foldLse(&ms, &zs, t).?;
+        try std.testing.expect(std.math.isFinite(z.m) and std.math.isFinite(z.lz) and z.lz >= 0.0);
+        var sum: f64 = 0.0;
+        for (row) |l| {
+            const lq = z.logQ(l);
+            try std.testing.expect(!std.math.isNan(lq) and lq <= 1e-9);
+            sum += exp(lq);
+        }
+        try std.testing.expectApproxEqAbs(@as(f64, 1.0), sum, 1e-5);
+        if (temp <= 0.04) try std.testing.expect(std.math.isInf(exp(@as(f64, row[0]) / t))); // the unshifted sum overflows
+    }
+    // the clamp: T = 0 is the kernel's 1e-6
+    try std.testing.expectEqual(@as(f64, 1e-6), draftTemp(0.0));
+}
+
+test "folding partials: empty blocks are skipped, a non-finite one refuses the row" {
+    const t = 0.5;
+    // one block holds a single column l = 2, another e^0 + e^-2 at max 1 (columns 1 and 0), a third is empty
+    const z = foldLse(&.{ 2.0, 1.0, -std.math.inf(f32) }, &.{ 1.0, 1.0 + @as(f32, @floatCast(exp(-2.0))), 0.0 }, t).?;
+    try std.testing.expectEqual(@as(f64, 2.0), z.m);
+    const want = log(1.0 + exp(-2.0) + exp(-4.0));
+    try std.testing.expectApproxEqAbs(want, z.lz, 1e-7);
+    try std.testing.expectApproxEqAbs(@as(f64, 1.0), exp(z.logQ(2.0)) + exp(z.logQ(1.0)) + exp(z.logQ(0.0)), 1e-7);
+    try std.testing.expect(foldLse(&.{ 2.0, std.math.nan(f32) }, &.{ 1.0, 1.0 }, t) == null);
+    try std.testing.expect(foldLse(&.{ 2.0, 1.0 }, &.{ 1.0, std.math.inf(f32) }, t) == null);
+    try std.testing.expect(foldLse(&.{ -std.math.inf(f32), -std.math.inf(f32) }, &.{ 0.0, 0.0 }, t) == null);
+}
+
+test "the draft, accept and residual keys are independent of the sampler's and of each other" {
+    const seed: u64 = 12345;
+    const pos: u64 = 99;
+    const id: u64 = 7;
+    const d = uniform(tagged(seed, draft_tag), pos, id);
+    const a = uniform(tagged(seed, accept_tag), pos, id);
+    const r = uniform(tagged(seed, residual_tag), pos, id);
+    try std.testing.expect(d != a and a != r and d != r);
+    try std.testing.expect(d != uniform(seed, pos, id));
+    try std.testing.expect(tagged(seed, draft_tag) != tagged(seed, accept_tag));
+}
