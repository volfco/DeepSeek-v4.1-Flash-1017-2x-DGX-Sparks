+test "the emitted token follows p over 200K seeds, one row and a three-draft block" {
+    const ids = [_]i64{ 10, 20, 30, 40 };
+    var p: Dist = .{ .n = 4 };
+    p.ids[0..4].* = ids;
+    p.p[0..4].* = .{ 0.2, 0.3, 0.25, 0.25 };
+    const q = [_]f64{ 0.4, 0.2, 0.2, 0.2 };
+    const n = 200_000;
+    var first: [4]usize = @splat(0);
+    var second: [4]usize = @splat(0);
+    var third: [4]usize = @splat(0);
+    var n2: usize = 0;
+    var n3: usize = 0;
+    for (0..n) |i| {
+        const seed = i * 7 + 1;
+        var t: [3]i64 = @splat(0);
+        var rows: usize = 0;
+        for (0..3) |r| {
+            const x = sampleWeights(&ids, &q, 100 + r, tagged(seed, draft_tag)).?;
+            const y = speculateRow(seed, 100 + r, x, p, &q, q[@intCast(@divTrunc(x - 10, 10))]);
+            t[r] = y orelse x;
+            rows += 1;
+            if (y != null) break;
+        }
+        first[@intCast(@divTrunc(t[0] - 10, 10))] += 1;
+        if (rows > 1) {
+            second[@intCast(@divTrunc(t[1] - 10, 10))] += 1;
+            n2 += 1;
+        }
+        if (rows > 2) {
+            third[@intCast(@divTrunc(t[2] - 10, 10))] += 1;
+            n3 += 1;
+        }
+    }
+    try std.testing.expect(chi2(&first, n, p.p[0..4]) < 11.34);
+    try std.testing.expect(chi2(&second, n2, p.p[0..4]) < 11.34);
+    try std.testing.expect(chi2(&third, n3, p.p[0..4]) < 11.34);
+}
