+// The same selection from the block maxima in global memory (block_max's output): the small-row form's second launch,
+// one CTA a row. The maxima are staged on chip once, so the radix passes and the compaction stay shared-memory work.
+extern "C" __global__ void __launch_bounds__(1024) tf_ds_idx_pick_kernel(const float* bmax, long long bs, int nbk, int k,
+                                                                        const long long* every, int* cblk, int pdl) {
+    pdl_enter(pdl);
+    const int r = blockIdx.x;
+    extern __shared__ float maxima[];
+    const float* src = bmax + (long long)r * bs;
+    for (int b = threadIdx.x; b < nbk; b += blockDim.x) maxima[b] = src[b];
+    __syncthreads();
+    tf_ds_idx_select(maxima, nbk, k, nullptr, 0, cblk, r, every[r]);
+}
