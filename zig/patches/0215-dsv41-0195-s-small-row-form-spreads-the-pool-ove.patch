+extern "C" __global__ void __launch_bounds__(1024) tf_ds_idx_fused_kernel(const float* score, long long ss, int width,
+                                                                          int bsize, const long long* vis,
+                                                                          const long long* every, int k,
+                                                                          uint8_t* mask, long long ms, int* cblk,
+                                                                          int pdl) {
