+    const int r = blockIdx.x;
+    const int nb = 1 + (width - 1) / bsize;
+    extern __shared__ float maxima[];
+    const float* row = score + (long long)r * ss;
+    // phase 1: the block maxima; the served block size with a 16-byte-aligned row stride takes the static, vectorized
+    // form, anything else the runtime loop (the same arithmetic, so both are byte-identical)
+    const long long visible = vis[r];
+    const long long last = visible > 0 ? (visible - 1) / bsize : -1;
+    if (bsize == 8 && (ss & 3) == 0) tf_ds_block_max_t<8>(maxima, row, width, nb, last);
+    else tf_ds_block_max_t<0>(maxima, row, width, nb, last, bsize);
+    __syncthreads();
+    tf_ds_idx_select(maxima, nb, k, mask, ms, cblk, r, every[r]);
+}
