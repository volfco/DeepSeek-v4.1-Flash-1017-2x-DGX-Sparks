             if (eh.lead_on) m.lead.reset(eh);
diff --git a/zig/src/families/dsv41/prompt.zig b/zig/src/families/dsv41/prompt.zig
index 3388b3f..e467359 100644
--- a/zig/src/families/dsv41/prompt.zig
+++ b/zig/src/families/dsv41/prompt.zig
@@ -1471,6 +1471,14 @@ pub const EngramHost = struct {
     d_vals: []u32 = &.{},
     d_row_w: usize = 0,
     d_row_s: usize = 0,
+    // TF_DS_ENGRAM_FAST: the rows' decode on the host's decode threads (null: engram.decodeRows' spawn a call)
+    dpool: ?*engram_io.DecodePool = null,
+    // TF_DS_ENGRAM_FAST: the chunk `hashes` holds for the fallback path's second layer, and the sequence it was hashed
+    // from (forgetHashes clears it: a round's engramAhead writes the same buffer, and every pass resets it)
+    hash_start: usize = std.math.maxInt(usize),
+    hash_n: usize = 0,
+    hash_seq: [*]const i32 = undefined,
+    hash_seq_len: usize = 0,
     t_hash: u64 = 0,
     t_read: u64 = 0,
     t_decode: u64 = 0,
@@ -1550,6 +1558,25 @@ pub const EngramHost = struct {
         };
     }
 
+    /// TF_DS_ENGRAM_FAST: the rows' FP8 -> bf16 decode, on the host's decode threads when it has them (else the spawn a
+    /// call engram.decodeRows does). Only one caller decodes at a time (a chunk's reader is joined before its layers).
+    pub fn decode(eh: *EngramHost, w: []const u8, s: []const u8, out: []u16, m: usize, row_w: usize, row_s: usize) void {
+        if (eh.dpool) |dp| return dp.decode(w, s, out, m, row_w, row_s);
+        engram.decodeRows(w, s, out, m, row_w, row_s, 8);
+    }
+
+    /// The fallback path's hashes: once for both layers, reused at the second layer of the same chunk and sequence
+    /// (TF_DS_ENGRAM_FAST). forgetHashes clears it wherever `hashes` is written by someone else.
+    fn hashesFor(eh: *EngramHost, seq: []const i32, start: usize, n: usize) void {
+        const cols = eh.hasher.cols();
+        if (eh.hasher.fast and eh.hash_start == start and eh.hash_n == n and eh.hash_seq == seq.ptr and eh.hash_seq_len == seq.len) return;
+        eh.hasher.hashes(seq, start, n, eh.hashes[0 .. n * eh.hasher.layers * cols]);
+        eh.hash_start = start;
+        eh.hash_n = n;
+        eh.hash_seq = seq.ptr;
+        eh.hash_seq_len = seq.len;
+    }
+
     /// TF_DS_ENGRAM_DEDUPE: the buffers a prompt chunk's distinct rows are read into (the largest layer's row widths), and
     /// the open-addressing map from a row id to its row in them (twice the chunk's ids, a power of two).
     pub fn useDedupe(eh: *EngramHost, gpa: std.mem.Allocator, c: *const Config, cap: usize) !void {
@@ -1583,6 +1610,13 @@ pub const EngramHost = struct {
     }
 };
 
+/// TF_DS_ENGRAM_FAST=1 turns the host-side economies on (all bit-identical): the reciprocal modulo the hasher's columns,
+/// a chunk's decode on the host's decode threads instead of a spawn a call, the fallback path's hashes kept for the second
+/// layer, and TF_DS_ENGRAM_AIO_SLOTS over the prompt ring's slots.
+pub fn fastEnabled(v: ?[]const u8) bool {
+    return std.mem.eql(u8, v orelse "0", "1");
+}
+
 /// TF_DS_ENGRAM_DEDUPE=1 turns the prompt chunks' row dedupe on (off by default; the bytes are the same either way).
 pub fn dedupeEnabled(v: ?[]const u8) bool {
     return std.mem.eql(u8, v orelse "0", "1");
@@ -1683,6 +1717,12 @@ pub fn trimTables(eh: *EngramHost, c: *const Config, io: std.Io) void {
     std.log.info("dsv41: Engram trim: punched {d} MiB this rank never reads (columns {d}..{d})", .{ freed >> 20, eh.lo, eh.hi });
 }
 
+/// TF_DS_ENGRAM_FAST's hash cache: forget the chunk `hashes` holds (a round's engramAhead wrote it, or a new pass started).
+pub fn forgetHashes(eh: *EngramHost) void {
+    eh.hash_start = std.math.maxInt(usize);
+    eh.hash_seq_len = 0;
+}
+
 /// Rows `ids` of table `t` into out_w / out_s: on the AIO ring when given, else the pool's preads. With `dedupe` and the
 /// switch on, the distinct ids are read once and their rows copied to the repeats (exact: the same id is the same bytes),
 /// so the n-grams a prompt repeats cost one read instead of one each.
@@ -1743,7 +1783,7 @@ fn engramAhead1(eh: *EngramHost, c: *const Config, seq: []const i32, start: usiz
     const t0 = if (timed) readStamp(eh) else 0;
     try engramReadRows(eh, eh.paio, t, eh.ahead_flat[j][0..m], eh.ahead_w[j][0 .. m * t.row_w], eh.ahead_s[j][0 .. m * t.row_s], true);
     if (timed) eh.reads.observe(readStamp(eh) - t0);
-    engram.decodeRows(eh.ahead_w[j][0 .. m * t.row_w], eh.ahead_s[j][0 .. m * t.row_s], eh.ahead_rows[j][0 .. m * t.row_w], m, t.row_w, t.row_s, 8);
+    eh.decode(eh.ahead_w[j][0 .. m * t.row_w], eh.ahead_s[j][0 .. m * t.row_s], eh.ahead_rows[j][0 .. m * t.row_w], m, t.row_w, t.row_s);
     eh.ahead_ready[j] = true;
 }
 
@@ -1857,6 +1897,11 @@ test "unreadRows: each rank's dead range is the other rank's buckets" {
     try std.testing.expectEqual(rows, (r0[1][0] - r0[0][1]) + (r1[1][0] - r1[0][1]));
 }
 
+test "TF_DS_ENGRAM_FAST: only 1 turns the host-side economies on" {
+    try std.testing.expect(fastEnabled("1"));
+    for ([_]?[]const u8{ null, "", "0", "2", "on", "true", " 1", "1 " }) |v| try std.testing.expect(!fastEnabled(v));
