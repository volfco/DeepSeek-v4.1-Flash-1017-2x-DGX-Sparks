     const t0 = if (timed) prompt.readStamp(eh) else 0;
     try prompt.engramReadRows(eh, ring, t, eh.ahead_flat[j][0..m], eh.ahead_w[j][0 .. m * t.row_w], eh.ahead_s[j][0 .. m * t.row_s], true);
