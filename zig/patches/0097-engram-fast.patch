From 0000000000000000000000000000000000000097 Mon Sep 17 00:00:00 2001
From: colum <colum@users.noreply.github.com>
Date: Tue, 11 Nov 2026 10:30:00 +0000
Subject: [PATCH] dsv41: TF_DS_ENGRAM_FAST=1 takes the host-side economies off
 the Engram path

Four host-side costs a chunk paid for, all of them bit-identical, behind one switch for an A/B:

- the hash's modulo by a reciprocal (Granlund-Montgomery) instead of a 64-bit divide a column: 48 divisions
  a position become a multiply-high and a conditional subtract. `Mod` is tested against @mod for every prime
  and 5,000 values each, minInt and maxInt included;
- a chunk's rows decoded on 8 decode threads of the host's (engram_io.DecodePool) instead of
  engram.decodeRows spawning 8 threads a call (two calls a chunk, ~16 spawns);
- the fallback path's hashes kept for the chunk's second layer instead of hashed twice, keyed by the chunk and
  the sequence and forgotten wherever someone else writes the buffer (a round's engramAhead, every pass's
  resetEngramAhead);
- TF_DS_ENGRAM_AIO_SLOTS over the prompt ring's slots (64..65,536; unset: 4,096), for an A/B of its depth.

Each is what the profile said was left in the host's part of a chunk; the read-ahead hides the I/O, so these are
the CPU and the hash's start latency, not the read. Expect under 1 % of a chunk each, and the switch exists to
measure them rather than to claim them.

Tests: engram.zig (Mod against @mod, every prime, 5,000 random values and the edges), prompt.zig (the switch's
values), and the decode pool is exercised by the dedupe test's chunk when the switch is on. Not run on a pair;
`TF_DS_ENGRAM_FAST=0` is the engine unchanged.

---
diff --git a/zig/src/families/dsv41/engram.zig b/zig/src/families/dsv41/engram.zig
index 589b665..19ace85 100644
--- a/zig/src/families/dsv41/engram.zig
+++ b/zig/src/families/dsv41/engram.zig
@@ -62,6 +62,29 @@ pub fn primes(c: Config, out: *[max_layers][max_cols]i64) void {
     }
 }
 
+/// A bucket prime's division by a reciprocal (Granlund-Montgomery): M = floor((2^64 - 1) / p), so mulhi(u, M) is u / p's
+/// true quotient or one less and one conditional subtract is exact; `s` = 2^64 mod p folds a negative rolling value back
+/// in (an i64 bit-cast to u64 is a + 2^64). The same result as @mod for every input (tested).
+pub const Mod = struct {
+    m: u64,
+    p: u64,
+    s: u64,
+
+    pub fn init(p: u64) Mod {
+        const m = (~@as(u64, 0)) / p;
+        return .{ .m = m, .p = p, .s = 0 -% (m *% p) };
+    }
+
+    pub fn of(self: Mod, a: i64) u64 {
+        const u: u64 = @bitCast(a);
+        const q: u64 = @intCast((@as(u128, u) * self.m) >> 64);
+        var r = u - q * self.p; // q <= u / p: no wrap, and r < 2p
+        if (r >= self.p) r -= self.p;
+        if (a < 0) r = if (r >= self.s) r - self.s else r + self.p - self.s;
+        return r;
+    }
+};
+
 /// Row ids of positions [start, start + n) of a sequence, as the served engine reads Engram tables.
 pub const Hasher = struct {
     layers: usize,
@@ -69,6 +92,9 @@ pub const Hasher = struct {
     heads: usize,
     primes: [max_layers][max_cols]i64 = undefined,
     offsets: [max_layers][max_cols]i64 = undefined,
+    mods: [max_layers][max_cols]Mod = undefined,
+    /// TF_DS_ENGRAM_FAST: the hash's modulo by `mods` instead of a divide a column (same ids, tested).
+    fast: bool = false,
     mult: [max_layers][max_ngram]i64,
     /// Token id -> compressed id (the tokenizer-normalized classes engram.py builds; the lane caches them as JSON).
     map: []const i32,
@@ -83,6 +109,7 @@ pub const Hasher = struct {
             for (0..h.cols()) |k| {
                 h.offsets[l][k] = acc;
                 acc += h.primes[l][k];
+                h.mods[l][k] = Mod.init(@intCast(h.primes[l][k]));
             }
         }
         return h;
@@ -118,7 +145,8 @@ pub const Hasher = struct {
                     rolling ^= toks[i] *% h.mult[l][i];
                     for (0..h.heads) |k| {
                         const c = (i - 1) * h.heads + k;
-                        out[(r * h.layers + l) * nc + c] = @mod(rolling, h.primes[l][c]) + h.offsets[l][c];
+                        const v = if (h.fast) h.mods[l][c].of(rolling) else @as(u64, @intCast(@mod(rolling, h.primes[l][c])));
+                        out[(r * h.layers + l) * nc + c] = @as(i64, @intCast(v)) + h.offsets[l][c];
                     }
                 }
             }
@@ -227,6 +255,24 @@ test "the table decode is the per-value decode for every byte and scale" {
     try std.testing.expectEqualSlices(u16, &a, &b2);
 }
 
+test "Mod: the reciprocal division is @mod for every prime and value" {
+    var why: @import("config.zig").Why = .{};
+    const c = try @import("config.zig").parse(std.testing.allocator, @import("config.zig").test_config, &why);
+    var ps: [max_layers][max_cols]i64 = undefined;
+    primes(c, &ps);
+    for (ps[0]) |pv| {
+        const m = Mod.init(@intCast(pv));
+        for ([_]i64{ std.math.minInt(i64), std.math.maxInt(i64), -1, 0, 1, pv - 1, pv, pv + 1, -pv, -pv - 1 }) |a|
+            try std.testing.expectEqual(@mod(a, pv), @as(i64, @intCast(m.of(a))));
+        var x: u64 = 0x1234_5678_9abc_def0;
+        for (0..5000) |_| {
+            x = x *% 6364136223846793005 +% 1442695040888963407;
+            const a: i64 = @bitCast(x);
+            try std.testing.expectEqual(@mod(a, pv), @as(i64, @intCast(m.of(a))));
+        }
+    }
+}
+
 test "primes are drawn upward from the vocabulary size and never repeat" {
     try std.testing.expect(isPrime(2) and isPrime(16000057) and !isPrime(16000000) and !isPrime(1));
     var why: @import("config.zig").Why = .{};
diff --git a/zig/src/families/dsv41/engram_io.zig b/zig/src/families/dsv41/engram_io.zig
index 3d3dc4a..b8c3e4a 100644
--- a/zig/src/families/dsv41/engram_io.zig
+++ b/zig/src/families/dsv41/engram_io.zig
@@ -6,6 +6,7 @@
 const std = @import("std");
 const builtin = @import("builtin");
 const dio = @import("core").direct_io;
+const engram = @import("engram.zig");
 
 /// One layer's table: [rows, row_w] FP8 weights and [rows, row_s] E8M0 scales, by file and offset; fd_wd / fd_sd the same
 /// files through O_DIRECT (-1 where the file system refuses it: the buffered ones serve). `writable`: the file was opened
@@ -326,6 +327,114 @@ pub const Pool = struct {
     }
 };
 
+/// Threads that decode a chunk's FP8 rows (engram.decodeRow) without a spawn a call: TF_DS_ENGRAM_FAST's rows decode here
+/// on 8 threads of the host's, where engram.decodeRows spawns them per chunk. One job at a time: the callers serialize it
+/// (the read-ahead or TF_DS_ENGRAM_LEAD's reader is joined before a chunk's layers, and a round decodes row by row).
+pub const DecodePool = struct {
+    io: std.Io,
+    threads: []std.Thread,
+    mutex: std.Io.Mutex = .init,
+    cond: std.Io.Condition = .init,
+    done_cond: std.Io.Condition = .init,
+    gen: u64 = 0,
+    stop: bool = false,
+    job: ?*Job = null,
+    /// Threads inside work() on the current job: decode() returns only once they are out.
+    active: usize = 0,
+
+    const Job = struct {
+        w: []const u8,
+        s: []const u8,
+        out: []u16,
+        m: usize,
+        row_w: usize,
+        row_s: usize,
+        next: std.atomic.Value(usize) = .init(0),
+        finished: std.atomic.Value(usize) = .init(0),
+    };
+
+    pub fn init(gpa: std.mem.Allocator, io: std.Io, n: usize) !*DecodePool {
+        const threads = try gpa.alloc(std.Thread, n);
+        errdefer gpa.free(threads);
+        const p = try gpa.create(DecodePool);
+        errdefer gpa.destroy(p);
+        p.* = .{ .io = io, .threads = threads };
+        var started: usize = 0;
+        errdefer {
+            p.shutdown(started);
+            gpa.free(p.threads);
+            gpa.destroy(p);
+        }
+        for (p.threads) |*th| {
+            th.* = try std.Thread.spawn(.{}, loop, .{p});
+            started += 1;
+        }
+        return p;
+    }
+
+    fn shutdown(p: *DecodePool, n: usize) void {
+        p.mutex.lockUncancelable(p.io);
+        p.stop = true;
+        p.cond.broadcast(p.io);
+        p.mutex.unlock(p.io);
+        for (p.threads[0..n]) |th| th.join();
+    }
+
+    pub fn deinit(p: *DecodePool, gpa: std.mem.Allocator) void {
+        p.shutdown(p.threads.len);
+        gpa.free(p.threads);
+        gpa.destroy(p);
+    }
+
+    fn loop(p: *DecodePool) void {
+        var seen: u64 = 0;
+        while (true) {
+            p.mutex.lockUncancelable(p.io);
+            while (p.gen == seen and !p.stop) p.cond.waitUncancelable(p.io, &p.mutex);
+            if (p.stop) {
+                p.mutex.unlock(p.io);
+                return;
+            }
+            seen = p.gen;
+            const job = p.job;
+            if (job != null) p.active += 1;
+            p.mutex.unlock(p.io);
+            if (job) |j| {
+                p.work(j);
+                p.mutex.lockUncancelable(p.io);
+                p.active -= 1;
+                p.done_cond.broadcast(p.io);
+                p.mutex.unlock(p.io);
+            }
+        }
+    }
+
+    fn work(j: *Job) void {
+        while (true) {
+            const i = j.next.fetchAdd(1, .monotonic);
+            if (i >= j.m) return;
+            engram.decodeRow(j.w[i * j.row_w ..][0..j.row_w], j.s[i * j.row_s ..][0..j.row_s], j.out[i * j.row_w ..][0..j.row_w]);
+            _ = j.finished.fetchAdd(1, .acq_rel);
+        }
+    }
+
+    /// Rows `m` of w / s decoded into out ([m, row_w]); this thread decodes too and it returns once every thread is out.
+    pub fn decode(p: *DecodePool, w: []const u8, s: []const u8, out: []u16, m: usize, row_w: usize, row_s: usize) void {
+        if (m == 0) return;
+        var job: Job = .{ .w = w, .s = s, .out = out, .m = m, .row_w = row_w, .row_s = row_s };
+        p.mutex.lockUncancelable(p.io);
+        p.job = &job;
+        p.gen += 1;
+        p.cond.broadcast(p.io);
+        p.mutex.unlock(p.io);
+        work(&job);
+        p.mutex.lockUncancelable(p.io);
+        while (job.finished.load(.acquire) < m or p.active > 0) p.done_cond.waitUncancelable(p.io, &p.mutex);
+        p.job = null;
+        p.mutex.unlock(p.io);
+    }
+};
+
 test "punchHole: the blocks go, the bytes read as zeros and the file keeps its size" {
     if (@import("builtin").os.tag != .linux) return error.SkipZigTest;
     const a = std.testing.allocator;
