@@ -446,6 +448,7 @@ pub const Model = struct {
         // whatever the Engram setup below has made goes if the open fails after it (close() only runs for an open model);
         // registered here, not inside the block, so a later failure runs them too
         errdefer if (m.tables) |*t| t.close();
+        errdefer if (m.edpool) |p| p.deinit(gpa);
         errdefer if (m.epool) |p| p.deinit(gpa);
         errdefer if (m.aio) |x| x.deinit();
         errdefer if (m.paio) |x| x.deinit();
@@ -467,7 +470,15 @@ pub const Model = struct {
                 .map_scales = prompt.scalesMapped(if (std.c.getenv("TF_DS_ENGRAM_SCALES")) |v| std.mem.span(v) else null),
             });
             m.epool = try engram_io.Pool.init(gpa, io, 64);
-            m.eh = try prompt.EngramHost.init(a, c, engram.Hasher.init(c.*, map, mult), &m.tables.?, m.epool.?, sp.rank, sp.world, chunk_rows);
+            const fast = prompt.fastEnabled(if (std.c.getenv("TF_DS_ENGRAM_FAST")) |v| std.mem.span(v) else null);
+            var hasher = engram.Hasher.init(c.*, map, mult);
+            hasher.fast = fast; // TF_DS_ENGRAM_FAST: the reciprocal modulo, same ids
+            m.eh = try prompt.EngramHost.init(a, c, hasher, &m.tables.?, m.epool.?, sp.rank, sp.world, chunk_rows);
+            if (fast) {
+                // the rows' decode on threads of their own, not a spawn a chunk
+                m.edpool = try engram_io.DecodePool.init(gpa, io, 8);
+                m.eh.?.dpool = m.edpool;
+            }
             // TF_DS_ENGRAM_TRIM=1: give back the blocks of the rows this rank never reads (the other rank's hash columns)
             if (prompt.trimEnabled(if (std.c.getenv("TF_DS_ENGRAM_TRIM")) |v| std.mem.span(v) else null)) prompt.trimTables(&m.eh.?, c, io);
             // TF_DS_ENGRAM_METRICS (on; 0 turns it off): every table read timed for /metrics (the clock; --profile's p_* split stays off)
@@ -483,7 +494,13 @@ pub const Model = struct {
                 m.aio = try engram_aio.Aio.init(gpa, io, 1024 * ((o.round_rows + 15) / 16));
                 m.eh.?.aio = m.aio;
                 // a prompt chunk's reads (2 x 12 x 2,048 at most): a ring of 4,096 slots (32 MiB), 1,024 rows a batch
-                m.paio = try engram_aio.Aio.init(gpa, io, 4096);
+                // (TF_DS_ENGRAM_FAST: TF_DS_ENGRAM_AIO_SLOTS over it, 64 .. 65,536, for an A/B of the ring's depth)
+                const slots: usize = if (fast) slots: {
+                    const v = std.c.getenv("TF_DS_ENGRAM_AIO_SLOTS") orelse break :slots 4096;
+                    const n = std.fmt.parseInt(usize, std.mem.span(v), 10) catch break :slots 4096;
+                    break :slots if (n >= 64 and n <= 65536) n else 4096;
+                } else 4096;
+                m.paio = try engram_aio.Aio.init(gpa, io, slots);
                 m.eh.?.paio = m.paio;
                 m.ahead_apart = true;
             }
@@ -671,6 +688,7 @@ pub const Model = struct {
         if (m.aio) |x| x.deinit();
         if (m.paio) |x| x.deinit();
         if (m.paio2) |x| x.deinit();
+        if (m.edpool) |p| p.deinit(m.gpa);
         if (m.epool) |p| p.deinit(m.gpa);
         if (m.tables) |*t| t.close();
         if (m.rdma_rings) |*r| r.close(m.gpa);
@@ -1084,6 +1102,7 @@ pub const Model = struct {
             eh.ahead_start = std.math.maxInt(usize);
             eh.ahead_ready = .{ false, false };
             eh.chunk_hashed = false;
+            prompt.forgetHashes(eh);
