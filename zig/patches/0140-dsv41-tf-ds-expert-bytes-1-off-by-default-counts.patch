+/// TF_DS_EXPERT_BYTES's MoE counters on this rank (a profile), a layer's decode window each: the distinct expert places
+/// the windows route and the trellis bytes those places read; nothing when the switch is off.
+fn printExpertBytes(w: *std.Io.Writer, rank: u32, m: *const dsv41.model.Model) !void {
+    const xb = m.rd.moe_bytes orelse return;
+    const win: f64 = @floatFromInt(@max(xb.windows, 1));
+    const rounds: f64 = @floatFromInt(@max(xb.windows / @max(m.w.layers.len, 1), 1));
+    const kb = @as(f64, @floatFromInt(xb.bytes)) / 1024;
+    try w.print("{{\"rank\": {d}, \"expert_bytes\": {{\"windows\": {d}, \"rows_a_window\": {d:.1}, \"places_a_window\": {d:.3}, \"kb_a_window\": {d:.1}, \"kb_a_round\": {d:.1}}}}}\n", .{ rank, xb.windows, @as(f64, @floatFromInt(xb.rows)) / win, @as(f64, @floatFromInt(xb.places)) / win, kb / win, kb / rounds });
+    try w.flush();
+}
