+/// TF_DS_EXPERT_BYTES=1 (a profile, W4-1: the MoE byte model's check): a decode round's expert places at fixed rows and
+/// the trellis bytes they read. After a layer's experts run, its window's distinct ids and count are read back from the
+/// decode scratch (a synchronous copy a layer: eager rounds only) and each place's bytes added to the counters.
+/// `place`: expert e's trellis bytes (gate + up + down) from the layer's k2 tables, read once at open, off the round.
+pub const ExpertBytes = struct {
+    place: []u64, // emax a layer
+    ids: []i32, // the window's places, read back a layer
+    emax: usize,
+    windows: u64 = 0, // a layer's decode window each
+    rows: u64 = 0,
+    places: u64 = 0,
+    bytes: u64 = 0,
+
+    /// A [n, k] trellis at k2 half-bits a value is k * n * k2 / 16 bytes: weights.zig's tr shape is [k / 16, n / 16,
+    /// 8 * k2] of i16, and experts() splits gate and up by output columns ([width, dims]) and down by input rows
+    /// ([down_n, down_k]). k2 is the expert's own (weights.Expert's gate_k2 / up_k2 / down_k2 tables): k2_gu and k2_d
+    /// are only the {min, max} bounds the kernel range is picked by.
+    fn placeBytes(ex: weights.Experts, k2_g: u32, k2_u: u32, k2_d: u32) u64 {
+        const gu: u64 = @as(u64, ex.dims) * ex.width * (@as(u64, k2_g) + @as(u64, k2_u));
+        return (gu + @as(u64, ex.down_k) * ex.down_n * @as(u64, k2_d)) / 16;
+    }
+
+    /// The switch's tables: the k2 tables are constants (loaded before a round is made), so the bytes a place reads are
+    /// worked out once here.
+    fn open(e: *const Engine, gpa: std.mem.Allocator) !ExpertBytes {
+        var emax: usize = 0;
+        for (e.w.layers) |lay| emax = @max(emax, lay.experts.count);
+        if (emax == 0) return error.NoExpertBytes; // no routed experts to count
+        const place = try gpa.alloc(u64, e.w.layers.len * emax);
+        errdefer gpa.free(place);
+        const ids = try gpa.alloc(i32, @min(e.round_rows * e.slots(), emax));
+        errdefer gpa.free(ids);
+        @memset(place, 0); // (the shared expert's, and past a layer's last: no bytes)
+        var xb: ExpertBytes = .{ .place = place, .ids = ids, .emax = emax };
+        const k2 = try gpa.alloc(i32, 3 * emax);
+        defer gpa.free(k2);
+        for (e.w.layers, 0..) |lay, l| {
+            const ex = lay.experts;
+            for ([_]u64{ ex.gate_k2, ex.up_k2, ex.down_k2 }, 0..) |tbl, j|
+                try e.d.check(e.d.api.cuMemcpyDtoH_v2(@ptrCast(k2.ptr + j * emax), tbl, ex.count * 4), "cuMemcpyDtoH");
+            for (0..ex.count) |x| {
+                const k2g: u32 = @intCast(k2[x]);
+                const k2u: u32 = @intCast(k2[emax + x]);
+                const k2d: u32 = @intCast(k2[2 * emax + x]);
+                xb.place[l * emax + x] = placeBytes(ex, k2g, k2u, k2d);
+            }
+        }
+        return xb;
+    }
+
+    pub fn deinit(xb: *ExpertBytes, gpa: std.mem.Allocator) void {
+        gpa.free(xb.place);
+        gpa.free(xb.ids);
+    }
+
+    /// A layer's decode window: the scratch's distinct places (decode_prep's ids, count) and their trellis bytes. The
+    /// copy waits for the layer's experts (the round queues them a layer ahead), which is the profile's one cost.
+    fn count(xb: *ExpertBytes, e: *const Engine, rd: *const Round, ch: *const Chunk, l: usize) !void {
+        var n: i32 = 0;
+        try e.d.check(e.d.api.cuMemcpyDtoH_v2(&n, ch.xsd.count, 4), "cuMemcpyDtoH");
+        if (n <= 0) return;
+        const places: usize = @min(@as(usize, @intCast(n)), xb.ids.len);
+        try e.d.check(e.d.api.cuMemcpyDtoH_v2(@ptrCast(xb.ids.ptr), ch.xsd.ids, places * 4), "cuMemcpyDtoH");
+        xb.windows += 1;
+        xb.rows += rd.r;
+        xb.places += places;
+        for (xb.ids[0..places]) |id| {
+            if (id < 0) continue; // (a slot no expert routes)
+            const e_id: usize = @intCast(id);
+            if (e_id >= xb.emax) continue;
+            xb.bytes += xb.place[l * xb.emax + e_id];
+        }
+    }
+};
