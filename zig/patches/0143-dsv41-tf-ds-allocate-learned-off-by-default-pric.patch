index 0000000000000000000000000000000000000000..215ad7e972ed86a4d99275e08205873cc9741c0b
--- /dev/null
+++ b/zig/src/core/lanes/allocate_learned_test.zig
@@ -0,0 +1,148 @@
+//! TF_DS_ALLOCATE_LEARNED: the window allocator prices rows with the depth rule's learned round costs where a round
+//! of that depth was measured, the static shared table where it was not. The two tables must rank candidate depths
+//! differently for the switch to mean anything; these construct such pairs.
+const std = @import("std");
+const config = @import("config.zig");
+const Config = config.Config;
+const Cost = config.Cost;
+const depth = @import("depth.zig");
+const Table = @import("table.zig").Table;
+const Engine = @import("engine.zig").Engine;
+const Stream = @import("stream.zig").Stream;
+const fake = @import("fake.zig");
+const be = @import("backend.zig");
+const win = @import("windows.zig");
+
+const gpa = std.testing.allocator;
+
+const chain = [_]f64{ 0.9, 0.81, 0.729, 0.6561 };
+
+/// The served ROUND_MS table's first 16 rows (dsv41's draft.round_ms).
+const served = [_]f64{ 30.0, 35.2, 39.9, 44.9, 48.6, 52.1, 55.6, 59.1, 62.7, 66.3, 69.6, 72.9, 75.5, 78.2, 81.3, 84.4 };
+
+fn staticServed() [16]Cost {
+    var c: [16]Cost = undefined;
+    for (&c, 1..) |*x, w| x.* = .{ .width = @intCast(w), .ms = served[w - 1] };
+    return c;
+}
+
+/// A steep static table: every row costs 25 ms, so wide rounds never pay back.
+fn staticSteep() [16]Cost {
+    var c: [16]Cost = undefined;
+    for (&c, 1..) |*x, w| x.* = .{ .width = @intCast(w), .ms = 25.0 * @as(f64, @floatFromInt(w)) };
+    return c;
+}
+
+/// Keyed by drafts = rows - 1, as observeCost keys them. The measured fit on this pair: ~11.4 ms for a round's first
+/// row plus ~4.9 ms a row past it.
+const measured_all: [15]f64 = blk: {
+    var t: [15]f64 = undefined;
+    for (&t, 1..) |*x, d| x.* = 11.4 + 4.9 * @as(f64, @floatFromInt(d + 1));
+    break :blk t;
+};
+
+/// Learned round times rising 20 ms a draft: rows past the static table's knee cost much more than it prices.
+const steep_all: [15]f64 = blk: {
+    var t: [15]f64 = undefined;
+    for (&t, 1..) |*x, d| x.* = 30.0 + 20.0 * @as(f64, @floatFromInt(d));
+    break :blk t;
+};
+
+/// The steep learned table from drafts 3 on (rows 4+); rows 2 and 3 are never measured and keep the static table.
+const steep_from3: [13]f64 = blk: {
+    var t: [13]f64 = undefined;
+    for (&t, 3..) |*x, d| x.* = 30.0 + 20.0 * @as(f64, @floatFromInt(d));
+    break :blk t;
+};
+
+fn chances(_: *anyopaque, _: *Stream, out: []f64) anyerror!bool {
+    @memcpy(out, chain[0..out.len]);
+    return true;
+}
+
+fn startNow(_: *anyopaque) void {}
+
+fn elapsed(_: *anyopaque, _: be.Mark) f64 {
+    return 0.0;
+}
+
+const Seed = struct { from: i64, ms: []const f64 };
+
+/// The drafts two identical held-chain head plans are granted, with the learned costs seeded through observeCost
+/// (no stream's first round is seeded: those carry the prefill-to-decode switch and stay out of the table).
+fn grant(shared_costs: []const Cost, seed: ?Seed, learned: bool) ![2]u32 {
+    var cfg = try Config.init(gpa, .{
+        .exact_width = 16,
+        .mtp = true,
+        .speculate = true,
+        .speculate_early = false,
+        .drafts = 4,
+        .mtp_step_ms = 0.5,
+        .draft_probabilities = true,
+        .shared_costs = shared_costs,
+        .batch_rows = 16,
+        .allocate_learned = learned,
+    }, 16, 15);
+    defer cfg.deinit(gpa);
+    var target: fake.Fake = .{ .gpa = gpa };
+    defer target.deinit();
+    var vtable = target.backend().vtable.*;
+    vtable.probabilities = chances;
+    var token: u8 = 0;
+    var engine = Engine.init(gpa, &cfg, .{ .ptr = &target, .vtable = &vtable }, .{ .ptr = &token, .vtable = &.{ .start = startNow, .elapsed_ms = elapsed } });
+    defer engine.deinit();
+    if (seed) |s| {
+        for (s.ms, 0..) |ms, k| try engine.rule.observeCost(s.from + @as(i64, @intCast(k)), ms, false, null);
+    }
+    var streams: [2]Stream = undefined;
+    var plans: [2]win.Plan = undefined;
+    for (&streams, &plans, 0..) |*s, *p, i| {
+        s.* = try Stream.init(gpa, .{ .id = if (i == 0) "a" else "b", .prompt = &.{ 1, 2, 3 }, .max_new = 8 });
+        p.* = .{ .stream = s, .position = 0, .kind = .head, .held = 4 };
+    }
+    defer for (&streams) |*s| s.deinit(gpa);
+    try win.allocate(&engine, &plans);
+    return .{ streams[0].granted.?, streams[1].granted.? };
+}
+
+test "with the switch on, rows past the static table's prices are refused for the learned ones" {
+    const costs = staticServed();
+    const off = try grant(&costs, .{ .from = 1, .ms = &steep_all }, false);
+    try std.testing.expectEqualSlices(u32, &.{ 4, 4 }, &off); // the table's favorite: the widest round
+    const on = try grant(&costs, .{ .from = 1, .ms = &steep_all }, true);
+    try std.testing.expectEqualSlices(u32, &.{ 2, 2 }, &on); // the learned costs' favorite: half as deep
+}
+
+test "with the switch on, rows cheaper than the static table prices are taken for the learned ones" {
+    const costs = staticSteep();
+    const off = try grant(&costs, .{ .from = 1, .ms = &measured_all }, false);
+    try std.testing.expectEqualSlices(u32, &.{ 1, 1 }, &off); // the steep table's favorite: one draft each
+    const on = try grant(&costs, .{ .from = 1, .ms = &measured_all }, true);
+    try std.testing.expectEqualSlices(u32, &.{ 4, 4 }, &on); // the learned costs' favorite: the widest round
+}
+
+test "a row count never measured falls back to the static table" {
+    const costs = staticServed();
+    // learned only from rows 4 (drafts >= 3) up; rows 2 and 3 keep the served table, cheaply priced
+    const on = try grant(&costs, .{ .from = 3, .ms = &steep_from3 }, true);
+    try std.testing.expectEqualSlices(u32, &.{ 1, 0 }, &on);
+    // no observation at all for any row count: exactly the table's choice either way
+    const on_cold = try grant(&costs, null, true);
+    const off_cold = try grant(&costs, null, false);
+    try std.testing.expectEqualSlices(u32, &off_cold, &on_cold);
+    try std.testing.expectEqualSlices(u32, &.{ 4, 4 }, &on_cold);
+}
+
+test "learnedRowsMs is null until a round of that depth is measured" {
+    var fc: Table = .{};
+    defer fc.deinit(gpa);
+    var shared: Table = .{};
+    defer shared.deinit(gpa);
+    var rule: depth.Rule = .{ .gpa = gpa, .prior = &.{0.9}, .most_drafts = 1, .family_costs = &fc, .shared_costs = &shared, .mtp_step_ms = 0.5, .plain_guard = false, .node_probabilities = false, .batch_rows = 8 };
+    defer rule.deinit();
+    try std.testing.expectEqual(@as(?f64, null), rule.learnedRowsMs(0));
+    try std.testing.expectEqual(@as(?f64, null), rule.learnedRowsMs(4));
+    try rule.observeCost(3, 42.0, false, null); // a 3-draft (4-row) round
+    try std.testing.expectEqual(@as(?f64, 42.0), rule.learnedRowsMs(4));
+    try std.testing.expectEqual(@as(?f64, null), rule.learnedRowsMs(5));
+}
