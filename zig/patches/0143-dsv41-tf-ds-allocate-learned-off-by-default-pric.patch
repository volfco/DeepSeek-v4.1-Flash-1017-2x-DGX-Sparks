+/// The rows' cost table with TF_DS_ALLOCATE_LEARNED on: the depth rule's learned round time for a round of
+/// `rows` rows where at least one round at that depth was measured, else the static table's entry for the row
+/// count (never observed: the row count keeps today's behavior). Overhead stays the learned one either way.
+/// The arena owns the table (reset every round).
+fn learnedTable(a: std.mem.Allocator, e: *Engine, plans: usize) !Table {
+    var out: Table = .{};
+    errdefer out.deinit(a);
+    var rows: u64 = 1;
+    const limit: u64 = @max(@as(u64, e.cfg.batch_rows), @as(u64, @intCast(plans)));
+    while (rows <= limit) : (rows += 1) {
+        const key: i64 = @intCast(rows);
+        const ms = e.rule.learnedRowsMs(rows) orelse e.cfg.shared_costs.get(key) orelse continue;
+        try out.put(a, key, ms);
+    }
+    return out;
+}
+
