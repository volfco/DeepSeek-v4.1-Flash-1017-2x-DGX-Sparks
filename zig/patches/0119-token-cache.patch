+    pub const EncodeOptions = struct { scratch: Allocator = std.heap.page_allocator, depth_first: bool = true, cache: ?*PieceCache = null };
 
     pub fn encodeWith(t: *const Tokenizer, a: Allocator, text: []const u8, o: EncodeOptions) Error![]u32 {
         var arena = std.heap.ArenaAllocator.init(o.scratch);
@@ -217,7 +220,24 @@ pub const Tokenizer = struct {
