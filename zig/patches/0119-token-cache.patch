diff --git a/zig/src/core/tokenizer/cache.zig b/zig/src/core/tokenizer/cache.zig
new file mode 100644
index 0000000..946262b
--- /dev/null
+++ b/zig/src/core/tokenizer/cache.zig
@@ -0,0 +1,150 @@
+//! TENSORFOLD_TOKEN_CACHE_MB (rank 0's server; off by default): an LRU of encoded plain pieces, keyed by the bytes the
+//! added-token split hands the encoder. `Tokenizer.encodeWith` consults it for pieces whose ids cannot depend on their
+//! neighbours; with the switch off there is no cache and the encoder is the one it was.
+const std = @import("std");
+const Allocator = std.mem.Allocator;
+
+/// TENSORFOLD_TOKEN_CACHE_MB: MiB of cap. Unset, blank, `0` or anything that is not a count leave the cache off.
+pub fn cacheMb(v: ?[]const u8) ?usize {
+    const t = std.mem.trim(u8, v orelse return null, " \t\r\n");
+    const n = std.fmt.parseInt(usize, t, 10) catch return null;
+    return if (n == 0) null else n;
+}
+
+/// An LRU from a plain piece's bytes (0028's marks kept, so a marked and an unmarked spelling never share an entry) to
+/// its ids. One mutex, held for a lookup or an insert only, never while a piece is encoded: prepares run concurrently
+/// (server/prepare_gate.zig).
+pub const PieceCache = struct {
+    io: std.Io,
+    gpa: Allocator,
+    limit: usize,
+    used: usize = 0,
+    hits: u64 = 0, // for the tests
+    mutex: std.Io.Mutex = .init,
+    map: std.StringHashMapUnmanaged(*Entry) = .empty,
+    lru: std.DoublyLinkedList = .{},
+
+    const Entry = struct {
+        node: std.DoublyLinkedList.Node = .{},
+        text: []u8,
+        ids: []u32,
+        cost: usize,
+    };
+
+    pub fn init(io: std.Io, gpa: Allocator, limit: usize) PieceCache {
+        return .{ .io = io, .gpa = gpa, .limit = limit };
+    }
+
+    pub fn deinit(c: *PieceCache) void {
+        while (c.lru.popFirst()) |n| freeEntry(c.gpa, @fieldParentPtr("node", n));
+        c.map.deinit(c.gpa);
+        c.* = undefined;
+    }
+
+    /// `text`'s ids, copied into `a`; null on a miss.
+    pub fn get(c: *PieceCache, a: Allocator, text: []const u8) Allocator.Error!?[]const u32 {
+        c.mutex.lockUncancelable(c.io);
+        defer c.mutex.unlock(c.io);
+        const e = c.map.get(text) orelse return null;
+        c.lru.remove(&e.node);
+        c.lru.append(&e.node);
+        c.hits += 1;
+        const ids = try a.dupe(u32, e.ids);
+        return ids;
+    }
+
+    /// `text`'s ids. A piece larger than a quarter of the cap is not cached; when the cap would be passed, the older
+    /// half by last use goes first. A failed allocation drops the entry, never the encode.
+    pub fn put(c: *PieceCache, text: []const u8, ids: []const u32) void {
+        const cost = text.len + 4 * ids.len;
+        if (cost > c.limit / 4) return;
+        c.mutex.lockUncancelable(c.io);
+        defer c.mutex.unlock(c.io);
+        if (c.map.get(text)) |e| { // another prepare stored it while this one encoded
+            c.lru.remove(&e.node);
+            c.lru.append(&e.node);
+            return;
+        }
+        while (c.used + cost > c.limit and c.used > c.limit / 2) {
+            const n = c.lru.popFirst() orelse break;
+            const e: *Entry = @fieldParentPtr("node", n);
+            _ = c.map.remove(e.text);
+            c.used -= e.cost;
+            freeEntry(c.gpa, e);
+        }
+        const e = c.gpa.create(Entry) catch return;
+        e.node = .{};
+        e.text = c.gpa.dupe(u8, text) catch {
+            c.gpa.destroy(e);
+            return;
+        };
+        e.ids = c.gpa.dupe(u32, ids) catch {
+            c.gpa.free(e.text);
+            c.gpa.destroy(e);
+            return;
+        };
+        e.cost = cost;
+        c.map.put(c.gpa, e.text, e) catch {
+            freeEntry(c.gpa, e);
+            return;
+        };
+        c.used += cost;
+        c.lru.append(&e.node);
+    }
+};
+
+fn freeEntry(gpa: Allocator, e: *PieceCache.Entry) void {
+    gpa.free(e.text);
+    gpa.free(e.ids);
+    gpa.destroy(e);
+}
+
+test "TENSORFOLD_TOKEN_CACHE_MB: unset, 0 or unparsable are off" {
+    try std.testing.expectEqual(@as(?usize, null), cacheMb(null));
+    try std.testing.expectEqual(@as(?usize, null), cacheMb(""));
+    try std.testing.expectEqual(@as(?usize, null), cacheMb(" \t\r\n"));
+    try std.testing.expectEqual(@as(?usize, null), cacheMb("0"));
+    try std.testing.expectEqual(@as(?usize, null), cacheMb("lots"));
+    try std.testing.expectEqual(@as(?usize, null), cacheMb("-4"));
+    try std.testing.expectEqual(@as(?usize, 32), cacheMb("32"));
+    try std.testing.expectEqual(@as(?usize, 32), cacheMb(" 32 \n"));
+}
+
+test "the cache keeps its cap, evicts the older half and returns what it stored" {
+    const gpa = std.testing.allocator;
+    var cache = PieceCache.init(std.testing.io, gpa, 64 << 10);
+    defer cache.deinit();
+    var text: [1024]u8 = undefined;
+    var ids: [1024]u32 = undefined;
+    var stored: usize = 0;
+    for (0..200) |i| { // 200 pieces of ~1 KiB: past 64 KiB, so the older half goes
+        const len = 256 + i % 768;
+        @memset(text[0..len], 'a' + @as(u8, @intCast(i % 26)));
+        for (ids[0..len], 0..) |*id, k| id.* = @intCast(i * 4096 + k);
+        cache.put(text[0..len], ids[0..len]);
+        try std.testing.expect(cache.used <= cache.limit);
+        stored += 1;
+    }
+    try std.testing.expect(stored == 200);
+    // the most recent piece is still there, and every entry's ids are the ones put under its text
+    @memset(text[0..200], 'z');
+    for (ids[0..200], 0..) |*id, k| id.* = @intCast(k + 7);
+    cache.put(text[0..200], ids[0..200]);
+    const got = (try cache.get(gpa, text[0..200])).?;
+    defer gpa.free(got);
+    try std.testing.expectEqualSlices(u32, ids[0..200], got);
+    try std.testing.expect(cache.hits == 1);
+}
+
+test "a piece larger than a quarter of the cap is not cached" {
+    const gpa = std.testing.allocator;
+    var cache = PieceCache.init(std.testing.io, gpa, 1 << 10);
+    defer cache.deinit();
+    var text: [256]u8 = undefined;
+    var ids: [256]u32 = undefined;
+    @memset(&text, 'x');
+    for (&ids, 0..) |*id, k| id.* = @intCast(k);
+    cache.put(&text, &ids); // 256 + 1024 bytes, over 1 KiB / 4
+    try std.testing.expectEqual(@as(usize, 0), cache.used);
+    try std.testing.expectEqual(@as(?[]const u32, null), try cache.get(gpa, &text));
+}
