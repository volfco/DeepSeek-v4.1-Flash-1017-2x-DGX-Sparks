         \\  {"type":"Split","pattern":{"Regex":"\\p{N}{1,3}"},"behavior":"Isolated","invert":false},
@@ -648,3 +672,136 @@ test "encode's ids are the breadth-first walk's, and it keeps no scratch in the
     try std.testing.expect(deep.peak * 4 < wide.peak);
     try std.testing.expect(deep.peak < 40 * text.len);
 }
+
+/// The cache tests' texts: prose, every added token (adjacent and spaced), 0028's marks, pieces of exactly 255, 256 and
+/// 257 bytes (as a middle piece and as the text's first), empty pieces and bytes that are not UTF-8.
+fn cacheCorpus(a: Allocator) ![]const []const u8 {
+    var out: std.ArrayList([]const u8) = .empty;
+    try out.append(a, try longText(a, &test_words, 4096));
+    try out.append(a, try a.dupe(u8, "<｜User｜><|assistant|><x><｜User｜>"));
+    try out.append(a, try a.dupe(u8, "one <|assistant|>  two <x> three <｜User｜> four"));
+    try out.append(a, try a.dupe(u8, "a<" ++ Tokenizer.plain_mark ++ "x>a"));
+    try out.append(a, try a.dupe(u8, "ab" ++ Tokenizer.plain_mark ++ "cd <|assistant|>" ++ Tokenizer.plain_mark ++ " tail"));
+    for ([_]usize{ 255, 256, 257 }) |n| {
+        const piece = try a.alloc(u8, n);
+        @memset(piece, 'q');
+        defer a.free(piece);
+        try out.append(a, try std.mem.concat(a, u8, &.{ "<｜User｜>", piece, "<｜User｜>" }));
+        try out.append(a, try std.mem.concat(a, u8, &.{ piece, "<｜User｜>" }));
+    }
+    try out.append(a, try a.dupe(u8, ""));
+    try out.append(a, try a.dupe(u8, "a\xff\xfe broken \xc3 and 日本語"));
+    try out.append(a, try a.dupe(u8, " "));
+    return try out.toOwnedSlice(a);
+}
+
+test "cached encode equals plain encode on a cold and a warm cache" {
+    const gpa = std.testing.allocator;
+    var t = try deepseekLike(gpa, &test_words);
+    defer t.deinit();
+    var cache = PieceCache.init(std.testing.io, gpa, 1 << 20);
+    defer cache.deinit();
+    const corpus = try cacheCorpus(gpa);
+    defer {
+        for (corpus) |s| gpa.free(s);
+        gpa.free(corpus);
+    }
+    for (corpus) |s| {
+        const plain = try t.encode(gpa, s);
+        defer gpa.free(plain);
+        const cold = try t.encodeWith(gpa, s, .{ .cache = &cache });
+        defer gpa.free(cold);
+        try std.testing.expectEqualSlices(u32, plain, cold);
+        const warm = try t.encodeWith(gpa, s, .{ .cache = &cache });
+        defer gpa.free(warm);
+        try std.testing.expectEqualSlices(u32, plain, warm);
+    }
+    try std.testing.expect(cache.hits > 0); // the warm pass hit on the pieces the split handed over
+    try std.testing.expect(cache.used > 0);
+}
+
+test "a text's first piece is not cached; a piece after an added token is" {
+    const gpa = std.testing.allocator;
+    var t = try deepseekLike(gpa, &test_words);
+    defer t.deinit();
+    var cache = PieceCache.init(std.testing.io, gpa, 1 << 20);
+    defer cache.deinit();
+    const leading = try t.encodeWith(gpa, "the model reads a long prompt", .{ .cache = &cache });
+    defer gpa.free(leading);
+    try std.testing.expectEqual(@as(usize, 0), cache.used);
+    try std.testing.expectEqual(@as(u64, 0), cache.hits);
+    const after = try t.encodeWith(gpa, "<｜User｜> the model reads a long prompt", .{ .cache = &cache });
+    defer gpa.free(after);
+    try std.testing.expect(cache.used > 0);
+}
+
+test "eviction holds the bound and cached results stay the plain ones" {
+    const gpa = std.testing.allocator;
+    var t = try deepseekLike(gpa, &test_words);
+    defer t.deinit();
+    var cache = PieceCache.init(std.testing.io, gpa, 64 << 10);
+    defer cache.deinit();
+    const filler = "the model reads a long prompt of many tokens and keeps its state while another conversation resumes from memory ";
+    for (0..2) |round| {
+        for (0..60) |i| {
+            const text = try std.fmt.allocPrint(gpa, "<｜User｜>{d} {s}<｜User｜>tail {d} {s}", .{ i, filler, i, filler });
+            defer gpa.free(text);
+            const plain = try t.encode(gpa, text);
+            defer gpa.free(plain);
+            const cached = try t.encodeWith(gpa, text, .{ .cache = &cache });
+            defer gpa.free(cached);
+            try std.testing.expectEqualSlices(u32, plain, cached);
+            try std.testing.expect(cache.used <= cache.limit);
+            if (round == 1) try std.testing.expect(cache.hits > 0);
+        }
+    }
+}
+
+const EncodeJob = struct {
+    t: *const Tokenizer,
+    cache: *PieceCache,
+    text: []const u8,
+    out: ?[]u32 = null,
+
+    fn run(j: *EncodeJob) void {
+        j.out = j.t.encodeWith(std.testing.allocator, j.text, .{ .cache = j.cache }) catch null;
+    }
+};
+
+test "two threads encoding the same texts get the plain result" {
+    const gpa = std.testing.allocator;
+    var t = try deepseekLike(gpa, &test_words);
+    defer t.deinit();
+    var cache = PieceCache.init(std.testing.io, gpa, 1 << 20);
+    defer cache.deinit();
+    const text = try longText(gpa, &test_words, 16 << 10);
+    defer gpa.free(text);
+    const plain = try t.encode(gpa, text);
+    defer gpa.free(plain);
+    var jobs: [4]EncodeJob = undefined;
+    var threads: [4]std.Thread = undefined;
+    for (&jobs) |*j| j.* = .{ .t = &t, .cache = &cache, .text = text };
+    for (&jobs, &threads) |*j, *th| th.* = try std.Thread.spawn(.{}, EncodeJob.run, .{j});
+    for (&threads) |*th| th.join();
+    for (&jobs) |*j| {
+        try std.testing.expectEqualSlices(u32, plain, j.out.?);
+        gpa.free(j.out.?);
+    }
+}
+
+test "the switch off is the plain encoder and consults no cache" {
+    const gpa = std.testing.allocator;
+    var t = try deepseekLike(gpa, &test_words);
+    defer t.deinit();
+    var cache = PieceCache.init(std.testing.io, gpa, 1 << 20);
+    defer cache.deinit();
+    const text = "<｜User｜> the model reads a long prompt <x> and keeps its state";
+    const plain = try t.encode(gpa, text);
+    defer gpa.free(plain);
+    const off = try t.encodeWith(gpa, text, .{}); // no cache: the path HfText takes with the switch off
+    defer gpa.free(off);
+    try std.testing.expectEqualSlices(u32, plain, off);
+    try std.testing.expectEqual(@as(usize, 0), cache.used);
+    try std.testing.expectEqual(@as(u64, 0), cache.hits);
+    try std.testing.expectEqual(@as(?usize, null), cacheMb(null));
+}
