+    try std.testing.expect(!warpShapesOk(128, 64, 48)); // a block that is not whole warps strands lanes mid-warp
+    try std.testing.expect(!warpShapesOk(96, 64, 32)); // d/2 = 48: the half-row packing splits a warp
+    try std.testing.expect(!warpShapesOk(128, 3, 32)); // odd rd: the rotary suffix starts on an odd column
