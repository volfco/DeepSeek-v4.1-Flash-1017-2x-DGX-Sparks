+    try std.testing.expect(keyFuseOk(true, 7, 128, 64, 1));
+    try std.testing.expect(!keyFuseOk(true, 7, 256, 64, 1)); // fuseOk accepts 256; the key kernel cannot
+    try std.testing.expect(fuseOk(true, 7, 256, 64, 1));
+    try std.testing.expect(!keyFuseOk(true, 7, 512, 64, 1));
+    try std.testing.expect(!keyFuseOk(false, 7, 128, 64, 1));
+    try std.testing.expect(!keyFuseOk(true, 0, 128, 64, 1));
+    try std.testing.expect(!keyFuseOk(true, 7, 128, 256, 1)); // rd past d is fuseOk's own refusal
+}
