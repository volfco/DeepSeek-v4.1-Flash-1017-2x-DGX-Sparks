+/// The only width tf_ds_fused_idx_key_kernel can take: it normalizes with the kit's 128-wide `_rmsnorm`
+/// specialization, whose per-thread item count is `D / 128` computed from the *template* argument (128), not from the
+/// runtime `d`. A 256- or 512-wide row would normalize only its first 128 elements and pack the rest unnormalized, so
+/// the key arm has a width gate of its own rather than fuseOk's [128, 512] range.
+pub const key_width: usize = 128;
+
+/// The decode indexer key arm's gate: fuseOk's bounds and exactly `key_width`.
+pub fn keyFuseOk(fused: bool, rows: usize, d: usize, rd: usize, heads: usize) bool {
+    return d == key_width and fuseOk(fused, rows, d, rd, heads);
+}
