+            }
+            if (!p.do_compress) return;
+            if (p.compress_fused) {
+                // Simulate tf_ds_compress2_norm_kernel across all grid.x = p.grid_rows blocks.
+                for (0..p.grid_rows) |g| {
+                    if (2 * g + 1 >= n) {
+                        const j = 2 * g;
+                        if (j >= p.raw_first and j < n) {
+                            const slot = (p.raw_pos0 + (j - p.raw_first)) % raw_rows;
