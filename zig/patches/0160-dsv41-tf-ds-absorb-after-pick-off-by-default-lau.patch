+/// The series' boolean switches' value ("1" or "on"; anything else: off), as envOf hands it over (0160).
+fn envOnOff(v: ?[]const u8) bool {
+    const s = v orelse return false;
+    return std.mem.eql(u8, s, "1") or std.mem.eql(u8, s, "on");
+}
+
+test "a boolean switch parses 1 and on, and nothing else" {
+    try std.testing.expect(envOnOff("1"));
+    try std.testing.expect(envOnOff("on"));
+    for ([_]?[]const u8{ null, "", "0", "off", "ON", "yes", "2" }) |bad| try std.testing.expect(!envOnOff(bad));
+}
