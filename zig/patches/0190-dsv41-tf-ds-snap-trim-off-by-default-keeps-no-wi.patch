+test "TF_DS_SNAP_TRIM: the decoder layers' rings leave the layout, so the small state and the digest follow" {
+    var shapes: [8]LayerShape = undefined;
+    for (&shapes) |*s| s.* = .{ .ratio = 2, .kv = true, .idx = true, .raw = true };
+    const geo = Geometry{ .block_tokens = 16, .window = 8, .ring_extra = 4, .raw_rows = 4, .head_dim = 64, .index_head_dim = 64 };
+    const whole = try StateLayout.init(&shapes, geo, .replicated);
+    var trimmed = shapes;
+    for (trimmed[4..]) |*s| s.ring = false; // the decoder's last half
+    const cut = try StateLayout.init(&trimmed, geo, .replicated);
+    const ring: usize = @intCast(geo.ringRows() * geo.head_dim * 2);
+    try std.testing.expectEqual(whole.small_bytes - 4 * ring, cut.small_bytes);
+    var rings_whole: usize = 0;
+    var rings_cut: usize = 0;
+    for (whole.smallPlanes()) |p| if (p.kind == .ring) {
+        rings_whole += 1;
+    };
+    for (cut.smallPlanes()) |p| if (p.kind == .ring) {
+        rings_cut += 1;
+    };
+    try std.testing.expectEqual(@as(usize, 8), rings_whole);
+    try std.testing.expectEqual(@as(usize, 4), rings_cut);
+    // the digest is what the pair and the store compare: the two layouts must never look alike
+    try std.testing.expect(!std.mem.eql(u8, &whole.digest(), &cut.digest()));
+    // and the planes that remain keep their order: the rings first, then each ratio-2 layer's raw stores
+    var saw_raw = false;
+    for (cut.smallPlanes()) |p| {
+        if (p.kind == .raw_kv or p.kind == .raw_score) saw_raw = true else try std.testing.expect(!saw_raw);
+    }
+}
