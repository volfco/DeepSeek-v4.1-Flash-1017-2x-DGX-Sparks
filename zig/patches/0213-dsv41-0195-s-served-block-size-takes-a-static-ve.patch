 // Compact selected columns in input order so neither the mask nor the list needs a sort. The maxima and the selection
 // live only on chip: the call sites read the mask (the prompt arm) or the block list (decode), never bmax/pidx, so the
 // fused launch writes neither (the unfused blockMax/topkIndices/poolPick sequence still does).
+// The block maxima (tf_ds_block_max_kernel's rule) for every block this thread owns, on chip. BS == 8 is the served
+// block size, instantiated with the trip count static: two aligned 16-byte loads a block, then the same comparison order
+// as the scalar loop (a NaN wins; otherwise a greater score replaces the maximum), and a guarded scalar tail for the
+// row's last partial block. BS == 0 keeps the runtime size (every other `bsize` and every unfused-shape fallback).
+template <int BS>
+__device__ __forceinline__ void tf_ds_block_max_t(float* maxima, const float* row, int width, int nb, long long last,
+                                                  int bsize = 0) {
+    const float ninf = -__int_as_float(0x7f800000);
+    const int bs = BS ? BS : bsize;
+    for (int b = threadIdx.x; b < nb; b += blockDim.x) {
+        const float* s = row + (long long)b * bs;
+        float m = ninf;
+        bool nan = false;
+        if (BS == 8 && b * 8 + 8 <= width) {
+            const float4 lo = *reinterpret_cast<const float4*>(s);
+            const float4 hi = *reinterpret_cast<const float4*>(s + 4);
+            const float x[8] = {lo.x, lo.y, lo.z, lo.w, hi.x, hi.y, hi.z, hi.w};
+            #pragma unroll
+            for (int j = 0; j < 8; ++j) {
+                if (x[j] != x[j]) nan = true;
+                else if (x[j] > m) m = x[j];
+            }
+        } else {
+            for (int j = 0; j < bs && b * bs + j < width; ++j) {
+                const float x = s[j];
+                if (x != x) nan = true;
+                else if (x > m) m = x;
+            }
+        }
+        float v = nan ? __int_as_float(0x7fc00000) : m;
+        if (b == last) v = __int_as_float(0x7f800000);
+        maxima[b] = v;
+    }
+}
