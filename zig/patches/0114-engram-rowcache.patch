-            try t.layers.put(gpa, kv.key_ptr.*, .{ .fd_w = w.fd, .base_w = w.base, .row_w = w.row, .fd_s = s.fd, .base_s = s.base, .row_s = s.row, .rows = w.rows, .fd_wd = w.dfd, .fd_sd = s.dfd, .writable = w.writable and s.writable, .s_map = s_map });
+            try t.layers.put(gpa, kv.key_ptr.*, .{ .id = kv.key_ptr.*, .fd_w = w.fd, .base_w = w.base, .row_w = w.row, .fd_s = s.fd, .base_s = s.base, .row_s = s.row, .rows = w.rows, .fd_wd = w.dfd, .fd_sd = s.dfd, .writable = w.writable and s.writable, .s_map = s_map });
