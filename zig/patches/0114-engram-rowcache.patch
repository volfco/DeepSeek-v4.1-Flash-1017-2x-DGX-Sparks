         }
+        b.left = n_sub;
         a.next_id += 1;
         a.head += reads;
         a.batches.putAssumeCapacity(id, b);
         a.live.appendAssumeCapacity(.{ id, b.first });
         var sent: usize = 0;
-        while (sent < reads) {
-            const r = ioSubmit(a.ctx, reads - sent, ptrs[sent..].ptr);
+        while (sent < n_sub) {
+            const r = ioSubmit(a.ctx, n_sub - sent, ptrs[sent..].ptr);
             if (r <= 0) {
                 const bp = a.batches.getPtr(id).?;
-                bp.left -= reads - sent; // never submitted
+                bp.left -= n_sub - sent; // never submitted
                 bp.failed = true;
                 break;
             }
@@ -274,6 +294,10 @@ pub const Aio = struct {
                         @memcpy(b.s_dst.?[i * b.row_s ..][0..b.row_s], m[row * b.row_s ..][0..b.row_s]);
                     }
                 };
+                // TF_DS_ENGRAM_ROWCACHE: what the batch read lands in the cache (a row it served is already there)
+                if (!failed) if (a.rc) |rc| if (b.w_dst) |w| {
+                    for (b.ids, 0..) |rid, i| rc.put(b.layer, rid, w[i * b.row_w ..][0..b.row_w], if (b.s_map == null) b.s_dst.?[i * b.row_s ..][0..b.row_s] else null);
+                };
                 if (a.batches.fetchRemove(id)) |kv| a.freeBatch(kv.value);
                 for (a.live.items, 0..) |l, k| if (l[0] == id) {
                     _ = a.live.orderedRemove(k);
diff --git a/zig/src/families/dsv41/engram_io.zig b/zig/src/families/dsv41/engram_io.zig
