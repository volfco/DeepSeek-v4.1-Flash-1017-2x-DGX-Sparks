+                continue;
+            }
+            cbs[n_sub] = .{
                 .data = (id << 20) | j,
                 .lio_opcode = cmd_pread,
                 .fildes = @intCast(if (sc) fd_s else fd_w),
@@ -210,18 +228,20 @@ pub const Aio = struct {
                 .nbytes = std.mem.alignForward(u64, off + rb - lo, block),
