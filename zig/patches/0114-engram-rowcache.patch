+/// Engram layer id (layers.<id>.engram.embed.*) — half of RowCache's row key, since the row id ranges reset per layer.
+pub const Table = struct { id: u32 = 0, fd_w: std.c.fd_t, base_w: u64, row_w: usize, fd_s: std.c.fd_t, base_s: u64, row_s: usize, rows: u64, fd_wd: std.c.fd_t = -1, fd_sd: std.c.fd_t = -1, writable: bool = false, s_map: ?[]const u8 = null };
 
