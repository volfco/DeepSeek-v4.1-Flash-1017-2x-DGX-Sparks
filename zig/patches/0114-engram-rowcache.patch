+        var hit = false; // TF_DS_ENGRAM_ROWCACHE serves this row (decided at its first read; the scales follow it)
         for (0..reads) |j| {
             const i = if (mapped) j else j >> 1;
             const sc = !mapped and (j & 1 == 1);
@@ -202,7 +213,14 @@ pub const Aio = struct {
             b.skew[j] = @intCast(off - lo);
             b.bytes[j] = rb;
             b.dst[j] = if (out_w) |w| (if (sc) out_s.?[i * t.row_s ..].ptr else w[i * t.row_w ..].ptr) else null;
-            cbs[j] = .{
+            if (out_w != null) if (a.rc) |rc| {
