+/// TF_DS_ENGRAM_ROWCACHE_MB: a process-lifetime LRU of the Engram rows a read already fetched, keyed (table id, row id).
+/// Row ids are position-free n-gram hashes (engram.zig's Hasher) that recur across turns, requests and decode steps, and
+/// their ranges reset per layer, so a key without the table id would serve one layer's bytes at another's row. Entries
+/// hold the weight bytes and the scale bytes, except where the table maps its scales (TF_DS_ENGRAM_SCALES=map: the scales
+/// come from the mapping and cost no cache bytes). The budget is bytes of row payloads and the LRU rows go past it; up to
+/// four readers share the cache (the read-ahead, the lead readers, the rounds), so a mutex guards each lookup, and a
+/// duplicate fill keeps the first copy (every copy of a (table, row) is the same bytes).
+pub const RowCache = struct {
+    const Key = struct { layer: u32, row: i64 };
+    const Node = struct {
+        key: Key,
+        w: []u8,
+        s: []u8,
+        newer: ?*Node = null, // toward the most recently used
+        older: ?*Node = null,
+    };
+
+    gpa: std.mem.Allocator,
+    io: std.Io,
+    budget: u64,
+    used: u64 = 0,
+    map: std.AutoHashMapUnmanaged(Key, *Node) = .empty,
+    mru: ?*Node = null,
+    lru: ?*Node = null,
+    mutex: std.Io.Mutex = .init,
+
+    /// TF_DS_ENGRAM_ROWCACHE_MB's budget in bytes; null when unset, 0 or not a number (off: every read as before).
+    pub fn budgetOf(v: ?[]const u8) ?u64 {
+        const n = std.fmt.parseInt(u64, v orelse return null, 10) catch return null;
+        if (n == 0) return null;
+        return std.math.mul(u64, n, 1 << 20) catch null;
+    }
+
+    pub fn init(gpa: std.mem.Allocator, io: std.Io, budget: u64) !*RowCache {
+        const rc = try gpa.create(RowCache);
+        rc.* = .{ .gpa = gpa, .io = io, .budget = budget };
+        return rc;
+    }
+
+    pub fn deinit(rc: *RowCache) void {
+        var it = rc.map.valueIterator();
+        while (it.next()) |np| rc.free(np.*);
+        rc.map.deinit(rc.gpa);
+        rc.gpa.destroy(rc);
+    }
+
+    /// The row's bytes into out_w (and out_s where the entry holds scales); false leaves both untouched. A mapped
+    /// table's entries hold no scales (the mapping serves them), so a caller that needs them misses instead.
+    pub fn get(rc: *RowCache, layer: u32, row: i64, out_w: []u8, out_s: ?[]u8) bool {
+        rc.mutex.lockUncancelable(rc.io);
+        defer rc.mutex.unlock(rc.io);
+        const n = rc.map.get(.{ .layer = layer, .row = row }) orelse return false;
+        if (out_w.len != n.w.len) return false;
+        if (out_s) |os| {
+            if (os.len != n.s.len) return false;
+            @memcpy(os, n.s);
+        }
+        @memcpy(out_w, n.w);
+        rc.front(n);
+        return true;
+    }
+
+    /// Whether the row is cached (no copy): a reader's run of misses ends at the next cached row.
+    pub fn has(rc: *RowCache, layer: u32, row: i64) bool {
+        rc.mutex.lockUncancelable(rc.io);
+        defer rc.mutex.unlock(rc.io);
+        return rc.map.contains(.{ .layer = layer, .row = row });
+    }
+
+    /// Cache the row's bytes (`s` null where the scales come from a mapping). The first copy of a row stays, the LRU
+    /// rows go past the budget, and a row the budget cannot hold is not cached at all.
+    pub fn put(rc: *RowCache, layer: u32, row: i64, w: []const u8, s: ?[]const u8) void {
+        const bytes: u64 = w.len + if (s) |x| x.len else 0;
+        if (bytes == 0 or bytes > rc.budget) return;
+        rc.mutex.lockUncancelable(rc.io);
+        defer rc.mutex.unlock(rc.io);
+        const key: Key = .{ .layer = layer, .row = row };
+        if (rc.map.contains(key)) return;
+        while (rc.used + bytes > rc.budget) {
+            const v = rc.lru orelse break;
+            rc.unlink(v);
+            _ = rc.map.remove(v.key);
+            rc.used -= v.w.len + v.s.len;
+            rc.free(v);
+        }
+        if (rc.used + bytes > rc.budget) return;
+        const data = rc.gpa.alloc(u8, bytes) catch return; // the cache gives way, never the read
+        const n = rc.gpa.create(Node) catch {
+            rc.gpa.free(data);
+            return;
+        };
+        n.* = .{ .key = key, .w = data[0..w.len], .s = data[w.len..] };
+        @memcpy(n.w, w);
+        if (s) |x| @memcpy(n.s, x);
+        rc.map.put(rc.gpa, key, n) catch {
+            rc.free(n);
+            return;
+        };
+        rc.link(n);
+        rc.used += bytes;
+    }
+
+    fn free(rc: *RowCache, n: *Node) void {
+        rc.gpa.free(n.w.ptr[0 .. n.w.len + n.s.len]);
+        rc.gpa.destroy(n);
+    }
+
+    fn front(rc: *RowCache, n: *Node) void {
+        if (rc.mru == n) return;
+        rc.unlink(n);
+        rc.link(n);
+    }
+
+    fn link(rc: *RowCache, n: *Node) void {
+        n.newer = null;
+        n.older = rc.mru;
+        if (rc.mru) |m| m.newer = n;
+        rc.mru = n;
+        if (rc.lru == null) rc.lru = n;
+    }
+
+    fn unlink(rc: *RowCache, n: *Node) void {
+        if (n.newer) |x| x.older = n.older else rc.mru = n.older;
+        if (n.older) |x| x.newer = n.newer else rc.lru = n.newer;
+        n.newer = null;
+        n.older = null;
+    }
+};
+
 /// Reader threads that wait for a gather and share its rows by an atomic counter.
 pub const Pool = struct {
     io: std.Io,
@@ -542,3 +672,92 @@ test "rows of a toy table by id, on the pool" {
     try std.testing.expectEqualSlices(u8, &.{ 20, 21, 22, 23, 0, 1, 2, 3, 8, 9, 10, 11 }, &w);
     try std.testing.expectEqualSlices(u8, &.{ 29, 24, 26 }, &s);
 }
+
+test "TF_DS_ENGRAM_ROWCACHE_MB: unset or 0 is off, N is N MiB" {
+    try std.testing.expect(RowCache.budgetOf(null) == null);
+    try std.testing.expect(RowCache.budgetOf("0") == null);
+    try std.testing.expect(RowCache.budgetOf("x") == null);
+    try std.testing.expect(RowCache.budgetOf("-1") == null);
+    try std.testing.expectEqual(@as(?u64, 16 << 20), RowCache.budgetOf("16"));
+}
+
+test "row cache: a cached row's bytes are the read's, keyed (table id, row id)" {
+    const a = std.testing.allocator;
+    const io = std.testing.io;
+    var tmp = std.testing.tmpDir(.{ .iterate = true });
+    defer tmp.cleanup();
+    // the [6, 4] weight table and its [6, 1] scales for layer 14, as above
+    const json = "{\"layers.14.engram.embed.weight\":{\"dtype\":\"U8\",\"shape\":[6,4],\"data_offsets\":[0,24]}," ++
+        "\"layers.14.engram.embed.scale\":{\"dtype\":\"U8\",\"shape\":[6,1],\"data_offsets\":[24,30]}}";
+    var file: std.ArrayList(u8) = .empty;
+    defer file.deinit(a);
+    var len: [8]u8 = undefined;
+    std.mem.writeInt(u64, &len, json.len, .little);
+    try file.appendSlice(a, &len);
+    try file.appendSlice(a, json);
+    for (0..30) |i| try file.append(a, @intCast(i));
+    try tmp.dir.writeFile(io, .{ .sub_path = "engram.safetensors", .data = file.items });
+    const dir = try std.fs.path.join(a, &.{ ".zig-cache", "tmp", &tmp.sub_path });
+    defer a.free(dir);
+    var t = try Tables.open(a, io, dir);
+    defer t.close();
+    const tab = t.layers.get(14).?;
+    const pool = try Pool.init(a, io, 2);
+    defer pool.deinit(a);
+    const rc = try RowCache.init(a, io, 1 << 20);
+    defer rc.deinit();
+    // the rows the pool read cached, and read back as the read's bytes
+    var w: [2 * 4]u8 = undefined;
+    var s: [2]u8 = undefined;
+    try pool.gather(tab, &.{ 5, 0 }, &w, &s);
+    rc.put(tab.id, 5, w[0..4], s[0..1]);
+    rc.put(tab.id, 0, w[4..8], s[1..2]);
+    var gw: [4]u8 = undefined;
+    var gs: [1]u8 = undefined;
+    try std.testing.expect(rc.get(14, 5, &gw, &gs));
+    try std.testing.expectEqualSlices(u8, w[0..4], &gw);
+    try std.testing.expectEqualSlices(u8, s[0..1], &gs);
+    // the same numeric row id of another table is another row (the id ranges reset per layer)
+    const w2 = [_]u8{ 9, 8, 7, 6 };
+    const s2 = [_]u8{0};
+    rc.put(1, 5, &w2, &s2);
+    try std.testing.expect(rc.get(14, 5, &gw, &gs));
+    try std.testing.expectEqualSlices(u8, w[0..4], &gw);
+    try std.testing.expect(rc.get(1, 5, &gw, &gs));
+    try std.testing.expectEqualSlices(u8, &w2, &gw);
+    try std.testing.expectEqualSlices(u8, &s2, &gs);
+    // an uncached row misses and leaves its out untouched
+    @memset(&gw, 0xAA);
+    try std.testing.expect(!rc.get(14, 6, &gw, &gs));
+    try std.testing.expectEqual(@as(u8, 0xAA), gw[0]);
+    // a mapped table's entry holds no scales: a caller that needs them misses (the mapping must serve them)
+    rc.put(2, 5, &w2, null);
+    try std.testing.expect(rc.get(2, 5, &gw, null));
+    try std.testing.expect(!rc.get(2, 5, &gw, &gs));
+}
+
+test "row cache: the LRU rows go at the byte budget" {
+    const a = std.testing.allocator;
+    const io = std.testing.io;
+    // 5 bytes a row (4 weight + 1 scale): a budget of two rows
+    const rc = try RowCache.init(a, io, 10);
+    defer rc.deinit();
+    const w = [_]u8{ 1, 2, 3, 4 };
+    const s = [_]u8{5};
+    var gw: [4]u8 = undefined;
+    var gs: [1]u8 = undefined;
+    rc.put(1, 1, &w, &s);
+    rc.put(1, 2, &w, &s);
+    try std.testing.expect(rc.get(1, 1, &gw, &gs)); // row 1 read again: row 2 is now the LRU one
+    rc.put(1, 3, &w, &s);
+    try std.testing.expectEqual(@as(u64, 10), rc.used);
+    try std.testing.expect(rc.get(1, 1, &gw, &gs));
+    try std.testing.expect(rc.get(1, 3, &gw, &gs));
+    try std.testing.expect(!rc.has(1, 2));
+    // a row the budget cannot hold is not cached at all
+    const big: [12]u8 = @splat(7);
+    rc.put(1, 4, &big, null);
+    try std.testing.expect(!rc.has(1, 4));
+    try std.testing.expectEqual(@as(u64, 10), rc.used);
+    // and the entries are freed with the cache (the test allocator checks)
+}
