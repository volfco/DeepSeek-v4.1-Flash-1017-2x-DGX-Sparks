+/// The switch for the chunk's MoE gather on a stream of its own (the next layer's Engram block's host work overlaps it).
+pub const gather_side_env = "TF_DS_PREFILL_GATHER_OVERLAP";
+
+/// TF_DS_PREFILL_GATHER_OVERLAP runs where there is something to exchange over one transport: two or more ranks (a
+/// single rank's all-gather copies its own rows) and not the four-node 2D split (its quarters post on the main stream).
+pub fn overlapWorks(world: usize, two: bool) bool {
+    return world >= 2 and !two;
+}
+
+/// The chunk's MoE gather on its side stream: forked behind the main stream's MoE, joined where the pending post first
+/// reads gm. The same all-gather of the same buffer on the same ranks, so the bytes are; only its stream changes.
+pub fn gatherAside(e: *const Engine, ch: *Chunk) !void {
+    const s = ch.gs orelse return gather(e, ch, ch.pm, ch.gm);
+    if (ch.gs_fork) |f| {
+        try f.record(e.s);
+        try s.wait(f);
+    }
+    try e.comm.allGather(ch.pm, ch.gm, ch.n * e.c.hidden, .f32, s);
+    if (ch.gs_join) |j| try j.record(s);
+    ch.pending_side = true;
+}
+
+/// The side gather's join, before anything reads gm (a no-op when none is in flight or the switch is off).
+pub fn joinAside(e: *const Engine, ch: *Chunk) !void {
+    if (!ch.pending_side) return;
+    ch.pending_side = false;
+    if (ch.gs_join) |j| try e.s.wait(j);
+}
+
+/// The layer's pending MoE post (_forward_k's hc_post over gm), after the side gather's join when one is in flight.
+fn pendingPost(e: *const Engine, ch: *Chunk) !void {
+    if (!ch.pending) return;
+    try joinAside(e, ch);
+    try tri_basic.hcPost(e.t, ch.gm, ch.h, ch.post, ch.comb, ch.h, e.world, ch.n, e.c.hidden);
+    ch.pending = false;
+}
