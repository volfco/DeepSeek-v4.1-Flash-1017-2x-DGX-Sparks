+/// TF_DS_ENGRAM_DECODE_THREADS=<n>: the Engram row-decode pool's size (TF_DS_ENGRAM_FAST's DecodePool); unset, unparsable
+/// or outside 1 .. 16 reads 8, as before. The bytes are the same either way.
+pub fn decodeThreads(v: ?[]const u8) usize {
+    const n = std.fmt.parseInt(u32, v orelse return 8, 10) catch return 8;
+    if (n < 1 or n > 16) return 8;
+    return n;
+}
