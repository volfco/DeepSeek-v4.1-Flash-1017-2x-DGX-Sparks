# Applied by zig/Dockerfile with git apply after the hand-written patches; regenerate with scripts/port-patches.sh, do not edit.
diff --git a/zig/src/families/dsv41/engram_io.zig b/zig/src/families/dsv41/engram_io.zig
index b8634c71b7acad1cb01c8e4955194b7f314534a7..a074daca5ee12dde225203de0505710c99461cfe 100644
--- a/zig/src/families/dsv41/engram_io.zig
+++ b/zig/src/families/dsv41/engram_io.zig
@@ -701,6 +701,27 @@ test "rows of a toy table by id, on the pool" {
     try std.testing.expectEqualSlices(u8, &.{ 29, 24, 26 }, &s);
 }
 
+test "DecodePool: the same rows decode the same at each pool size" {
+    const a = std.testing.allocator;
+    const io = std.testing.io;
+    const row_w = 96; // three 32-value cells, three scales a row
+    const row_s = 3;
+    const m = 40;
+    var w: [m * row_w]u8 = undefined;
+    var s: [m * row_s]u8 = undefined;
+    for (&w, 0..) |*b, i| b.* = @intCast((i * 31 + 7) & 0xff);
+    for (&s, 0..) |*b, i| b.* = @intCast(100 + (i * 3) % 60);
+    var want: [m * row_w]u16 = undefined;
+    for (0..m) |i| engram.decodeRow(w[i * row_w ..][0..row_w], s[i * row_s ..][0..row_s], want[i * row_w ..][0..row_w]);
+    for ([_]usize{ 1, 2, 8, 16 }) |n| {
+        const p = try DecodePool.init(a, io, n);
+        defer p.deinit(a);
+        var got: [m * row_w]u16 = @splat(0);
+        p.decode(&w, &s, &got, m, row_w, row_s);
+        try std.testing.expectEqualSlices(u16, &want, &got);
+    }
+}
