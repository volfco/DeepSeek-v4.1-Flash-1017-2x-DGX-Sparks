index d849036..b804195 100644
--- a/zig/kernels/cuda/dsv41_ops.cu
+++ b/zig/kernels/cuda/dsv41_ops.cu
@@ -552,6 +552,33 @@ extern "C" __global__ void __launch_bounds__(1024) tf_ds_argmax_rows_kernel(cons
     if (threadIdx.x == 0) out[blockIdx.x] = token;
 }
 
+// TF_DS_DEVICE_ACCEPT: the longest prefix of a CHAIN window's drafts whose tokens equal the target's picks
+// (acceptPath's keep for a chain; the full tree rule stays on the host). One block per window; the ids
+// (i64) and the picks (u32) are the buffers the forward already wrote, so no new data crosses the pair.
+extern "C" __global__ void __launch_bounds__(32) tf_ds_accept_chain_kernel(
+        const long long* ids, const unsigned* picks, const unsigned* row0, const unsigned* wrows,
+        int nwin, unsigned* keep_out) {
+    const int w = blockIdx.x;
+    if (w >= nwin) return;
+    const unsigned r0 = row0[w], rows = wrows[w];
+    if (rows == 0) { if (threadIdx.x == 0) keep_out[w] = 0; return; }
+    // one thread walks the rows (R <= 16): keep = 1 + the longest matching prefix
+    if (threadIdx.x == 0) {
+        unsigned keep = 1;
+        unsigned at = 0;
+        while (at + 1 < rows) {
+            const unsigned r = r0 + at + 1;
+            const unsigned pr = r0 + at;
+            const long long id = ids[r];
+            const unsigned pick = picks[pr];
+            if (id != (long long)pick) break;
+            keep += 1;
+            at += 1;
+        }
+        keep_out[w] = keep;
+    }
+}
