+test "a chain's acceptPath is the identity prefix over the matching drafts" {
+    const gpa = std.testing.allocator;
+    for ([_]usize{ 1, 2, 3, 5, 6 }) |rows| {
+        const parents = try rowParents(gpa, rows, null);
+        defer gpa.free(parents);
+        const total = @as(usize, 1) << @intCast(2 * rows);
+        var combo: usize = 0;
+        while (combo < total) : (combo += 1) {
+            var tokens: [6]u32 = undefined;
+            var picks: [6]u32 = undefined;
+            for (0..rows) |i| {
+                tokens[i] = @intCast((combo >> @intCast(i)) & 1);
+                picks[i] = @intCast((combo >> @intCast(rows + i)) & 1);
+            }
+            const path = try acceptPath(gpa, tokens[0..rows], parents, picks[0..rows]);
+            defer gpa.free(path);
+            // the 5-line host rule the device kernel implements: 1 + the longest prefix with tokens[r] == picks[r - 1]
+            var keep: usize = 1;
+            while (keep < rows and tokens[keep] == picks[keep - 1]) keep += 1;
+            try std.testing.expectEqual(keep, path.len);
+            for (path, 0..) |r, i| try std.testing.expectEqual(@as(u32, @intCast(i)), r);
+        }
+    }
+}
