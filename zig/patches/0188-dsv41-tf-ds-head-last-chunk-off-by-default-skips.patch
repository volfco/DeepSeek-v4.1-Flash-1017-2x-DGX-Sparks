 pub const SliceEnd = enum { more, head, encoder_only };
 
+/// Does the pass have rows after this chunk? `fill` is the pass's whole id sequence (fill_seq) and `seq` the chunk's
+/// slice of it: the same buffer, cut short. The Engram read-ahead asks it, and TF_DS_HEAD_LAST_CHUNK skips the head of
+/// every chunk it says yes for.
+fn moreRowsAfter(fill: []const i32, seq: []const i32, start: usize, n: usize) bool {
+    return fill.len > start + n and fill.ptr == seq.ptr;
+}
