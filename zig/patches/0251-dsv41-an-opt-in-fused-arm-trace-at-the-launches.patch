diff --git a/zig/src/families/dsv41/fused_trace.zig b/zig/src/families/dsv41/fused_trace.zig
new file mode 100644
index 0000000000000000000000000000000000000000..d405742c3c935e6890a7d42feeeb19cce6d96d69
--- /dev/null
+++ b/zig/src/families/dsv41/fused_trace.zig
@@ -0,0 +1,183 @@
+//! TF_DS_FUSED_TRACE (off by default): an opt-in, once-per-distinct-tuple record of which fused arm the call sites
+//! select, so a run can show which kernel ran at each row count, width and PDL setting. Host-side only: the call sites
+//! hand over what they already decided (the same gate functions and bounds the launchers use), nothing is read back
+//! from the device, no bytes change, and no fingerprint bit moves. The record is bounded: past `capacity` distinct
+//! tuples further ones are not printed (a round's matrix is far below it).
+const std = @import("std");
+
+pub const env_name: [:0]const u8 = "TF_DS_FUSED_TRACE";
+
+/// The arm a call site runs. `width` in the record is the shape the arm was chosen for (the compressor's channel
+/// count, the indexer's column width, the rope kernel's head dim), so one entry identifies the exact kernel and shape.
+pub const Arm = enum {
+    idx_fused,
+    idx_small,
+    idx_unfused,
+    compress2x_norm,
+    compress2_norm,
+    compress_unfused,
+    key_fused,
+    key_unfused,
+    latent_fused,
+    latent_unfused,
+    query_fused,
+    query_pair,
+    query_unfused,
+    prompt_key_fused,
+    prompt_key_unfused,
+    prompt_latent_fused,
+    prompt_latent_unfused,
+    prune_six,
+    prune_unfused,
+};
+
+pub const Entry = struct {
+    arm: Arm,
+    rows: usize,
+    width: usize,
+    pdl: bool,
+};
+
+pub const capacity = 128;
+
+var seen: [capacity]Entry = undefined;
+var count: usize = 0;
+var enabled_cache: ?bool = null;
+
+/// TF_DS_FUSED_TRACE: unset, "" or "0" off; anything else on.
+pub fn enabled() bool {
+    if (enabled_cache) |on| return on;
+    const text = std.c.getenv(env_name);
+    const on = if (text) |t| std.mem.span(t).len != 0 and !std.mem.eql(u8, std.mem.span(t), "0") else false;
+    enabled_cache = on;
+    return on;
+}
+
+/// Record one arm selection. Called from the call sites behind `enabled()`, and directly by the test below.
+pub fn note(arm: Arm, rows: usize, width: usize, pdl: bool) void {
+    for (seen[0..count]) |e| {
+        if (e.arm == arm and e.rows == rows and e.width == width and e.pdl == pdl) return;
+    }
+    if (count == capacity) return;
+    seen[count] = .{ .arm = arm, .rows = rows, .width = width, .pdl = pdl };
+    count += 1;
+    std.debug.print("dsv41 fused trace: {s} rows={d} width={d} pdl={d}\n", .{ @tagName(arm), rows, width, @intFromBool(pdl) });
+}
+
+pub fn entries() []const Entry {
+    return seen[0..count];
+}
+
+pub fn reset() void {
+    count = 0;
+    enabled_cache = null;
+}
+
+// -- the served matrix the call sites run ----------------------------------------------------------------------------
+
+const idx_fused = @import("idx_fused.zig");
+const compress2_norm = @import("compress2_norm.zig");
+const rope_store = @import("rope_store.zig");
+
+/// The indexer's arm for a decode row count and bucket width (round.zig's candidate-source arm, prompt.zig's pooled
+/// source layer): the fused launch, its small-row form, or the unfused block_max/pool_pick sequence.
+pub fn idxArm(fused: bool, rows: usize, width: usize, bsize: usize, nbk: usize, k: usize) Arm {
+    if (!idx_fused.fuseOk(fused, rows, width, bsize, nbk, k)) return .idx_unfused;
+    return if (rows <= idx_fused.small_rows and nbk >= idx_fused.small_nbk) .idx_small else .idx_fused;
+}
+
+/// The compressor's arm (round.zig's decode ratio-2 chain, prompt.zig's chunk path).
+pub fn compressArm(fused: bool, prompt: bool, rows: usize, d: usize) Arm {
+    if (prompt) return if (compress2_norm.fuseOk(fused, rows, d)) .compress2_norm else .compress_unfused;
+    return if (compress2_norm.decodeOk(fused, rows, d)) .compress2x_norm else .compress_unfused;
+}
+
+/// The 0198 arms (round.zig's key / latent / query launches, prompt.zig's stores).
+pub fn keyArm(fused: bool, rows: usize, d: usize, rd: usize, heads: usize, prompt: bool) Arm {
+    if (!prompt and rope_store.keyFuseOk(fused, rows, d, rd, heads)) return .key_fused;
+    if (prompt and rope_store.fuseOk(fused, rows, d, rd, heads)) return .prompt_key_fused;
+    return if (prompt) .prompt_key_unfused else .key_unfused;
+}
+
+pub fn latentArm(fused: bool, rows: usize, d: usize, rd: usize, prompt: bool) Arm {
+    if (prompt) return if (rope_store.fuseOk(fused, rows, d, rd, 1)) .prompt_latent_fused else .prompt_latent_unfused;
+    return if (rope_store.fuseOk(fused, rows, d, rd, 1)) .latent_fused else .latent_unfused;
+}
+
+pub fn queryArm(fused: bool, rows: usize, d: usize, rd: usize, heads: usize) Arm {
+    if (!rope_store.fuseOk(fused, rows, d, rd, heads)) return .query_unfused;
+    return if (rows >= 32) .query_pair else .query_fused;   // the per-row-count geometry (0241)
+}
+
+// -- tests -----------------------------------------------------------------------------------------------------------
+
+const expectEqual = std.testing.expectEqual;
+
+test "the trace is off unless TF_DS_FUSED_TRACE is set" {
+    reset();
+    try expectEqual(false, enabled());   // the test harness runs without the variable
+}
+
+test "the served matrix selects the recorded arms, once per tuple" {
+    reset();
+    const rows_list = [_]usize{ 1, 7, 32, 48, 128, 1024 };
+    for (rows_list) |rows| {
+        for ([_]bool{ false, true }) |pdl| {
+            // decode: bucket 8 (the small pool) and 8192 (the 65,536-column window); k = candidate_blocks
+            for ([_]usize{ 8, 8192 }) |nb| {
+                const width = 8 * nb - 3;
+                const nbk = 1 + (width - 1) / 8;
+                note(idxArm(true, rows, width, 8, nbk, @min(2048, nbk)), rows, width, pdl);
+            }
+            for ([_]usize{ 128, 512 }) |d| note(compressArm(true, false, rows, d), rows, d, pdl);
+            note(keyArm(true, rows, 128, 64, 1, false), rows, 128, pdl);
+            note(latentArm(true, rows, 512, 64, false), rows, 512, pdl);
+            note(queryArm(true, rows, 128, 64, 32), rows, 128, pdl);
+            note(.prune_six, rows, 7, pdl);
+        }
+    }
+    // the arms the call sites take at the served decode shapes, as a table
+    const table = [_]Entry{
+        .{ .arm = .idx_fused, .rows = 1, .width = 61, .pdl = false },
+        .{ .arm = .idx_small, .rows = 1, .width = 65533, .pdl = false },
+        .{ .arm = .idx_small, .rows = 7, .width = 65533, .pdl = false },
+        .{ .arm = .idx_fused, .rows = 32, .width = 65533, .pdl = false },
+        .{ .arm = .compress2x_norm, .rows = 1, .width = 128, .pdl = false },
+        .{ .arm = .compress2x_norm, .rows = 1, .width = 512, .pdl = false },
+        .{ .arm = .key_fused, .rows = 1, .width = 128, .pdl = false },
+        .{ .arm = .latent_fused, .rows = 1, .width = 512, .pdl = false },
+        .{ .arm = .query_fused, .rows = 1, .width = 128, .pdl = false },
+        .{ .arm = .query_pair, .rows = 32, .width = 128, .pdl = false },
+        .{ .arm = .prune_six, .rows = 1, .width = 7, .pdl = false },
+    };
+    for (table) |want| {
+        var found = false;
+        for (entries()) |e| {
+            if (std.meta.eql(e, want)) found = true;
+        }
+        if (!found) std.debug.print("missing {s} rows={d} width={d} pdl={d}\n", .{ @tagName(want.arm), want.rows, want.width, @intFromBool(want.pdl) });
+        try std.testing.expect(found);
+    }
+    // pdl is part of the key, and a repeated tuple is recorded once (rows 3 is not in the matrix above)
+    const before = count;
+    note(.idx_fused, 3, 61, true);
+    try expectEqual(before + 1, count);
+    note(.idx_fused, 3, 61, true);
+    try expectEqual(before + 1, count);
+    note(.idx_fused, 3, 61, false);
+    try expectEqual(before + 2, count);
+    try std.testing.expect(count <= capacity);
+}
+
+test "the arms switch off with the switches" {
+    reset();
+    try expectEqual(.idx_unfused, idxArm(false, 7, 65533, 8, 8192, 2048));
+    try expectEqual(.compress_unfused, compressArm(false, false, 7, 512));
+    try expectEqual(.key_unfused, keyArm(false, 7, 128, 64, 1, false));
+    try expectEqual(.latent_unfused, latentArm(false, 7, 512, 64, false));
+    try expectEqual(.query_unfused, queryArm(false, 32, 128, 64, 32));
+    // and past the fused bounds the unfused sequence runs, as the call sites fall back
+    try expectEqual(.idx_unfused, idxArm(true, 7, 8 * 16385 - 3, 8, 16385, 2048));
+    try expectEqual(.compress_unfused, compressArm(true, false, 7, 256));   // decodeOk takes 128 and 512 only
+    try expectEqual(.compress2_norm, compressArm(true, true, 128, 2048));   // the prompt half takes pow2 to 2048
+}
