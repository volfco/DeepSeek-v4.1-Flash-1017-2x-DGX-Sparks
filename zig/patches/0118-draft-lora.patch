+/// A host stub of the epilogue's device work: the pointers are host arrays' addresses (the tests pass @intFromPtr), the
+/// arithmetic is the real one in f32, and the calls are counted in order.
+const Stub = struct {
+    calls: usize = 0,
+    roped: bool = false,
+    added: bool = false,
+    fp32: bool = false,
+
+    fn gemm(ctx: *anyopaque, x: u64, w: u64, y: u64, rows: usize, k: usize, n: usize, alpha: f32, beta: f32, fp32_out: bool) anyerror!void {
+        const s: *Stub = @ptrCast(@alignCast(ctx));
+        s.calls += 1;
+        s.fp32 = fp32_out;
+        const xs: [*]const f32 = @ptrFromInt(x);
+        const ws: [*]const f32 = @ptrFromInt(w);
+        const ys: [*]f32 = @ptrFromInt(y);
+        for (0..rows) |i| for (0..n) |j| {
+            var acc: f32 = 0;
+            for (0..k) |kk| acc += xs[i * k + kk] * ws[j * k + kk];
+            ys[i * n + j] = alpha * acc + beta * ys[i * n + j];
+        };
+    }
+    fn rope(ctx: *anyopaque, y: u64, rows: usize, heads: usize, hd: usize) anyerror!void {
+        const s: *Stub = @ptrCast(@alignCast(ctx));
+        s.calls += 1;
+        s.roped = true;
+        _ = .{ y, rows, heads, hd };
+    }
+    fn add(ctx: *anyopaque, y: u64, t: u64, count: usize) anyerror!void {
+        const s: *Stub = @ptrCast(@alignCast(ctx));
+        s.calls += 1;
+        s.added = true;
+        const ys: [*]f32 = @ptrFromInt(y);
+        const ts: [*]const f32 = @ptrFromInt(t);
+        for (0..count) |i| ys[i] += ts[i];
+    }
+    fn sinkOf(s: *Stub) Sink {
+        return .{ .ctx = s, .gemm = Stub.gemm, .rope = Stub.rope, .add = Stub.add };
+    }
+};
+
+/// y0 + scale * B * (A * x) in f32, the reference the stub's launches must reproduce.
+fn refEpilogue(y0: []const f32, x: []const f32, av: []const f32, bv: []const f32, rows: usize, k: usize, r: usize, n: usize, scale: f32, out: []f32) void {
+    var t: [64]f32 = undefined;
+    for (0..rows) |i| for (0..r) |j| {
+        var acc: f32 = 0;
+        for (0..k) |kk| acc += av[j * k + kk] * x[i * k + kk];
+        t[i * r + j] = acc;
+    };
+    for (0..rows) |i| for (0..n) |j| {
+        var acc: f32 = 0;
+        for (0..r) |kk| acc += bv[j * r + kk] * t[i * r + kk];
+        out[i * n + j] = y0[i * n + j] + scale * acc;
+    };
+}
+
+test "epilogue: y += (alpha/r) * B * (A * x), the rope only on wq_b, and nothing for an untargeted module" {
+    const rows = 2;
+    const r = 2;
+    const k = 3;
+    const n = 2;
+    const scale: f32 = 0.5; // alpha / r, r = 2, alpha = 1
+    var av = [_]f32{ 0.5, -1, 2, 0.25, 0.75, -0.5 }; // A [r, k]
+    var bv = [_]f32{ 1, 2, -1, 0.5 }; // B [n, r]
+    var xv = [_]f32{ 1, 2, 3, -1, 0.5, 2 }; // x [rows, k]
+    var tv = [_]f32{ 0, 0, 0, 0 };
+    var yl = [_]f32{ 0, 0, 0, 0 };
+    var yv = [_]f32{ 0.5, -0.25, 1, 2 }; // the projection's own output
+    var want: [4]f32 = undefined;
+    refEpilogue(&yv, &xv, &av, &bv, rows, k, r, n, scale, &want);
+
+    // wq_b: gemm, gemm, rope, add - the term lands on the projection's post-rope output
+    var ad: Adapter = .{
+        .r = r,
+        .scale = scale,
+        .hd = n, // one head of n columns: the rope's head count is m.n / hd
+        .t = @intFromPtr(&tv),
+        .yl = @intFromPtr(&yl),
+        .n_max = n,
+    };
+    ad.stages[1].mods[@intFromEnum(Kind.wq_b)] = .{ .a = @intFromPtr(&av), .b = @intFromPtr(&bv), .k = k, .n = n };
+    var st: Stub = .{};
+    const sk = Stub.sinkOf(&st);
+    try apply(&ad, sk, 1, .wq_b, @intFromPtr(&xv), @intFromPtr(&yv), rows);
+    try testing.expectEqual(@as(usize, 4), st.calls);
+    try testing.expect(st.roped and st.added and !st.fp32);
+    try testing.expectEqualSlices(f32, &want, &yv);
+
+    // wo_b: two GEMMs, the second accumulating into the fp32 output - no rope, no add
+    var yf = [_]f32{ 0.5, -0.25, 1, 2 };
+    refEpilogue(&yf, &xv, &av, &bv, rows, k, r, n, scale, &want);
+    ad.stages[0].mods[@intFromEnum(Kind.wo_b)] = .{ .a = @intFromPtr(&av), .b = @intFromPtr(&bv), .k = k, .n = n };
+    st = .{};
+    try apply(&ad, sk, 0, .wo_b, @intFromPtr(&xv), @intFromPtr(&yf), rows);
+    try testing.expectEqual(@as(usize, 2), st.calls);
+    try testing.expect(!st.roped and !st.added and st.fp32);
+    try testing.expectEqualSlices(f32, &want, &yf);
+
+    // an unadapted module and a zero alpha issue nothing (a zero rank is scale 0 too, and load keeps it out entirely)
+    st = .{};
+    try apply(&ad, sk, 0, .wq_a, @intFromPtr(&xv), @intFromPtr(&yv), rows);
+    try testing.expectEqual(@as(usize, 0), st.calls);
+    var zero: Adapter = ad;
+    zero.scale = 0;
+    try apply(&zero, sk, 1, .wq_b, @intFromPtr(&xv), @intFromPtr(&yv), rows);
+    try testing.expectEqual(@as(usize, 0), st.calls);
+    try apply(&ad, sk, 2, .wq_b, @intFromPtr(&xv), @intFromPtr(&yv), rows); // a stage without the module
+    try testing.expectEqual(@as(usize, 0), st.calls);
+}
