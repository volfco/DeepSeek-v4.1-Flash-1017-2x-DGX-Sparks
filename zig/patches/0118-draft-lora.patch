+//! TF_DS_LORA: a PEFT adapter on the DSpark drafter's attention projections, applied as an additive epilogue on a
+//! projection's output (`y += (alpha/r) * B * (A * x)`) after the EXL3 glinear has written y. The EXL3 trellis kernels
+//! are untouched: the term is two GEMMs into a scratch, roped where the projection's own epilogue ropes (wq_b), then
+//! added. Off by default; with the switch off (or an empty/zero-rank adapter) no buffer is taken and no launch is
+//! issued, so the pass is bit-identical to base.
+//!
+//! TP=2: the adapter folder holds the unsharded tensors. A rank loads only its own slice, by the same plan the rank's
+//! weights were loaded with (plan.Split; the DSpark blocks are TP2 inside the pair, so `pair` is null): wq_b's B rows
+//! are the rank's output columns (`wqB`), wo_b's A columns are the rank's input rows (`range(groups * o_lora)`), and the
+//! replicated projections (wq_a, wkv) take the whole adapter on both ranks.
+//!
+//! Capture: every launch here is stream-ordered on the engine's stream inside Drafter.body, which is what
+//! PassGraphs.run captures, so a replayed graph replays the epilogue too. The GEMMs are cuBLAS (already captured in
+//! body for the confidence head); rope_heads is the kit's Triton cubin already in the AOT set; add_bf16 is the
+//! family's fatbin kernel. No new AOT entry is needed.
+const std = @import("std");
+const core = @import("core");
+const plan = @import("plan.zig");
+const config = @import("config.zig");
+const prompt = @import("prompt.zig");
+const tri_norm = @import("tri_norm.zig");
+
+const safetensors = core.safetensors;
+
+pub const env = "TF_DS_LORA";
+pub const config_name = "adapter_config.json";
+pub const model_name = "adapter_model.safetensors";
+
+/// The most rank an adapter may carry (the scratch is [rows, r] bf16).
+pub const max_r = 128;
+/// The DSpark stages an adapter may carry (draft.max_stages).
+pub const max_stages = 4;
+
+/// The projections an adapter may target: the block's dense ones whose output is this rank's buffer and whose input is
+/// a buffer the pass has already written. wo_a (grouped slices) and the experts are not targeted.
+pub const Kind = enum { wq_a, wq_b, wkv, wo_b };
+pub const kind_names = [_][]const u8{ "wq_a", "wq_b", "wkv", "wo_b" };
+pub const n_kinds = kind_names.len;
+
+/// The switch: unset or empty is off.
+pub fn enabled(dir: ?[]const u8) bool {
+    const d = dir orelse return false;
+    return d.len > 0;
+}
+
+pub fn kindOf(name: []const u8) ?Kind {
+    const n = if (std.mem.startsWith(u8, name, "attn.")) name["attn.".len..] else name;
+    inline for (kind_names, 0..) |k, i| if (std.mem.eql(u8, n, k)) return @enumFromInt(i);
+    return null;
+}
+
+/// A projection's widths in the checkpoint and this rank's slice of them.
+pub const Shape = struct {
+    k_full: usize, // the projection's input width (A's columns)
+    n_full: usize, // its output width (B's rows)
+    k_rank: [2]usize, // this rank's input columns
+    n_rank: [2]usize, // this rank's output rows
+};
+
+/// The plan's ranges for one projection on `sp` (the DSpark blocks' TP2 split: `pair` null).
+pub fn shape(sp: plan.Split, c: config.Config, kind: Kind) Shape {
+    const d = c.hidden;
+    const gl = sp.groups(c);
+    return switch (kind) {
+        .wq_a => .{ .k_full = d, .n_full = c.q_lora, .k_rank = .{ 0, d }, .n_rank = .{ 0, c.q_lora } },
+        .wq_b => .{ .k_full = c.q_lora, .n_full = c.heads * c.head_dim, .k_rank = .{ 0, c.q_lora }, .n_rank = sp.wqB(c) },
+        .wkv => .{ .k_full = d, .n_full = c.head_dim, .k_rank = .{ 0, d }, .n_rank = .{ 0, c.head_dim } },
+        .wo_b => .{ .k_full = c.o_groups * c.o_lora, .n_full = d, .k_rank = sp.range(gl * c.o_lora), .n_rank = .{ 0, d } },
+    };
+}
+
+/// adapter_config.json's part the engine reads: the rank, alpha and target modules (PEFT's rslora / DoRA are refused).
+pub const Cfg = struct { r: usize, alpha: f32, kinds: []const Kind, scale: f32 };
+
+fn number(v: std.json.Value) ?f64 {
+    return switch (v) {
+        .integer => |i| @floatFromInt(i),
+        .float => |f| f,
+        .number_string => |s| std.fmt.parseFloat(f64, s) catch null,
+        else => null,
+    };
+}
+
+fn flag(o: std.json.ObjectMap, name: []const u8) bool {
+    const v = o.get(name) orelse return false;
+    return v == .bool and v.bool;
+}
+
+/// The adapter's config: a rank in 0..=max_r, an alpha >= 0, and target modules among `kind_names` (with or without the
+/// "attn." prefix). A zero rank or an empty target list is a zero adapter (a no-op).
+pub fn parseConfig(a: std.mem.Allocator, text: []const u8) !Cfg {
+    const v = try std.json.parseFromSliceLeaky(std.json.Value, a, text, .{});
+    if (v != .object) return error.AdapterConfig;
+    const o = v.object;
+    if (flag(o, "use_rslora")) return error.AdapterRslora;
+    if (flag(o, "use_dora")) return error.AdapterDora;
+    const rf = number(o.get("r") orelse return error.AdapterRank) orelse return error.AdapterRank;
+    if (rf < 0 or rf != @floor(rf)) return error.AdapterRank;
+    const r: usize = @intFromFloat(rf);
+    if (r > max_r) return error.AdapterRankTooLarge;
+    const alpha: f32 = @floatCast(number(o.get("lora_alpha") orelse return error.AdapterAlpha) orelse return error.AdapterAlpha);
+    if (!(alpha >= 0)) return error.AdapterAlpha;
+    var kinds: std.ArrayList(Kind) = .empty;
+    if (o.get("target_modules")) |tv| {
+        if (tv != .array) return error.AdapterTargets;
+        for (tv.array.items) |item| {
+            if (item != .string) return error.AdapterTargets;
+            const k = kindOf(item.string) orelse return error.UnsupportedTargetModule;
+            var dup = false;
+            for (kinds.items) |x| dup = dup or x == k;
+            if (!dup) try kinds.append(a, k);
+        }
+    }
+    const scale: f32 = if (r == 0) 0 else alpha / @as(f32, @floatFromInt(r));
+    return .{ .r = r, .alpha = alpha, .kinds = kinds.items, .scale = scale };
+}
+
+/// A validated adapter folder: the mapped tensors as saved (the unsharded A and B), the rank's plan ranges and the
+/// scale. `close` unmaps it.
+pub const Checked = struct {
+    file: safetensors.File,
+    r: usize,
+    scale: f32,
+    hd: usize,
+    used: u8, // bit per Kind targeted
+    shapes: [n_kinds]Shape,
+    tensors: [max_stages][n_kinds]?AB,
+
+    pub const AB = struct { a: safetensors.Tensor, b: safetensors.Tensor };
+
+    pub fn close(k: *Checked, io: std.Io) void {
+        k.file.close(io);
+    }
+};
+
+fn findTensors(file: *const safetensors.File, j: usize, kind: Kind, r: usize, sh: Shape) !Checked.AB {
+    var out: [2]safetensors.Tensor = undefined;
+    const parts = [_][]const u8{ "lora_A", "lora_B" };
+    const want = [_][2]usize{ .{ r, sh.k_full }, .{ sh.n_full, r } };
+    for (parts, 0..) |part, i| {
+        var suffix: [96]u8 = undefined;
+        const s = try std.fmt.bufPrint(&suffix, ".mtp.{d}.attn.{s}.{s}.weight", .{ j, kind_names[@intFromEnum(kind)], part });
+        var found: ?safetensors.Tensor = null;
+        for (file.names.keys()) |name| {
+            if (!std.mem.endsWith(u8, name, s)) continue;
+            found = file.get(name);
+            break;
+        }
+        const t = found orelse return error.AdapterTensor;
+        if (t.dtype != .bf16) return error.UnsupportedAdapterDType;
+        if (!t.is(.bf16, &want[i])) return error.AdapterShape;
+        out[i] = t;
+    }
+    return .{ .a = out[0], .b = out[1] };
+}
+
+/// Validate a PEFT folder against the plan: the config's rank, alpha and target modules, the tensors' names, dtypes
+/// and (unsharded) shapes. A missing folder or file, or any mismatch, fails here rather than at the first request.
+pub fn check(gpa: std.mem.Allocator, io: std.Io, dir: []const u8, c: config.Config, sp: plan.Split) !Checked {
+    var d = std.Io.Dir.cwd().openDir(io, dir, .{}) catch return error.AdapterDirMissing;
+    d.close(io);
+    var arena = std.heap.ArenaAllocator.init(gpa);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const cfg_path = try std.fs.path.join(a, &.{ dir, config_name });
+    const text = std.Io.Dir.cwd().readFileAlloc(io, cfg_path, a, .limited(1 << 20)) catch return error.AdapterConfigMissing;
+    const cfg = try parseConfig(a, text);
+    if (c.draft_layers > max_stages) return error.AdapterTooManyStages;
+    const model_path = try std.fs.path.join(a, &.{ dir, model_name });
+    var file = safetensors.File.open(gpa, io, model_path) catch return error.AdapterModelMissing;
+    errdefer file.close(io);
+    var used: u8 = 0;
+    var shapes: [n_kinds]Shape = undefined;
+    var tensors: [max_stages][n_kinds]?Checked.AB = @splat(@splat(null));
+    if (cfg.r > 0) {
+        for (cfg.kinds) |k| {
+            const sh = shape(sp, c, k);
+            shapes[@intFromEnum(k)] = sh;
+            used |= @as(u8, 1) << @intFromEnum(k);
+            for (0..c.draft_layers) |j| tensors[j][@intFromEnum(k)] = try findTensors(&file, j, k, cfg.r, sh);
+        }
+    }
+    return .{ .file = file, .r = cfg.r, .scale = cfg.scale, .hd = c.head_dim, .used = used, .shapes = shapes, .tensors = tensors };
+}
+
+/// One module's rank slice on the device: A [r, k] (this rank's input columns) and B [n, r] (this rank's output rows).
+pub const Mod = struct { a: u64, b: u64, k: usize, n: usize };
+
+pub const Stage = struct { mods: [n_kinds]?Mod = @splat(null) };
+
+pub const Adapter = struct {
+    r: usize,
+    scale: f32,
+    hd: usize,
+    t: u64, // bf16 [rows, r]: A * x
+    yl: u64 = 0, // bf16 [rows, n_max]: B * t (0 when no bf16-output projection is targeted)
+    n_max: usize = 0,
+    stages: [max_stages]Stage = @splat(.{ .mods = @splat(null) }),
+};
+
+/// The device work the epilogue issues. The real sink (draft.zig's Ctx) runs cuBLAS and the family's kernels; the tests
+/// run a host stub, which is how the epilogue's arithmetic and launch plan are checked without a GPU.
+pub const Sink = struct {
+    ctx: *anyopaque,
+    gemm: *const fn (ctx: *anyopaque, x: u64, w: u64, y: u64, rows: usize, k: usize, n: usize, alpha: f32, beta: f32, fp32_out: bool) anyerror!void,
+    rope: *const fn (ctx: *anyopaque, y: u64, rows: usize, heads: usize, hd: usize) anyerror!void,
+    add: *const fn (ctx: *anyopaque, y: u64, t: u64, count: usize) anyerror!void,
+};
+
+/// The served sink's state: the engine, the rope tables and position the pass's rows carry.
+pub const Ctx = struct { e: *const prompt.Engine, rope: prompt.Rope, pos: u64, rd: usize };
+
+fn gemm(ctx: *anyopaque, x: u64, w: u64, y: u64, rows: usize, k: usize, n: usize, alpha: f32, beta: f32, fp32_out: bool) anyerror!void {
+    const c: *Ctx = @ptrCast(@alignCast(ctx));
+    try c.e.blas.gemmBf16(x, w, y, rows, k, n, alpha, beta, fp32_out);
+}
+
+fn rope(ctx: *anyopaque, y: u64, rows: usize, heads: usize, hd: usize) anyerror!void {
+    const c: *Ctx = @ptrCast(@alignCast(ctx));
+    try tri_norm.ropeHeads(c.e.t, y, c.rope.cos, c.rope.sin, c.pos, c.rd, false, rows, heads, hd);
+}
+
+fn add(ctx: *anyopaque, y: u64, t: u64, count: usize) anyerror!void {
+    const c: *Ctx = @ptrCast(@alignCast(ctx));
+    try c.e.ops.addBf16(c.e.s, y, t, count);
+}
+
+pub fn sink(c: *Ctx) Sink {
+    return .{ .ctx = c, .gemm = gemm, .rope = rope, .add = add };
+}
+
+/// The additive epilogue on `kind`'s output `y` (bf16 [rows, n], or fp32 for wo_b) from the projection's input `x`:
+/// t = A * x, then y += scale * B * t. wq_b's output is post-RoPE (the glinear epilogue rotates it), so its term takes
+/// the same rotation before it is added. An untargeted module, or a zero scale, issues nothing.
+pub fn apply(ad: *const Adapter, sk: Sink, stage: usize, kind: Kind, x: u64, y: u64, rows: usize) !void {
+    if (rows == 0 or ad.scale == 0 or stage >= ad.stages.len) return;
+    const m = ad.stages[stage].mods[@intFromEnum(kind)] orelse return;
+    try sk.gemm(sk.ctx, x, m.a, ad.t, rows, m.k, ad.r, 1, 0, false);
+    if (kind == .wo_b) return sk.gemm(sk.ctx, ad.t, m.b, y, rows, ad.r, m.n, ad.scale, 1, true);
+    try sk.gemm(sk.ctx, ad.t, m.b, ad.yl, rows, ad.r, m.n, ad.scale, 0, false);
+    if (kind == .wq_b) try sk.rope(sk.ctx, ad.yl, rows, m.n / ad.hd, ad.hd);
+    try sk.add(sk.ctx, y, ad.yl, rows * m.n);
+}
+
+/// A's rank slice: its input columns [k0, k1) of every row, into a device tensor [r, k1 - k0].
+fn uploadA(e: *const prompt.Engine, a: *prompt.Arena, t: safetensors.Tensor, r: usize, k: [2]usize, k_full: usize) !u64 {
+    const w = k[1] - k[0];
+    const dst = try a.take(r * w * 2);
+    if (w == k_full) {
+        try prompt.upload(e, dst, t.bytes.ptr, r * w * 2);
+        return dst;
+    }
+    const stage = try std.heap.page_allocator.alloc(u8, r * w * 2);
+    defer std.heap.page_allocator.free(stage);
+    for (0..r) |i| @memcpy(stage[i * w * 2 ..][0 .. w * 2], t.bytes[i * k_full * 2 ..][k[0] * 2 ..][0 .. w * 2]);
+    try prompt.upload(e, dst, stage.ptr, r * w * 2);
+    return dst;
+}
+
+/// B's rank slice: its output rows [n0, n1) (contiguous rows of the saved [n_full, r] tensor).
+fn uploadB(e: *const prompt.Engine, a: *prompt.Arena, t: safetensors.Tensor, r: usize, n: [2]usize) !u64 {
+    const w = n[1] - n[0];
+    const dst = try a.take(w * r * 2);
+    try prompt.upload(e, dst, t.bytes.ptr + n[0] * r * 2, w * r * 2);
+    return dst;
+}
+
+/// Load TF_DS_LORA's folder for this rank: null when the switch is off, empty, or the adapter is a zero adapter (r = 0,
+/// an empty target list, or alpha = 0) - in those cases nothing is allocated and no launch is issued.
+pub fn load(e: *const prompt.Engine, a: *prompt.Arena, sp: plan.Split, dir: ?[]const u8, rows: usize) !?Adapter {
+    const path = dir orelse return null;
+    if (!enabled(path)) return null;
+    // shortcut: load runs on one thread before serving; the process-wide single-threaded Io is what server/log.zig falls
+    // back to as well (the served threads never touch it).
+    const io = std.Io.Threaded.global_single_threaded.io();
+    const tp2: plan.Split = .{ .rank = sp.rank, .world = sp.world }; // the DSpark blocks stay TP2 inside the pair
+    var ck = check(std.heap.page_allocator, io, path, e.c.*, tp2) catch |err| {
+        std.log.err("dsv41 lora: TF_DS_LORA={s}: {s}", .{ path, @errorName(err) });
+        return err;
+    };
+    defer ck.close(io);
+    if (ck.r == 0 or ck.scale == 0 or ck.used == 0) return null;
+    var ad: Adapter = .{ .r = ck.r, .scale = ck.scale, .hd = ck.hd, .t = 0 };
+    var n_max: usize = 0;
+    for (0..e.c.draft_layers) |j| {
+        for (kind_names, 0..) |_, ki| {
+            if (ck.used & (@as(u8, 1) << @intCast(ki)) == 0) continue;
+            const kind: Kind = @enumFromInt(ki);
+            const ab = ck.tensors[j][ki].?;
+            const sh = ck.shapes[ki];
+            const ap = try uploadA(e, a, ab.a, ck.r, sh.k_rank, sh.k_full);
+            const bp = try uploadB(e, a, ab.b, ck.r, sh.n_rank);
+            ad.stages[j].mods[ki] = .{ .a = ap, .b = bp, .k = sh.k_rank[1] - sh.k_rank[0], .n = sh.n_rank[1] - sh.n_rank[0] };
+            if (kind != .wo_b) n_max = @max(n_max, sh.n_rank[1] - sh.n_rank[0]);
+        }
+    }
+    ad.t = try a.take(rows * ck.r * 2);
+    ad.n_max = n_max;
+    if (n_max > 0) ad.yl = try a.take(rows * n_max * 2);
+    return ad;
+}
