+/// Write a PEFT folder (the config and a BF16 safetensors of zero-filled A/B tensors) into `dir`.
+fn writeFixture(gpa: std.mem.Allocator, io: std.Io, dir: std.Io.Dir, cfg_text: []const u8, ts: []const Fixture) !void {
+    var json: std.ArrayList(u8) = .empty;
+    defer json.deinit(gpa);
+    var blob: std.ArrayList(u8) = .empty;
+    defer blob.deinit(gpa);
+    try json.appendSlice(gpa, "{");
+    var off: usize = 0;
+    for (ts, 0..) |t, i| {
+        const bytes = t.shape[0] * t.shape[1] * 2;
+        var buf: [256]u8 = undefined;
+        if (i > 0) try json.appendSlice(gpa, ",");
+        try json.appendSlice(gpa, try std.fmt.bufPrint(&buf, "\"{s}\":{{\"dtype\":\"BF16\",\"shape\":[{d},{d}],\"data_offsets\":[{d},{d}]}}", .{ t.name, t.shape[0], t.shape[1], off, off + bytes }));
+        off += bytes;
+    }
+    try json.appendSlice(gpa, "}");
+    var hdr: [8]u8 = undefined;
+    std.mem.writeInt(u64, &hdr, json.items.len, .little);
+    try blob.appendSlice(gpa, &hdr);
+    try blob.appendSlice(gpa, json.items);
+    for (0..off) |_| try blob.append(gpa, 0);
+    try dir.writeFile(io, .{ .sub_path = model_name, .data = blob.items });
+    try dir.writeFile(io, .{ .sub_path = config_name, .data = cfg_text });
+}
