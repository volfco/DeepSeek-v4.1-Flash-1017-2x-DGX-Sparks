+test "TF_DS_EXPERT_HOT_CACHE: hotPick takes the top counts' ranges, ties to the lower id" {
+    // two experts of three, each with gate/up/down ranges (3 * E in id order)
+    const ranges = [_][2]u64{ .{ 10, 1 }, .{ 20, 2 }, .{ 30, 3 }, .{ 11, 1 }, .{ 21, 2 }, .{ 31, 3 }, .{ 12, 1 }, .{ 22, 2 }, .{ 32, 3 } };
+    var out: [6][2]u64 = undefined;
+    // expert 2 first (count 9), then expert 0 (count 5); ties (1 and 2 at 0 counts) never reached
+    const n = hotPick(&.{ 5, 0, 9 }, &ranges, 2, out[0..]);
+    try std.testing.expectEqual(@as(usize, 2), n);
+    try std.testing.expectEqual(@as(u64, 30), out[0][0]);
+    try std.testing.expectEqual(@as(u64, 31), out[1][0]);
+    try std.testing.expectEqual(@as(u64, 32), out[2][0]);
+    try std.testing.expectEqual(@as(u64, 10), out[3][0]);
+    // a tie goes to the lower id; a k past the counts stops at what there is
+    const m = hotPick(&.{ 7, 7, 0 }, &ranges, 5, out[0..]);
+    try std.testing.expectEqual(@as(usize, 2), m);
+    try std.testing.expectEqual(@as(u64, 10), out[0][0]);
+    try std.testing.expectEqual(@as(u64, 20), out[3][0]); // expert 1's gate (the tie's lower id took expert 0 first)
+    try std.testing.expectEqual(@as(usize, 0), hotPick(&.{ 0, 0, 0 }, &ranges, 2, out[0..]));
+}
