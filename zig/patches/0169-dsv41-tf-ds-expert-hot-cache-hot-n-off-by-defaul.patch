 /// Model.moe of a decode window (shared_side off: SHARED_OVERLAP unset in the served lane): the gate's chunk sums
+/// 0179 (TF_DS_EXPERT_HOT_CACHE=hot): the hot set - the round's picked experts counted per layer on the device
+/// (hist, u32 [layers, stride], the track kernel's), its host copy (counts), and each layer's top-k picked experts'
+/// trellis ranges for the prefetch (ranges [layers, k*3], n [layers]). The plan rebuilds every 32 rounds from the
+/// histogram, read after the round's own sync. Counts only: invisible to every output.
+pub const Hot = struct {
+    stride: usize, // the histogram's experts a layer (the largest count; ids are bounds-checked against it)
+    layers: usize,
+    k: usize, // the plan's experts a layer (1..5: 3 ranges a piece, the prefetch's 16-entry cap)
+    hist: u64, // u32 [layers, stride] on the device
+    counts: []u32, // the same, host
+    ranges: [][2]u64, // [layers, k * 3]: gate, up, down of each chosen expert
+    n: []u8, // [layers] how many the plan holds
+};
+
+/// 0179: a layer's top `k` picked experts from its counts (ties to the lower id), their gate/up/down trellis ranges
+/// from the host copy (`ranges`: 3 * E, expert e's at [e], [E + e], [2E + e]) into `out`; returns how many.
+pub fn hotPick(counts: []const u32, ranges: []const [2]u64, k: usize, out: [][2]u64) usize {
+    const e_count = counts.len;
+    if (e_count == 0 or k == 0 or out.len < 3 * k) return 0;
+    var taken: [8]bool = @splat(false);
+    var n: usize = 0;
+    while (n < k) : (n += 1) {
+        var best: ?usize = null;
+        for (0..e_count) |i| {
+            if (taken[i]) continue;
+            if (best == null or counts[i] > counts[best.?]) best = i; // (ties to the lower id)
+        }
+        const i = best orelse break;
+        if (counts[i] == 0) break;
+        taken[i] = true;
+        out[n * 3 + 0] = ranges[i];
+        out[n * 3 + 1] = ranges[e_count + i];
+        out[n * 3 + 2] = ranges[2 * e_count + i];
+    }
+    return n;
+}
