+/// 0179 (TF_DS_EXPERT_HOT_CACHE): `hot:<n>` counts the round's picked experts per layer and prefetches the top
+/// <n>'s trellis beside the paced prefetch; `decoded...` is the decoded-weights cache whose kernel does not exist in
+/// the kit - it refuses with its named error (the contract is the patch's commit body). Unset, `0`, `off`: nothing.
+fn parseHot(v: ?[]const u8) !?u8 {
+    const s = std.mem.trim(u8, v orelse return null, " \t\r\n");
+    if (s.len == 0 or std.mem.eql(u8, s, "0") or std.mem.eql(u8, s, "off")) return null;
+    if (std.mem.startsWith(u8, s, "hot:")) {
+        const n = std.fmt.parseInt(u8, s["hot:".len..], 10) catch return error.BadExpertHot;
+        return if (n >= 1 and n <= 5) n else error.BadExpertHot;
+    }
+    if (std.mem.startsWith(u8, s, "decoded")) return error.KitKernelMissing;
+    return error.BadExpertHot;
+}
