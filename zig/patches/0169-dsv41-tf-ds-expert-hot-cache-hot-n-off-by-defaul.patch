+// 0179 (TF_DS_EXPERT_HOT_CACHE=hot): the round's picked experts counted per layer (hist [layers, experts] u32 on the
+// device), for the prefetch's hot set. Counts only: invisible to every output. The count comes from the decode
+// scratch (decode_prep's ids/count), so the launch rides after it on the same stream.
+struct TfDsHotTrack { const int* ids; const unsigned* count; unsigned* hist; int layer, experts; };
+extern "C" __global__ void tf_ds_hot_track_kernel(TfDsHotTrack a, int pdl) {
+    pdl_enter(pdl);
+    const int count = (int)*a.count;
+    for (int i = blockIdx.x * blockDim.x + threadIdx.x; i < count; i += gridDim.x * blockDim.x) {
+        const int id = a.ids[i];
+        if (id >= 0 && id < a.experts) atomicAdd(&a.hist[(size_t)a.layer * a.experts + id], 1u);
+    }
+}
