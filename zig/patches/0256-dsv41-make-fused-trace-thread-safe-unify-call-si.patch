+    // heads=12 at rows=32 is not a multiple of 8 warps: exact.ropeQd keeps the one-element form (.query_fused)
+    try expectEqual(.query_fused, queryArm(true, 32, 128, 64, 12));
+    try expectEqual(.query_pair, queryArm(true, 32, 128, 64, 16));
+    try expectEqual(.query_fused, queryArm(true, 31, 128, 64, 32));
+
+    // prompt pooled (allow_small=false) at m <= 7, nbk >= 6144 stays .idx_fused; decode (allow_small=true) takes .idx_small
+    try expectEqual(.idx_fused, idxArm(true, false, 7, 6144 * 8, 8, 6144, 2048));
+    try expectEqual(.idx_fused, idxArm(true, false, 1, 65533, 8, 8192, 2048));
+    try expectEqual(.idx_small, idxArm(true, true, 7, 6144 * 8, 8, 6144, 2048));
+    try expectEqual(.idx_small, idxArm(true, true, 1, 65533, 8, 8192, 2048));
+    try expectEqual(.idx_fused, idxArm(true, true, 7, 6143 * 8, 8, 6143, 2048));
+
+    // 0255 cand_fast8 alignment and bsize=8 gate
+    try expectEqual(.cand_fast8, candFastArm(true, 0x1000, 2048, 8));
+    try expectEqual(.cand_fast, candFastArm(false, 0x1000, 2048, 8));
+    try expectEqual(.cand_fast, candFastArm(true, 0x1008, 2048, 8));
+    try expectEqual(.cand_fast, candFastArm(true, 0x1000, 2050, 8));
+    try expectEqual(.cand_fast, candFastArm(true, 0x1000, 2048, 4));
+
+    // 0254 topk_indices_cut takes precedence over topk_indices_fast when TF_DS_IDX_FUSED is on
+    try expectEqual(.topk_indices_cut, topkIndicesArm(true, false));
+    try expectEqual(.topk_indices_cut, topkIndicesArm(true, true));
+    try expectEqual(.topk_indices_fast, topkIndicesArm(false, true));
+    try expectEqual(.topk_indices, topkIndicesArm(false, false));
+}
+
+test "capacity clamp stops at 128 distinct entries" {
+    reset();
+    for (0..capacity + 40) |i| {
+        note(.topk_indices_cut, i + 1, 4096, false);
+    }
+    const snap = entries();
+    try expectEqual(@as(usize, capacity), snap.len);
+    for (0..capacity) |i| {
+        try expectEqual(Entry{ .arm = .topk_indices_cut, .rows = i + 1, .width = 4096, .pdl = false }, snap[i]);
+    }
+    // existing entries still deduplicate and nothing pushes count past capacity
+    note(.topk_indices_cut, 1, 4096, false);
+    try expectEqual(@as(usize, capacity), entries().len);
+}
+
+test "concurrent note() and enabled() calls race safely across the count == 127 boundary" {
+    reset();
+    // Pre-fill 127 distinct entries so 8 threads race directly for the final slot (index 127).
+    for (0..capacity - 1) |i| {
+        note(.cand_fast8, i + 1, 1024, false);
+    }
+    try expectEqual(@as(usize, capacity - 1), entries().len);
+
+    const Worker = struct {
+        fn runAtBoundary(go: *const std.atomic.Value(bool), tid: usize) void {
+            while (!go.load(.acquire)) std.atomic.spinLoopHint();
+            _ = enabled();
+            for (0..16) |k| {
+                note(.cand_fast8, 1000 + tid * 32 + k, 1024, (k & 1) != 0);
+                note(.cand_fast8, 1, 1024, false); // duplicate of an existing entry
+            }
+        }
+
+        fn runFromZero(go: *const std.atomic.Value(bool), tid: usize) void {
+            while (!go.load(.acquire)) std.atomic.spinLoopHint();
+            for (0..48) |k| {
+                _ = enabled();
+                note(.idx_fused, (tid * 17 + k) % 160 + 1, 65536, (k & 1) != 0);
+            }
+        }
+    };
+
+    var go: std.atomic.Value(bool) = .init(false);
+    var threads: [8]std.Thread = undefined;
+    for (&threads, 0..) |*t, i| t.* = try std.Thread.spawn(.{}, Worker.runAtBoundary, .{ &go, i });
+    go.store(true, .release);
+    for (threads) |t| t.join();
+
+    const snap1 = entries();
+    try expectEqual(@as(usize, capacity), snap1.len);
+    try std.testing.expect(snap1[capacity - 1].rows >= 1000);
+
+    // Also race from zero across overlapping and excess distinct tuples: capacity holds and no duplicate slips in.
+    reset();
+    var go2: std.atomic.Value(bool) = .init(false);
+    for (&threads, 0..) |*t, i| t.* = try std.Thread.spawn(.{}, Worker.runFromZero, .{ &go2, i });
+    go2.store(true, .release);
+    for (threads) |t| t.join();
+
+    const snap2 = entries();
+    try expectEqual(@as(usize, capacity), snap2.len);
+    for (snap2, 0..) |a, i| {
+        for (snap2[i + 1 ..]) |b| {
+            try std.testing.expect(!std.meta.eql(a, b));
+        }
+    }
+    reset();
 }
