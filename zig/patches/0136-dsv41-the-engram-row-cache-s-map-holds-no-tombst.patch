# port-patches.sh: bench-prep @ 44b2cbb76857 over decode-step-structure @ 181ba7d569bb (commits daa21b2e74af..fdee78de9438)
# dsv41: the Engram row cache's map holds no tombstones (dense array map, swapRemove) - a full cache's misses stop probing the whole table
# Applied by zig/Dockerfile with git apply after the hand-written patches; regenerate with scripts/port-patches.sh, do not edit.
diff --git a/zig/src/families/dsv41/engram_io.zig b/zig/src/families/dsv41/engram_io.zig
index 0dfee42936a446fc4f25ac55a19998de0ece119c..3722c7409de5b34a11ae8b8f77cbfccb745c4e36 100644
--- a/zig/src/families/dsv41/engram_io.zig
+++ b/zig/src/families/dsv41/engram_io.zig
@@ -313,7 +313,8 @@ pub const RowCache = struct {
     io: std.Io,
     budget: u64,
     used: u64 = 0,
-    map: std.AutoHashMapUnmanaged(Key, *Node) = .empty,
+    // the dense array map: swapRemove leaves no tombstones, so a miss never probes a table full of them
+    map: std.AutoArrayHashMapUnmanaged(Key, *Node) = .empty,
     mru: ?*Node = null,
     lru: ?*Node = null,
     mutex: std.Io.Mutex = .init,
@@ -332,8 +333,7 @@ pub const RowCache = struct {
     }
 
     pub fn deinit(rc: *RowCache) void {
-        var it = rc.map.valueIterator();
-        while (it.next()) |np| rc.free(np.*);
+        for (rc.map.values()) |np| rc.free(np);
         rc.map.deinit(rc.gpa);
         rc.gpa.destroy(rc);
     }
@@ -373,7 +373,7 @@ pub const RowCache = struct {
         while (rc.used + bytes > rc.budget) {
             const v = rc.lru orelse break;
             rc.unlink(v);
-            _ = rc.map.remove(v.key);
+            _ = rc.map.swapRemove(v.key);
             rc.used -= v.w.len + v.s.len;
             rc.free(v);
         }
@@ -883,3 +883,42 @@ test "row cache: the LRU rows go at the byte budget" {
     try std.testing.expectEqual(@as(u64, 10), rc.used);
     // and the entries are freed with the cache (the test allocator checks)
 }
+
+test "row cache: churn past 20x capacity keeps never-used slots for the lookups" {
+    const a = std.testing.allocator;
+    const io = std.testing.io;
+    // 9 bytes a row (8 weight + 1 scale): a 576-byte budget pins the cache at 64 rows
+    const rows = 64;
+    const rc = try RowCache.init(a, io, rows * 9);
+    defer rc.deinit();
+    const w = [_]u8{ 1, 2, 3, 4, 5, 6, 7, 8 };
+    const s = [_]u8{9};
+    for (0..rows) |i| rc.put(1, @intCast(i), &w, &s);
+    try std.testing.expectEqual(@as(u64, rows * 9), rc.used);
+    // 20x the cache's capacity in put/evict cycles, each put a row that misses and evicts the LRU row, and
+    // interleaved lookups of keys that never exist (a miss walks the table's probe path)
+    for (0..20 * rows) |i| {
+        rc.put(1, @intCast(rows + i), &w, &s);
+        try std.testing.expect(!rc.has(1, -1 - @as(i64, @intCast(i))));
+    }
+    // structure, not wall-clock: the sparse map's remove hands its slot back as "available" (a tombstone), so it
+    // never rehashes at a steady count and its slots a miss can stop at drift to zero (measured 0 here): every miss
+    // then probes the whole table under the mutex. The dense array map keeps its slack (measured 11).
+    try std.testing.expect(probeEnds(rc) >= 4);
+}
+
+/// The slots a miss's probe can stop at: the sparse map's zeroed metadata bytes (a used slot has the top bit set, a
+/// tombstone is exactly 1, a free slot 0); the dense array map's slack past the entries. So a regression back to the
+/// sparse map fails this again rather than passing a capacity check. Test-only.
+fn probeEnds(rc: *const RowCache) usize {
+    const M = @TypeOf(rc.map);
+    if (@hasField(M, "metadata")) {
+        const m = rc.map.metadata orelse return rc.map.capacity();
+        var n: usize = 0;
+        for (m[0..rc.map.capacity()]) |md| {
+            if (@as(u8, @bitCast(md)) == 0) n += 1;
+        }
+        return n;
+    }
+    return rc.map.capacity() - rc.map.count();
+}
