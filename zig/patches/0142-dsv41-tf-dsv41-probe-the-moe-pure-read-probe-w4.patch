diff --git a/zig/kernels/cuda/probe.cu b/zig/kernels/cuda/probe.cu
index d3359e785756c1561a55d4ead08ecd7217b09348..f5ab9f96f8de8b9f77df2478f4f0d360204e918e 100644
--- a/zig/kernels/cuda/probe.cu
+++ b/zig/kernels/cuda/probe.cu
@@ -54,3 +54,123 @@ extern "C" __global__ void tf_probe_pdl_step(unsigned long long* counter, unsign
     *counter += add;
     asm volatile("griddepcontrol.launch_dependents;" ::: "memory");
 }
+
+// ---------------------------------------------------------------------------
+// The MoE pure-read probe (W4, 0144): read expert trellis bytes at scale and accumulate a checksum, one word per
+// block, to separate "bus-bound" from "trellis-decode-bound". Grid shaped like the decode launch (places x I/128
+// blocks, 4 warps); places is the number of ranges (13 picked experts), I/128 the column tiles (9 at I=1152).
+// Contract: every range is 16-byte aligned and its length a multiple of 16; at most 16 ranges per launch.
+// UNVERIFIED-BUILD: this file has never been through nvcc on the build host.
+
+struct ProbeRead {
+    const char* ptr[16];
+    unsigned long long bytes[16];
+    int n;
+};
+
+struct ProbePrefetch {
+    const char* ptr[16];
+    unsigned long long bytes[16];
+    int n;
+};
+
+// Block-uniform slice of range blockIdx.x: [start, end); equal ceiling slices, rounded to 16 bytes. A block whose
+// slice is empty reads nothing and reports a zero word.
+__device__ __forceinline__ void probe_slice(const ProbeRead& a, long long& start, long long& end) {
+    const long long len = (long long)a.bytes[blockIdx.x];
+    const long long per = (((len + gridDim.y - 1) / gridDim.y) + 15) & ~15LL;
+    start = per * blockIdx.y;
+    end = (start + per < len) ? (start + per) : len;
+}
+
+// 128 threads: per-warp shuffle reduce, then the first warp's lanes 0..3. Valid on every thread; only thread 0's
+// value is meaningful.
+__device__ __forceinline__ unsigned long long probe_block_sum(unsigned long long v, unsigned long long* shared) {
+    for (int off = 16; off > 0; off >>= 1) v += __shfl_down_sync(0xffffffffu, v, off);
+    const int lane = threadIdx.x & 31;
+    const int warp = threadIdx.x >> 5;
+    if (lane == 0) shared[warp] = v;
+    __syncthreads();
+    if (threadIdx.x == 0) return shared[0] + shared[1] + shared[2] + shared[3];
+    return 0;
+}
+
+// Streaming read of the given ranges with __ldcs (evict-first), one uint4 a load. Grid (places, tiles), block 128.
+extern "C" __global__ void __launch_bounds__(128) probe_read_ldg(ProbeRead a, unsigned long long* out) {
+    __shared__ unsigned long long shared[4];
+    long long start, end;
+    probe_slice(a, start, end);
+    unsigned long long acc = 0;
+    if (start < end) {
+        const uint4* p = reinterpret_cast<const uint4*>(a.ptr[blockIdx.x] + start);
+        const long long n = (end - start) >> 4;
+        for (long long i = threadIdx.x; i < n; i += blockDim.x) {
+            const uint4 w = __ldcs(p + i);
+            acc += (unsigned long long)w.x + (unsigned long long)w.y + (unsigned long long)w.z + (unsigned long long)w.w;
+        }
+    }
+    const unsigned long long total = probe_block_sum(acc, shared);
+    // Every block leaves exactly one word, even the empty-slice ones (total == 0 there).
+    if (threadIdx.x == 0) out[blockIdx.x * gridDim.y + blockIdx.y] = total;
+}
+
+// The same ranges through cp.async into a 3-stage shared ring, 4 warps (like grouped_cp_kernel's S=3 ring): each
+// stage holds 128 uint4 = one per thread. Batches of 128 x 16 B; one commit_group per batch, wait_group 1 keeps the
+// oldest group complete before its stage is read. Reads sm_80+ cp.async.cg.
+extern "C" __global__ void __launch_bounds__(128) probe_read_cpasync(ProbeRead a, unsigned long long* out) {
+    __shared__ uint4 ring[3][128];
+    __shared__ unsigned long long shared[4];
+    long long start, end;
+    probe_slice(a, start, end);
+    unsigned long long acc = 0;
+    if (start < end) {
+        const long long n = (end - start) >> 4;   // 16-byte units
+        const long long batches = (n + 127) >> 7; // 128 units a stage
+        const char* base = a.ptr[blockIdx.x] + start;
+        // Prologue: fill stages 0 and 1, committing an empty group when the batch does not exist.
+        for (long long b = 0; b < 2; ++b) {
+            if (b < batches) {
+                const long long v = b * 128 + threadIdx.x;
+                if (v < n) {
+                    const unsigned dst = (unsigned)__cvta_generic_to_shared(&ring[b][threadIdx.x]);
+                    asm volatile("cp.async.cg.shared.global [%0], [%1], 16;" :: "r"(dst), "l"(base + v * 16) : "memory");
+                }
+            }
+            asm volatile("cp.async.commit_group;" ::: "memory");
+        }
+        for (long long b = 0; b < batches; ++b) {
+            asm volatile("cp.async.wait_group 1;" ::: "memory");
+            __syncthreads();
+            const int s = (int)(b % 3);
+            const long long v = b * 128 + threadIdx.x;
+            if (v < n) {
+                const uint4 w = ring[s][threadIdx.x];
+                acc += (unsigned long long)w.x + (unsigned long long)w.y + (unsigned long long)w.z + (unsigned long long)w.w;
+            }
+            __syncthreads(); // every warp done with the stage before it is refilled
+            const long long nb = b + 2;
+            if (nb < batches) {
+                const long long nv = nb * 128 + threadIdx.x;
+                if (nv < n) {
+                    const unsigned dst = (unsigned)__cvta_generic_to_shared(&ring[nb % 3][threadIdx.x]);
+                    asm volatile("cp.async.cg.shared.global [%0], [%1], 16;" :: "r"(dst), "l"(base + nv * 16) : "memory");
+                }
+            }
+            asm volatile("cp.async.commit_group;" ::: "memory"); // one group a batch, empty past the end
+        }
+    }
+    const unsigned long long total = probe_block_sum(acc, shared);
+    if (threadIdx.x == 0) out[blockIdx.x * gridDim.y + blockIdx.y] = total;
+}
+
+// Every 128-byte line of each range brought into L2; writes nothing. A stand-alone prefetch stream for the
+// with-prefetch half of the report; grid-strided, plain prefetch.global.L2 (PTX 2.0, any sm_20+).
+extern "C" __global__ void probe_prefetch_l2(ProbePrefetch a) {
+    const long long stride = (long long)gridDim.x * blockDim.x;
+    const long long at = (long long)blockIdx.x * blockDim.x + threadIdx.x;
+    for (int t = 0; t < a.n; ++t) {
+        const long long lines = (long long)(a.bytes[t] >> 7);
+        for (long long i = at; i < lines; i += stride)
+            asm volatile("prefetch.global.L2 [%0];" :: "l"(a.ptr[t] + (i << 7)) : "memory");
+    }
+}
