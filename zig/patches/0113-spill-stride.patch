--- a/zig/src/core/engine_api.zig
+++ b/zig/src/core/engine_api.zig
@@ -202,6 +202,8 @@ pub const Spill = struct {
     min_tokens: u32 = 8192,
     /// TF_SPILL_TURNS: old turns kept on a conversation's active path before they go first (0: until room is needed).
     turns: u32 = 4,
+    /// TF_SPILL_STRIDE: every Nth old turn manifest past that window stays as a rewind/branch resume point (0: none).
+    stride: u32 = 0,
     /// TF_SPILL_LOAD_MS: one service's budget for every restore together, then staged writes (at least 1).
     load_ms: u32 = 40,
     /// TF_SPILL_LOAD_WAIT_MS: how long a request waits parked on a restore, or at the queue's front for the pool's room
diff --git a/zig/src/core/spill/store.zig b/zig/src/core/spill/store.zig
index d6d9887a..26c8919f 100644
--- a/zig/src/core/spill/store.zig
+++ b/zig/src/core/spill/store.zig
@@ -43,6 +43,9 @@ pub const Slot = slots_mod.Slot;
 pub const Staging = slots_mod.Staging;
 pub const Hooks = fsio.Hooks;
 
+/// TF_SPILL_STRIDE's extra manifests kept per path past the retention window: keeps the point index bounded.
+pub const stride_kept_max: u32 = 64;
+
 /// The logical rows a write reads from: the family's extent and its generation. A later occupant of the same base
 /// has another generation, so a delayed staging can never attach to it.
 pub const Source = struct {
@@ -74,6 +77,9 @@ pub const Config = struct {
     quota: f64 = 0,
     /// Newest states kept on a conversation's active path (0: every turn until room is needed).
     turns: u32 = 4,
+    /// With `turns` on: every `stride`th turn past the window stays as a rewind/branch resume point, at most
+    /// `stride_kept_max` of them (0: the trim deletes every turn past the window).
+    stride: u32 = 0,
     /// Shorter states are not written.
     min_tokens: u32 = 8192,
     /// Bytes of unpublished writes (rows still in device memory, queued staging) past which a keep is refused.
@@ -253,6 +259,7 @@ const Inode = struct { bytes: u64, names: std.ArrayList(Digest) = .empty };
 const Point = struct {
     key: Digest,
     at: u32,
+    depth: u32 = 0, // turns from the branch's root at publish; trimPath's stride slot (in memory: the manifest has no turn count)
     shared: bool,
     group: u64,
     used: i96,
@@ -691,7 +698,13 @@ pub const Store = struct {
                 return a.at < b.at;
             }
         }.shorter);
-        for (order.items) |p| try s.parent.put(gpa, p.key, s.parentOf(p));
+        for (order.items) |p| {
+            const up = s.parentOf(p);
+            try s.parent.put(gpa, p.key, up);
+            // every manifest that survived the last run takes one stride (the root anchored at 1, so every depth
+            // stays 1 mod stride and trimPath keeps them eligible): the turns its trims deleted are gone
+            p.depth = if (up) |uk| s.points.get(uk).?.depth + @max(s.cfg.stride, 1) else 1;
+        }
         s.clock = 0;
         for (order.items) |p| s.clock = @max(s.clock, p.used);
     }
@@ -920,7 +933,9 @@ pub const Store = struct {
 
     /// `p` just entered the index: its parent, and the points it now stands between.
     fn adopt(s: *Store, p: *Point) void {
-        s.parent.put(s.gpa, p.key, s.parentOf(p)) catch {};
+        const up = s.parentOf(p);
+        s.parent.put(s.gpa, p.key, up) catch {};
+        p.depth = (if (up) |uk| s.points.get(uk).?.depth else 0) + 1;
         var it = s.points.valueIterator();
         while (it.next()) |qq| {
             const q = qq.*;
@@ -1165,7 +1180,9 @@ pub const Store = struct {
     }
 
     /// After `p` is published: on its conversation's path (its ancestors below a shared point) the newest `turns`
-    /// stay, older ones go now (they free their small files only: `p` names every block they named).
+    /// stay, older ones go now (they free their small files only: `p` names every block they named). With `stride`
+    /// on, every `stride`th turn past the window (from the branch's root) stays too, `stride_kept_max` of them:
+    /// resume points for rewinds and branches past the window.
     fn trimPath(s: *Store, p: *Point) void {
         if (s.cfg.turns == 0 or p.shared) return;
         var path: std.ArrayList(Digest) = .empty;
@@ -1178,7 +1195,15 @@ pub const Store = struct {
             cur = s.parent.get(k) orelse null;
         }
         if (path.items.len <= s.cfg.turns) return;
+        var kept: u32 = 0;
         for (path.items[s.cfg.turns..]) |k| {
+            if (s.cfg.stride != 0 and kept < stride_kept_max) {
+                const q = s.points.get(k).?;
+                if ((q.depth - 1) % s.cfg.stride == 0) {
+                    kept += 1;
+                    continue;
+                }
+            }
             if (!s.reading.contains(k)) s.remove(k, "trimmed_turns");
         }
     }
