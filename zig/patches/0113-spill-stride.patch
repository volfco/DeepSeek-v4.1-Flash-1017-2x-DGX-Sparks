             var prng = std.Random.DefaultPrng.init(id *% 0x9e3779b97f4a7c15 +% 1);
             prng.random().bytes(r);
             gop.value_ptr.* = r;
@@ -1207,6 +1209,70 @@ fn checkTurns(gpa: Allocator) !void {
     try ensure(std.mem.eql(u8, got, h.src(11)[0 .. 3 * block_tokens * bpt]), @src());
 }
 
+/// TF_SPILL_STRIDE: every Nth turn past the window stays (turns t, t-N, t-2N... of the path; t=13 is on the
+/// stride for both N here) as a resume point, and the trimmed ones' blocks stay named by the newer points.
+fn checkStride(gpa: Allocator) !void {
+    for ([_]usize{ 2, 3 }) |n| {
+        const h = try H.init(gpa, .{ .tag = "stride", .turns = 4, .stride = @intCast(n) });
+        defer h.deinit();
+        const all = try idsOf(gpa, 13 * block_tokens, 1600);
+        defer gpa.free(all);
+        var keys: [13]Digest = undefined;
+        for (1..14) |t| keys[t - 1] = try write(h, all[0 .. t * block_tokens], .{ .lineage = lin(16), .source = 16 });
+        var trimmed: u64 = 0;
+        for (1..14) |t| {
+            const want = t >= 10 or (t - 1) % n == 0;
+            if (!want) trimmed += 1;
+            try ensure(h.s.points.contains(keys[t - 1]) == want, @src());
+        }
+        const ct = h.s.counts();
+        try ensure(ct.trimmed_turns == trimmed and ct.blocks == 13 and ct.staged_blocks == 13, @src());
+    }
+}
+
+/// TF_SPILL_STRIDE unset/0: the trim keeps exactly the newest `turns`, as before.
+fn checkStrideOff(gpa: Allocator) !void {
+    const h = try H.init(gpa, .{ .tag = "strideoff", .turns = 4 });
+    defer h.deinit();
+    const all = try idsOf(gpa, 13 * block_tokens, 1601);
+    defer gpa.free(all);
+    var keys: [13]Digest = undefined;
+    for (1..14) |t| keys[t - 1] = try write(h, all[0 .. t * block_tokens], .{ .lineage = lin(17), .source = 17 });
+    for (1..14) |t| try ensure(h.s.points.contains(keys[t - 1]) == (t >= 10), @src());
+    const ct = h.s.counts();
+    try ensure(ct.trimmed_turns == 9 and ct.blocks == 13 and ct.staged_blocks == 13, @src());
+}
+
+/// The stride's extras per path are bounded: `stride_kept_max` past the window, the oldest ones gone.
+fn checkStrideCap(gpa: Allocator) !void {
+    const h = try H.init(gpa, .{ .tag = "stridecap", .turns = 4, .stride = 1, .max_tokens = 2048 });
+    defer h.deinit();
+    const all = try idsOf(gpa, 71 * block_tokens, 1602);
+    defer gpa.free(all);
+    var keys: [71]Digest = undefined;
+    for (1..72) |t| keys[t - 1] = try write(h, all[0 .. t * block_tokens], .{ .lineage = lin(18), .source = 18 });
+    const kept: u32 = 4 + store.stride_kept_max;
+    const first: usize = 72 - kept;
+    try ensure(h.s.points.count() == kept, @src());
+    for (1..72) |t| try ensure(h.s.points.contains(keys[t - 1]) == (t >= first), @src());
+}
+
+/// TF_SPILL_STRIDE across a restart: the reopen anchors the surviving path's depth grid at 1 (every survivor one
+/// stride later), so the next publish's trim still finds the extras on the stride and keeps them.
+fn checkStrideRestart(gpa: Allocator) !void {
+    const h = try H.init(gpa, .{ .tag = "stridere", .turns = 4, .stride = 2 });
+    defer h.deinit();
+    const all = try idsOf(gpa, 14 * block_tokens, 1603);
+    defer gpa.free(all);
+    var keys: [14]Digest = undefined;
+    for (1..14) |t| keys[t - 1] = try write(h, all[0 .. t * block_tokens], .{ .lineage = lin(19), .source = 19 });
+    const extras = [_]usize{ 1, 3, 5, 7, 9 }; // t-N, t-2N... past the window, on the stride
+    for (extras) |t| try ensure(h.s.points.contains(keys[t - 1]), @src());
+    try h.reopen();
+    keys[13] = try write(h, all, .{ .lineage = lin(19), .source = 19 }); // one more turn: the trim runs again
+    for (extras) |t| try ensure(h.s.points.contains(keys[t - 1]), @src());
+}
+
 /// A resume forks the lineage at its cut: the same names before it (nothing restaged), its own after.
 fn checkFork(gpa: Allocator) !void {
     const h = try H.init(gpa, .{ .tag = "fork" });
@@ -1723,6 +1789,10 @@ const checks = [_]Check{
     .{ .name = "guard cancel", .f = checkGuardCancel },
     .{ .name = "eviction order", .f = checkEvictionOrder },
     .{ .name = "turns", .f = checkTurns },
+    .{ .name = "stride", .f = checkStride },
+    .{ .name = "stride off", .f = checkStrideOff },
+    .{ .name = "stride cap", .f = checkStrideCap },
+    .{ .name = "stride restart", .f = checkStrideRestart },
     .{ .name = "fork", .f = checkFork },
     .{ .name = "groups", .f = checkGroups },
     .{ .name = "quota", .f = checkQuota },
