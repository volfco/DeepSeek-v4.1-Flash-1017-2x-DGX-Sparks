+/// TF_DS_SPILL_SHARED_MIN_TOKENS: a shared cut is written below `min_tokens` down to its own floor; a conversation's
+/// own state still needs `min_tokens`, and the floor never rises above it.
+fn checkKeepFloor(gpa: Allocator) !void {
+    try ensure(store.keepFloor(8192, 0, true) == 8192, @src()); // off: the gate alone
+    try ensure(store.keepFloor(8192, 2048, false) == 8192, @src());
+    try ensure(store.keepFloor(8192, 2048, true) == 2048, @src());
+    try ensure(store.keepFloor(2048, 8192, true) == 2048, @src());
+    const h = try H.init(gpa, .{ .tag = "sharedmin" });
+    defer h.deinit();
+    h.cfg.min_tokens = 2 * block_tokens;
+    h.cfg.shared_min_tokens = block_tokens;
+    try h.reopen();
+    const tiny = try idsOf(gpa, block_tokens / 2, 2300); // under even the shared floor
+    defer gpa.free(tiny);
+    try ensure(keepIds(h, tiny, .{ .lineage = lin(1), .source = 1, .shared = true }) == .short, @src());
+    const floor = try idsOf(gpa, block_tokens, 2301);
+    defer gpa.free(floor);
+    try ensure(keepIds(h, floor, .{ .lineage = lin(2), .source = 2 }) == .short, @src()); // its own state: min_tokens
+    const key = try write(h, floor, .{ .lineage = lin(3), .source = 3, .shared = true });
+    try ensure(h.s.presence(key), @src());
+    const big = try idsOf(gpa, 2 * block_tokens, 2302);
+    defer gpa.free(big);
+    _ = try write(h, big, .{ .lineage = lin(4), .source = 4 });
+}
