+test "a planned live mark reserves its contextual bytes before the peer starts its pass" {
+    const Bytes = struct {
+        fn durable(_: *anyopaque, _: u32) u64 { return 10; }
+        fn live(_: *anyopaque, _: u32, _: usize) u64 { return 60; }
+    };
+    const gpa = std.testing.allocator;
+    var f: Fake = .{ .gpa = gpa };
+    var vt = f.snapshots().vtable.*;
+    vt.bytes = Bytes.durable;
+    vt.keep_bytes = Bytes.live;
+    const a = [_]u32{ 1, 2, 3, 4, 5, 6, 7, 8 };
+    const other = [_]u32{ 9, 9, 9, 9, 9, 9, 9, 9 };
+    for ([_]u64{ 50, 100 }) |budget| {
+        var s = Store.init(gpa, .{ .ptr = &f, .vtable = &vt }, .{ .min_prompt = 0, .min_gap = 0 }, budget);
+        defer s.deinit();
+        if (budget == 100) {
+            f.at = 4;
+            try std.testing.expect(s.keep(&other, 4, null, &.{}));
+            try std.testing.expectEqual(60, s.held);
+        }
+        const look = try s.lookup(gpa, &a, 4, &.{}, &.{});
+        defer gpa.free(look.marks);
+        try std.testing.expectEqual(@as(usize, if (budget == 50) 0 else 1), look.marks.len);
+        try std.testing.expectEqual(0, s.held);
+        try std.testing.expectEqual(@as(u64, if (budget == 50) 0 else 1), s.counts.evicted);
+    }
+}
