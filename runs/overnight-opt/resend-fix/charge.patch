+test "paired full-end charging fits 78 grid and two full states without evicting one" {
+    const Bytes = struct {
+        fn ordinary(_: *anyopaque, _: u32) u64 { return 6684672; }
+        fn uniform(_: *anyopaque, _: u32) u64 { return 7644160; }
+        fn live(_: *anyopaque, at: u32, len: usize) u64 { return if (at == len) 7644160 else 6684672; }
+    };
+    const gpa = std.testing.allocator;
+    for ([_]bool{ false, true }) |accurate| {
+        var f: Fake = .{ .gpa = gpa };
+        var vt = f.snapshots().vtable.*;
+        vt.bytes = if (accurate) Bytes.ordinary else Bytes.uniform;
+        vt.keep_bytes = if (accurate) Bytes.live else null;
+        var s = Store.init(gpa, .{ .ptr = &f, .vtable = &vt }, .{ .grid = 4, .window = 2, .endstate = true, .end_limit = 2 }, 512 * 1024 * 1024);
+        defer s.deinit();
+        for (0..80) |i| {
+            const input = [_]u32{ @intCast(i + 1), 2, 3, 4, 5, 6 };
+            f.at = if (i >= 78) input.len else 4;
+            try std.testing.expect(s.keep(&input, f.at, null, &.{}));
+            try std.testing.expect(s.held + s.restoring_bytes <= s.budget);
+        }
+        try std.testing.expectEqual(@as(usize, if (accurate) 80 else 70), s.entries.items.len);
+        try std.testing.expectEqual(@as(u64, if (accurate) 78 * 6684672 + 2 * 7644160 else 70 * 7644160), s.held);
+        try std.testing.expectEqual(@as(u64, if (accurate) 0 else 10), s.counts.evicted);
+    }
+}
