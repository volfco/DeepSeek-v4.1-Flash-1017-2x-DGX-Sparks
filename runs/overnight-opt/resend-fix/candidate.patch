+/// The follower records the payload at save time. Spill-restored buffers contain only the base state.
+const FollowSnapshot = struct {
+    buf: cuda.DeviceBuffer,
+    tail: ?[2]usize = null,
+    end_offset: ?usize = null,
+
+    fn layout(base: usize, tail_bytes: usize, end_bytes: usize, full_end: bool) struct { bytes: usize, end: ?usize } {
+        return if (full_end) .{ .bytes = base + end_bytes, .end = base } else .{ .bytes = base + tail_bytes, .end = null };
+    }
+};
