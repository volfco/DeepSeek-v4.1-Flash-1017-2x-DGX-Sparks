+test "identical prompt follower snapshots restore their own end bytes and no spill or grid padding" {
+    const t = std.testing;
+    const ordinary = FollowSnapshot.layout(16, 0, 8, false);
+    const exact_tail = FollowSnapshot.layout(16, 5, 8, false);
+    const end = FollowSnapshot.layout(16, 5, 8, true);
+    try t.expectEqual(@as(usize, 16), ordinary.bytes);
+    try t.expectEqual(@as(?usize, null), ordinary.end);
+    try t.expectEqual(@as(usize, 21), exact_tail.bytes);
+    try t.expectEqual(@as(?usize, null), exact_tail.end);
+    try t.expectEqual(@as(usize, 24), end.bytes);
+    var image: [32]u8 = @splat(0xec);
+    const expected = [_]u8{ 0xd0, 0xd1, 0xd2, 0xd3, 11, 22, 33, 44 };
+    image[end.end.?..][0..8].* = expected;
+    try t.expectEqualSlices(u8, &expected, image[end.bytes - expected.len ..][0..8]);
+    try t.expectEqual(@as(u8, 0xec), image[end.bytes]);
+    const from_spill: FollowSnapshot = .{ .buf = undefined };
+    try t.expect(from_spill.tail == null and from_spill.end_offset == null);
+}
