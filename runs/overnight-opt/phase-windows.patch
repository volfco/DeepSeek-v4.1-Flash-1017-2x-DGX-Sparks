+//! Benchmark-only phase ranges, in CLOCK_MONOTONIC nanoseconds. One bounded buffer per host thread.
+const std = @import("std");
+const Record = extern struct { start: u64, end: u64, kind: u32, phase: u32 };
+threadlocal var fd: c_int = -2;
+threadlocal var used: usize = 0;
+threadlocal var buffer: [512]Record = undefined;
+pub fn enabled() bool {
+    if (fd == -2) {
+        fd = -1;
+        const value = std.c.getenv("TF_DS_PHASE_WINDOWS") orelse return false;
+        if (std.mem.eql(u8, std.mem.span(value), "1")) fd = std.c.open("/tmp/dsv41-phase-windows.bin", .{ .ACCMODE = .WRONLY, .CREAT = true, .APPEND = true, .NOFOLLOW = true, .CLOEXEC = true }, @as(c_uint, 0o600));
+    }
+    return fd >= 0;
+}
+pub fn clock() u64 {
+    var ts: std.c.timespec = undefined;
+    _ = std.c.clock_gettime(.MONOTONIC, &ts);
+    return @as(u64, @intCast(ts.sec)) * std.time.ns_per_s + @as(u64, @intCast(ts.nsec));
+}
+pub fn flush() void {
+    if (used == 0) return;
+    const bytes = std.mem.sliceAsBytes(buffer[0..used]);
+    var at: usize = 0;
+    while (at < bytes.len) {
+        const n = std.c.write(fd, bytes.ptr + at, bytes.len - at);
+        if (n <= 0) @panic("phase trace write failed");
+        at += @intCast(n);
+    }
+    used = 0;
+}
+pub fn record(kind: u32, phase: u32, start: u64, end: u64) void {
+    if (!enabled() or end < start) return;
+    if (used == buffer.len) flush();
+    buffer[used] = .{ .kind = kind, .phase = phase, .start = start, .end = end };
+    used += 1;
+}
