+    /// Start the conservative head deadline when the request is sent. A late reply earns no extension.
+    pub fn fromReply(grant: LeaseGrant, request_nonce: u64, sent_ns: i96, received_ns: i96) ?LeaseView {
+        const early = sent_ns + @divTrunc(@as(i96, grant.ttl_ms) * std.time.ns_per_ms, 2);
+        if (request_nonce == 0 or request_nonce != grant.request_nonce or received_ns < sent_ns or received_ns >= early) return null;
+        return .{ .grant = grant, .until_ns = early };
+    }
+
+    pub fn permits(view: LeaseView, live: ?[16]u8, point: LeasePoint, now_ns: i96) bool {
+        const incarnation = live orelse return false;
+        return now_ns < view.until_ns and std.mem.eql(u8, &incarnation, &view.grant.incarnation) and
+            std.meta.eql(view.grant.point, point);
+    }
+};
