+    /// Called under the store lock by the three ordinary eviction paths. An integrity forget remains authoritative.
+    fn leaseProtects(s: *Store, key: Digest, turn: bool) bool {
+        const lease = if (s.bench_lease) |*v| v else return false;
+        if (!std.mem.eql(u8, &lease.grant.point.key, &key)) return false;
+        if (std.Io.Clock.awake.now(s.io).toNanoseconds() >= lease.until_ns) return false;
+        if (turn) lease.deferred_turn = true;
+        return true;
+    }
