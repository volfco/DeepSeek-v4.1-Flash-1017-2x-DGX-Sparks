diff --git a/zig/kernels/cuda/dsv41_torch.cu b/zig/kernels/cuda/dsv41_torch.cu
index 304439a..5870651 100644
--- a/zig/kernels/cuda/dsv41_torch.cu
+++ b/zig/kernels/cuda/dsv41_torch.cu
@@ -259,3 +259,221 @@ extern "C" __global__ void tf_ds_hc_mean4_kernel(const __nv_bfloat16* h, __nv_bf
         out[r * os + d] = __float2bfloat16_rn(__fmul_rn(s, 0.25f));
     }
 }
+
+// ===================================================================================================================
+// TF_DS_FUSED_COMPRESS2_NORM (0197, off by default).
+//
+// The fused kernels replicate the arithmetic of the launches they replace, op for op, reduction order included:
+//   - the prompt kernel replicates tf_ds_compress2_kernel / tf_ds_rms_norm_kernel above (bit-checked against
+//     torch on GB10),
+//   - the decode kernel replicates tf_ds_compress2x_kernel above plus the kit's `_rmsnorm` (kernels.py,
+//     bertholomus/TensorFold branch deepseek-v41-tp2); tl.sum's order is reconstructed as per-thread sequential
+//     over EPT contiguous elements, a butterfly xor 16..1 across the warp, then a 4-lane butterfly xor 2, xor 1
+//     over the four warp partials (the reduction-order risk; see the report).
+// UNVERIFIED-BUILD on this machine (no nvcc): gated on the exact suite on a Spark, like the rest of the series. The
+// harness in p0197 emulates these kernels and the launches they replace and checks them bitwise on >=1000 fuzz rows.
+// ===================================================================================================================
+
+// -- shared device helpers -------------------------------------------------------------------------------------------
+
+// The kit's `_rmsnorm` (kernels.py, deepseek-v41-tp2): x bf16 -> f32, rinv = 1 / sqrt(sum(x*x) / D + eps),
+// out = bf16(w * (x * rinv)). BLOCK = pow2(D) <= 2048, num_warps = 4 (128 threads, D <= 2048). tl.sum's order is
+// reconstructed as: thread t owns elements [t*EPT, (t+1)*EPT) (EPT = BLOCK / 128) and accumulates them in order,
+// then a butterfly xor 16..1 across the warp, then the four warp partials folded by a 4-lane butterfly (xor 2, xor 1).
+// `src`/`dst` may be global or shared bf16. The caller's blockDim.x must be >= 128 (the callers use exactly 128).
+__device__ __forceinline__ void tf_ds_triton_rmsnorm_row(const __nv_bfloat16* src, const __nv_bfloat16* w,
+                                                         __nv_bfloat16* dst, int D, float eps) {
+    const int tid = threadIdx.x;
+    const int ept = D >> 7;   // BLOCK / 128 (D pow2, >= 128)
+    float acc = 0.f;
+    if (tid < 128) {
+        const int base = tid * ept;
+        for (int i = 0; i < ept; i++) {
+            const float x = __bfloat162float(src[base + i]);
+            acc = __fadd_rn(acc, __fmul_rn(x, x));
+        }
+    }
+    #pragma unroll
+    for (int off = 16; off > 0; off >>= 1) acc = __fadd_rn(acc, __shfl_xor_sync(0xffffffffu, acc, off));
+    __shared__ float partial[4];
+    __shared__ float rinv_s;
+    if (tid < 128 && (tid & 31) == 0) partial[tid >> 5] = acc;
+    __syncthreads();
+    if (tid < 4) {
+        float v = partial[tid];
+        v = __fadd_rn(v, __shfl_xor_sync(0xfu, v, 2));
+        v = __fadd_rn(v, __shfl_xor_sync(0xfu, v, 1));
+        if (tid == 0) rinv_s = __fdiv_rn(1.0f, sqrtf(__fadd_rn(__fdiv_rn(v, (float)D), eps)));
+    }
+    __syncthreads();
+    const float rinv = rinv_s;
+    for (int i = tid; i < D; i += blockDim.x) {
+        const float x = __bfloat162float(src[i]);
+        dst[i] = __float2bfloat16_rn(__fmul_rn(__bfloat162float(w[i]), __fmul_rn(x, rinv)));
+    }
+}
+
+// tf_ds_rms_norm_kernel's arithmetic on one row held in `src` (bf16), L = blockDim.x lanes (the caller passes the
+// same lane count the unfused launch would use: rmsLanes(D, rows), 32/64/128), one row per block (h == 1).
+__device__ __forceinline__ void tf_ds_torch_rmsnorm_row(const __nv_bfloat16* src, const __nv_bfloat16* w,
+                                                        __nv_bfloat16* dst, int D, float factor, float eps) {
+    __shared__ float red[128];
+    __shared__ float rs;
+    const int L = blockDim.x;
+    const int lane = threadIdx.x;
+    float acc0 = 0.f, acc1 = 0.f, acc2 = 0.f, acc3 = 0.f;
+    for (int idx = lane; idx * 4 + 3 < D; idx += L) {
+        const float a = __bfloat162float(src[idx * 4 + 0]);
+        const float b = __bfloat162float(src[idx * 4 + 1]);
+        const float c = __bfloat162float(src[idx * 4 + 2]);
+        const float d = __bfloat162float(src[idx * 4 + 3]);
+        acc0 = __fadd_rn(acc0, __fmul_rn(a, a));
+        acc1 = __fadd_rn(acc1, __fmul_rn(b, b));
+        acc2 = __fadd_rn(acc2, __fmul_rn(c, c));
+        acc3 = __fadd_rn(acc3, __fmul_rn(d, d));
+    }
+    float v = __fadd_rn(__fadd_rn(__fadd_rn(acc0, acc1), acc2), acc3);
+    int dim_x = L;
+    if (L > 32) {
+        red[lane] = v;
+        for (int offset = L / 2; offset >= 32; offset >>= 1) {
+            __syncthreads();
+            if (lane < offset && lane + offset < L) {
+                v = __fadd_rn(v, red[lane + offset]);
+                red[lane] = v;
+            }
+        }
+        dim_x = 32;
+    }
+    __syncthreads();
+    for (int offset = dim_x >> 1; offset > 0; offset >>= 1) v = __fadd_rn(v, __shfl_down_sync(TF_FULL_MASK, v, offset));
+    if (lane == 0) rs = rsqrtf(__fadd_rn(__fmul_rn(v, factor), eps));
+    __syncthreads();
+    const float r = rs;
+    for (int j = lane; j < D; j += L) {
+        const float y = __fmul_rn(__bfloat162float(src[j]), r);
+        dst[j] = __float2bfloat16_rn(__fmul_rn(__bfloat162float(w[j]), y));
+    }
+}
+
+// The pair-sum arithmetic of tf_ds_compress2_kernel / tf_ds_compress2x_kernel, verbatim (kv/score addressed by the
+// caller): the pair's softmax (max, the two expf, the sum from 0), the products, the pair's sum as compress2 adds it.
+__device__ __forceinline__ float tf_ds_compress2_pair(float s0, float s1, float kv0, float kv1) {
+    float m = -3.402823466e+38f;   // numeric_limits<float>::lowest()
+    m = m < s0 ? s0 : m;
+    m = m < s1 ? s1 : m;
+    float sum = 0.f;
+    sum = __fadd_rn(sum, expf(__fsub_rn(s0, m)));
+    sum = __fadd_rn(sum, expf(__fsub_rn(s1, m)));
+    const float p0 = __fdiv_rn(expf(__fsub_rn(s0, m)), sum);
+    const float p1 = __fdiv_rn(expf(__fsub_rn(s1, m)), sum);
+    const float y0 = __fmul_rn(kv0, p0);
+    const float y1 = __fmul_rn(kv1, p1);
+    float t = __fadd_rn(__fadd_rn(0.f, y0), __fadd_rn(0.f, y1));
+    t = __fadd_rn(t, 0.f);
+    t = __fadd_rn(t, 0.f);
+    return t;
+}
+
+// -- TF_DS_FUSED_COMPRESS2_NORM (0197) -------------------------------------------------------------------------------
+
+// The prompt path's ratio-2 chain: tf_ds_compress2_kernel (grid-stride over G*C, here one block per group, the pair
+// sums staged through shared memory as bf16 exactly as the unfused launch round-trips them through global memory)
+// followed by tf_ds_rms_norm_kernel's arithmetic (torch's reduce order, the block's lane count passed as blockDim.x,
+// the same `factor` the unfused launch computes). One block per group g, grid.x = G. `factor` is rows/(rows*D) as
+// float, computed by the caller exactly as Exact.rmsNorm does.
+extern "C" __global__ void tf_ds_compress2_norm_kernel(const float* kv, const float* score,
+                                                       const __nv_bfloat16* w, __nv_bfloat16* out,
+                                                       long long ldo, int G, int D, float factor, float eps, int pdl) {
+    pdl_enter(pdl);
+    const int g = blockIdx.x;
+    __shared__ __nv_bfloat16 srow[2048];   // D <= 2048
+    for (int c = threadIdx.x; c < D; c += blockDim.x) {
+        const float s0 = score[((long long)g * 2) * D + c];
+        const float s1 = score[((long long)g * 2 + 1) * D + c];
+        srow[c] = __float2bfloat16_rn(tf_ds_compress2_pair(s0, s1, kv[((long long)g * 2) * D + c], kv[((long long)g * 2 + 1) * D + c]));
+    }
+    __syncthreads();
+    tf_ds_torch_rmsnorm_row(srow, w, out + (long long)g * ldo, D, factor, eps);
+}
+
+// The decode path's ratio-2 chain (round.zig's compressorChain): tf_ds_compress2x_kernel's scatter/resolve/pair-sum
+// (verbatim, including the partner resolution and the out-of-range `invalid` flag) with the pair sums staged through
+// shared memory as bf16, then the kit's `_rmsnorm` (tf_ds_triton_rmsnorm_row). The compress2x out (rd.lat2) is not
+// written: nothing reads it once the norm is fused (the unfused path's reader was the rmsnorm). grid.x = G,
+// block = 128 (the _rmsnorm num_warps=4 layout; D pow2 in [128, 2048]).
+extern "C" __global__ void __launch_bounds__(128) tf_ds_compress2x_norm_kernel(const float* ckv, long long ckv_ld,
+                                                                               const float* cgate, long long cgate_ld,
+                                                                               const long long* rslot,
+                                                                               float* ring_kv,
+                                                                               float* ring_score,
+                                                                               const long long* gi, long long src_rows,
+                                                                               const __nv_bfloat16* w,
+                                                                               __nv_bfloat16* out, long long ldo,
+                                                                               int G, int D, float eps,
+                                                                               unsigned* invalid, int pdl) {
+    pdl_enter(pdl);
+    const int g = blockIdx.x;
+    __shared__ __nv_bfloat16 srow[2048];   // D <= 2048
+    // phase 1: scatter this round's rows to the raw slots (byte copies, like scatterRows) — compress2x verbatim
+    {
+        const long long dst = rslot[g] * (long long)D;
+        const float* s = ckv + (long long)g * ckv_ld;
+        float* d = ring_kv + dst;
+        if (((D & 3) == 0) && ((((uintptr_t)s | (uintptr_t)d) & 15) == 0)) {
+            const uint4* s4 = (const uint4*)s;
+            uint4* d4 = (uint4*)d;
+            for (int j = threadIdx.x; j < D / 4; j += blockDim.x) d4[j] = s4[j];
+        } else {
+            for (int j = threadIdx.x; j < D; j += blockDim.x) d[j] = s[j];
+        }
+        const float* sg = cgate + (long long)g * cgate_ld;
+        float* dg = ring_score + dst;
+        if (((D & 3) == 0) && ((((uintptr_t)sg | (uintptr_t)dg) & 15) == 0)) {
+            const uint4* s4 = (const uint4*)sg;
+            uint4* d4 = (uint4*)dg;
+            for (int j = threadIdx.x; j < D / 4; j += blockDim.x) d4[j] = s4[j];
+        } else {
+            for (int j = threadIdx.x; j < D; j += blockDim.x) dg[j] = sg[j];
+        }
+    }
+    // phase 2: resolve both partners against this round's rows (thread 0; block-uniform) — compress2x verbatim
+    __shared__ int partner_row[2];
+    if (threadIdx.x == 0) {
+        for (int i = 0; i < 2; i++) {
+            const long long want = gi[2 * g + i];
+            int found = -1;
+            for (int r = 0; r < G; r++) {
+                if (rslot[r] == want) { found = r; break; }
+            }
+            partner_row[i] = found;
+        }
+    }
+    __syncthreads();
+    const long long gi0 = gi[2 * g], gi1 = gi[2 * g + 1];
+    const bool ok0 = gi0 >= 0 && gi0 < src_rows;
+    const bool ok1 = gi1 >= 0 && gi1 < src_rows;
+    if (!(ok0 && ok1)) {
+        if (threadIdx.x == 0 && invalid) *invalid = 1u;
+    }
+    for (int c = threadIdx.x; c < D; c += blockDim.x) {
+        float kv[2], score[2];
+        for (int i = 0; i < 2; i++) {
+            const long long q = i == 0 ? gi0 : gi1;
+            const bool ok = i == 0 ? ok0 : ok1;
+            if (!ok) { kv[i] = 0.f; score[i] = 0.f; continue; }
+            const int pr = partner_row[i];
+            if (pr >= 0) {
+                kv[i] = ckv[(long long)pr * ckv_ld + c];
+                score[i] = cgate[(long long)pr * cgate_ld + c];
+            } else {
+                kv[i] = ring_kv[q * (long long)D + c];
+                score[i] = ring_score[q * (long long)D + c];
+            }
+        }
+        srow[c] = __float2bfloat16_rn(tf_ds_compress2_pair(score[0], score[1], kv[0], kv[1]));
+    }
+    __syncthreads();
+    // phase 3: the kit's `_rmsnorm` (D pow2; blockDim.x == 128 == the num_warps=4 layout)
+    tf_ds_triton_rmsnorm_row(srow, w, out + (long long)g * ldo, D, eps);
+}
diff --git a/zig/src/families/dsv41/compress2_norm.zig b/zig/src/families/dsv41/compress2_norm.zig
new file mode 100644
index 0000000..a0296b7
--- /dev/null
+++ b/zig/src/families/dsv41/compress2_norm.zig
@@ -0,0 +1,208 @@
+//! TF_DS_FUSED_COMPRESS2_NORM (off by default): the ratio-2 compressor chain and the RMSNorm after it in ONE launch.
+//!
+//! Two call sites, two kernels (dsv41_torch.cu), one switch:
+//!   * decode (round.zig's compressorChain, the ratio-2 kv-source layers): tf_ds_compress2x_norm_kernel — the 0127
+//!     fused scatter/gather/compress2 (tf_ds_compress2x_kernel's arithmetic, verbatim) followed by the kit's
+//!     `_rmsnorm` replicated (BLOCK = pow2(D), num_warps = 4; tl.sum's reduction order reconstructed as per-thread
+//!     sequential over EPT contiguous elements, a butterfly xor 16..1 across the warp, then a 4-lane butterfly
+//!     xor 2, xor 1 over the warp partials — UNVERIFIED against the compiled kit kernel, see the report).
+//!   * prompt (prompt.zig's ratio-2 branch): tf_ds_compress2_norm_kernel — Exact.compress2's pair sum followed by
+//!     Exact.rmsNorm's arithmetic (torch's reduce order, the lane count the unfused launch would use), the pair sums
+//!     passing through shared memory as bf16 exactly as the unfused pair of launches round-trips through memory.
+//!
+//! Precedence: TF_DS_FUSED_COMPRESS2_NORM wins over TF_DS_FUSED_COMPRESS2 (it implies the 0127 fusion);
+//! TF_DS_FUSED_COMPRESS2 alone keeps the 0127 behavior (chain fused, the norm a separate launch); neither = the
+//! unfused chain. The switch is read once at load (ops.zig); a bad value refuses to start.
+//!
+//! The kernels are UNVERIFIED-BUILD on this machine (no nvcc): gated on the exact suite on a Spark before the switch
+//! is trusted, like the rest of the series. The decode kernel's norm replication is the one piece whose reduction
+//! order is reconstructed, not copied: it is the honest risk of this switch (see the report). The prompt kernel
+//! reuses only arithmetic that is already bit-checked against torch on GB10.
+//!
+//! The host references below are for the tests; they are not bit-identical to the kernels (rsqrtf and the expf the
+//! kernels use are not reproducible in Zig). Bitwise validation lives in the C++ harness (p0197), which emulates the
+//! kernels and the launches they replace.
+const std = @import("std");
+
+pub const env_name: [:0]const u8 = "TF_DS_FUSED_COMPRESS2_NORM";
+
+/// The switch's value: unset, "" or "0" off; "1" on; anything else is a refusal to start (the message is on stderr).
+pub fn parse(text: ?[]const u8) ?bool {
+    const t = text orelse return false;
+    if (t.len == 0 or std.mem.eql(u8, t, "0")) return false;
+    if (std.mem.eql(u8, t, "1")) return true;
+    std.debug.print("{s}: expected 1 or 0\n", .{env_name});
+    return null;
+}
+
+pub fn fromText(text: ?[]const u8) error{BadCompress2Norm}!bool {
+    return parse(text) orelse error.BadCompress2Norm;
+}
+
+fn isPow2(n: usize) bool {
+    return n > 0 and (n & (n - 1)) == 0;
+}
+
+/// Whether the fused launch supports this configuration: the row count and the channel count. The decode kernel
+/// needs D pow2 in [128, 2048] (the _rmsnorm replication's BLOCK); the prompt kernel needs D % 4 == 0, D >= 128
+/// (torch's vectorized mean), so pow2 in [128, 2048] covers both. Rows: any (the call sites pass R >= 1; a zero-row
+/// call never reaches the launcher).
+pub fn fuseOk(fused: bool, rows: usize, d: usize) bool {
+    return fused and rows > 0 and isPow2(d) and d >= 128 and d <= 2048;
+}
+
+// -- host reference --------------------------------------------------------------------------------------------------
+
+/// Round-to-nearest-even f32 -> bf16 -> f32 (the rounding the kernels apply at every bf16 store).
+pub fn bf16Round(x: f32) f32 {
+    if (std.math.isNan(x)) return x;
+    const b: u32 = @bitCast(x);
+    return @bitCast((b + 0x7FFF + ((b >> 16) & 1)) & 0xFFFF0000);
+}
+
+/// The pair's softmax-weighted sum (tf_ds_compress2_kernel's arithmetic), the raw fp32 value.
+pub fn pairSum(kv0: f32, kv1: f32, s0: f32, s1: f32) f32 {
+    var m: f32 = -3.402823466e+38; // numeric_limits<float>::lowest()
+    if (s0 > m) m = s0;
+    if (s1 > m) m = s1;
+    var sum: f32 = 0;
+    sum += @exp(s0 - m);
+    sum += @exp(s1 - m);
+    const p0 = @exp(s0 - m) / sum;
+    const p1 = @exp(s1 - m) / sum;
+    const y0 = kv0 * p0;
+    const y1 = kv1 * p1;
+    return ((0.0 + y0) + (0.0 + y1)) + 0.0 + 0.0;
+}
+
+/// The pair sum as the kernels store it: bf16-rounded.
+pub fn pairSumBf16(kv0: f32, kv1: f32, s0: f32, s1: f32) f32 {
+    return bf16Round(pairSum(kv0, kv1, s0, s1));
+}
+
+/// The torch rms_norm lane count (exact.zig's rmsLanes; replicated here so this module stands alone — the test below
+/// asserts the two agree).
+pub fn rmsLanes(d: usize, rows: usize) usize {
+    const dim0 = d / 4;
+    const d0 = if (dim0 < 512) lastPow2(dim0) else 512;
+    const d1 = if (rows < 512) lastPow2(rows) else 512;
+    const bw: usize = @min(d0, 32);
+    const bh: usize = @min(d1, 512 / bw);
+    return @min(d0, 512 / bh);
+}
+
+fn lastPow2(n: usize) usize {
+    return if (n == 0) 0 else @as(usize, 1) << @intCast(std.math.log2_int(usize, n));
+}
+
+/// The norm of one bf16-valued row, torch's lane structure (per-lane 4-wide vector accumulators combined in order,
+/// the L>32 fold, the shuffle down), returning bf16-valued f32. `factor` is torch's rows/(rows*D) as f32. Not
+/// bit-identical to the kernel (rsqrtf vs 1/@sqrt); used for the property tests, not for bitwise checks.
+pub fn rmsNormRef(x: []const f32, w: []const f32, out: []f32, lanes: usize, factor: f32, eps: f32) void {
+    const d = x.len;
+    const l = lanes;
+    var part: [128]f32 = @splat(0);
+    var lane: usize = 0;
+    while (lane < l) : (lane += 1) {
+        var a0: f32 = 0;
+        var a1: f32 = 0;
+        var a2: f32 = 0;
+        var a3: f32 = 0;
+        var idx = lane;
+        while (idx * 4 + 3 < d) : (idx += l) {
+            a0 += x[idx * 4 + 0] * x[idx * 4 + 0];
+            a1 += x[idx * 4 + 1] * x[idx * 4 + 1];
+            a2 += x[idx * 4 + 2] * x[idx * 4 + 2];
+            a3 += x[idx * 4 + 3] * x[idx * 4 + 3];
+        }
+        part[lane] = ((a0 + a1) + a2) + a3;
+    }
+    var dim_x = l;
+    if (l > 32) {
+        var offset = l / 2;
+        while (offset >= 32) : (offset >>= 1) {
+            var lane2: usize = 0;
+            while (lane2 < offset) : (lane2 += 1) {
+                if (lane2 + offset < l) part[lane2] = part[lane2] + part[lane2 + offset];
+            }
+        }
+        dim_x = 32;
+    }
+    var offset = dim_x / 2;
+    while (offset > 0) : (offset >>= 1) {
+        var lane2: usize = 0;
+        while (lane2 < dim_x) : (lane2 += 1) {
+            if (lane2 + offset < dim_x) part[lane2] = part[lane2] + part[lane2 + offset];
+        }
+    }
+    const r = 1.0 / @sqrt(part[0] * factor + eps);
+    var j: usize = 0;
+    while (j < d) : (j += 1) out[j] = bf16Round(w[j] * (x[j] * r));
+}
+
+// -- tests -----------------------------------------------------------------------------------------------------------
+
+const expectEqual = std.testing.expectEqual;
+const exact = @import("exact.zig");
+
+test "the switch parses its forms and nothing else" {
+    try expectEqual(false, parse(null).?);
+    try expectEqual(false, parse("").?);
+    try expectEqual(false, parse("0").?);
+    try expectEqual(true, parse("1").?);
+    try expectEqual(@as(?bool, null), parse("2"));
+    try expectEqual(@as(?bool, null), parse("yes"));
+    try expectEqual(@as(?bool, null), parse("01"));
+    try std.testing.expectEqual(@as(bool, true), try fromText("1"));
+    try std.testing.expectError(error.BadCompress2Norm, fromText("2"));
+}
+
+test "fuseOk takes pow2 channel counts in [128, 2048] and any nonzero rows" {
+    try std.testing.expect(fuseOk(true, 1, 512));
+    try std.testing.expect(fuseOk(true, 16, 128));
+    try std.testing.expect(fuseOk(true, 2048, 2048));
+    try std.testing.expect(!fuseOk(true, 0, 512));
+    try std.testing.expect(!fuseOk(false, 16, 512));
+    try std.testing.expect(!fuseOk(true, 16, 96)); // not pow2
+    try std.testing.expect(!fuseOk(true, 16, 64)); // too narrow for the torch norm's vectorization
+    try std.testing.expect(!fuseOk(true, 16, 4096));
+    try std.testing.expect(!fuseOk(true, 16, 500)); // not pow2
+}
+
+test "rmsLanes matches exact.zig's" {
+    for ([_]usize{ 128, 256, 512, 1024, 2048 }) |d| {
+        for ([_]usize{ 1, 2, 3, 4, 5, 8, 9, 16, 17, 33, 512, 2048 }) |rows| {
+            try expectEqual(exact.rmsLanes(d, rows), rmsLanes(d, rows));
+        }
+    }
+}
+
+test "pairSum: the softmax pair, bf16 rounding at the store" {
+    // s0 == s1: the softmax splits 0.5/0.5; the pair sum is the mean of the kv values
+    const v = pairSum(2.0, 4.0, 1.0, 1.0);
+    try std.testing.expectApproxEqAbs(@as(f32, 3.0), v, 1e-6);
+    try expectEqual(@as(f32, 3.0), pairSumBf16(2.0, 4.0, 1.0, 1.0));
+    // one score far above the other: the pair sum is that side's kv (to bf16)
+    try expectEqual(bf16Round(4.0), pairSumBf16(2.0, 4.0, -100.0, 100.0));
+    // a tie at the -inf floor: both weights equal
+    const v2 = pairSum(2.0, 6.0, -3.4e38, -3.4e38);
+    try std.testing.expectApproxEqAbs(@as(f32, 4.0), v2, 1e-3);
+}
+
+test "bf16Round rounds to nearest even at the 16-bit boundary" {
+    try expectEqual(@as(f32, 1.0), bf16Round(1.0));
+    try expectEqual(@as(f32, 1.0), bf16Round(1.00390625)); // halfway between 1.0 and 1.0078125 -> ties to even (1.0)
+    try expectEqual(@as(f32, 1.015625), bf16Round(1.01171875)); // halfway -> ties to even (1.015625)
+    try expectEqual(@as(f32, 0.0), bf16Round(0.0));
+    try expectEqual(@as(f32, -0.0), bf16Round(-0.0));
+}
+
+test "rmsNormRef: a constant row normalizes to w * sign (x * rinv)" {
+    // x = c (all ones): sum = d * c^2; rinv = rsqrt(c^2 + eps); out = bf16(w * c * rinv)
+    var x: [512]f32 = @splat(2.0);
+    var w: [512]f32 = @splat(1.5);
+    var out: [512]f32 = undefined;
+    rmsNormRef(&x, &w, &out, 32, 1.0 / 512.0, 1e-20);
+    const expect_v = bf16Round(1.5 * (2.0 / @sqrt(4.0 + 1e-20)));
+    for (out) |v| try expectEqual(expect_v, v);
+}
