index 0000000..b5c5225
--- /dev/null
+++ b/zig/src/families/dsv41/moe_route.zig
@@ -0,0 +1,209 @@
+//! TF_DS_FUSED_ROUTE (off by default): one launch a layer for a decode window's routing - the gate (rowmm_gate's chunk
+//! sums, kc > 0) or the prompt path's cuBLAS logits (kc == 0), the routing and, when TF_DS_T13_EXPERT_PRUNE is on, the
+//! prune's rule (its cap is refused), plus 0177's dead-row override when it is on. Pure: no cuda import; the launcher
+//! is Ops.moeRoute and the call sites are round.zig's and prompt.zig's moe functions.
+//!
+//! The kernel's bit-level arithmetic is written to reproduce the kit's _rowmm_parts / _route_parts and the prune
+//! kernel op for op (see the kernel in zig/kernels/cuda/dsv41_ops.cu and upstream kernels.py, deepseek-v41-tp2). That
+//! reproduction is UNVERIFIED-BUILD on this machine (no nvcc): it is gated on the exact suite on a Spark before the
+//! switch is trusted. cap > 0, two ranks' 2D split and a decode gate wider than decode_rows refuse the fusion at the
+//! call site, which keeps the unfused launches.
+const std = @import("std");
+
+pub const env_name: [:0]const u8 = "TF_DS_FUSED_ROUTE";
+
+/// The switch's value: unset, "" or "0" off; "1" on; anything else is a refusal to start (the message is on stderr).
+pub fn parse(text: ?[]const u8) ?bool {
+    const t = text orelse return false;
+    if (t.len == 0 or std.mem.eql(u8, t, "0")) return false;
+    if (std.mem.eql(u8, t, "1")) return true;
+    std.debug.print("{s}: expected 1 or 0\n", .{env_name});
+    return null;
+}
+
+pub fn fromText(text: ?[]const u8) error{BadFusedRoute}!bool {
+    return parse(text) orelse error.BadFusedRoute;
+}
+
+/// The most rows the chunk-sum gate supports (rowmm_gate's bound; wider windows fall back to the cuBLAS path).
+pub const decode_rows = 16;
+pub const max_topk = 8;
+pub const max_experts = 512;
+pub const max_slots = 8;
+
+/// Whether the fused path supports this configuration. The call sites fall back to the unfused launches when it does
+/// not (never with cap set: that is the caller's error, refused at start-up). `two` is the four-node split.
+pub fn fuseOk(fused: bool, two: bool, rows: usize, topk: usize, experts: usize, slots: usize) bool {
+    return fused and !two and rows > 0 and rows <= decode_rows and topk >= 1 and topk <= max_topk and slots >= topk and slots <= max_slots and experts >= 32 and experts <= max_experts;
+}
+
+/// Whether the prompt path's kc == 0 routing can be fused for `rows` rows: any row count (the GEMM is cuBLAS's and
+/// is not replaced), same bounds on the routing itself.
+pub fn fuseOkLogits(fused: bool, two: bool, rows: usize, topk: usize, experts: usize, slots: usize) bool {
+    return fused and !two and rows > 0 and topk >= 1 and topk <= max_topk and slots >= topk and slots <= max_slots and experts >= 32 and experts <= max_experts;
+}
+
+// -- host reference -------------------------------------------------------------------------------------------------
+//
+// The kernel's arithmetic on the host, written to the same spec (used by the tests below and by a future GPU port
+// harness). fp32 with IEEE semantics; every operation in the order the kernel makes it. This is NOT a model of
+// Triton's code generation: agreement with the compiled kit kernels is a hardware question.
+
+fn softplusSqrt(lg: f32) f32 {
+    const sp = if (lg > 20.0) lg else @log(1.0 + @exp(lg));
+    return @sqrt(sp);
+}
+
+/// _route_parts'/_route's arithmetic, op for op. `lg` is the row's logits (kc == 0) or chunk sums combined by the
+/// caller into `combined`. pick/wts are [slots]; the shared expert keeps slots >= topk with weight 1.
+pub fn routeRow(logits: []const f32, bias: []const f32, topk: usize, scale: f32, shared_id: usize, pick: []i32, wts: []f32) void {
+    std.debug.assert(logits.len == bias.len and pick.len == wts.len and pick.len >= topk);
+    const ne = logits.len;
+    var sel: [max_experts]f32 = undefined;
+    var sc: [max_experts]f32 = undefined;
+    for (0..ne) |e| {
+        sc[e] = softplusSqrt(logits[e]);
+        sel[e] = sc[e] + bias[e];
+    }
+    var tot: f32 = 0;
+    var p: [max_topk]i32 = undefined;
+    var v: [max_topk]f32 = undefined;
+    for (0..topk) |n| {
+        var best: f32 = -std.math.inf(f32);
+        var bid: usize = ne; // ties to the lowest id
+        for (0..ne) |e| {
+            if (sel[e] > best or (sel[e] == best and e < bid)) {
+                best = sel[e];
+                bid = e;
+            }
+        }
+        p[n] = @intCast(bid);
+        v[n] = sc[bid];
+        tot += v[n];
+        sel[bid] = -std.math.inf(f32);
+    }
+    // The CPU's rounded reciprocal stands in for the kit's approximate GPU reciprocal.
+    const inv_denom: f32 = 1.0 / (tot + 1e-20);
+    for (0..pick.len) |s| {
+        if (s < topk) {
+            pick[s] = p[s];
+            wts[s] = (v[s] * inv_denom) * scale;
+        } else {
+            pick[s] = @intCast(shared_id);
+            wts[s] = 1.0;
+        }
+    }
+}
+
+/// The chunk sums the gate computes, combined in order from zero (the route kernel's chunk loop), for reference
+/// tests. `S` is [kc][ne] (the gate's output layout).
+pub fn combineChunks(s: []const f32, kc: usize, ne: usize, out: []f32) void {
+    std.debug.assert(s.len == kc * ne and out.len == ne);
+    for (0..ne) |e| {
+        var acc: f32 = 0;
+        for (0..kc) |t| acc += s[t * ne + e];
+        out[e] = acc;
+    }
+}
+
+// -- tests -----------------------------------------------------------------------------------------------------------
+
+const expectEqual = std.testing.expectEqual;
+const expectApproxEqAbs = std.testing.expectApproxEqAbs;
+
+test "the switch parses its forms and nothing else" {
+    try expectEqual(false, parse(null).?);
+    try expectEqual(false, parse("").?);
+    try expectEqual(false, parse("0").?);
+    try expectEqual(true, parse("1").?);
+    try expectEqual(@as(?bool, null), parse("2"));
+    try expectEqual(@as(?bool, null), parse("yes"));
+    try expectEqual(@as(?bool, null), parse("01"));
+    try std.testing.expectEqual(@as(bool, true), try fromText("1"));
+    try std.testing.expectError(error.BadFusedRoute, fromText("2"));
+}
+
+test "fuseOk takes the decode bounds; logits takes any rows" {
+    try std.testing.expect(fuseOk(true, false, 16, 6, 384, 7));
+    try std.testing.expect(fuseOk(true, false, 1, 6, 384, 7));
+    try std.testing.expect(!fuseOk(true, false, 17, 6, 384, 7));
+    try std.testing.expect(!fuseOk(true, true, 4, 6, 384, 7));
+    try std.testing.expect(!fuseOk(false, false, 4, 6, 384, 7));
+    try std.testing.expect(!fuseOk(true, false, 4, 9, 384, 7));
+    try std.testing.expect(!fuseOk(true, false, 4, 6, 384, 5)); // slots < topk must fail
+    try std.testing.expect(!fuseOk(true, false, 4, 6, 16, 7));
+    try std.testing.expect(!fuseOk(true, false, 0, 6, 384, 7));
+    try std.testing.expect(fuseOkLogits(true, false, 2048, 6, 384, 7));
+    try std.testing.expect(!fuseOkLogits(true, true, 1, 6, 384, 7));
+    try std.testing.expect(!fuseOkLogits(true, false, 0, 6, 384, 7));
+}
+
+test "routeRow picks the top-k by sc + bias, ties to the lower id, shared expert last with weight 1" {
+    // logits comfortably above softplus^-1(ln(2)) (lg > 0): the picks must follow the logits exactly
+    var lg: [384]f32 = @splat(0);
+    var bias: [384]f32 = @splat(0);
+    lg[5] = 9; lg[7] = 8; lg[9] = 7; lg[300] = 6; lg[11] = 5; lg[200] = 4.5;
+    var pick: [7]i32 = undefined;
+    var wts: [7]f32 = undefined;
+    routeRow(&lg, &bias, 6, 1.5, 383, &pick, &wts);
+    try expectEqual([_]i32{ 5, 7, 9, 300, 11, 200, 383 }, pick);
+    try expectEqual(@as(f32, 1.0), wts[6]);
+    // weights are sc normalized to the picked sum, scaled
+    var tot: f32 = 0;
+    var sc: [6]f32 = undefined;
+    for (0..6) |i| {
+        sc[i] = softplusSqrt(lg[@intCast(pick[i])]);
+        tot += sc[i];
+    }
+    for (0..6) |i| try expectApproxEqAbs((sc[i] / (tot + 1e-20)) * 1.5, wts[i], 1e-6);
+}
+
+test "routeRow takes the shared expert at index ne too (the shared slot sits after the routed ones)" {
+    var lg: [384]f32 = @splat(0);
+    var bias: [384]f32 = @splat(0);
+    var pick: [7]i32 = undefined;
+    var wts: [7]f32 = undefined;
+    routeRow(&lg, &bias, 6, 1.5, 384, &pick, &wts); // the shared pick sits at ne, not ne - 1
+    try expectEqual(@as(i32, 384), pick[6]);
+    try expectEqual(@as(f32, 1.0), wts[6]);
+}
+
+test "routeRow ties to the lower id" {
+    var lg: [384]f32 = @splat(0); // every sc identical
+    var bias: [384]f32 = @splat(0);
+    var pick: [7]i32 = undefined;
+    var wts: [7]f32 = undefined;
+    routeRow(&lg, &bias, 6, 1.5, 383, &pick, &wts);
+    try expectEqual([_]i32{ 0, 1, 2, 3, 4, 5, 383 }, pick);
+}
+
+test "routeRow's bias can outrank the logits" {
+    var lg: [384]f32 = @splat(0);
+    var bias: [384]f32 = @splat(0);
+    lg[300] = 100; // huge logit, no bias
+    bias[42] = 10; // moderate logit, big bias
+    var pick: [7]i32 = undefined;
+    var wts: [7]f32 = undefined;
+    routeRow(&lg, &bias, 6, 1.5, 383, &pick, &wts);
+    // sc(100) = 10, sc(0) + 10 = 10.83: the bias wins for slot 0, the big logit takes slot 1
+    try expectEqual(@as(i32, 42), pick[0]);
+    try expectEqual(@as(i32, 300), pick[1]);
+}
+
+test "routeRow normalizes with one shared reciprocal before scaling" {
+    const logits = [_]f32{ 121, 81, 81, 81, 81, 81 };
+    const bias: [logits.len]f32 = @splat(0);
+    var pick: [7]i32 = undefined;
+    var wts: [7]f32 = undefined;
+    routeRow(&logits, &bias, 6, 1.5, 6, &pick, &wts);
+    // With the CPU's rounded reciprocal, score 9 / total 56 uses this
+    // weight. Rounding division directly would produce 0x3e76db6e.
+    try expectEqual(@as(u32, 0x3e76db6f), @as(u32, @bitCast(wts[1])));
+}
+
+test "combineChunks adds the chunks in order from zero" {
+    var s = [_]f32{ 1, 2, 3, 4, 5, 6 }; // kc=3, ne=2
+    var out: [2]f32 = undefined;
+    combineChunks(&s, 3, 2, &out);
+    try expectEqual([_]f32{ 1 + 3 + 5, 2 + 4 + 6 }, out);
+}
