 }
 
+// The fused route (TF_DS_FUSED_ROUTE): a decode window's gate, routing and prune in one launch, one block a row.
+// With kc > 0 the block computes the gate's chunk sums itself (rowmm_gate's _rowmm_parts arithmetic: each output's
+// chunk of 256 columns as 8 columns a lane, the same butterfly over 32 lanes as in rowmm2, chunks in order from
+// zero into the fp32 accumulator - the bits rowmm_gate's S and _route_parts' chunk loop are written to keep), then
+// the routing (_route_parts' _route_row: sqrt(softplus(lg)) with the lg > 20 shortcut, selection by sc + bias with
+// ties to the lower id, weights (sc * reciprocal(tot + 1e-20f)) * scale) in the same block. With kc == 0 the gate
+// phase is skipped and logits (a prompt chunk's cuBLAS output) are read instead: this is _route with kc == 0. When
+// do_prune the prune's rule is applied after the routing (expert_prune.zig's pruneRow, op for op; renorm arithmetic
+// and the stats counters as the prune kernel makes them). When `dead` is not null and dead[r] is set, every slot
+// becomes pick -1, weight 0 (0177, after the prune, as deadRows runs). The window-wide prune cap (cap > 0) needs all
+// rows in one block and is refused at the wrapper. stats (nullable) is the prune kernel's u64 [6]; scratch (required
+// iff stats) is u32[64] owned by the caller: 2x16 before/after bitmask words, then one ticket word for the
+// last-block reduce; on the stats path the last block resets the 33 words before it returns.
+//
+// The bit-level claim: each lane's 8-element chunk partial is a sequential fp32 chain (the products rounded as
+// written), the 32-lane reduce is the xor butterfly, each gate accumulator and the chunk loop are the same adds in
+// the same order, and every rounding is IEEE (this file is built --fmad=false --ftz=false). expf/logf/sqrtf are the
+// libdevice functions tl.exp/tl.log/tl.sqrt lower to, compiled without fast math. Whether the result is bit for bit
+// the kit's on a GB10 is a hardware question (UNVERIFIED-BUILD here: no nvcc on this machine): it is gated on the
+// exact suite on a Spark before the switch is trusted.
+//
+// The 0194 extension (same switch): the decode window's decode_prep folded in - the rotation of the input rows per
+// pick (rot_in_kernel's arithmetic: x * suh0/suh1 per gate / up matrix, FWHT128, x HAD_SCALE, to fp16), this row's half
+// of the unrouted-row combine (decode_prep's block-0 combine, done per row), and, in block 0 after a grid-wide barrier,
+// the grouping (uids / ucount / members) - all op for op from the upstream source (deepseek-v41-tp2, experts.cu). What
+// remains of a decode window after a fused launch: the two kit grouped_decode launches. UNVERIFIED-BUILD like the
+// rest; gated on the exact suite with the switch on.
+__device__ __forceinline__ void fwht128(float (&v)[4], int lane) {
+    float a = v[0] + v[1], b = v[0] - v[1], c = v[2] + v[3], d = v[2] - v[3];
+    v[0] = a + c; v[1] = b + d; v[2] = a - c; v[3] = b - d;
+#pragma unroll
+    for (int m = 1; m < 32; m <<= 1) {
+#pragma unroll
+        for (int j = 0; j < 4; ++j) {
+            float o = __shfl_xor_sync(0xffffffffu, v[j], m);
+            v[j] = (lane & m) ? o - v[j] : v[j] + o;
+        }
+    }
+}
+constexpr float HAD_SCALE = 0.08838834764831845f;   // 1 / sqrt(128)
+struct TfDsFused {
+    float scale;      // routed scaling (1.5)
+    float topp;       // prune rule (TfDsPrune shares these)
+    int shared_id;    // the shared expert's id (routing fills slots >= topk with it, weight 1)
+    int rows, ne, nb; // nb: pow2(ne), the routing's lane bound
+    int topk, slots, kc, k, xs;
+    int do_prune, cap, cap_min, min_k, renorm, apply, pdl;
+    int prep;         // 0194: 0 - the launch only routes (the prompt path); 1 - also the experts' prep (decode windows)
+    int e_count;      // 0194: the experts pack's size (the rotation's and grouping's pick bound; the gate only has ne)
+    int maxm;         // 0194: the member lists' stride (the rows)
+};
+extern "C" __global__ void __launch_bounds__(256) tf_ds_fused_route_kernel(
+    const __nv_bfloat16* __restrict__ x,  // [rows, xs] bf16; null iff kc == 0
+    const __half* __restrict__ w,         // [ne, k] fp16; null iff kc == 0
+    const float* __restrict__ logits,     // [rows, ne] fp32 (kc == 0); null iff kc > 0
+    const float* __restrict__ bias,       // [ne] fp32
+    int* pick, float* wts,                // [rows, slots]
+    const unsigned char* dead,            // [rows] or null (0177)
+    unsigned long long* stats,            // nullable u64 [6]
+    unsigned* scratch,                    // required iff stats or prep: u32[64], see above
+    __half* __restrict__ xg,              // 0194: [rows*slots, k] fp16 zeros (rot_in's out); null iff !prep
+    __half* __restrict__ xu,              // 0194: [rows*slots, k] fp16 zeros (rot_in's out); null iff !prep
+    const __half* __restrict__ suh0,      // 0194: fp16 [e_count, k] gate's signs; null iff !prep
+    const __half* __restrict__ suh1,      // 0194: fp16 [e_count, k] up's signs; null iff !prep
+    int* __restrict__ ids,                // 0194: [maxu] int32 out: the window's distinct experts; null iff !prep
+    int* __restrict__ ucount,             // 0194: [1] int32 out: how many; null iff !prep
+    int* __restrict__ members,            // 0194: [maxu, maxm] int32 out: member (row * 32 + slot) lists; null iff !prep
+    const float* __restrict__ y,          // 0194: [rows*slots, k] fp32 scratch the unrouted-row combine reads (zero first use)
+    const float* __restrict__ add,        // 0194: [rows, k] fp32 add for the unrouted-row combine, or null
+    float* __restrict__ out,              // 0194: [rows, k] fp32 out for the unrouted-row combine; null iff !prep
+    int* __restrict__ epoch,              // 0194: [1] int32, incremented once a launch (grouped_decode's readiness); null iff !prep
+    const TfDsFused a) {
+#define TF_DS_FUSED_EXPERTS 512
+    const int r = blockIdx.x, tid = threadIdx.x;
+    pdl_enter(a.pdl);
+    if (r >= a.rows) return;
+    if (a.prep && r == 0 && tid == 0 && epoch) epoch[0] += 1;
+    __shared__ float lg[512];
+    __shared__ int s_pick[8];
+    __shared__ float s_wts[8];
+    __shared__ unsigned mb[16], ma[16], acc[3];
+    for (int i = tid; i < 16; i += blockDim.x) { mb[i] = 0; ma[i] = 0; }
+    if (tid < 3) acc[tid] = 0;
+    // the gate: chunk sums added in order from zero (rowmm2's accumulator; _route_parts' chunk loop)
+    if (a.kc > 0) {
+        const int lane = tid & 31, warp = tid >> 5, nwarps = blockDim.x >> 5;
+        const int kk = a.k;
+        for (int n = warp; n < a.ne; n += nwarps) {
+            float accv = 0.f;
+            for (int t = 0; t < a.kc; ++t) {
+                const int off = t * 256 + lane * 8;
+                const uint4 xv = *reinterpret_cast<const uint4*>(x + (size_t)r * a.xs + off);
+                const uint4 wv = *reinterpret_cast<const uint4*>(w + (size_t)n * kk + off);
+                float part = 0.f;
+                const __nv_bfloat162* xp = reinterpret_cast<const __nv_bfloat162*>(&xv);
+                const __half2* wp = reinterpret_cast<const __half2*>(&wv);
+#pragma unroll
+                for (int j2 = 0; j2 < 4; ++j2) {
+                    const float2 xf = __bfloat1622float2(xp[j2]);
+                    const float2 wf = __half22float2(wp[j2]);
+                    part = __fadd_rn(part, __fmul_rn(xf.x, wf.x));
+                    part = __fadd_rn(part, __fmul_rn(xf.y, wf.y));
+                }
+#pragma unroll
+                for (int o = 16; o > 0; o >>= 1) part = __fadd_rn(part, __shfl_xor_sync(0xffffffffu, part, o));
+                accv = __fadd_rn(accv, part);
+            }
+            if (lane == 0) lg[n] = accv;
+        }
+        // the route phase's masked read covers e up to nb; keep the tail defined (the value is never used past the
+        // `ok` mask, so this is belt and braces, not semantics)
+        for (int e = a.ne + tid; e < a.nb; e += blockDim.x) lg[e] = 0.f;
+    } else {
+        for (int e = tid; e < a.nb; e += blockDim.x) lg[e] = e < a.ne ? logits[(size_t)r * a.ne + e] : 0.f;
+    }
+    __syncthreads();
+    // the routing (_route_parts' _route_row: its reductions are an extremum, a lowest-index tie break and a one-hot
+    // sum, so the result is independent of how the experts are laid out across the warp)
+    if (tid < 32) {
+        const int lane = tid;
+        const int stride = 32;              // e = lane + j * 32 covers nb <= 512 with j < 16
+        float sel[16], sc[16];
+        int ids[16];
+#pragma unroll
+        for (int j = 0; j < 16; ++j) {
+            const int e = lane + j * stride;
+            const bool ok = e < a.ne;
+            const float l = ok ? lg[e] : 0.f;
+            const float sp = l > 20.f ? l : logf(1.f + expf(l));
+            const float scv = sqrtf(sp);
+            sc[j] = scv;
+            ids[j] = e;
+            sel[j] = ok ? __fadd_rn(scv, bias[e]) : __int_as_float(0xff800000); // -inf
+        }
+        float tots = 0.f;
+        int picks[8];
+        float ws[8];
+#pragma unroll
+        for (int s = 0; s < 8; ++s) { picks[s] = a.shared_id; ws[s] = 1.f; }
+        for (int n = 0; n < a.topk; ++n) {
+            float best = __int_as_float(0xff800000);
+            int bid = lane;                 // ties (including all -inf) to the lowest id, as tl.min(tl.where(sel == best, e, NB))
+#pragma unroll
+            for (int j = 0; j < 16; ++j) {
+                const float v = sel[j];
+                if (v > best || (v == best && ids[j] < bid)) { best = v; bid = ids[j]; }
+            }
+#pragma unroll
+            for (int o = 16; o > 0; o >>= 1) {
+                const float ob = __shfl_xor_sync(0xffffffffu, best, o);
+                const int oi = __shfl_xor_sync(0xffffffffu, bid, o);
+                if (ob > best || (ob == best && oi < bid)) { best = ob; bid = oi; }
+            }
+            float v = 0.f;
+#pragma unroll
+            for (int j = 0; j < 16; ++j) v += ids[j] == bid ? sc[j] : 0.f;
+#pragma unroll
+            for (int o = 16; o > 0; o >>= 1) v = __fadd_rn(v, __shfl_xor_sync(0xffffffffu, v, o));
+            picks[n] = bid;
+            ws[n] = v;
+            tots = __fadd_rn(tots, v);
+#pragma unroll
+            for (int j = 0; j < 16; ++j) sel[j] = ids[j] == bid ? __int_as_float(0xff800000) : sel[j];
+        }
+        const float denom = __fadd_rn(tots, 1e-20f);
+        // The kit uses MUFU.RCP and two separately rounded multiplies. The
+        // score sum plus epsilon is normal and far below the reciprocal's
+        // overflow/underflow scaling thresholds for finite logits.
+        float inv_denom;
+        asm("rcp.approx.ftz.f32 %0, %1;" : "=f"(inv_denom) : "f"(denom));
+#pragma unroll
+        for (int s = 0; s < 8; ++s) ws[s] = s < a.topk ? __fmul_rn(__fmul_rn(ws[s], inv_denom), a.scale) : 1.f;
+        if (lane == 0) {
+            for (int s = 0; s < a.slots; ++s) { s_pick[s] = picks[s]; s_wts[s] = ws[s]; }
+        }
+        if (stats && lane == 0) { // before the rule (the prune kernel's load-time mask)
+            for (int s = 0; s < a.topk; ++s) {
+                const int p = picks[s];
+                if (p >= 0 && p < TF_DS_FUSED_EXPERTS) atomicOr(&mb[p >> 5], 1u << (p & 31));
+            }
+        }
+        __syncwarp();
+    }
+    // the prune's rule (expert_prune.zig's pruneRow, op for op; the cap is refused at the wrapper)
+    if (a.do_prune && tid == 0) {
+        int p[8], rank[8], live = 0;
+        float f[8], ex[8], w[8], tot = 0.f;
+        bool keep[8];
+        for (int i = 0; i < a.topk; ++i) {
+            p[i] = s_pick[i]; w[i] = s_wts[i]; keep[i] = true;
+            if (p[i] < 0) continue;
+            ++live; tot = __fadd_rn(tot, w[i]);
+        }
+        const bool ok = live > 0 && tot > 0.f && !isinf(tot);
+        if (ok) {
+            for (int i = 0; i < a.topk; ++i) f[i] = p[i] >= 0 ? __fdiv_rn(w[i], tot) : 0.f;
+            for (int i = 0; i < a.topk; ++i) {
+                rank[i] = 0;
+                if (p[i] < 0) continue;
+                for (int j = 0; j < a.topk; ++j) rank[i] += p[j] >= 0 && (f[j] > f[i] || (f[j] == f[i] && j < i));
+            }
+            float run = 0.f;
+            for (int k = 0; k < live; ++k)
+                for (int i = 0; i < a.topk; ++i)
+                    if (p[i] >= 0 && rank[i] == k) { ex[i] = run; run = __fadd_rn(run, f[i]); }
+            const int floor_k = a.min_k > 1 ? a.min_k : 1;
+            for (int i = 0; i < a.topk; ++i)
+                if (p[i] >= 0) keep[i] = rank[i] < floor_k || ex[i] < a.topp;
+            int kept = 0;
+            float ks = 0.f, mass = 0.f;
+            for (int i = 0; i < a.topk; ++i) {
+                if (p[i] < 0) continue;
+                if (keep[i]) { ++kept; ks = __fadd_rn(ks, w[i]); } else mass = __fadd_rn(mass, f[i]);
+            }
+            if (kept < live) {
+                if (a.apply) {
+                    const float g = __fdiv_rn(tot, ks);
+                    for (int i = 0; i < a.topk; ++i) {
+                        if (p[i] < 0) continue;
+                        if (keep[i]) { if (a.renorm) w[i] = __fmul_rn(w[i], g); }
+                        else { p[i] = -1; w[i] = 0.f; }
+                    }
+                }
+                if (stats) { atomicAdd(&acc[0], (unsigned)(live - kept)); atomicAdd(&acc[2], (unsigned)(mass * 1e6f + 0.5f)); }
+            }
+        }
+        if (stats) {
+            atomicAdd(&acc[1], 1u);
+            for (int i = 0; i < a.topk; ++i)
+                if (p[i] >= 0 && keep[i] && p[i] < TF_DS_FUSED_EXPERTS) atomicOr(&ma[p[i] >> 5], 1u << (p[i] & 31));
+        }
+        if (a.apply) {
+            for (int i = 0; i < a.topk; ++i) { s_pick[i] = p[i]; s_wts[i] = w[i]; }
+        }
+    }
+    if (tid < 32) __syncwarp();
+    // 0177's dead rows: no slot routes (after the prune, as deadRows runs)
+    if (dead && dead[r]) {
+        if (tid < a.slots) { s_pick[tid] = -1; s_wts[tid] = 0.f; }
+        __syncwarp();
+    }
+    if (tid < a.slots) {
+        pick[(size_t)r * a.slots + tid] = s_pick[tid];
+        wts[(size_t)r * a.slots + tid] = s_wts[tid];
+    }
+    __syncthreads();
+    // --- 0194: this row's rotation of its picks (rot_in_kernel's arithmetic: x * suh, FWHT128, x HAD_SCALE, fp16) ---
+    if (a.prep) {
+        const int lane = tid & 31, warp = tid >> 5, nwarps = blockDim.x >> 5;
+        const int nblk = a.k >> 7; // K / 128
+        const int items = a.slots * nblk * 2;
+        for (int item = warp; item < items; item += nwarps) {
+            const int slot = item / (nblk * 2);
+            const int mat = (item / nblk) & 1;
+            const int blk = item % nblk;
+            const int e = s_pick[slot];
+            if (e < 0 || e >= a.e_count) continue;
+            const int p = r * a.slots + slot;
+            const __half* suh = (mat ? suh1 : suh0) + (size_t)e * a.k + blk * 128 + 4 * lane;
+            const __nv_bfloat16* xr = x + (size_t)r * a.xs + blk * 128 + 4 * lane;
+            float v[4];
+#pragma unroll
+            for (int j = 0; j < 4; ++j) v[j] = __bfloat162float(xr[j]) * __half2float(suh[j]);
+            fwht128(v, lane);
+            __half* o = (mat ? xu : xg) + (size_t)p * a.k + blk * 128 + 4 * lane;
+#pragma unroll
+            for (int j = 0; j < 4; ++j) o[j] = __float2half_rn(v[j] * HAD_SCALE);
+        }
+        // this row's unrouted-slot combine (decode_prep's block-0 combine, this row's own share)
+        int routed = 0;
+#pragma unroll
+        for (int q = 0; q < 8; ++q) routed += (q < a.slots && s_pick[q] >= 0 && s_pick[q] < a.e_count);
+        if (routed == 0) {
+            for (int d = tid * 4; d < a.k; d += blockDim.x * 4) {
+                float slot_acc[4] = { 0.f, 0.f, 0.f, 0.f };
+                for (int q = 0; q < a.slots; ++q) {
+                    const float w = s_wts[q];
+#pragma unroll
+                    for (int j = 0; j < 4; ++j) slot_acc[j] = fmaf(w, y ? y[((size_t)r * a.slots + q) * a.k + d + j] : 0.f, slot_acc[j]);
+                }
+#pragma unroll
+                for (int j = 0; j < 4; ++j) out[(size_t)r * a.k + d + j] = add ? __fadd_rn(slot_acc[j], add[(size_t)r * a.k + d + j]) : slot_acc[j];
+            }
+        }
+    }
+    // the window's masks into scratch; the last block pops them into stats and resets scratch for the next launch
+    if (stats) {
+        __syncthreads();
+        if (tid == 0) {
+            // the per-block counters go straight to stats (every block contributes); the window's before/after masks
+            // need the launch-wide OR, so only the last block pops them and bumps the window count
+            atomicAdd(stats + 3, (unsigned long long)acc[0]);
+            atomicAdd(stats + 4, (unsigned long long)acc[1]);
+            atomicAdd(stats + 5, (unsigned long long)acc[2]);
+            unsigned* sc = scratch;
+            for (int i = 0; i < 16; ++i) { atomicOr(&sc[i], mb[i]); atomicOr(&sc[16 + i], ma[i]); }
+            __threadfence();
+            const unsigned t = atomicAdd(&sc[32], 1u);
+            if (t == gridDim.x - 1) {
+                int before = 0, after = 0;
+                for (int i = 0; i < 16; ++i) { before += __popc(__ldcg(&sc[i])); after += __popc(__ldcg(&sc[16 + i])); }
+                atomicAdd(stats, 1ull);
+                atomicAdd(stats + 1, (unsigned long long)before);
+                atomicAdd(stats + 2, (unsigned long long)after);
+                for (int i = 0; i < 33; ++i) atomicExch(&sc[i], 0u);
+            }
+        }
+    }
+    // --- 0194: grid-wide barrier; block 0 groups the window's picks (kit decode_prep's block-0 grouping) ---
+    if (a.prep) {
+        __threadfence();
+        __syncthreads();
+        if (tid == 0) atomicAdd(&scratch[33], 1u);
+        if (blockIdx.x == 0) {
+            __shared__ int s_sp[128], s_first[128], s_used;
+            const int n = a.rows * a.slots;
+            if (tid == 0) s_used = 0;
+            __syncthreads();
+            while (__ldcg(&scratch[33]) != gridDim.x) __nanosleep(64);
+            for (int i = tid; i < n; i += blockDim.x) s_sp[i] = pick[i];
+            __syncthreads();
+            for (int i = tid; i < n; i += blockDim.x) {
+                const int e = s_sp[i];
+                int f = e >= 0 && e < a.e_count;
+                for (int j = 0; f && j < i; ++j) f = s_sp[j] != e;
+                s_first[i] = f;
+            }
+            __syncthreads();
+            int used = 0;
+            for (int i = tid; i < n; i += blockDim.x) {
+                const int e = s_sp[i];
+                if (e < 0 || e >= a.e_count) continue;
+                int place = 0, pos = 0, tot = 0;
+                for (int j = 0; j < n; ++j) {
+                    const int ej = s_sp[j];
+                    place += s_first[j] && ej < e;
+                    tot += ej == e;
+                    pos += ej == e && j < i;
+                }
+                if (pos < a.maxm) members[place * a.maxm + pos] = (i / a.slots) * 32 + (i % a.slots);
+                if (s_first[i]) {
+                    ids[place] = e;
+                    for (int k = tot; k < a.maxm; ++k) members[place * a.maxm + k] = -1;
+                    ++used;
+                }
+            }
+            if (used) atomicAdd(&s_used, used);
+            __syncthreads();
+            if (tid == 0) { ucount[0] = s_used; scratch[33] = 0; }
+        }
+        return;
+    }
+}
+
 // Routed-expert top-p prune of a decode window (expert_prune.zig's pruneWindow, op for op), in place on the router's
 // output, one thread a row. A slot the rule drops becomes pick -1, weight 0; the kept weights are scaled by total / kept
 // sum (renorm). With cap > 0 the window then keeps only its cap heaviest experts (the rows' kept shares summed in row
diff --git a/zig/src/families/dsv41/dsv41.zig b/zig/src/families/dsv41/dsv41.zig
index 290f9c1..4190082 100644
--- a/zig/src/families/dsv41/dsv41.zig
+++ b/zig/src/families/dsv41/dsv41.zig
@@ -53,6 +53,7 @@ pub const model = @import("model.zig");
 pub const prompt_rows = @import("prompt_rows.zig");
 pub const prefill_prof = @import("prefill_prof.zig");
 pub const expert_prune = @import("expert_prune.zig");
+pub const moe_route = @import("moe_route.zig");
