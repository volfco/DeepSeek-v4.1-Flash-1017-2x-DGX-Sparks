@@ -0,0 +1,252 @@
+//! TF_DS_FUSED_ROPE_STORE (off by default): the rope+store chains of the kv-source and index-source layers in ONE
+//! launch each. Five kernels (dsv41_torch.cu), one switch:
+//!   * decode indexer key (round.zig's kv-source layers): the kit's `_rmsnorm` (D=index_head_dim) + `_rope_heads`
+//!     (RD=rope_dim, H=1) + `_fp4_store` (BLOCK=32, E4M3=false) — tf_ds_fused_idx_key_kernel.
+//!   * decode latent (the same layers): `_rope_heads` + `_fp4_store` (D=head_dim, BLOCK=16, E4M3=true) —
+//!     tf_ds_fused_rope_store_kernel.
+//!   * decode indexer query (round.zig's index-source layers): `_rope_heads` (RD=rope_dim, H=index_heads) +
+//!     `_fp4qd_p2` (32-element blocks, pow2 scale, dequantized bf16 out) — tf_ds_fused_rope_qd_kernel.
+//!   * prompt indexer key (prompt.zig's kv-source layers): Exact.rmsNorm + Exact.rope (torch's arithmetic) + the
+//!     kit's `_fp4_store` — tf_ds_fused_prompt_idx_key_kernel.
+//!   * prompt latent (prompt.zig's kv-source layers): Exact.rope + `_fp4_store` — tf_ds_fused_prompt_latent_kernel.
+//!
+//! The kit's `_rmsnorm` replication carries the same reduction-order reconstruction as TF_DS_FUSED_COMPRESS2_NORM's
+//! decode half (see compress2_norm.zig and the report); `_rope_heads` / `_fp4_store` / `_fp4qd_p2` are elementwise
+//! (max is exact) and bit-safe to replicate. The E4M3 scale path replicates the Triton bit twiddle exactly
+//! (denormal `sub` path, `nor` path with the 0x7F->0x7E clamp, and the `fb >= (1087 << 20)` saturation arm, which
+//! is bits(480.0f) and so covers f >= 480 / amax >= 2880 - dropping it would let the normal path run past 0x7F
+//! where the kit saturates to 0x7E).
+//! UNVERIFIED-BUILD on this machine (no nvcc): gated on the exact suite on a Spark, like the rest of the series.
+const std = @import("std");
+
+pub const env_name: [:0]const u8 = "TF_DS_FUSED_ROPE_STORE";
+
+/// The switch's value: unset, "" or "0" off; "1" on; anything else is a refusal to start (the message is on stderr).
+pub fn parse(text: ?[]const u8) ?bool {
+    const t = text orelse return false;
+    if (t.len == 0 or std.mem.eql(u8, t, "0")) return false;
+    if (std.mem.eql(u8, t, "1")) return true;
+    std.debug.print("{s}: expected 1 or 0\n", .{env_name});
+    return null;
+}
+
+pub fn fromText(text: ?[]const u8) error{BadRopeStore}!bool {
+    return parse(text) orelse error.BadRopeStore;
+}
+
+fn isPow2(n: usize) bool {
+    return n > 0 and (n & (n - 1)) == 0;
+}
+
+/// Whether the fused launch supports this configuration: rows, the head dim (pow2 in [128, 512]: the kernels' srow
+/// is 512 bf16 and the fp4 blocks divide it), the rope dim (pow2, <= d) and the head count.
+pub fn fuseOk(fused: bool, rows: usize, d: usize, rd: usize, heads: usize) bool {
+    return fused and rows > 0 and isPow2(d) and d >= 128 and d <= 512 and isPow2(rd) and rd >= 2 and rd <= d and heads >= 1;
+}
+
+// -- host reference (tests) ------------------------------------------------------------------------------------------
+//
+// The kernels' arithmetic on the host, written to the same spec. fp32 IEEE; every operation in the kernel's order.
+// Not bit-identical to the kernels (expf/sqrtf are not reproducible in Zig); the fuzz harness (p0197) is the bitwise
+// check. These exist for the known-answer tests below.
+
+/// One E2M1 code (the `_e2m1_round` thresholds, ties to the even code), sign bit included.
+pub fn e2m1Code(t: f32) u8 {
+    const a = @abs(t);
+    var idx: u8 = 0;
+    if (a > 0.25) idx += 1;
+    if (a > 0.75) idx += 1;
+    if (a > 1.25) idx += 1;
+    if (a > 1.75) idx += 1;
+    if (a > 2.5) idx += 1;
+    if (a > 3.5) idx += 1;
+    if (a > 5.0) idx += 1;
+    if (a == 0.75 or a == 1.75 or a == 3.5) idx += 1;
+    if (t < 0.0 and idx > 0) idx |= 8;
+    return idx;
+}
+
+/// The E2M1 magnitude of a code (the g table of `_fp4qd_p2`).
+pub fn e2m1Mag(idx: u8) f32 {
+    return switch (idx & 7) {
+        0 => 0.0,
+        1 => 0.5,
+        2 => 1.0,
+        3 => 1.5,
+        4 => 2.0,
+        5 => 3.0,
+        6 => 4.0,
+        else => 6.0,
+    };
+}
+
+/// The pow2 (E8M0) scale of _fp4_store's non-E4M3 path: f = max(amax, 6*2^-126) / 6 (IEEE div), the byte is the
+/// biased exponent rounded up by one when f has a mantissa, the scale is 2^(byte - 127).
+pub fn pow2Scale(amax: f32) struct { sc: f32, byte: u8 } {
+    const m = if (amax != amax) amax else @max(amax, 6.0 * 0x1p-126); // NaN propagates, as the kernel's fmax_nan
+    const f = m / 6.0;
+    const bits: u32 = @bitCast(f);
+    const e: u32 = ((bits >> 23) & 0xFF) + (if ((bits & 0x7FFFFF) != 0) @as(u32, 1) else 0);
+    return .{ .sc = @bitCast(e << 23), .byte = @truncate(e) };
+}
+
+/// The E4M3 scale of _fp4_store's E4M3 path: f = max(amax, 6*2^-9) / 6, the byte is f rounded to E4M3 (RNE,
+/// saturation to 0x7E) by the Triton bit twiddle, replicated exactly.
+pub fn e4m3Scale(amax: f32) struct { sc: f32, byte: u8 } {
+    const m = if (amax != amax) amax else @max(amax, 6.0 * 0x1p-9);
+    const f = m / 6.0;
+    const byte = e4m3Byte(f);
+    return .{ .sc = e4m3ToFloat(byte), .byte = byte };
+}
+
+fn e4m3Byte(f: f32) u8 {
+    const fb: i32 = @bitCast(f);
+    const sub: i32 = @as(i32, @bitCast(f + 16384.0)) -% (141 << 23);
+    var nor: i32 = (fb +% (-120 << 23) +% 0x7FFFF +% ((fb >> 20) & 1)) >> 20;
+    if (nor == 0x7F) nor = 0x7E;
+    const sb: i32 = if (fb >= (1087 << 20)) 0x7E else if (fb < (121 << 23)) sub else nor;
+    return @truncate(@as(u32, @bitCast(sb & 0xFF)));
+}
+
+fn e4m3ToFloat(b: u8) f32 {
+    const sign: u32 = (@as(u32, b) >> 7) & 1;
+    const exp: u32 = (b >> 3) & 0xF;
+    const man: u32 = b & 7;
+    if (exp == 0) return (if (sign == 1) @as(f32, -1.0) else 1.0) * @as(f32, @floatFromInt(man)) * 0x1p-9;
+    const bits: u32 = ((exp + 120) << 23) | (man << 20) | (sign << 31);
+    return @bitCast(bits);
+}
+
+/// One rotary pair, the kit's `_rope_heads` arithmetic (Triton contracts the first product into the add).
+pub fn ropePairTriton(x0: f32, x1: f32, cs: f32, sn: f32, inv: bool) [2]f32 {
+    const s = if (inv) -sn else sn;
+    return .{ @mulAdd(f32, x0, cs, -(x1 * s)), @mulAdd(f32, x0, s, x1 * cs) };
+}
+
+/// One rotary pair, ops.rope_'s arithmetic (tf_ds_rope_kernel: fma(a, c, -(b*d)), fma(b, c, a*d)).
+pub fn ropePairTorch(x0: f32, x1: f32, cs: f32, sn: f32, inv: bool) [2]f32 {
+    const s = if (inv) -sn else sn;
+    return .{ @mulAdd(f32, x0, cs, -(x1 * s)), @mulAdd(f32, x1, cs, x0 * s) };
+}
