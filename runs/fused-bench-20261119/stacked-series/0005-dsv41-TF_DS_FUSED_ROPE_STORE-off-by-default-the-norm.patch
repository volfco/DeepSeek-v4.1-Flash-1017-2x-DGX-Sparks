+}
+
+test "fuseOk takes pow2 head dims in [128, 512], pow2 rope dims <= d, any nonzero heads/rows" {
+    try std.testing.expect(fuseOk(true, 1, 512, 64, 1));
+    try std.testing.expect(fuseOk(true, 16, 128, 64, 32));
+    try std.testing.expect(fuseOk(true, 16, 512, 512, 1));
+    try std.testing.expect(!fuseOk(true, 0, 512, 64, 1));
+    try std.testing.expect(!fuseOk(false, 16, 512, 64, 1));
+    try std.testing.expect(!fuseOk(true, 16, 96, 64, 1)); // not pow2
+    try std.testing.expect(!fuseOk(true, 16, 1024, 64, 1)); // too wide for srow
+    try std.testing.expect(!fuseOk(true, 16, 512, 48, 1)); // rope dim not pow2
+    try std.testing.expect(!fuseOk(true, 16, 512, 1024, 1)); // rope dim wider than the head
+    try std.testing.expect(!fuseOk(true, 16, 512, 64, 0)); // no heads
+}
+
+test "e2m1Code: thresholds, ties to even, sign bit" {
+    try expectEqual(@as(u8, 0), e2m1Code(0.0));
+    try expectEqual(@as(u8, 0), e2m1Code(0.25)); // at the boundary, not above it
+    try expectEqual(@as(u8, 1), e2m1Code(0.5));
+    try expectEqual(@as(u8, 2), e2m1Code(0.75)); // tie -> even code (2)
+    try expectEqual(@as(u8, 2), e2m1Code(1.0));
+    try expectEqual(@as(u8, 3), e2m1Code(1.5));
+    try expectEqual(@as(u8, 4), e2m1Code(1.75)); // tie -> even code (4)
+    try expectEqual(@as(u8, 4), e2m1Code(2.0));
+    try expectEqual(@as(u8, 4), e2m1Code(2.5)); // tie at 2.5 stays 4 (even)
+    try expectEqual(@as(u8, 6), e2m1Code(3.5)); // tie -> even code (6)
+    try expectEqual(@as(u8, 7), e2m1Code(6.0));
+    try expectEqual(@as(u8, 7), e2m1Code(6.0));
+    try expectEqual(@as(u8, 0x9), e2m1Code(-0.5)); // idx 1 | sign
+    try expectEqual(@as(u8, 0x0), e2m1Code(-0.0)); // t < 0 is false for -0.0: no sign bit
+    try expectEqual(@as(u8, 0xC), e2m1Code(-2.0)); // idx 4 | sign
+    try expectEqual(@as(u8, 0xF), e2m1Code(-6.0));
+}
+
+test "pow2Scale: exact powers of two and the mantissa bump" {
+    // amax = 6 -> f = 1.0 -> exp 127, mantissa 0 -> byte 127, sc = 1.0
+    const a = pow2Scale(6.0);
+    try expectEqual(@as(u8, 127), a.byte);
+    try expectEqual(@as(f32, 1.0), a.sc);
+    // amax = 3 -> f = 0.5 -> exp 126 -> byte 126, sc = 0.5
+    const b = pow2Scale(3.0);
+    try expectEqual(@as(u8, 126), b.byte);
+    try expectEqual(@as(f32, 0.5), b.sc);
+    // amax = 7 -> f = 7/6 = 1.1666.. -> mantissa nonzero -> byte 128, sc = 2.0
+    const c = pow2Scale(7.0);
+    try expectEqual(@as(u8, 128), c.byte);
+    try expectEqual(@as(f32, 2.0), c.sc);
+    // amax = 0 -> f = 2^-126 -> byte 1, sc = 2^-126
+    const d = pow2Scale(0.0);
+    try expectEqual(@as(u8, 1), d.byte);
+    try expectEqual(@as(f32, 0x1p-126), d.sc);
+}
+
+test "e4m3Scale: known values and the byte encoding" {
+    // amax = 6 -> f = 1.0 -> E4M3 0x38 (exp 7, man 0), sc = 1.0
+    const a = e4m3Scale(6.0);
+    try expectEqual(@as(u8, 0x38), a.byte);
+    try expectEqual(@as(f32, 1.0), a.sc);
+    // amax = 100 -> f = 16.6667 -> rounds to 16 (E4M3 0x58), sc = 16.0
+    const b = e4m3Scale(100.0);
+    try expectEqual(@as(u8, 0x58), b.byte);
+    try expectEqual(@as(f32, 16.0), b.sc);
+    // amax = 0 -> f = 2^-9 (the floor) -> denormal boundary: exp field 0, man = 1 -> byte 0x01, sc = 2^-9
+    const c = e4m3Scale(0.0);
+    try expectEqual(@as(u8, 0x01), c.byte);
+    try expectEqual(@as(f32, 0x1p-9), c.sc);
+    // f = 460 (amax = 2760): RNE saturates to 448 (0x7E)
+    const d = e4m3Scale(2760.0);
+    try expectEqual(@as(u8, 0x7E), d.byte);
+    try expectEqual(@as(f32, 448.0), d.sc);
+    // the explicit saturation arm starts where bits(f) reaches 1087 << 20 = bits(480.0f): amax 2879 is still the
+    // 0x7F->0x7E clamp's, amax 2880 needs the arm - without it `nor` runs past 0x7F and encodes 0x80 (a
+    // negative-zero scale)
+    try expectEqual(@as(u8, 0x7E), e4m3Scale(2879.0).byte);
+    const e = e4m3Scale(2880.0);
+    try expectEqual(@as(u8, 0x7E), e.byte);
+    try expectEqual(@as(f32, 448.0), e.sc);
+    const g = e4m3Scale(1e4);
+    try expectEqual(@as(u8, 0x7E), g.byte);
+    try expectEqual(@as(f32, 448.0), g.sc);
+}
+
+test "e4m3ToFloat decodes the byte layout" {
+    try expectEqual(@as(f32, 0.0), e4m3ToFloat(0x00));
+    try expectEqual(@as(f32, 0x1p-9), e4m3ToFloat(0x01)); // min denormal
+    try expectEqual(@as(f32, 1.0), e4m3ToFloat(0x38));
+    try expectEqual(@as(f32, -2.0), e4m3ToFloat(0xC0));
+    try expectEqual(@as(f32, 448.0), e4m3ToFloat(0x7E));
+    try expectEqual(@as(f32, 0.75), e4m3ToFloat(0x34)); // exp 6 (2^-1), man 4 -> 1.5 * 0.5
+}
+
+test "ropePair: cos=1/sin=0 is the identity, cos=0/sin=1 rotates by a quarter turn" {
+    const a = ropePairTriton(1.5, -2.0, 1.0, 0.0, false);
+    try expectEqual(@as(f32, 1.5), a[0]);
+    try expectEqual(@as(f32, -2.0), a[1]);
+    const b = ropePairTriton(1.5, -2.0, 0.0, 1.0, false);
+    try expectEqual(@as(f32, 2.0), b[0]);
+    try expectEqual(@as(f32, 1.5), b[1]);
+    const c = ropePairTorch(1.5, -2.0, 0.0, 1.0, false);
+    try expectEqual(@as(f32, 2.0), c[0]);
+    try expectEqual(@as(f32, 1.5), c[1]);
+    // the inverse rotation undoes the forward one (up to fp rounding)
+    const fwd = ropePairTriton(1.5, -2.0, 0.6, 0.8, false);
+    const back = ropePairTriton(fwd[0], fwd[1], 0.6, 0.8, true);
+    try std.testing.expectApproxEqAbs(@as(f32, 1.5), back[0], 1e-6);
+    try std.testing.expectApproxEqAbs(@as(f32, -2.0), back[1], 1e-6);
+}
