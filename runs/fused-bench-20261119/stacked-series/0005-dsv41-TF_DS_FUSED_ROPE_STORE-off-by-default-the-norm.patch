+
+// ===================================================================================================================
+// TF_DS_FUSED_ROPE_STORE (0198, off by default).
+//
+// Each fused kernel replicates the launches it replaces, op for op:
+//   - the kit's `_rmsnorm` (see tf_ds_triton_rmsnorm_row above),
+//   - the kit's `_rope_heads` (Triton contracts the first product into the add: re = fma(xe, cs, -(xo*sn)),
+//     im = fma(xe, sn, xo*cs); the torch ops.rope_ equivalent is tf_ds_rope_pair_torch),
+//   - the kit's `_fp4_store` (E2M1 codes, the E4M3 or the pow2/E8M0 scale, byte packing),
+//   - the kit's `_fp4qd_p2` (E2M1 codes with the pow2 scale, the dequantized bf16 out).
+// The `_rmsnorm` replication carries the reduction-order risk noted above; the rope and fp4 pieces are
+// elementwise/order-free (max is exact) and are bit-safe to replicate. UNVERIFIED-BUILD on this machine (no nvcc):
+// gated on the exact suite on a Spark, like the rest of the series.
+// ===================================================================================================================
+
+// _rope_heads (kernels.py), one rotary pair j of one head: x points at the head's first rotary element. INV negates
+// sin. Triton contracts the first product into the add (llvm.fma): re = fma(xe, cs, -(xo*sn)), im = fma(xe, sn, xo*cs).
+__device__ __forceinline__ void tf_ds_rope_pair_triton(__nv_bfloat16* x, const float* cos, const float* sin,
+                                                       long long p, int j, int RD, bool inv) {
+    const int half = RD >> 1;
+    const float cs = cos[p * half + j];
+    float sn = sin[p * half + j];
+    if (inv) sn = -sn;
+    const float xe = __bfloat162float(x[2 * j]);
+    const float xo = __bfloat162float(x[2 * j + 1]);
+    x[2 * j]     = __float2bfloat16_rn(__fmaf_rn(xe, cs, -__fmul_rn(xo, sn)));
+    x[2 * j + 1] = __float2bfloat16_rn(__fmaf_rn(xe, sn, __fmul_rn(xo, cs)));
+}
+
+// ops.rope_ (tf_ds_rope_kernel above), one pair: re = fma(a, c, -(b*d)), im = fma(b, c, a*d), d = inv ? -sin : sin.
+__device__ __forceinline__ void tf_ds_rope_pair_torch(__nv_bfloat16* x, const float* cos, const float* sin,
+                                                      long long p, int j, int RD, bool inv) {
+    const int half = RD >> 1;
+    const float cs = cos[p * half + j];
+    float sn = sin[p * half + j];
+    if (inv) sn = -sn;
+    const float xe = __bfloat162float(x[2 * j]);
+    const float xo = __bfloat162float(x[2 * j + 1]);
+    x[2 * j]     = __float2bfloat16_rn(__fmaf_rn(xe, cs, -__fmul_rn(xo, sn)));
+    x[2 * j + 1] = __float2bfloat16_rn(__fmaf_rn(xo, cs, __fmul_rn(xe, sn)));
+}
+
+// E2M1 magnitude of an already-clamped t (|t| <= 6), ties to the even code (kernels.py `_e2m1_round`).
+__device__ __forceinline__ unsigned tf_ds_e2m1_code(float t) {
+    const float a = fabsf(t);
+    unsigned idx = (a > 0.25f ? 1u : 0u) + (a > 0.75f ? 1u : 0u) + (a > 1.25f ? 1u : 0u) + (a > 1.75f ? 1u : 0u)
+                 + (a > 2.5f ? 1u : 0u) + (a > 3.5f ? 1u : 0u) + (a > 5.0f ? 1u : 0u);
+    if (a == 0.75f || a == 1.75f || a == 3.5f) idx += 1u;
+    return idx | ((t < 0.0f && idx > 0u) ? 8u : 0u);
+}
+
+// The E2M1 magnitude as a float (kernels.py's g table).
+__device__ __forceinline__ float tf_ds_e2m1_mag(unsigned idx) {
+    switch (idx) {
+        case 0: return 0.0f;
+        case 1: return 0.5f;
+        case 2: return 1.0f;
+        case 3: return 1.5f;
+        case 4: return 2.0f;
+        case 5: return 3.0f;
+        case 6: return 4.0f;
+        default: return 6.0f;
+    }
+}
+
+// float -> E4M3 byte with RNE and saturation to 448 (0x7E), for _fp4_store's E4M3 scale. Pure bit ops, the same
+// rounding the Triton source spells out (denormal path via the +16384.0 trick, normal path via the round-to-nearest
+// add at bit 19, the 0x7F -> 0x7E clamp, the `fb >= (1087 << 20)` saturation to 0x7E). `1087 << 20` is exactly
+// bits(480.0f), so that arm covers f >= 480 (amax >= 2880): it is reachable and must be kept - the 0x7F clamp alone
+// leaves f >= 480 as 0x80 (a negative zero scale) where the kit's kernel saturates to 448.
+__device__ __forceinline__ unsigned tf_ds_e4m3_byte(float f) {
+    const int fb = __float_as_int(f);
+    const int sub = __float_as_int(f + 16384.0f) - (141 << 23);
+    int nor = (fb + (-120 << 23) + 0x7FFFF + ((fb >> 20) & 1)) >> 20;
+    if (nor == 0x7F) nor = 0x7E;
+    const int sb = (fb >= (1087 << 20)) ? 0x7E : ((fb < (121 << 23)) ? sub : nor);
+    return (unsigned)(sb & 0xFF);
+}
+
+// E4M3 byte -> float (the scale the codes are dequantized with).
+__device__ __forceinline__ float tf_ds_e4m3_to_float(unsigned b) {
+    const unsigned sign = (b >> 7) & 1u, exp = (b >> 3) & 0xFu, man = b & 7u;
+    float v;
+    if (exp == 0) v = (float)man * 0x1p-9f;                       // denormal: man * 2^-9
+    else v = ldexpf(1.0f + (float)man * 0.125f, (int)exp - 7);
+    return sign ? -v : v;
+}
+
+// clamp to [-6, 6], NaN propagates (tl.minimum/tl.maximum propagate NaN)
+__device__ __forceinline__ float tf_ds_clamp6(float v) { return v > 6.0f ? 6.0f : (v < -6.0f ? -6.0f : v); }
+
+// fmaxf that propagates NaN (tl.max propagates NaN)
+__device__ __forceinline__ float tf_ds_fmax_nan(float a, float b) { return (a != a) ? a : ((b != b) ? b : fmaxf(a, b)); }
+
+// _fp4_store (kernels.py) for one row of D bf16 values in `srow`: per BLOCK-element block the amax (NaN propagates),
+// the scale (E4M3: RNE to E4M3 with saturation, the E8M0/pow2 path: biased-exponent byte, scale = 2^(e-127)), the
+// E2M1 codes, the packed bytes (element j low nibble, element j + D/2 high nibble) written to codes[row] (D/2 bytes)
+// and the scale byte per block to scales[row] (D/BLOCK bytes).
+__device__ __forceinline__ void tf_ds_fp4_store_row(const __nv_bfloat16* srow, uint8_t* codes, uint8_t* scales,
+                                                    long long row, int D, int BLOCK, bool e4m3) {
+    const int NB = D / BLOCK;
+    __shared__ float sc[32];
+    __shared__ unsigned char sb[32];
+    for (int b = threadIdx.x; b < NB; b += blockDim.x) {
+        float amax = 0.f;
+        for (int j = 0; j < BLOCK; j++) {
+            const float a = fabsf(__bfloat162float(srow[b * BLOCK + j]));
+            amax = tf_ds_fmax_nan(amax, a);
+        }
+        if (e4m3) {
+            const float f = __fdiv_rn(tf_ds_fmax_nan(amax, 6.0f * 0x1p-9f), 6.0f);
+            const unsigned char byte = (unsigned char)tf_ds_e4m3_byte(f);
+            sb[b] = byte;
+            sc[b] = tf_ds_e4m3_to_float(byte);
+        } else {
+            const float f = __fdiv_rn(tf_ds_fmax_nan(amax, 6.0f * 0x1p-126f), 6.0f);
+            const int bits = __float_as_int(f);
+            const int e = ((bits >> 23) & 0xFF) + (((bits & 0x7FFFFF) != 0) ? 1 : 0);
+            sb[b] = (unsigned char)(e & 0xFF);
+            sc[b] = __uint_as_float(((unsigned)e) << 23);
+        }
+    }
+    __syncthreads();
+    const int HALF = D >> 1;
+    for (int i = threadIdx.x; i < HALF; i += blockDim.x) {
+        const float xl = __bfloat162float(srow[i]);
+        const float xh = __bfloat162float(srow[i + HALF]);
+        const float tl = tf_ds_clamp6(__fdiv_rn(xl, sc[i / BLOCK]));
+        const float th = tf_ds_clamp6(__fdiv_rn(xh, sc[(i + HALF) / BLOCK]));
+        codes[row * HALF + i] = (uint8_t)(tf_ds_e2m1_code(tl) | (tf_ds_e2m1_code(th) << 4));
+    }
+    for (int b = threadIdx.x; b < NB; b += blockDim.x) scales[row * NB + b] = sb[b];
+}
+
+// -- TF_DS_FUSED_ROPE_STORE (0198) ----------------------------------------------------------------------------------
+
+// The decode indexer key (round.zig's kv-source layers): the kit's `_rmsnorm` (D=128) + `_rope_heads` (RD=64, H=1,
+// forward) + `_fp4_store` (D=128, BLOCK=32, E4M3=false) in one launch. grid.x = rows, block = 128 (the _rmsnorm
+// num_warps=4 layout). The rotated row is written to out_ik (rd.ik) as the unfused sequence leaves it; the packed
+// codes/scales go to rows_idx[r] (the ctarget row), exactly as _fp4_store's ROWS indirection.
+extern "C" __global__ void __launch_bounds__(128) tf_ds_fused_idx_key_kernel(const __nv_bfloat16* x, long long ldx,
+                                                                             const __nv_bfloat16* w,
+                                                                             const float* cos, const float* sin,
+                                                                             const long long* pos,
+                                                                             __nv_bfloat16* out_ik,
+                                                                             uint8_t* codes, uint8_t* scales,
+                                                                             const long long* rows_idx,
+                                                                             int D, int RD, float eps, int pdl) {
+    pdl_enter(pdl);
+    const int r = blockIdx.x;
+    __shared__ __nv_bfloat16 srow[512];   // D <= 512
+    // phase 1: _rmsnorm (x row -> srow, bf16)
+    tf_ds_triton_rmsnorm_row(x + (long long)r * ldx, w, srow, D, eps);
+    __syncthreads();
+    // phase 2: _rope_heads (RD/2 pairs, head base = D - RD)
+    const long long p = pos[r];
+    for (int j = threadIdx.x; j < (RD >> 1); j += blockDim.x)
+        tf_ds_rope_pair_triton(srow + (D - RD), cos, sin, p, j, RD, false);
+    __syncthreads();
+    // phase 3: the rotated row to out_ik (the unfused sequence leaves it there), then _fp4_store
+    for (int i = threadIdx.x; i < D; i += blockDim.x) out_ik[(long long)r * D + i] = srow[i];
+    tf_ds_fp4_store_row(srow, codes, scales, rows_idx[r], D, 32, false);
+}
+
+// The decode latent (round.zig's kv-source layers): `_rope_heads` (RD=64, H=1, forward) + `_fp4_store`
+// (D=512, BLOCK=16, E4M3=true) in one launch. x is rd.lat, rotated in place (as the unfused sequence does); the
+// packed codes/scales go to rows_idx[r] (the ltarget row; under TF_DS_KV_SHARD the rank's plane or the trash row).
+extern "C" __global__ void __launch_bounds__(128) tf_ds_fused_rope_store_kernel(__nv_bfloat16* x,
+                                                                                const float* cos, const float* sin,
+                                                                                const long long* pos,
+                                                                                uint8_t* codes, uint8_t* scales,
+                                                                                const long long* rows_idx,
+                                                                                int D, int RD, int pdl) {
+    pdl_enter(pdl);
+    const int r = blockIdx.x;
+    __shared__ __nv_bfloat16 srow[512];   // D <= 512
+    for (int i = threadIdx.x; i < D; i += blockDim.x) srow[i] = x[(long long)r * D + i];
+    __syncthreads();
+    const long long p = pos[r];
+    for (int j = threadIdx.x; j < (RD >> 1); j += blockDim.x)
+        tf_ds_rope_pair_triton(srow + (D - RD), cos, sin, p, j, RD, false);
+    __syncthreads();
+    for (int i = threadIdx.x; i < D; i += blockDim.x) x[(long long)r * D + i] = srow[i];
+    tf_ds_fp4_store_row(srow, codes, scales, rows_idx[r], D, 16, true);
+}
+
+// The decode indexer query (round.zig's index-source layers): `_rope_heads` (RD=64, H=index_heads, forward) +
+// `_fp4qd_p2` (32-element blocks, E2M1 codes with a pow2 scale, the dequantized bf16 written back out) in one launch.
+// grid.x = rows * H, block = 128. x (rd.iq) is rotated in place; out (rd.iq4) gets the dequantized values.
+extern "C" __global__ void __launch_bounds__(128) tf_ds_fused_rope_qd_kernel(__nv_bfloat16* x, __nv_bfloat16* out,
+                                                                             const float* cos, const float* sin,
+                                                                             const long long* pos,
+                                                                             int H, int HD, int RD, int pdl) {
+    pdl_enter(pdl);
+    const int r = blockIdx.x / H, h = blockIdx.x % H;
+    const long long base = ((long long)r * H + h) * HD;
+    __shared__ __nv_bfloat16 srow[512];   // HD <= 512
+    for (int i = threadIdx.x; i < HD; i += blockDim.x) srow[i] = x[base + i];
+    __syncthreads();
+    const long long p = pos[r];
+    for (int j = threadIdx.x; j < (RD >> 1); j += blockDim.x)
+        tf_ds_rope_pair_triton(srow + (HD - RD), cos, sin, p, j, RD, false);
+    __syncthreads();
+    for (int i = threadIdx.x; i < HD; i += blockDim.x) x[base + i] = srow[i];
+    // _fp4qd_p2: one 32-element block per thread, sequential (max is order-free)
+    const int nblk = HD / 32;
+    for (int b = threadIdx.x; b < nblk; b += blockDim.x) {
+        float v[32];
+        float amax = 0.f;
+        #pragma unroll
+        for (int j = 0; j < 32; j++) {
+            v[j] = __bfloat162float(srow[b * 32 + j]);
+            const float a = fabsf(v[j]);
+            amax = tf_ds_fmax_nan(amax, a);
+        }
+        const float sv = __fdiv_rn(tf_ds_fmax_nan(amax, 6.0f * 0x1p-126f), 6.0f);
+        const int bits = __float_as_int(sv);
+        const int ex = ((bits >> 23) & 0xFF) + (((bits & 0x7FFFFF) != 0) ? 1 : 0);
+        const float sc = __uint_as_float(((unsigned)ex) << 23);
+        #pragma unroll
+        for (int j = 0; j < 32; j++) {
+            const float t = tf_ds_clamp6(__fdiv_rn(v[j], sc));
+            const float a = fabsf(t);
+            unsigned idx = (a > 0.25f ? 1u : 0u) + (a > 0.75f ? 1u : 0u) + (a > 1.25f ? 1u : 0u) + (a > 1.75f ? 1u : 0u)
+                         + (a > 2.5f ? 1u : 0u) + (a > 3.5f ? 1u : 0u) + (a > 5.0f ? 1u : 0u);
+            if (a == 0.75f || a == 1.75f || a == 3.5f) idx += 1u;
+            const float g = tf_ds_e2m1_mag(idx);
+            const float q = __uint_as_float(__float_as_uint(g) | (__float_as_uint(t) & 0x80000000u));
+            out[base + b * 32 + j] = __float2bfloat16_rn(__fmul_rn(q, sc));
+        }
+    }
+}
+
+// The prompt indexer key (prompt.zig's kv-source layers): torch's ops.rms_norm (the Exact kernel's arithmetic) +
+// ops.rope_ (tf_ds_rope_kernel's arithmetic) + the kit's `_fp4_store` (D=128, BLOCK=32, E4M3=false) in one launch.
+// grid.x = rows, block = rmsLanes(D, rows) (the lane count the unfused rmsNorm launch uses). The rotated row is
+// written to out_ik (ch.ik) as the unfused sequence leaves it; codes/scales to rows_idx[r] (the group's slot).
+extern "C" __global__ void tf_ds_fused_prompt_idx_key_kernel(const __nv_bfloat16* x, long long ldx,
+                                                             const __nv_bfloat16* w, float eps, float factor,
+                                                             const float* cos, const float* sin, const long long* pos,
+                                                             __nv_bfloat16* out_ik,
+                                                             uint8_t* codes, uint8_t* scales, const long long* rows_idx,
+                                                             int D, int RD, int pdl) {
+    pdl_enter(pdl);
+    const int r = blockIdx.x;
+    __shared__ __nv_bfloat16 srow[512];   // D <= 512
+    tf_ds_torch_rmsnorm_row(x + (long long)r * ldx, w, srow, D, factor, eps);
+    __syncthreads();
+    const long long p = pos[r];
+    for (int j = threadIdx.x; j < (RD >> 1); j += blockDim.x)
+        tf_ds_rope_pair_torch(srow + (D - RD), cos, sin, p, j, RD, false);
+    __syncthreads();
+    for (int i = threadIdx.x; i < D; i += blockDim.x) out_ik[(long long)r * D + i] = srow[i];
+    tf_ds_fp4_store_row(srow, codes, scales, rows_idx[r], D, 32, false);
+}
+
+// The prompt latent (prompt.zig's kv-source layers): ops.rope_ (tf_ds_rope_kernel's arithmetic) + the kit's
+// `_fp4_store` (D=512, BLOCK=16, E4M3=true) in one launch. x is ch.lat2 (the copy of ch.lat the call site makes),
+// rotated in place as the unfused sequence does; codes/scales to rows_idx[r] (the group's slot).
+extern "C" __global__ void __launch_bounds__(128) tf_ds_fused_prompt_latent_kernel(__nv_bfloat16* x,
+                                                                                   const float* cos, const float* sin,
+                                                                                   const long long* pos,
+                                                                                   uint8_t* codes, uint8_t* scales,
+                                                                                   const long long* rows_idx,
+                                                                                   int D, int RD, int pdl) {
+    pdl_enter(pdl);
+    const int r = blockIdx.x;
+    __shared__ __nv_bfloat16 srow[512];   // D <= 512
+    for (int i = threadIdx.x; i < D; i += blockDim.x) srow[i] = x[(long long)r * D + i];
+    __syncthreads();
+    const long long p = pos[r];
+    for (int j = threadIdx.x; j < (RD >> 1); j += blockDim.x)
+        tf_ds_rope_pair_torch(srow + (D - RD), cos, sin, p, j, RD, false);
+    __syncthreads();
+    for (int i = threadIdx.x; i < D; i += blockDim.x) x[(long long)r * D + i] = srow[i];
+    tf_ds_fp4_store_row(srow, codes, scales, rows_idx[r], D, 16, true);
+}
