+// TF_DS_IDX_FUSED (off by default): the candidate pool's chain for a row in ONE launch - the block maxima
+// (tf_ds_block_max_kernel's rule: an amax over bsize scores, a NaN wins, the row's newest block pinned to +inf), the top
+// `k` over them (tf_ds_topk_select_row, the same selection tf_ds_topk_indices_kernel launches) and the pool's mask
+// and/or block list (tf_ds_pool_pick_kernel's rule). One block per row (1024 threads), grid (rows). Every phase runs
+// the source kernels' arithmetic op for op, so the bits match the unfused sequence; the maxima go through `bmax`
+// ([rows, nb] fp32, row stride bs, nb = ceil(width / bsize)) as the unfused launch wrote them, and the selection's vis
+// is `every` (the call sites pass the every_vis constant: no column masked at or past nb <= 2^40). A picked block
+// whose maximum is not above -inf (a NaN or an all-(-inf) block) is not in the pool: it sets no mask byte and lists -1.
+// score [rows, width] fp32 (row stride ss), vis, every [rows] int64, pidx out [rows, k] int64, mask out u8 [rows, nb]
+// (row stride ms) or null, cblk out int32 [rows, k] or null. k <= 2048 and k <= nb, like the topk kernel.
+extern "C" __global__ void __launch_bounds__(1024) tf_ds_idx_fused_kernel(const float* score, long long ss, int width,
+                                                                          int bsize, const long long* vis,
+                                                                          const long long* every, float* bmax,
+                                                                          long long bs, long long* pidx, int k,
+                                                                          uint8_t* mask, long long ms, int* cblk,
+                                                                          int pdl) {
+    pdl_enter(pdl);
+    const int r = blockIdx.x;
+    const int nb = (width + bsize - 1) / bsize;
+    const float ninf = -__int_as_float(0x7f800000);
+    const float* row = score + (long long)r * ss;
+    float* out_b = bmax + (long long)r * bs;
+    // phase 1: the block maxima (tf_ds_block_max_kernel's rule, one thread a block)
+    const long long t = vis[r] - 1;
+    const long long last = t >= 0 ? t / bsize : -((-t + bsize - 1) / bsize);
+    for (int b = threadIdx.x; b < nb; b += blockDim.x) {
+        const float* s = row + (long long)b * bsize;
+        float m = ninf;
+        bool nan = false;
+        for (int j = 0; j < bsize && b * bsize + j < width; ++j) {
+            const float x = s[j];
+            if (x != x) nan = true;
+            else if (x > m) m = x;
+        }
+        float v = nan ? __int_as_float(0x7fc00000) : m;
+        if (b == last) v = __int_as_float(0x7f800000);
+        out_b[b] = v;
+    }
+    // phase 2: the top-k over the maxima (the same launch tf_ds_topk_indices_kernel makes, the maxima as its row)
+    __syncthreads();   // block-wide: phase 2 reads every bmax element this block wrote
+    tf_ds_topk_select_row(out_b, nb, k, every[r], pidx + (long long)r * k);
+    __syncthreads();   // block-wide: phase 3 reads the columns this block wrote
+    // phase 3: the pool (tf_ds_pool_pick_kernel's rule). A negative column (every[r] can mask one in principle) is not
+    // in the pool - the unfused launch would read bmax before the row here, which no call site passes every small
+    // enough to hit; treat it as not picked.
+    if (mask != nullptr) {
+        for (int b = threadIdx.x; b < nb; b += blockDim.x) mask[(long long)r * ms + b] = 0;
+        __syncthreads();
+    }
+    for (int j = threadIdx.x; j < k; j += blockDim.x) {
+        const long long c = pidx[(long long)r * k + j];
+        const bool ok = c >= 0 && out_b[c] > ninf;
+        if (mask != nullptr && ok) mask[(long long)r * ms + c] = 1;
+        if (cblk != nullptr) cblk[(long long)r * k + j] = ok ? (int)c : -1;
+    }
+}
+
