diff --git a/zig/src/families/dsv41/idx_fused.zig b/zig/src/families/dsv41/idx_fused.zig
new file mode 100644
index 0000000..a1e8ab9
--- /dev/null
+++ b/zig/src/families/dsv41/idx_fused.zig
@@ -0,0 +1,225 @@
+//! TF_DS_IDX_FUSED (off by default): the indexer's candidate pool in one launch - the block maxima
+//! (tf_ds_block_max_kernel), the top-k over them (tf_ds_topk_indices_kernel's selection) and the pool's mask / block
+//! list (tf_ds_pool_pick_kernel), one block per row. Pure: no cuda import; the launcher is Ops.idxFused and the call
+//! sites are round.zig's candidate-source arm (the decode rows) and prompt.zig's chunk path (the pooled source layer).
+//!
+//! The kernel's bit-level arithmetic is written to reproduce the three launches it replaces op for op (see the kernel in
+//! zig/kernels/cuda/dsv41_ops.cu). That reproduction is UNVERIFIED-BUILD on this machine (no nvcc): it is gated on the
+//! exact suite on a Spark before the switch is trusted, like 0193/0194. Past `max_nbk` blocks the row, or with a bad
+//! switch value, the unfused launches run (or the engine refuses to start).
+const std = @import("std");
+
+pub const env_name: [:0]const u8 = "TF_DS_IDX_FUSED";
+
+/// The switch's value: unset, "" or "0" off; "1" on; anything else is a refusal to start (the message is on stderr).
+pub fn parse(text: ?[]const u8) ?bool {
+    const t = text orelse return false;
+    if (t.len == 0 or std.mem.eql(u8, t, "0")) return false;
+    if (std.mem.eql(u8, t, "1")) return true;
+    std.debug.print("{s}: expected 1 or 0\n", .{env_name});
+    return null;
+}
+
+pub fn fromText(text: ?[]const u8) error{BadIdxFused}!bool {
+    return parse(text) orelse error.BadIdxFused;
+}
+
+/// The selection's k bound (the pool's top blocks: candidate_blocks at both call sites, 2048 on this checkpoint).
+pub const max_k = 2048;
+/// The maxima's block count past which the fused launch keeps one block a row for work the unfused launches spread
+/// over a 2D grid: the fused path covers the pool's regime (nbk > candidate_blocks) up to 8192 blocks (64K keys at
+/// the served block size); past it the unfused sequence runs.
+pub const max_nbk = 8192;
+
+/// Whether the fused launch supports this configuration. The call sites fall back to the unfused sequence when it
+/// does not. k > nbk (the selection's own bound) and nbk <= 0 refuse; `width` must agree with `bsize`.
+pub fn fuseOk(fused: bool, rows: usize, width: usize, bsize: usize, nbk: usize, k: usize) bool {
+    return fused and rows > 0 and width > 0 and bsize >= 1 and nbk == (width + bsize - 1) / bsize and nbk >= 1 and nbk <= max_nbk and k >= 1 and k <= max_k and k <= nbk;
+}
+
+// -- host reference -------------------------------------------------------------------------------------------------
+//
+// The kernel's arithmetic on the host, written to the same spec (used by the tests below). fp32 with IEEE semantics;
+// the selection is keyed on the same 64-bit key and is computed by sorting (the kernel's radix select is the same
+// total order, which is what the tests check the fused arm against semantically, not algorithmically).
+
+const ninf: f32 = -std.math.inf(f32);
+
+/// The key tf_ds_score_key makes: the score's bits (-0 as +0) ordered as signed integers, above the inverted column.
+pub fn scoreKey(x: f32, j: usize) u64 {
+    var bits: u32 = @bitCast(x);
+    if (bits == 0x80000000) bits = 0; // score + 0.0
+    const sb: i32 = @bitCast(bits);
+    const ordered: i32 = if (sb < 0) sb ^ 0x7FFFFFFF else sb;
+    const key = (@as(u64, @bitCast(@as(i64, ordered))) << 32) | @as(u64, 0xFFFFFFFF - @as(u64, @intCast(j)));
+    return key ^ 0x8000000000000000;
+}
+
+/// The block maxima (tf_ds_block_max_kernel's rule): an amax over each block of `bsize` scores (a NaN wins, the NaN is
+/// quiet 0x7fc00000), the row's newest block (floor((vis - 1) / bsize), floor division on negatives) +inf.
+pub fn blockMaxima(score: []const f32, width: usize, bsize: usize, vis: i64, out: []f32) void {
+    std.debug.assert(score.len >= width and out.len >= (width + bsize - 1) / bsize);
+    const nb = (width + bsize - 1) / bsize;
+    const t = vis - 1;
+    const last: i64 = if (t >= 0) @divFloor(t, @as(i64, @intCast(bsize))) else -@divFloor(-t + @as(i64, @intCast(bsize)) - 1, @as(i64, @intCast(bsize)));
+    for (0..nb) |b| {
+        var m: f32 = ninf;
+        var nan = false;
+        for (0..bsize) |j| {
+            if (b * bsize + j >= width) break;
+            const x = score[b * bsize + j];
+            if (x != x) nan = true else if (x > m) m = x;
+        }
+        var v: f32 = if (nan) @bitCast(@as(u32, 0x7fc00000)) else m;
+        if (@as(i64, @intCast(b)) == last) v = std.math.inf(f32);
+        out[b] = v;
+    }
+}
+
+/// The top-k of the maxima by the key order (ties to the lower column; k <= nb), ascending columns, a column at or
+/// past `every` as -1. Independent of the kernel's radix select (a sort, the same total order).
+pub fn topCols(bmax: []const f32, every: i64, k: usize, out: []i64) void {
+    std.debug.assert(bmax.len >= k and out.len >= k and k >= 1 and bmax.len <= max_nbk);
+    var keys: [max_nbk]u64 = undefined;
+    var cols: [max_nbk]usize = undefined;
+    for (0..bmax.len) |i| {
+        keys[i] = scoreKey(bmax[i], i);
+        cols[i] = i;
+    }
+    // selection sort of the k largest keys (descending); the keys are unique, so this is stable on columns
+    for (0..k) |n| {
+        var best = n;
+        for (n + 1..bmax.len) |i| {
+            if (keys[i] > keys[best]) best = i;
+        }
+        std.mem.swap(u64, &keys[n], &keys[best]);
+        std.mem.swap(usize, &cols[n], &cols[best]);
+    }
+    // the k largest, columns ascending (the kernel's bitonic sort of the same set)
+    std.mem.sort(usize, cols[0..k], {}, std.sort.asc(usize));
+    for (0..k) |n| {
+        const c: i64 = @intCast(cols[n]);
+        out[n] = if (c < every) c else -1;
+    }
+}
+
+/// The pool pick (tf_ds_pool_pick_kernel's rule): `mask` (if given) is zeroed and each picked block whose maximum is
+/// above -inf sets its byte; `cblk` (if given) lists the block, or -1 when its maximum is not above -inf (a NaN
+/// maximum is not above -inf either). A negative column is not picked (the unfused launch reads bmax before the row
+/// there, unreachable today: every is every_vis).
+pub fn poolPick(bmax: []const f32, idx: []const i64, mask: ?[]u8, cblk: ?[]i32) void {
+    if (mask) |m| @memset(m, 0);
+    for (idx, 0..) |c, j| {
+        const ok = c >= 0 and bmax[@intCast(c)] > ninf;
+        if (mask) |m| {
+            if (ok) m[@intCast(c)] = 1;
+        }
+        if (cblk) |cb| cb[j] = if (ok) @intCast(c) else -1;
+    }
+}
+
+// -- tests -----------------------------------------------------------------------------------------------------------
+
+const expectEqual = std.testing.expectEqual;
+
+test "the switch parses its forms and nothing else" {
+    try expectEqual(false, parse(null).?);
+    try expectEqual(false, parse("").?);
+    try expectEqual(false, parse("0").?);
+    try expectEqual(true, parse("1").?);
+    try expectEqual(@as(?bool, null), parse("2"));
+    try expectEqual(@as(?bool, null), parse("yes"));
+    try expectEqual(@as(?bool, null), parse("01"));
+    try std.testing.expectEqual(@as(bool, true), try fromText("1"));
+    try std.testing.expectError(error.BadIdxFused, fromText("2"));
+}
+
+test "fuseOk takes the pool's bounds" {
+    try std.testing.expect(fuseOk(true, 16, 16392, 8, 2049, 2048)); // the smallest pooled case
+    try std.testing.expect(fuseOk(true, 1, 64, 8, 8, 4));
+    try std.testing.expect(fuseOk(true, 2048, 65536, 8, 8192, 2048)); // the nbk cap, inclusive
+    try std.testing.expect(!fuseOk(true, 16, 65544, 8, 8193, 2048)); // past the cap
+    try std.testing.expect(!fuseOk(false, 16, 16392, 8, 2049, 2048));
+    try std.testing.expect(!fuseOk(true, 0, 16392, 8, 2049, 2048));
+    try std.testing.expect(!fuseOk(true, 16, 16392, 8, 2050, 2048)); // nbk disagrees with width/bsize
+    try std.testing.expect(!fuseOk(true, 16, 16392, 8, 2049, 3000)); // k past the 2048 cap
+    try std.testing.expect(!fuseOk(true, 16, 16392, 8, 2049, 2050)); // k past nbk
+    try std.testing.expect(!fuseOk(true, 16, 16392, 0, 16392, 4));
+    try std.testing.expect(fuseOk(true, 16, 100, 8, 13, 13)); // k == nbk is fine
+    try std.testing.expect(!fuseOk(true, 16, 100, 8, 13, 14)); // k > nbk is not
+}
+
+test "scoreKey matches the -0/+0 rule and orders scores like signed integers" {
+    // +0.0 and -0.0 get the same key modulo the column; a larger score always wins a smaller column
+    const a = scoreKey(5.0, 0);
+    const b = scoreKey(-5.0, 0);
+    try std.testing.expect(a > b);
+    const key_neg_zero = scoreKey(-0.0, 3);
+    const key_pos_zero = scoreKey(0.0, 3);
+    try expectEqual(key_pos_zero, key_neg_zero); // the -0 to +0 rule
+    // an inverted column: a tie breaks to the lower column
+    try std.testing.expect(scoreKey(1.0, 0) > scoreKey(1.0, 1));
+    // NaN above +inf, as the bit order makes it
+    try std.testing.expect(scoreKey(@bitCast(@as(u32, 0x7fc00000)), 1) > scoreKey(std.math.inf(f32), 1));
+    // -inf floor: the smallest key class
+    try std.testing.expect(scoreKey(0.0, 0) > scoreKey(-std.math.inf(f32), 0));
+}
+
+test "blockMaxima: NaN wins, the newest block is pinned, short blocks are padded -inf" {
+    var s = [_]f32{ 1, 2, 3, @as(f32, @bitCast(@as(u32, 0x7fc00000))), -std.math.inf(f32), 4, 5, 6, 7 };
+    var bmax: [3]f32 = undefined;
+    blockMaxima(&s, 9, 4, 100, &bmax); // vis past the row: nothing pinned (100's newest block is 24)
+    try expectEqual(@as(u32, 0x7fc00000), @as(u32, @bitCast(bmax[0]))); // block 0 holds the NaN: it wins
+    try expectEqual(@as(f32, 6), bmax[1]); // islands: idx 4..7 = -inf, 4, 5, 6
+    try expectEqual(@as(f32, 7), bmax[2]); // the short last block (idx 8), padded with -inf
+    // the newest block pinned to +inf whatever its scores
+    blockMaxima(&s, 9, 4, 7, &bmax); // vis = 7: the newest key is 6: block 1 pinned
+    try expectEqual(std.math.inf(f32), bmax[1]);
+    try expectEqual(@as(u32, 0x7fc00000), @as(u32, @bitCast(bmax[0])));
+    // vis at or below 0: t < 0, floor division pins nothing (a negative block index)
+    blockMaxima(&s, 9, 4, 0, &bmax);
+    try expectEqual(@as(f32, 6), bmax[1]);
+}
+
+test "topCols picks the k largest by key, ties to the lower block, every masks the tail" {
+    const bmax = [_]f32{ 1, 2, 2, -std.math.inf(f32), 9, 9, 0, 7 };
+    var out: [3]i64 = undefined;
+    topCols(&bmax, 100, 3, &out);
+    try expectEqual([_]i64{ 4, 5, 7 }, out); // 9, 9, 7 (ties between the two 9s: the lower column first)
+    // every = 5: columns at or past 5 become -1
+    topCols(&bmax, 5, 3, &out);
+    try expectEqual([_]i64{ 4, -1, -1 }, out);
+    // -inf columns rank last (they are still selected when k > the count of finite maxima)
+    const flat = [_]f32{ -std.math.inf(f32), -std.math.inf(f32) };
+    var o2: [2]i64 = undefined;
+    topCols(&flat, 100, 2, &o2);
+    try expectEqual([_]i64{ 0, 1 }, o2);
+}
+
+test "poolPick zeroes the mask, sets picked blocks above -inf, lists -1 otherwise" {
+    const bmax = [_]f32{ 5, -std.math.inf(f32), @bitCast(@as(u32, 0x7fc00000)) };
+    const idx = [_]i64{ 0, 1, 2 };
+    var mask = [_]u8{ 9, 9, 9 };
+    var cblk = [_]i32{ 99, 99, 99 };
+    poolPick(&bmax, &idx, &mask, &cblk);
+    try expectEqual([_]u8{ 1, 0, 0 }, mask); // only block 0 is above -inf; the NaN and -inf blocks are not picked
+    try expectEqual([_]i32{ 0, -1, -1 }, cblk);
+    // a negative column (an every-masked selection) is not picked
+    const idx2 = [_]i64{ -1, 0 };
+    var cblk2 = [_]i32{ 99, 99 };
+    poolPick(&bmax, &idx2, &mask, &cblk2);
+    try expectEqual([_]i32{ -1, 0 }, cblk2);
+}
+
