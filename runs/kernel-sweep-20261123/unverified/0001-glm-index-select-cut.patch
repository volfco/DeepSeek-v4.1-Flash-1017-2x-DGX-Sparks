+  uint p0, top, width, s_stride, i_stride, cut; // cut (GLM_INDEX_CUT): stop the select at a complete radix bin
 };
 
 // Exclusive prefix sum over a 1024-thread threadgroup (32 simdgroups), `part` 32 slots of scratch.
