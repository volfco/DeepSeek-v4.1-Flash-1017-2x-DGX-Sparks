+  threadgroup uint shared_prefix[1], shared_need[1], shared_done[1];
   threadgroup uint counts[32];
   uint prefix = 0, need = a.top;
   if (a.top < a.blocks) {
@@ -386,17 +387,21 @@
       threadgroup_barrier(mem_flags::mem_threadgroup);
       if (t == 0) {
         uint acc = 0, digit = 0;
+        bool full = false;
         for (int d = 255; d >= 0; d--) {
           const uint c = atomic_load_explicit(&hist[d], memory_order_relaxed);
-          if (acc + c >= need) { digit = uint(d); break; }
+          if (acc + c >= need) { digit = uint(d); full = need != 0u && acc + c == need; break; }
           acc += c;
         }
         shared_prefix[0] = prefix | (digit << shift);
         shared_need[0] = need - acc;
+        shared_done[0] = (g.cut != 0u && full) ? 1u : 0u;
       }
       threadgroup_barrier(mem_flags::mem_threadgroup);
       prefix = shared_prefix[0];
       need = shared_need[0];
+      // a complete bin: every key at or above this prefix is taken (`need` is the bin's whole population)
+      if (shared_done[0] != 0u) break;
     }
   }
   // blocks above the threshold key, plus the first `need` equal to it in block order: each thread a run of blocks
