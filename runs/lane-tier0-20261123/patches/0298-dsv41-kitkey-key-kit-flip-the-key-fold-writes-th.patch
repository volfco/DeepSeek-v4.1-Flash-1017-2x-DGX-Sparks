-/// differing).
-fn kitOf(x: f32, j: usize) u64 {
-    return scoreKey(x, j) ^ 0x8000000000000000;
-}
+/// The kit's `_score_keys` key for a score at a column is `kitKey` (above): the follow-up probe row measured it as
