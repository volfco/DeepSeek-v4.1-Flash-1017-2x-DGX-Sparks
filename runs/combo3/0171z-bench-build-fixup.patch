diff --git a/zig/src/native/cuda.zig b/zig/src/native/cuda.zig
index d471ae6..25c2531 100644
--- a/zig/src/native/cuda.zig
+++ b/zig/src/native/cuda.zig
@@ -115,7 +115,7 @@ fn promptCacheBudget(a: Allocator, io: std.Io, gib_opt: ?f64) u64 {
     const base: u64 = @intFromFloat(0.5 * gib);
     if (gib_opt) |g| return @intFromFloat(g * gib);
     const v = getenv("TF_DS_PROMPT_CACHE_AUTO") orelse return base;
-    if (!std.mem.eql(u8, std.mem.span(v), "1") and !std.mem.eql(u8, std.mem.span(v), "on")) return base;
