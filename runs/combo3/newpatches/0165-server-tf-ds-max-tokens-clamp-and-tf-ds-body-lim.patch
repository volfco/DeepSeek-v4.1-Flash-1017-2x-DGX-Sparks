+
+/// The body limit: ``TF_DS_BODY_LIMIT_MB`` (a positive MiB count; unset, non-numeric or 0: the served 32) - 64 MiB
+/// matches Baseten (docs/baseten-ultrafast-plan.md, second pass, section 5.5). Saturating at usize's top.
+pub fn limitOf(mb: ?[:0]const u8) usize {
+    const base = 32 * 1024 * 1024;
+    const v = mb orelse return base;
+    const n = std.fmt.parseInt(usize, std.mem.span(v), 10) catch return base;
+    return if (n >= 1) n *| (1024 * 1024) else base;
+}
