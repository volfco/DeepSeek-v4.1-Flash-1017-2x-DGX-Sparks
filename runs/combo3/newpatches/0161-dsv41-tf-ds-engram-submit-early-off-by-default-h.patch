+/// The rows' hashes with the reach-back ids before them, as a stash keeps them (0161): `pre` is the sequence's ids
+/// before `start` and `ids` the rows' own. Equal to `hasher.hashes(seq, start, ids.len, out)` for the sequence those
+/// came from - pinned by the test below for a start under the reach-back and past it (the shifted scratch's index-0
+/// read and pad rule agrees with the whole sequence's).
+fn stashHash(hasher: engram.Hasher, pre: []const i32, ids: []const i32, out: []i64) void {
+    var scratch: [round.EngramStash.rows_max + engram.max_ngram - 1]i32 = undefined;
+    if (pre.len + ids.len > scratch.len) return;
+    @memcpy(scratch[0..pre.len], pre);
+    @memcpy(scratch[pre.len..][0..ids.len], ids);
+    hasher.hashes(scratch[0 .. pre.len + ids.len], pre.len, ids.len, out);
+}
