+    try std.testing.expect(!en.covers(3, 12, &.{ 7, 8, 9 }, &.{ 100, 101, 102, 200 }));
+    try std.testing.expect(!en.covers(3, 12, &.{ 7, 8, 9 }, &.{ 100, 101, 102, 103, 200 }));
+    // the window starts elsewhere (its stream kept rows since the pass), or is another slot's: not covered
+    try std.testing.expect(!en.covers(3, 13, &.{ 8, 9, 10 }, &.{ 100, 101 }));
+    try std.testing.expect(!en.covers(2, 12, &.{ 7, 8, 9 }, &.{ 100, 101 }));
+    // a released stream's slot refilled at the same lengths: its ids the n-grams reach back to changed
+    try std.testing.expect(!en.covers(3, 12, &.{ 7, 8, 90 }, &.{ 100, 101 }));
+    // and a released slot's entry is dropped at its refill (fillOpen, a follower's fill_begin)
+    var es: [1]EngramStash.Entry = .{en};
+    var st = EngramStash{ .entries = &es };
+    st.drop(3); // past this one-entry stash: no-op
+    st.drop(0);
+    try std.testing.expect(!es[0].covers(3, 12, &.{ 7, 8, 9 }, &.{ 100, 101, 102, 103 }));
+}
+
 fn getenv(name: [*:0]const u8) ?[]const u8 {
     return std.mem.span(std.c.getenv(name) orelse return null);
 }
