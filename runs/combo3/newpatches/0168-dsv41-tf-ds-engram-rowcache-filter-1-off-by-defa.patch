+test "TF_DS_ENGRAM_ROWCACHE_FILTER: a negative takes no lock and every answer is the map's own" {
+    const gpa = std.testing.allocator;
+    const rc = try RowCache.init(gpa, std.testing.io, 1 << 20);
+    defer rc.deinit();
+    rc.filter_on = true;
+    var w: [64]u8 = @splat(7);
+    var out: [64]u8 = undefined;
+    // an uncached row: the filter's negative is final, no lock (the counters show which path ran)
