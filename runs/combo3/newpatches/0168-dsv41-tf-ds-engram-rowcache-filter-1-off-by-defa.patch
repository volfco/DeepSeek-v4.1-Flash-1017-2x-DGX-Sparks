+            h.update(std.mem.asBytes(&key.layer));
+            h.update(std.mem.asBytes(&key.row));
+            const v = h.final();
+            const a: u32 = @intCast(v & mask);
+            const b: u32 = @intCast((v >> 32) & mask);
+            return .{ a, b };
