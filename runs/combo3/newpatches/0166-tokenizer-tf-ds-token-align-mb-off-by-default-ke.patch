+test "TF_DS_TOKEN_ALIGN_MB: a recorded generated spelling wins over the re-encode" {
+    const gpa = std.testing.allocator;
+    var t = try deepseekLike(gpa, &test_words);
+    defer t.deinit();
+    var g = PieceCache.init(std.testing.io, gpa, 1 << 20);
+    defer g.deinit();
+    const generated = try t.encode(gpa, "a long prompt of many tokens");
+    defer gpa.free(generated);
+    t.recordGenerated(&g, generated);
+    // a resent prompt: the piece after the added token carries the reply's bytes and takes the recorded ids
+    const resent = try t.encodeWith(gpa, "<｜User｜>a long prompt of many tokens", .{ .generated = &g });
+    defer gpa.free(resent);
+    try std.testing.expect(g.hits > 0);
+    try std.testing.expectEqualSlices(u32, generated, resent[1..]); // the added token's id, then the record
+    // text that carries none of it encodes as before
+    const other = try t.encodeWith(gpa, "<｜User｜>a short prompt", .{ .generated = &g });
+    defer gpa.free(other);
+    const cold = try t.encode(gpa, "<｜User｜>a short prompt");
+    defer gpa.free(cold);
+    try std.testing.expectEqualSlices(u32, cold, other);
+}
+
+test "a recorded spelling's key carries the plain mark, as a resent prompt's piece does" {
+    const gpa = std.testing.allocator;
+    var t = try deepseekLike(gpa, &test_words);
+    defer t.deinit();
+    var g = PieceCache.init(std.testing.io, gpa, 1 << 20);
+    defer g.deinit();
+    // the model emitted the added token's spelling mid-reply; the record's key is maskAdded's, and the resent
+    // piece carries the same marks (0028 masks a client's text before the render)
+    const generated = try t.encode(gpa, "say<｜User｜>now");
+    defer gpa.free(generated);
+    t.recordGenerated(&g, generated);
+    const marked = (try t.maskAdded(gpa, "say<｜User｜>now")).?;
+    defer gpa.free(marked);
+    const whole = try std.mem.concat(gpa, u8, &.{ "<｜User｜>", marked });
+    defer gpa.free(whole);
+    const resent = try t.encodeWith(gpa, whole, .{ .generated = &g });
+    defer gpa.free(resent);
+    try std.testing.expect(g.hits > 0);
+    try std.testing.expectEqualSlices(u32, generated, resent[1..]);
+}
