@@ -42,6 +42,21 @@ pub fn gibs(bytes: u64) f64 {
     return @as(f64, @floatFromInt(bytes)) / GiB;
 }
 
+/// The CUDA path's auto budget (TF_DS_PROMPT_CACHE_AUTO, 0170): what 70% of RAM leaves past the loaded server, at
+/// least `floor` (the served 0.5 GiB default - auto can grow the cache where the machine has real room, never
+/// shrink it). The pair's unified memory is nearly all weights, so there auto stays at the floor.
+pub fn autoBudget(total: u64, ready: u64, floor: u64) u64 {
+    const f = fit(total, ready, null, false) catch return floor;
+    return @max(floor, f.budget);
+}
+
+test "the CUDA auto budget grows only past the floor" {
+    const floor = GiB / 2;
+    try std.testing.expectEqual(GiB / 2, autoBudget(128 * GiB, 110 * GiB, floor)); // the pair: no room past the weights, the floor
+    try std.testing.expectEqual((256 * GiB) / 100 * 70 - 174 * GiB, autoBudget(256 * GiB, 172 * GiB, floor)); // the M5: grows
+    try std.testing.expectEqual(GiB / 2, autoBudget(64 * GiB, 63 * GiB, floor)); // past the cap: the floor, never less
+}
