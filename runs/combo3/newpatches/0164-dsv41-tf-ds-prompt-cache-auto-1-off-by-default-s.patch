+/// The kept prompt states' budget: `--prompt-cache-gib` when given (0: none; past the room kept or refused as the
+/// flag says); else the served 0.5 GiB; with TF_DS_PROMPT_CACHE_AUTO=1 ("1" or "on") what 70% of RAM leaves past the
+/// loaded server (cache_fit, the sizing --prompt-cache-gib's comment promises) - read after the weights land, never
+/// below 0.5 GiB: auto grows the cache where the machine has real room and never shrinks it (0170).
+fn promptCacheBudget(a: Allocator, io: std.Io, gib_opt: ?f64) u64 {
+    const base: u64 = @intFromFloat(0.5 * gib);
+    if (gib_opt) |g| return @intFromFloat(g * gib);
+    const v = getenv("TF_DS_PROMPT_CACHE_AUTO") orelse return base;
+    if (!std.mem.eql(u8, std.mem.span(v), "1") and !std.mem.eql(u8, std.mem.span(v), "on")) return base;
+    const text = procText(a, io, "/proc/meminfo") orelse return base;
+    const info = budget.meminfo(text) orelse return base;
+    return cache_fit.autoBudget(info.total, info.total -| info.available, base);
+}
