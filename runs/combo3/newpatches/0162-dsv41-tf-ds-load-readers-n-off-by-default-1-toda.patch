+test "TF_DS_LOAD_READERS: splitRegions is contiguous, covering and 4 KiB-aligned at any reader count" {
+    var regions: [8][2]usize = undefined;
+    for ([_]usize{ 1, 2, 3, 5, 8 }) |n| {
+        splitRegions(regions[0..n], 100 << 20, n);
+        var at: usize = 0;
+        for (regions[0..n]) |r| {
+            try std.testing.expectEqual(at, r[0]); // contiguous, no gap or overlap
+            try std.testing.expectEqual(@as(usize, 0), r[0] % dio.alignment);
+            try std.testing.expectEqual(@as(usize, 0), r[1] % dio.alignment);
+            try std.testing.expect(r[0] <= r[1]);
+            at = r[1];
+        }
+        try std.testing.expectEqual(@as(usize, 100 << 20), at); // covering
+    }
+    // a total under the alignment spread leaves empty regions but stays aligned and covering
+    splitRegions(regions[0..8], 2 * dio.alignment, 8);
+    try std.testing.expectEqual(@as(usize, 0), regions[0][0]);
+    try std.testing.expectEqual(@as(usize, 2 * dio.alignment), regions[7][1]);
+    for (regions[0..8]) |r| try std.testing.expect(r[1] - r[0] <= 2 * dio.alignment);
+}
