+/// TF_DS_LOAD_READERS=N (1..8; unset, non-numeric or out of range: 1) - how many parallel O_DIRECT readers fill a
+/// span (0162). 1 is the old serial readWhole, byte for byte.
+fn readers() usize {
+    const v = std.c.getenv("TF_DS_LOAD_READERS") orelse return 1;
+    const n = std.fmt.parseInt(usize, std.mem.span(v), 10) catch return 1;
+    return if (n >= 1 and n <= 8) n else 1;
+}
+
+/// The buffer's `n` regions as [lo, hi) byte ranges, every boundary a multiple of `dio.alignment` so each reader's
+/// own reads stay aligned: contiguous and covering, a region empty when the total is under n * alignment.
+fn splitRegions(out: [][2]usize, total: usize, n: usize) void {
+    for (0..n) |i| {
+        const lo = std.mem.alignBackward(usize, total * i / n, dio.alignment);
+        const hi = if (i + 1 == n) total else std.mem.alignBackward(usize, total * (i + 1) / n, dio.alignment);
+        out[i] = .{ lo, hi };
+    }
+}
+
+/// readWhole from up to `n` threads over the disjoint regions of `buf` (TF_DS_LOAD_READERS > 1, 0162): the O_DIRECT
+/// preads queue side by side on the file instead of one at a time. `f.read` is one positional pread, safe on a
+/// shared fd; a spawn failure reads that region on this thread. The bytes and the buffer are readWhole's own.
+fn readWholeParallel(f: dio.File, buf: dio.Buffer, base: u64, piece: usize, n: usize) !void {
+    const Args = struct {
+        f: dio.File,
+        buf: dio.Buffer,
+        base: u64,
+        piece: usize,
+        lo: usize,
+        hi: usize,
+        err: ?anyerror = null,
+        fn run(a: *@This()) void {
+            // the region's start is a dio.alignment multiple (splitRegions), so the cast keeps readWhole's promise
+            readWhole(a.f, @alignCast(a.buf[a.lo..a.hi]), a.base + a.lo, a.piece) catch |err| {
+                a.err = err;
+            };
+        }
+    };
+    var regions: [8][2]usize = undefined;
+    splitRegions(regions[0..n], buf.len, n);
+    var args: [8]Args = undefined;
+    var threads: [8]?std.Thread = @splat(null);
+    for (regions[0..n], 0..) |r, i| {
+        args[i] = .{ .f = f, .buf = buf, .base = base, .piece = piece, .lo = r[0], .hi = r[1] };
+        if (r[0] >= r[1]) continue;
+        threads[i] = std.Thread.spawn(.{}, Args.run, .{&args[i]}) catch null;
+    }
+    var failed: ?anyerror = null;
+    for (0..n) |i| {
+        if (threads[i]) |t| t.join() else args[i].run();
+        if (args[i].err) |err| failed = failed orelse err;
+    }
+    if (failed) |err| return err;
+}
