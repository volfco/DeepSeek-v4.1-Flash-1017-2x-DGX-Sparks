+/// 0177 (TF_DS_DRAFT_TRIAGE): `conf:<t>` marks the draft rows whose chain survival is under `t` dead (they route
+/// nothing and the host treats them as rejected); `file:<path>` is the trained probe's hook - the probe study's
+/// weights do not exist, so the value refuses with its named error (the format is the patch's commit body).
+/// Unset, `0` or `off`: the engine as it was. A malformed value refuses the start.
+fn parseTriage(v: ?[]const u8) !?f64 {
+    const s = std.mem.trim(u8, v orelse return null, " \t\r\n");
+    if (s.len == 0 or std.mem.eql(u8, s, "0") or std.mem.eql(u8, s, "off")) return null;
+    if (std.mem.startsWith(u8, s, "conf:")) {
+        const t = std.fmt.parseFloat(f64, s["conf:".len..]) catch return error.BadDraftTriage;
+        return if (t > 0 and t < 1) t else error.BadDraftTriage;
+    }
+    if (std.mem.startsWith(u8, s, "file:")) return error.TriageProbeUnsupported;
+    return error.BadDraftTriage;
+}
