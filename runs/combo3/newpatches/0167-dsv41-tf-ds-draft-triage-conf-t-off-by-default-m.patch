+/// 0177 (TF_DS_DRAFT_TRIAGE): the rows the conf rule keeps - the pending row plus the drafts whose chain survival
+/// stays at or over `t`; the tail under it is dead (prefix-closed, as the chain is).
+pub fn triageLive(conf: []const f32, t: f64) usize {
+    var sv: [draft.max_block]f64 = undefined;
+    const n = @min(conf.len, sv.len);
+    survivals(conf[0..n], sv[0..n]);
+    var k: usize = 0;
+    while (k < n and sv[k] >= t) : (k += 1) {}
+    return 1 + k;
+}
