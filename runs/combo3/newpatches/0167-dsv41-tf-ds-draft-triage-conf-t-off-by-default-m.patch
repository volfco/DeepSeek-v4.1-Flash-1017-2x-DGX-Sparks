+extern "C" __global__ void tf_ds_dead_rows_kernel(int* pick, float* wts, const unsigned char* dead, int rows, int slots, int pdl) {
+    pdl_enter(pdl);
+    const int r = blockIdx.x * blockDim.x + threadIdx.x;
+    if (r < rows && dead[r]) {
+        for (int i = 0; i < slots; ++i) { pick[r * slots + i] = -1; wts[r * slots + i] = 0.f; }
+    }
+}
