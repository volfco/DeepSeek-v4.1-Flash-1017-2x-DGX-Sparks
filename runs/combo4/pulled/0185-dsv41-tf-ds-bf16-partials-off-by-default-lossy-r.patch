+/// TF_DS_BF16_PARTIALS runs where the partial is exchanged rather than copied: two or more ranks, and not the four-node
+/// 2D split (whose partials are the pair's own columns). LOSSY; this only says where it can apply.
+pub fn bf16PartialsWork(world: usize, two: bool) bool {
+    return world >= 2 and !two;
+}
+
+/// The attention partial's gather: the ranks' bf16 partials when TF_DS_BF16_PARTIALS is on (the payload halves),
+/// fp32 otherwise. The bf16 payload is widened where the mixes read it (ffnMixes), so ga means the same either way.
+pub fn gatherPartial(e: *const Engine, ch: *const Chunk) !void {
+    if (ch.pb == 0) return gather(e, ch, ch.pa, ch.ga);
+    try e.comm.allGather(ch.pb, ch.gb, ch.n * e.c.hidden, .bf16, e.s);
+}
