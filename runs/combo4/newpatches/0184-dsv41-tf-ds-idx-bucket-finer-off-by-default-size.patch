@@ -55,6 +55,20 @@ pub fn bucketFor(n: usize, cap: usize) usize {
     return @min(b, @max(cap, bucket_min));
 }
 
+/// TF_DS_IDX_BUCKET_FINER: the round's bucket, rounded up to a multiple of `gran` instead of to the next power of two,
+/// so the indexer's work sizes to the context (70K positions are 69 blocks of 1024, not 131072 keys).
+pub const bucket_finer_env = "TF_DS_IDX_BUCKET_FINER";
+/// Finer buckets' granularity: bucket_min (1024 keys), which keeps the bucket a whole number of the indexer's 64-key
+/// tiles and of the candidate pool's blocks (indexKeys, candFast, blockMax) at every ratio.
+pub const bucket_gran = bucket_min;
+
+/// TF_DS_IDX_BUCKET_FINER's bucket: `n` rounded up to a multiple of `gran` (at least bucket_min), never past bucketFor's
+/// own bucket - every buffer is sized for that one, and the finer bucket is always at or under it.
+pub fn bucketFiner(n: usize, cap: usize, gran: usize) usize {
+    const b = std.mem.alignForward(usize, @max(n, bucket_min), gran);
+    return @min(b, bucketFor(n, cap));
+}
+
