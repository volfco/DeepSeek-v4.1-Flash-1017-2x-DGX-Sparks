+test "a stream's drafts stop at its last grant plus the slack (the shipped node-probability rule)" {
+    const gpa = std.testing.allocator;
+    var fc: Table = .{};
+    defer fc.deinit(gpa);
+    const served = [_]f64{ 25.72, 28.72, 31.72, 33.38, 34.29, 35.17 };
+    for (served, 1..) |ms, w| try fc.put(gpa, @intCast(w), ms);
+    const shared: Table = .{};
+    const prior = [_]f64{ 0.9, 0.9, 0.9, 0.9, 0.9 };
+    var rule: Rule = .{ .gpa = gpa, .prior = &prior, .most_drafts = 5, .family_costs = &fc, .shared_costs = &shared, .mtp_step_ms = 0.5, .plain_guard = false, .node_probabilities = true, .batch_rows = 8 };
+    defer rule.deinit();
+    var st: ?State = null;
+    defer if (st) |*s| s.deinit(gpa);
+    // the shipped configuration is node probabilities (drafting), so budgets caps each stream at its last grant plus
+    // the slack: the chain never runs past what the last shared round would use, whatever the largest budget is
+    for ([_]?u32{ null, 0, 1, 3, 9 }) |granted| {
+        const who: Who = .{ .state = &st, .draft_room = 160, .finished = false, .forced = false, .granted = granted };
+        var whos = [_]Who{ who, who };
+        var out: [2]i64 = undefined;
+        try rule.budgets(&whos, noCopy, &out);
+        const cap: i64 = if (granted) |g| @as(i64, g) + rule.k.draft_slack else rule.most_drafts;
+        for (out) |d| try std.testing.expect(d >= 1 and d <= cap);
+    }
+}
