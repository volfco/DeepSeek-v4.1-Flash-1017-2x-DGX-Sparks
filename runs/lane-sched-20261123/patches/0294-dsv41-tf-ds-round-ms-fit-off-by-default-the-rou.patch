+#!/usr/bin/env python3
+"""Re-fit the served ROUND_MS table from the trace's per-layer model (0294).
+
+Input: layer_fit.txt (runs/trace-review-20261123/out/layer_fit.txt in the main checkout): per layer, the
+producer interval at 6 rows (us) and its slope (us/row), least squares on rows 2-7, ranks pooled, one column
+group per traced arm (fx1L, fx1Lb, np1L, ns1L; runs/sched-20261122/b2/mech/). The forward of an r-row round is
+the sum over the 40 target layers of (attn@6 + moe@6) + (r - 6) * (attn slope + moe slope): that is the table
+this prints, rows 1..24, at the live shape the trace ran (the 2x-DGX-Spark pair, ranks pooled).
+
+usage: python3 tools/round_fit.py <layer_fit.txt> [--variant fx1L] [--rows 24]
+
+The output is the residual evidence for tools/round_fit_residuals.txt: the per-variant coefficients, the zig
+literal for the shipped table, and residuals against (1) the served round_ms (draft.zig) and (2) the live round
+walls recorded in todo.md:714. The walls minus the fitted forward are the round's non-forward share (host,
+absorb, sampling, the streams' share): the rows-only table cannot carry a stream-count term (depth.zig's
+Rule.overhead prices "a shared round's ms past its forward, by streams"), which is why the two wall anchors
+imply different constants.
+"""
+import re
+import sys
+
+# the served table (draft.zig round_ms) and the live walls (todo.md:714; runs/overnight-20261122 provenance)
+SERVED = [30.0, 35.2, 39.9, 44.9, 48.6, 52.1, 55.6, 59.1, 62.7, 66.3, 69.6, 72.9,
+          75.5, 78.2, 81.3, 84.4, 87.5, 90.6, 93.7, 96.8, 99.9, 103.0, 106.1, 109.2]
+WALLS = [  # (rows, streams, wall ms, source)
+    (16, 8, 91.7, "todo.md:714 (the live eight-stream round)"),
+    (20, 4, 87.0, "todo.md:714 (the measured four-stream round, ~87)"),
+]
+
+def main():
+    args = sys.argv[1:]
+    if not args:
+        sys.exit(__doc__)
+    path, variant, nrows = args[0], "fx1L", 24
+    i = 1
+    while i < len(args):
+        if args[i] == "--variant":
+            variant, i = args[i + 1], i + 2
+        elif args[i] == "--rows":
+            nrows, i = int(args[i + 1]), i + 2
+        else:
+            sys.exit(f"unknown arg: {args[i]}")
+    names, layers, footer = [], [], {}
+    header = ""
+    for line in open(path):
+        s = line.strip()
+        if not s:
+            continue
+        if s.startswith("#"):
+            m = re.match(r"# (\w+): sum over layers at 6 rows: attention ([\d.]+) ms, MoE ([\d.]+) ms;"
+                         r" MoE slope sum ([\d.]+) us/row, attention slope sum ([\d.]+) us/row", s)
+            if m:
+                footer[m.group(1)] = tuple(float(m.group(k)) for k in (2, 3, 4, 5))
+            continue
+        if not header:
+            header = s
+            names = re.findall(r"(\w+) attn@6", header)
+            continue
+        v = []
+        for x in s.split():
+            try:
+                v.append(float(x))
+            except ValueError:
+                pass  # trailing layer tags: "engram", "kv"
+        layers.append(v[1:])  # drop the layer index: per variant, attn@6 slope moe@6 slope places/row
+    if not names or not layers:
+        sys.exit(f"no per-layer rows found in {path}")
+    if variant not in names:
+        sys.exit(f"variant {variant} not in {names}")
+    vi = names.index(variant)
+    col = [row[vi * 5:vi * 5 + 5] for row in layers]
+    attn6 = sum(r[0] for r in col) / 1000.0
+    attn_slope = sum(r[1] for r in col) / 1000.0
+    moe6 = sum(r[2] for r in col) / 1000.0
+    moe_slope = sum(r[3] for r in col) / 1000.0
+    f = footer.get(variant)
+    if f:  # the file's own footer cross-checks the sums
+        assert abs(f[0] - attn6) < 0.01 and abs(f[1] - moe6) < 0.01, f
+        assert abs(f[2] - moe_slope * 1000) < 0.5 and abs(f[3] - attn_slope * 1000) < 0.5, f
+    slope = attn_slope + moe_slope
+    at6 = attn6 + moe6
+
+    def fwd(r):
+        return at6 + (r - 6) * slope
+
+    print(f"# 0294 round_ms re-fit: layer_fit.txt = {path}")
+    print(f"# layers {len(layers)}, variants {names}, shipped variant {variant} (ranks pooled, least squares rows 2-7)")
+    for n in names:
+        c = [row[names.index(n) * 5:names.index(n) * 5 + 5] for row in layers]
+        a6 = sum(r[0] for r in c) / 1000.0
+        m6 = sum(r[2] for r in c) / 1000.0
+        sl = (sum(r[1] for r in c) + sum(r[3] for r in c)) / 1000.0
+        print(f"# {n}: forward at 6 rows {a6 + m6:.3f} ms (attention {a6:.3f} + MoE {m6:.3f}), slope {sl:.4f} ms/row")
+    print(f"# zig literal (rows 1..{nrows}), round_ms_fit:")
+    vals = [round(fwd(r), 1) for r in range(1, nrows + 1)]
+    print("pub const round_ms_fit = [_]f64{ " + ", ".join(f"{v}" for v in vals) + " };")
+    print("# residuals: fitted forward vs the served round_ms (draft.zig) and the live round walls (todo.md:714)")
+    print("# rows  fitted  served  fit-served")
+    for r in range(1, nrows + 1):
+        print(f"# {r:4d}  {fwd(r):6.2f}  {SERVED[r - 1]:6.1f}  {fwd(r) - SERVED[r - 1]:+8.2f}")
+    print(f"# the served table sits {SERVED[5] - fwd(6):.1f} ms over the forward at 6 rows and"
+          f" {SERVED[23] - fwd(24):.1f} over at 24 (a near-constant wall/forward gap; its own slope"
+          f" {SERVED[23] - SERVED[22]:.1f} vs the trace's {slope:.2f} ms/row)")
+    for rows, streams, wall, src in WALLS:
+        print(f"# wall {wall} ms at {rows} rows / {streams} streams ({src}): wall - fitted = {wall - fwd(rows):+.1f} ms"
+              f" (the non-forward share), wall - served = {wall - SERVED[rows - 1]:+.1f} ms")
+    print(f"# the two walls imply {WALLS[0][2] - fwd(WALLS[0][0]):.1f} and {WALLS[1][2] - fwd(WALLS[1][0]):.1f} ms"
+          f" of non-forward share at 8 and 4 streams: the stream-count term a rows-only table cannot carry"
+          f" (depth.zig Rule.overhead). The shipped table is the forward (draft.zig's contract: a round's forward"
+          f" ms by its rows).")
+
+if __name__ == "__main__":
+    main()
