+++ b/zig/src/families/dsv41/draft.zig
@@ -1005,6 +1005,24 @@ pub fn passSteps(n_streams: usize, slots: usize, drafts: usize, round_rows: usiz
 
 /// The served ROUND_MS table (TF_DS_ROUND_MS unset): a round's forward ms by its rows, and DRAFT_MS.
 pub const round_ms = [_]f64{ 30.0, 35.2, 39.9, 44.9, 48.6, 52.1, 55.6, 59.1, 62.7, 66.3, 69.6, 72.9, 75.5, 78.2, 81.3, 84.4, 87.5, 90.6, 93.7, 96.8, 99.9, 103.0, 106.1, 109.2 };
+
+/// TF_DS_ROUND_MS_FIT=1 (off by default; Model.open's choice of table): the round table re-fit from the trace's
+/// per-layer model at the live shape (runs/trace-review-20261123/out/layer_fit.txt, fx1L, ranks pooled, 40 target
+/// layers): a round's forward ms by its rows, (attn@6 + moe@6) + (rows - 6) * slope = 34.656 ms at 6 rows and
+/// 3.1536 ms a row. Residuals and the other arms' variants: tools/round_fit.py and tools/round_fit_residuals.txt.
+/// It is the forward (this table's contract); the served round_ms sits a near-constant 17-19 ms over it (the wall
+/// share) and the live walls imply 8-26 ms of non-forward share by stream count, which a rows-only table cannot
+/// carry (depth.zig's Rule.overhead prices "a shared round's ms past its forward, by streams"). The replay tools
+/// (chooseK) keep the served table: the recordings priced rounds with it.
+pub const round_ms_fit = [_]f64{ 18.9, 22.0, 25.2, 28.3, 31.5, 34.7, 37.8, 41.0, 44.1, 47.3, 50.4, 53.6, 56.7, 59.9, 63.0, 66.2, 69.3, 72.5, 75.7, 78.8, 82.0, 85.1, 88.3, 91.4 };
+
+test "round_ms_fit is the trace's forward model at rows 1..24" {
+    try std.testing.expectEqual(round_ms.len, round_ms_fit.len);
+    // 34.656 ms at 6 rows, 3.1536 ms a row (tools/round_fit_residuals.txt), to 0.1 ms
+    try std.testing.expectEqual(@as(f64, 34.7), round_ms_fit[5]);
+    try std.testing.expectEqual(@as(f64, 91.4), round_ms_fit[23]);
+    for (1..round_ms_fit.len) |i| try std.testing.expect(round_ms_fit[i] > round_ms_fit[i - 1]);
+}
 pub const draft_ms: f64 = 3.5;
 
