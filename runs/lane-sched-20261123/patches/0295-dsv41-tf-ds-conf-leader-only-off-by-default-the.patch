@@ -1999,15 +2002,22 @@ pub const Model = struct {
         }
     }
 
+    /// TF_DS_ENGRAM_SUBMIT_EARLY (0161): whether stashPass reads a pass's draft ids on the host (its gate below: the
+    /// stash's rows hashed through the AIO ring's tables) - the drafter pass reads the ids back for it (its want_drafts).
+    fn stashWants(m: *const Model) bool {
+        const eh = if (m.eh) |*x| x else return false;
+        return m.rd.esh.enabled and eh.aio != null;
+    }
+
     /// TF_DS_ENGRAM_SUBMIT_EARLY (0161): the drafter pass's return hashes each stream's next window rows - the
     /// pending token and the drafts it holds (depths[i]; a follower passes the batch's steps: the same superset or
     /// longer) - into the round's Engram stash (rd.esh, keyed by pool slot), so the round's start can flatten and
     /// submit them for the windows the stash covers (round.forward), the hashing off the round's critical path.
     /// No-op without the switch, the Engram tables or the AIO ring (the pool fallback has nothing to move).
     pub fn stashPass(m: *Model, seqs: []const []const i32, tokens: []const i64, q0: []const i64, slots: []const i64, depths: []const usize, drafts: []const [draft.max_block]i64) void {
+        if (!m.stashWants()) return;
         const st = &m.rd.esh;
-        const eh = if (m.eh) |*x| x else return;
-        if (!st.enabled or eh.aio == null) return;
+        const eh = &m.eh.?;
         const hasher = eh.hasher;
         const per = hasher.layers * hasher.cols();
         const back = hasher.ngram - 1; // the ids before a row its n-grams reach back to
