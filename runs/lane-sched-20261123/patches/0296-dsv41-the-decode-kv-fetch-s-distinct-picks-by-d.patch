+/// 0296 (the round profile): one decode fetch's distinct picks across the window's rows, for the tally by depth
+/// (PickUnions). The count runs on the fetch's own stream with the prompt union's kernels: the marks (ch.sf_cum,
+/// zeroed here in the stream's order) marked and scanned, the count left in ch.sf_sums at its last entry. A fetch of
+/// a selection counted already this round (a run's later layers: the same FetchKey) copies that count instead of
+/// recounting. Counts only, best-effort: a failed count leaves the slot empty and the tally skips it.
+fn pickUnionNote(e: *const Engine, rd: *Round, idx: u64, kk: usize, li: usize) void {
+    const u = &rd.pick_unions;
+    if (!u.on or kk == 0 or li >= u.host.len) return;
+    const bucket = rd.bucket;
+    if (u.marks == 0 or bucket == 0 or bucket > u.mark_rows) return;
+    const key: FetchKey = .{ .src = rd.cur_src, .idx = rd.idx_layer, .kk = kk };
+    const fresh = if (u.key) |k| !k.eql(key) else true;
+    u.key = key;
+    const dst = u.slots + li * @sizeOf(PickUnions.Slot);
+    u.host[li] = .{ .count = 0, .kk = @intCast(kk) };
+    prompt.upload(e, dst, &u.host[li], @sizeOf(PickUnions.Slot)) catch return;
+    if (fresh) {
+        u.fresh = li;
+        e.d.check(e.d.api.cuMemsetD32Async(u.marks, 0, bucket, e.s.handle), "cuMemsetD32Async") catch return;
+        shard_ops.unionCount(&e.kv.?.k, e.s, idx, kk, kk, rd.r, u.marks, bucket, u.sums) catch return;
+        e.d.check(e.d.api.cuMemcpyDtoDAsync_v2(dst, u.sums + shard_ops.scan_segs * 4, 4, e.s.handle), "cuMemcpyDtoDAsync") catch return;
+    } else {
+        e.d.check(e.d.api.cuMemcpyDtoDAsync_v2(dst, u.slots + u.fresh * @sizeOf(PickUnions.Slot), 4, e.s.handle), "cuMemcpyDtoDAsync") catch return;
+    }
+}
+
+/// 0296: the distinct-picks-by-depth line (one line a run, cumulative since process start like the profile's). The
+/// gate for a decode union fetch: distinct / picks under a half at depth 32768 and 131072 (the band's lower bound is
+/// the round's context bucket at bucketFor's powers of two), runs/trace-review-20261123/RESULTS.md section 4.
+pub fn printPickUnions(rd: *const Round, w: anytype, rank: u32) !void {
+    const u = &rd.pick_unions;
+    var fetches: u64 = 0;
+    var picks: u64 = 0;
+    var distinct: u64 = 0;
+    for (u.bands) |b| {
+        fetches += b.fetches;
+        picks += b.picks;
+        distinct += b.distinct;
+    }
+    try w.print("{{\"rank\": {d}, \"kv_pick_union\": {{\"fetches\": {d}, \"picks\": {d}, \"distinct\": {d}, \"by_depth\": [", .{ rank, fetches, picks, distinct });
+    var first = true;
+    for (u.bands, 0..) |b, i| {
+        if (b.fetches == 0) continue;
+        try w.print("{s}{{\"depth\": {d}, \"fetches\": {d}, \"picks\": {d}, \"distinct\": {d}}}", .{ if (first) "" else ", ", @as(usize, 1) << @intCast(i), b.fetches, b.picks, b.distinct });
+        first = false;
+    }
+    try w.print("]}}}}", .{});
+}
