+test "pick unions: a round's fetched slots tally by the depth band of its bucket" {
+    var u: PickUnions = .{};
+    u.host = try std.testing.allocator.alloc(PickUnions.Slot, 3);
+    defer std.testing.allocator.free(u.host);
+    u.host[0] = .{ .count = 512, .kk = 512 };
+    u.host[1] = .{}; // no fetch at that layer
+    u.host[2] = .{ .count = 300, .kk = 256 };
+    u.tally(32768, 4);
+    const b = u.bands[PickUnions.bandOf(32768)];
+    try std.testing.expectEqual(@as(u64, 2), b.fetches);
+    try std.testing.expectEqual(@as(u64, 4 * (512 + 256)), b.picks);
+    try std.testing.expectEqual(@as(u64, 812), b.distinct);
+    try std.testing.expectEqual(@as(u64, 0), u.bands[0].fetches);
+    // a second round at another depth lands in its own band
+    u.tally(131072, 2);
+    try std.testing.expectEqual(@as(u64, 2), u.bands[PickUnions.bandOf(131072)].fetches);
+    try std.testing.expectEqual(@as(u64, 2), b.fetches);
+}
+
+test "pick unions: the depth band is the bucket's floor log2" {
+    try std.testing.expectEqual(@as(usize, 15), PickUnions.bandOf(32768));
+    try std.testing.expectEqual(@as(usize, 17), PickUnions.bandOf(131072));
+    try std.testing.expectEqual(@as(usize, 14), PickUnions.bandOf(30000)); // TF_DS_IDX_BUCKET_FINER's finer buckets land below
+    try std.testing.expectEqual(@as(usize, 10), PickUnions.bandOf(1024));
+}
