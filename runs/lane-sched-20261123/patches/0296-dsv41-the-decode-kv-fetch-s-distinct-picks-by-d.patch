 /// place at their fixed size (one NCCL group). The same schedule on both ranks whoever holds the rows, every buffer
 /// the round's own (graph-safe); each row reads the replicated bytes in the replicated order (shard.zig's and
 /// shard_ring.zig's tests).
+/// 0296 (the round profile, TF_DS_ROUND_PROFILE): the decode fetch's distinct picks across the window's rows - the
+/// row count a decode KV union fetch would carry instead of rows * kk - tallied by the round's depth (its context
+/// bucket). Instrumentation only: counts, one line a run (printPickUnions), invisible to every output and to no
+/// schedule decision. The count is the prompt union's own (shard_ops.unionCount, shard.UnionRef's host model), kept
+/// on the device and read back after the round's own sync (Model.tallyPickUnions), the ring probes' pattern.
+pub const PickUnions = struct {
+    /// One fetch's record: the distinct picks its count found (0: the round fetched nothing at this layer) and its kk.
+    pub const Slot = struct { count: i32 = 0, kk: u32 = 0 };
+    /// A depth band's sums: the fetches at it, the picks they carried (rows x kk, summed) and their distinct picks.
+    pub const Band = struct { fetches: u64 = 0, picks: u64 = 0, distinct: u64 = 0 };
+    pub const bands_len: usize = 32;
+
+    on: bool = false, // the round profile's own gate (Model.useClock); off: nothing runs and nothing allocates
+    marks: u64 = 0, // ch.sf_cum (int32 [mark_rows]): the union's marks, the prompt fetch's own buffer
+    mark_rows: usize = 0, // its rows; a round's bucket past them skips the count (no room to mark)
+    sums: u64 = 0, // ch.sf_sums (int32 [scan_segs + 1]): where unionCount leaves the count for the tally
+    slots: u64 = 0, // Slot [layers] on the device, zeroed at every round's start (forward)
+    host: []Slot = &.{}, // the same records on the host (the HtoD source at a fetch, the DtoH target at the tally)
+    key: ?FetchKey = null, // the selection counted already this round; a later fetch of it copies the count
+    fresh: usize = 0, // the slot of the round's last fresh count (the copy source)
+    bands: [bands_len]Band = @splat(.{}),
+
+    /// The depth band (floor log2) of a round's context bucket; bucketFor's buckets are exact powers of two, so the
+    /// band's lower bound is the bucket itself at the go/no-go depths (32K: 15, 128K: 17).
+    pub fn bandOf(bucket: usize) usize {
+        return @min(bands_len - 1, 63 - @as(usize, @clz(@as(u64, bucket | 1))));
+    }
+
+    /// The round's fetched slots into their depth band: a slot with count 0 (no fetch there) is skipped.
+    pub fn tally(u: *PickUnions, bucket: usize, rows: usize) void {
+        for (u.host) |s| {
+            if (s.count <= 0) continue;
+            const kk: usize = s.kk;
+            const b = &u.bands[bandOf(bucket)];
+            b.fetches += 1;
+            b.picks += rows * kk;
+            b.distinct += @intCast(s.count);
+        }
+    }
+};
