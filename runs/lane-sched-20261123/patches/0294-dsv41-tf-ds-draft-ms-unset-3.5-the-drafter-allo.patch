             var window_ok = kk + 1 == ids.len;
             if (window_ok) for (1..ids.len) |j| {
                 if (ids[j] != dr.drafts[0][j - 1]) window_ok = false;
@@ -1302,7 +1302,7 @@ fn runDrafted(run: *Run, eng: *const prompt.Engine, ch: *prompt.Chunk, caches: *
                     try w_out.flush();
                     return false;
                 }
-                const kk = draft_mod.chooseK(dr.confs[di][0..steps], @min(st.want, steps), nl, most, R_max);
+                const kk = draft_mod.chooseK(dr.confs[di][0..steps], @min(st.want, steps), nl, most, R_max, try draft_mod.draftMsFromEnv());
                 for (0..kk) |jj| st.win[1 + jj] = dr.drafts[di][jj];
                 st.n = 1 + kk;
                 di += 1;
