+            .solo_head_overhead_ms = if (drafting and self.solo_overhead) self.m.draft_ms else null, // opt-in: the Python engine's fixed draft allowance
             .allocate_learned = self.allocate_learned,
             .draft_cal = self.draft_cal,
             .cal_log = self.cal_log,
diff --git a/zig/src/families/dsv41/layer_main.zig b/zig/src/families/dsv41/layer_main.zig
