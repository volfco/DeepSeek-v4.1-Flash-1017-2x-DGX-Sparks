             const emitted: usize = @intCast(pos[0] - @as(i64, @intCast(prompt_len)) + 1);
             const cap_k = @min(draft_mod.depth(1, most, R_max), drafts -| emitted);
-            const kk = draft_mod.chooseK(dr.confs[0][0..steps], @min(cap_k, steps), 1, most, R_max);
