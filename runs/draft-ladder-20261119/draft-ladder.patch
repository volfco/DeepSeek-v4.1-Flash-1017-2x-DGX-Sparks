+    try eq(@as(usize, 5), passDrafts(6, 5, 8, 4, 3)); // four streams
+    try eq(@as(usize, 6), passDrafts(6, 5, 0, 0, 15)); // TF_DS_DRAFT_BLOCK_KEPT=0: every pass with room
+}
