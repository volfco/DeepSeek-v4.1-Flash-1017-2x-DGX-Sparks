+    pub const weight: f32 = 1.0 / 16.0;
+    /// The landing chance a governed draft needs when the switch names none: a verified draft cost 3.6 ms and a
+    /// token 7.4 to 9.7 ms on the code-like prompts of November 19 (0.37 to 0.48).
+    pub const default_bar: f32 = 0.43;
+
+    /// Keeps what the log prints of a pass before the gate rewrites its governed confidences.
+    pub fn note(lad: *Ladder, confs: []const f32, from: usize) void {
+        var sv: [draft.max_block]f64 = undefined;
+        const n = @min(from, confs.len);
+        lad.surv = 1.0;
+        if (n > 0) {
+            survivals(confs[0..n], sv[0..n]);
+            lad.surv = @floatCast(sv[n - 1]);
+        }
+        lad.own = .{ if (confs.len > 1) confs[confs.len - 2] else 0, if (confs.len > 0) confs[confs.len - 1] else 0 };
+    }
+};
+
+pub const LadderSet = struct { bar: f32, from: usize };
+
+/// TF_DS_DRAFT_LADDER's value. Unset, "", "0" or "off": off (null). "1" or "on": the default bar on the block's last
+/// draft. Else "<bar>" or "<bar>,<first>": the bar in (0, 1] ("1.0" offers a governed draft never: its pass still
+/// runs and is scored) and the first governed draft counted from 1, past the checkpoint's block (`base`) and no
+/// later than the block's last (`most`); without it, the last. A block of the checkpoint's own size has no draft to
+/// govern (off).
+pub fn parseLadder(v: []const u8, base: usize, most: usize) !?LadderSet {
+    const t = std.mem.trim(u8, v, " ");
+    if (t.len == 0 or std.mem.eql(u8, t, "0") or std.mem.eql(u8, t, "off")) return null;
+    if (most <= base) return null;
+    var set: LadderSet = .{ .bar = Ladder.default_bar, .from = most - 1 };
+    if (std.mem.eql(u8, t, "1") or std.mem.eql(u8, t, "on")) return set;
+    var it = std.mem.splitScalar(u8, t, ',');
+    set.bar = std.fmt.parseFloat(f32, std.mem.trim(u8, it.first(), " ")) catch return error.BadDraftLadder;
+    if (!(set.bar > 0.0 and set.bar <= 1.0)) return error.BadDraftLadder;
+    if (it.next()) |f| {
+        const first = std.fmt.parseInt(usize, std.mem.trim(u8, f, " "), 10) catch return error.BadDraftLadder;
+        if (first <= base or first > most) return error.BadDraftLadder;
+        set.from = first - 1;
+    }
+    if (it.next() != null) return error.BadDraftLadder;
+    return set;
+}
+
+/// Scores a stream's last pass against the round that followed it. `held` is the drafts that pass ran for the stream
+/// (no filler past them) and `after[d]` the token after the round's kept row d (a draft request's `follow`): the
+/// truth at draft d's place, whether the round verified that draft or not. Draft d is right when it equals that
+/// token; it is scored only if the round kept the row before it and every draft before it was right, and only from
+/// `from` up. A score moves the draft's share by Ladder.weight toward 1 or 0. Returns the scores as bits: bit d for a
+/// scored draft, bit d + 16 for a right one.
+pub fn ladderScore(rate: []f32, held: []const u32, after: []const u32, from: usize) u32 {
+    var bits: u32 = 0;
+    for (0..@min(held.len, after.len)) |d| {
+        const right = held[d] == after[d];
+        if (d >= from) {
+            bits |= @as(u32, 1) << @intCast(d);
+            if (right) bits |= @as(u32, 1) << @intCast(d + 16);
+            rate[d] += ((if (right) @as(f32, 1.0) else 0.0) - rate[d]) * Ladder.weight;
+        }
+        if (!right) break;
+    }
+    return bits;
+}
+
+/// Gates the drafts a pass ran for a stream (`confs`: their confidences, the pass's own). The drafts before `from`
+/// stand as they are. From `from` up, a draft is offered while the chance that it lands (the pass's own survival
+/// through the drafts before `from`, times the stream's shares from there to it) is at least `bar`, and its
+/// confidence becomes its share's logit, so the round loop's allocation prices it by the stream's record. The first
+/// draft under the bar and every one after it are held at no_chance. Returns the drafts left on offer. The stream's
+/// held count is not this function's to change (holdDrafts: the round loop's count stands).
+pub fn ladderGate(confs: []f32, rate: []const f32, from: usize, bar: f32) usize {
+    if (confs.len <= from) return confs.len;
+    var sv: [draft.max_block]f64 = undefined;
+    var surv: f64 = 1.0;
+    if (from > 0) {
+        survivals(confs[0..from], sv[0..from]);
+        surv = sv[from - 1];
+    }
+    for (from..confs.len) |d| {
+        const p = std.math.clamp(@as(f64, rate[d]), 0.02, 0.98);
+        surv *= p;
+        if (surv < bar) {
+            for (confs[d..]) |*c| c.* = no_chance;
+            return d;
+        }
+        confs[d] = @floatCast(@log(p / (1.0 - p)));
+    }
+    return confs.len;
+}
