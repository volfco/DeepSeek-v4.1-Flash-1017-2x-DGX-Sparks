+test "TF_DS_DRAFT_LADDER: the switch's values" {
+    const eq = std.testing.expectEqual;
+    try eq(@as(?LadderSet, null), try parseLadder("", 5, 7));
+    try eq(@as(?LadderSet, null), try parseLadder("0", 5, 7));
+    try eq(@as(?LadderSet, null), try parseLadder("off", 5, 7));
+    try eq(@as(?LadderSet, null), try parseLadder("1", 5, 5)); // the checkpoint's own block: nothing to govern
+    try eq(LadderSet{ .bar = Ladder.default_bar, .from = 6 }, (try parseLadder("1", 5, 7)).?); // the seventh draft
+    try eq(LadderSet{ .bar = Ladder.default_bar, .from = 5 }, (try parseLadder("on", 5, 6)).?); // a six-draft block's sixth
+    try eq(LadderSet{ .bar = 0.5, .from = 6 }, (try parseLadder(" 0.5 ", 5, 7)).?);
+    try eq(LadderSet{ .bar = 1.0, .from = 6 }, (try parseLadder("1.0", 5, 7)).?); // never offered, still scored
+    try eq(LadderSet{ .bar = 0.4, .from = 5 }, (try parseLadder("0.4,6", 5, 7)).?); // the sixth and the seventh
+    const bad = std.testing.expectError;
+    try bad(error.BadDraftLadder, parseLadder("0.4,5", 5, 7)); // a draft of the checkpoint's block
+    try bad(error.BadDraftLadder, parseLadder("0.4,8", 5, 7));
+    try bad(error.BadDraftLadder, parseLadder("1.5", 5, 7));
+    try bad(error.BadDraftLadder, parseLadder("-0.1", 5, 7));
+    try bad(error.BadDraftLadder, parseLadder("x", 5, 7));
+    try bad(error.BadDraftLadder, parseLadder("0.4,6,7", 5, 7));
+}
