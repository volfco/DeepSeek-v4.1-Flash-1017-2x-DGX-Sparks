+test "TF_DS_DRAFT_BLOCK: a stream holds every draft it was asked; those its pass did not run land with no chance" {
+    const gpa = std.testing.allocator;
+    var held: [draft.max_block]u32 = @splat(0);
+    var confs: [draft.max_block]f32 = @splat(9.0); // stale confidences of an earlier, wider pass
+    const drafts = [_]i64{ 11, 12, 13, 14, 15, 99, 99, 99 };
+    const pass_confs = [_]f32{ 3.0, 3.0, 3.0, 3.0, 3.0, 9.0, 9.0, 9.0 };
+    // asked 7 (TF_DS_DRAFT_BLOCK=7), the pass narrowed to the checkpoint's 5
+    const n = holdDrafts(&held, &confs, 7, 5, &drafts, &pass_confs);
+    try std.testing.expectEqual(@as(usize, 7), n); // the round loop's count stands (a short count refused the window)
+    try std.testing.expectEqualSlices(u32, &.{ 11, 12, 13, 14, 15, 15, 15 }, held[0..7]);
+    var sv: [7]f64 = undefined;
+    survivals(confs[0..7], &sv);
+    try std.testing.expect(sv[4] > 0.7);
+    try std.testing.expectEqual(@as(f64, 0.0), sv[5]);
+    try std.testing.expectEqual(@as(f64, 0.0), sv[6]);
+    // the round loop's allocation, at the served round costs, never grants a draft the pass did not run
+    var costs: lanes.table.Table = .{};
+    defer costs.deinit(gpa);
+    for (draft.round_ms[0..16], 1..) |ms, rows| try costs.put(gpa, @intCast(rows), ms);
+    const granted = try lanes.allocate.allocate(gpa, &.{1}, &.{sv[0..]}, &costs, draft.draft_ms, 16);
+    defer gpa.free(granted);
+    try std.testing.expectEqual(@as(u32, 5), granted[0]);
+    // a pass as wide as asked holds its own drafts
+    const m = holdDrafts(&held, &confs, 6, 6, &drafts, &pass_confs);
+    try std.testing.expectEqual(@as(usize, 6), m);
+    try std.testing.expectEqual(@as(f32, 9.0), confs[5]);
+}
