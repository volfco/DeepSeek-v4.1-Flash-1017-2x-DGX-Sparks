+test "TF_DS_DRAFT_LADDER: a governed draft is scored by the next round's tokens, only when the drafts before it were right" {
+    const eq = std.testing.expectEqual;
+    const held = [_]u32{ 11, 12, 13, 14, 15, 16, 17 }; // a seven-draft pass
+    var rate: [draft.max_block]f32 = @splat(0.5);
+    // the round kept all eight rows: the seventh draft landed
+    try eq(@as(u32, 1 << 6 | 1 << 22), ladderScore(&rate, &held, &.{ 11, 12, 13, 14, 15, 16, 17, 90 }, 6));
+    try eq(@as(f32, 0.5 + 0.5 / 16.0), rate[6]);
+    try eq(@as(f32, 0.5), rate[5]); // the sixth is not governed
+    // the round kept seven rows: its last token is the truth at the seventh draft's place, verified or not
+    rate[6] = 0.5;
+    try eq(@as(u32, 1 << 6 | 1 << 22), ladderScore(&rate, &held, &.{ 11, 12, 13, 14, 15, 16, 17 }, 6)); // right, unverified
+    try eq(@as(u32, 1 << 6), ladderScore(&rate, &held, &.{ 11, 12, 13, 14, 15, 16, 99 }, 6)); // wrong
+    try eq(@as(f32, (0.5 + 0.5 / 16.0) * (15.0 / 16.0)), rate[6]);
+    // the round stopped earlier: the seventh draft's place was not reached, so it is not scored
+    rate[6] = 0.5;
+    try eq(@as(u32, 0), ladderScore(&rate, &held, &.{ 11, 12, 13, 14, 15, 16 }, 6));
+    try eq(@as(u32, 0), ladderScore(&rate, &held, &.{ 11, 12, 99 }, 6));
+    try eq(@as(u32, 0), ladderScore(&rate, &held, &.{}, 6));
+    // seven rows kept that were not this pass's drafts (a copied window): an earlier draft was wrong, so no score
+    try eq(@as(u32, 0), ladderScore(&rate, &held, &.{ 11, 12, 77, 14, 15, 16, 17 }, 6));
+    try eq(@as(f32, 0.5), rate[6]);
+    // a pass that ran six drafts has no seventh to score, whatever the round kept
+    try eq(@as(u32, 0), ladderScore(&rate, held[0..6], &.{ 11, 12, 13, 14, 15, 16, 17, 90 }, 6));
+    // two governed drafts: the sixth wrong ends the scoring before the seventh
+    try eq(@as(u32, 1 << 5), ladderScore(&rate, &held, &.{ 11, 12, 13, 14, 15, 66, 17 }, 5));
+    try eq(@as(u32, 1 << 5 | 1 << 21 | 1 << 6 | 1 << 22), ladderScore(&rate, &held, &.{ 11, 12, 13, 14, 15, 16, 17 }, 5));
+}
