+/// the checkpoint's dspark_block_size (5: [token, noise x 4], five drafts) to max_draft_block. A pass asked for more
+/// drafts than the checkpoint's block runs as many block rows as drafts ([token, noise x (steps - 1)]); a pass asked
+/// for no more runs the checkpoint's block, launch for launch what it ran without the switch. The drafter was trained
+/// on its own block: the rows past it are extrapolation, and the verify decides (a reply keeps its bits either way:
+/// drafts only choose how many rows a round verifies).
+pub const block_env = "TF_DS_DRAFT_BLOCK";
+/// The widest block the switch takes: lanes.window_rows is one row more (the pending row).
+pub const max_draft_block = 7;
+
+/// TF_DS_DRAFT_BLOCK's value: unset, empty or "0" is the checkpoint's block (`base`); else base .. max_draft_block.
+pub fn parseBlock(text: ?[]const u8, base: usize) !usize {
+    const s = std.mem.trim(u8, text orelse return base, " ");
+    if (s.len == 0 or std.mem.eql(u8, s, "0")) return base;
+    const v = std.fmt.parseInt(usize, s, 10) catch return error.BadDraftBlock;
+    if (v < base or v > max_draft_block or v > max_block) return error.BadDraftBlock;
+    return v;
+}
+
+pub fn blockFromEnv(base: usize) !usize {
+    return parseBlock(if (std.c.getenv(block_env)) |v| std.mem.span(v) else null, base);
+}
+
+test "TF_DS_DRAFT_BLOCK: unset is the checkpoint's block, a value from it to max_draft_block" {
+    try std.testing.expectEqual(@as(usize, 5), try parseBlock(null, 5));
+    try std.testing.expectEqual(@as(usize, 5), try parseBlock("", 5));
+    try std.testing.expectEqual(@as(usize, 5), try parseBlock("0", 5));
+    try std.testing.expectEqual(@as(usize, 5), try parseBlock("5", 5));
+    try std.testing.expectEqual(@as(usize, 6), try parseBlock(" 6 ", 5));
+    try std.testing.expectEqual(@as(usize, 7), try parseBlock("7", 5));
+    try std.testing.expectError(error.BadDraftBlock, parseBlock("4", 5));
+    try std.testing.expectError(error.BadDraftBlock, parseBlock("8", 5));
+    try std.testing.expectError(error.BadDraftBlock, parseBlock("six", 5));
+}
