+/// Whether rowmmGate's launch of a `rows`-row gate (rows <= tri.decode_rows) resolves in the kit: rowmm2's path does
+/// for every row count, the chunk sums' only where the kit holds the _rowmm_parts variant of exactly these rows (RB is
+/// the gate's rows). The published kit holds the target's gates (N 384) at RB 1..16 and the drafter's (N 128) at the
+/// rows its capture ran: 5, 10 and 15, a five-row block a stream. A drafter pass of other rows (TF_DS_DRAFT_BLOCK)
+/// asks, and takes the wide passes' cuBLAS gate when this says no.
+pub fn rowmmGateFits(t: Tri, x: u64, xs: usize, w: u64, out: u64, rows: usize, k: usize, n: usize) bool {
+    const tile = rpTile(rows);
+    const kc = k / 256;
+    if (!(rowmm_parts_min <= rows and rows <= tri.decode_rows and k % 256 == 0 and kc % tile.cpg == 0 and n >= 32)) return true;
+    if (rows > rowmm_parts_piece) return true; // rowmmPartsPiece splits those
+    const l = partsLaunch(t, x, xs, w, out, rows, k, n);
+    return t.has("_rowmm_parts", &l.args, &l.consts);
+}
